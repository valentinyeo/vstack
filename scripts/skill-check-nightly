#!/usr/bin/env bash
# skill-check-nightly: run skill-check, log the result to a ticket, comment when it changes.
#
#   skill-check-nightly [--ticket VSTA-36] [--project 13556] [--token-file FILE]
#                       [--remote HOST:REPORT_PATH] [--state-dir DIR] [--check PATH]
#                       [--host-label NAME]
#
# Without --ticket it only writes STATE/latest.json. That is how the Hetzner machine
# runs it: that machine has no Hypertask login and must not get one. The token is never
# printed, never logged and never traced.
#
# --host-label names the machine in the report. It defaults to this machine's hostname,
# so the nightly run on another box can say which box it was.
set -u

TICKET=""
PROJECT="13556"
TOKEN_FILE=""
REMOTE=""
STATE_DIR="${HOME}/.local/state/skill-check"
CHECK="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/skill-check.py"
HOST_LABEL=""
PYTHON="${PYTHON:-python3}"
MAX_AGE=129600

usage() {
    printf 'usage: skill-check-nightly [--ticket ID] [--project N] [--token-file F]\n'
    printf '                           [--remote HOST:PATH] [--state-dir DIR] [--check PATH]\n'
    printf '                           [--host-label NAME]\n'
}

need() {
    if [ "$#" -lt 2 ] || [ -z "$2" ]; then
        printf 'skill-check-nightly: %s needs a value\n' "$1" >&2
        exit 2
    fi
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --ticket) need "$@"; TICKET="$2"; shift 2 ;;
        --project) need "$@"; PROJECT="$2"; shift 2 ;;
        --token-file) need "$@"; TOKEN_FILE="$2"; shift 2 ;;
        --remote) need "$@"; REMOTE="$2"; shift 2 ;;
        --state-dir) need "$@"; STATE_DIR="$2"; shift 2 ;;
        --check) need "$@"; CHECK="$2"; shift 2 ;;
        --host-label) need "$@"; HOST_LABEL="$2"; shift 2 ;;
        --help|-h) usage; exit 0 ;;
        *) printf 'skill-check-nightly: unknown option %s\n' "$1" >&2; usage >&2; exit 2 ;;
    esac
done

mkdir -p "$STATE_DIR" || exit 1

# Drop last night's report first: a crash must not leave a stale one looking current.
rm -f "$STATE_DIR/latest.json"

status=0
check_args=(--json --out "$STATE_DIR/latest.json")
if [ -n "$HOST_LABEL" ]; then
    check_args+=(--host-label "$HOST_LABEL")
fi
"$PYTHON" "$CHECK" "${check_args[@]}" || status=$?
case "$status" in
    0|1) ;;
    *) printf 'skill-check-nightly: the check failed with exit %s\n' "$status" >&2
       exit 1 ;;
esac

if [ -z "$TICKET" ]; then
    printf 'skill-check-nightly: no ticket, wrote %s\n' "$STATE_DIR/latest.json"
    exit 0
fi

TOKEN=""
if [ -n "$TOKEN_FILE" ]; then
    TOKEN="$(tr -d '[:space:]' < "$TOKEN_FILE" 2>/dev/null)" || TOKEN=""
else
    TOKEN="${HT_TOKEN:-}"
fi
if [ -z "$TOKEN" ]; then
    printf 'skill-check-nightly: no token, set --token-file or HT_TOKEN\n' >&2
    exit 1
fi

REMOTE_HOST=""
REMOTE_MISSING=0
REMOTE_FILE="$STATE_DIR/remote.json"
rm -f "$REMOTE_FILE"
if [ -n "$REMOTE" ]; then
    case "$REMOTE" in
        *:*)
            REMOTE_HOST="${REMOTE%%:*}"
            REMOTE_PATH="${REMOTE#*:}"
            ;;
        *) printf 'skill-check-nightly: --remote wants HOST:PATH\n' >&2; exit 2 ;;
    esac
    if [ -z "$REMOTE_HOST" ] || [ -z "$REMOTE_PATH" ]; then
        printf 'skill-check-nightly: --remote wants HOST:PATH\n' >&2
        exit 2
    fi
    if ssh -o BatchMode=yes -o ConnectTimeout=15 "$REMOTE_HOST" \
           cat "$REMOTE_PATH" > "$REMOTE_FILE" 2>/dev/null; then
        age="$("$PYTHON" - "$REMOTE_FILE" <<'PY'
import datetime, json, sys
try:
    stamp = json.load(open(sys.argv[1]))['time']
    when = datetime.datetime.fromisoformat(stamp.replace('Z', '+00:00'))
    now = datetime.datetime.now(datetime.timezone.utc)
    print(int((now - when).total_seconds()))
except Exception:
    print(-1)
PY
)"
        # An empty or non-integer age means the snippet died, not a fresh report.
        if ! printf '%s' "$age" | grep -Eq '^-?[0-9]+$'; then
            REMOTE_MISSING=1
        elif [ "$age" -lt 0 ] || [ "$age" -gt "$MAX_AGE" ]; then
            REMOTE_MISSING=1
        fi
    else
        REMOTE_MISSING=1
    fi
    if [ "$REMOTE_MISSING" -eq 1 ]; then
        rm -f "$REMOTE_FILE"
    fi
fi

"$PYTHON" - "$STATE_DIR" "$REMOTE_HOST" "$REMOTE_MISSING" <<'PY' || exit 1
"""Build the agent log text, the comment body and the combined digest."""
import datetime
import hashlib
import html
import json
import os
import sys

state, remote_host, remote_missing = sys.argv[1], sys.argv[2], sys.argv[3] == '1'


def load(name):
    try:
        with open(os.path.join(state, name)) as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return None


local = load('latest.json') or {'host': 'local', 'findings': [], 'totals': {}}
remote = None if remote_missing else load('remote.json')

lines = []          # finding lines across hosts: digest input
log = ['skill check ' + datetime.datetime.now(datetime.timezone.utc)
       .strftime('%Y-%m-%dT%H:%M:%SZ')]
items = []          # (host, finding line) for the comment list


def one(report, missing=False):
    host = report.get('host', 'unknown')
    totals = report.get('totals', {})
    findings = report.get('findings', [])
    log.append('')
    noun = 'finding' if len(findings) == 1 else 'findings'
    log.append('%s: %d %s, %s visible description bytes (budget %s), '
               '%s visible, %s hidden'
               % (host, len(findings), noun, totals.get('visible_bytes', 0),
                  totals.get('budget', 0), totals.get('visible_items', 0),
                  totals.get('hidden_items', 0)))
    if missing:
        line = 'remote-report: missing: no report in 36 hours'
        log.append('%s: %s' % (host, line))
        items.append((host, line))
        lines.append('%s: %s' % (host, line))
        return
    for finding in findings:
        line = '%s: %s: %s' % (finding.get('kind'), finding.get('subject'),
                               finding.get('detail'))
        log.append('%s: %s' % (host, line))
        items.append((host, line))
        lines.append('%s: %s' % (host, line))


one(local)
if remote_missing:
    one({'host': remote_host or 'remote', 'findings': [], 'totals': {}}, missing=True)
elif remote is not None:
    one(remote)

digest = hashlib.sha256(('\n'.join(sorted(lines)) + '\n').encode('utf-8')).hexdigest()

if not lines:
    if remote_host:
        body = '<p>The skill check is clean on both machines.</p>\n'
    else:
        body = '<p>The skill check is clean.</p>\n'
else:
    noun = 'problem' if len(lines) == 1 else 'problems'
    body = ['<p>The nightly skill check found %d %s.</p>' % (len(lines), noun), '<ul>']
    for host, line in items:
        body.append('<li>%s: %s</li>' % (html.escape(host), html.escape(line)))
    body.append('</ul>')
    body = '\n'.join(body) + '\n'

with open(os.path.join(state, 'log.txt'), 'w') as handle:
    handle.write('\n'.join(log) + '\n')
with open(os.path.join(state, 'comment.html'), 'w') as handle:
    handle.write(body)
with open(os.path.join(state, 'combined.digest.tmp'), 'w') as handle:
    handle.write(digest + '\n')
print('%d findings across hosts' % len(lines))
PY

hypertask --token "$TOKEN" activity add "$TICKET" --project "$PROJECT" \
    --text "$(cat "$STATE_DIR/log.txt")" || {
    printf 'skill-check-nightly: the ticket log failed\n' >&2
    exit 1
}

if ! cmp -s "$STATE_DIR/combined.digest.tmp" "$STATE_DIR/posted.digest"; then
    if hypertask --token "$TOKEN" comment add "$TICKET" --project "$PROJECT" \
            --kind qa --file "$STATE_DIR/comment.html"; then
        cp "$STATE_DIR/combined.digest.tmp" "$STATE_DIR/posted.digest"
    else
        printf 'skill-check-nightly: the comment failed, digest not stored\n' >&2
        exit 1
    fi
else
    printf 'skill-check-nightly: nothing new to post\n'
fi
