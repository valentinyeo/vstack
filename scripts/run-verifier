#!/usr/bin/env python3
"""run-verifier: take the first verdict any verifier lane and model gives.

  run-verifier --out verifier.jsonl --prompt-file PROMPT [--event PATH] [--attempt-timeout SECONDS]
               [--idle-timeout SECONDS] [--no-bash-timeout SECONDS] -- <extra pi args>
  run-verifier --self-test

Models come from `pick-verifier-model --all`, so every attempt is from a family no author declares.
Lanes, in order: opencode-go with the model id, used only when OPENCODE_API_KEY is set; then
vercel-ai-gateway with the provider id, used only when AI_GATEWAY_API_KEY is set. Every model on the
first lane is tried before the second lane starts.
An attempt succeeds when its JSON trace shows a bash run and the last assistant message holds a verdict,
read through scripts/verdict.py: a bare PASS, PASS+NOTES or FAIL line, a VERDICT: <x> line, or a JSON
verdict field. These are exactly the two things the vstack verdict step asks for.
A stuck lane fails over early when it prints a 429/quota error to stderr or a provider error event,
stays silent past --idle-timeout (default 120s, paused while a tool call is running), or never starts
a bash call within --no-bash-timeout (default 150s); active lanes keep the full --attempt-timeout hard
cap. On abort or timeout the whole process group is terminated so no child processes leak into the next
lane.
Non-zero exits, empty traces and 429 or quota errors fall through to the next attempt. The trace moves to
--out on success, `VERIFIER_MODEL=<lane>/<id>` is appended to $GITHUB_ENV when set, and stderr names the
lane that answered. When every attempt fails, the last trace is copied to --out, stderr prints a clear
`NO VERDICT: every model lane failed: <lane: reason, ...>. This is not a code failure.` line, and the
exit code is 1. Never prints prompt text or keys.
"""
import argparse
import contextlib
import io
import json
import os
import re
import selectors
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from verdict import find_verdict

LANES = (
    ("opencode-go", "OPENCODE_API_KEY", {}),
    ("vercel-ai-gateway", "AI_GATEWAY_API_KEY", {
        "deepseek-v4.1-flash": "deepseek/deepseek-v4.1-flash",
        "glm-5.3-flash": "zai/glm-5.3-flash",
        "kimi-k3": "moonshotai/kimi-k3",
    }),
)
QUOTA = re.compile(r"\b429\b|\bquota\b|rate.?limit|credit balance", re.I)
FAILURE = "run-verifier: %s/%s gave no verdict (%s), trying next\n"
NO_VERDICT = "NO VERDICT: every model lane failed: %s. This is not a code failure."
DEFAULT_IDLE_TIMEOUT = 120
DEFAULT_NO_BASH_TIMEOUT = 150


def read(path):
    with open(path, encoding="utf-8", errors="replace") as handle:
        return handle.read()


def models(event):
    """The allowed verifier models, from the picker in this script's own checkout."""
    picker = os.path.join(os.path.dirname(os.path.realpath(__file__)), "pick-verifier-model")
    command = [sys.executable, "-I", picker, "--all"] + (["--event", event] if event else [])
    result = subprocess.run(command, capture_output=True, text=True)
    if result.returncode:
        sys.stderr.write(result.stderr)
        raise SystemExit(result.returncode)
    return [line.strip() for line in result.stdout.splitlines() if line.strip()]


def bash_evidence(trace):
    """True when the trace shows the verifier actually ran a bash tool, the proof the verdict step asks for."""
    for line in trace.splitlines():
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if event.get("type") == "tool_execution_end" and event.get("toolName") == "bash":
            return True
    return False


def verdict(trace):
    """True when the last assistant message of the trace holds the verdict scripts/verdict.py reads."""
    answer = []
    for line in trace.splitlines():
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if event.get("type") != "message_end":
            continue
        message = event.get("message") or {}
        if message.get("role") != "assistant":
            continue
        answer = [part.get("text", "") for part in message.get("content") or [] if part.get("type") == "text"]
    return find_verdict("\n".join(answer))[0] is not None


def fmt_seconds(seconds):
    return "%d" % seconds if seconds == int(seconds) else "%g" % seconds


def format_no_verdict(failures):
    detail = ", ".join("%s/%s: %s" % (lane, model, reason) for lane, model, reason in failures)
    return NO_VERDICT % (detail or "no API key set")


def bash_started_or_ended(event):
    return event.get("type") in ("tool_execution_start", "tool_execution_end") and event.get("toolName") == "bash"


def quota_error_event(event):
    """True when a pi JSON event reports a provider 429/quota error, never normal prose or tool output."""
    kind = event.get("type")
    if kind in ("error", "auto_retry_start"):
        text = " ".join(str(event.get(k) or "") for k in ("errorMessage", "error", "message"))
        return bool(QUOTA.search(text))
    if kind == "message_end":
        message = event.get("message") or {}
        if message.get("role") == "assistant" and message.get("stopReason") == "error":
            return bool(QUOTA.search(str(message.get("errorMessage") or "")))
    return False


def terminate_group(proc):
    """Stop pi and every child it spawned so a timed-out lane leaves no orphan processes."""
    for sig in (signal.SIGTERM, signal.SIGKILL):
        try:
            os.killpg(proc.pid, sig)
        except ProcessLookupError:
            break
        deadline = time.monotonic() + (0.5 if sig == signal.SIGTERM else 1.0)
        while proc.poll() is None and time.monotonic() < deadline:
            time.sleep(0.02)
        if proc.poll() is not None:
            break
    try:
        proc.wait(timeout=1)
    except subprocess.TimeoutExpired:
        pass


def attempt(pi, lane, model, extra, prompt, path, env, limit=None,
            idle_timeout=DEFAULT_IDLE_TIMEOUT, no_bash_timeout=DEFAULT_NO_BASH_TIMEOUT):
    """One pi run. Returns the reason it gave no verdict, or None on success."""
    command = [*pi, "--provider", lane, "--model", model, *extra, "--mode", "json", "-p", prompt]
    try:
        proc = subprocess.Popen(
            command,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=env,
            start_new_session=True,
        )
    except OSError as problem:
        return "cannot run %s: %s" % (pi[0], problem.strerror)

    started = time.monotonic()
    last_output = started
    saw_bash = False
    open_tools = set()
    open_anonymous_tools = 0
    abort_reason = None
    stdout_buf = b""
    stderr_buf = b""

    sel = selectors.DefaultSelector()
    sel.register(proc.stdout, selectors.EVENT_READ, "out")
    sel.register(proc.stderr, selectors.EVENT_READ, "err")

    try:
        with open(path, "wb") as out_file, open(path + ".err", "wb") as err_file:
            while sel.get_map():
                now = time.monotonic()
                deadlines = []
                if limit is not None and limit > 0:
                    if now - started >= limit:
                        abort_reason = "timed out after %ss" % fmt_seconds(limit)
                        break
                    deadlines.append(started + limit - now)
                tool_running = bool(open_tools) or open_anonymous_tools > 0
                if idle_timeout is not None and idle_timeout > 0 and not tool_running:
                    if now - last_output >= idle_timeout:
                        abort_reason = "no output for %ss" % fmt_seconds(idle_timeout)
                        break
                    deadlines.append(last_output + idle_timeout - now)
                if no_bash_timeout is not None and no_bash_timeout > 0 and not saw_bash:
                    if now - started >= no_bash_timeout:
                        abort_reason = "no bash call after %ss" % fmt_seconds(no_bash_timeout)
                        break
                    deadlines.append(started + no_bash_timeout - now)

                wait_for = min(deadlines) if deadlines else 0.2
                wait_for = max(0.0, min(wait_for, 0.2))
                events = sel.select(timeout=wait_for)
                if not events:
                    if proc.poll() is not None:
                        break
                    continue

                for key, _ in events:
                    chunk = os.read(key.fd, 65536)
                    if not chunk:
                        sel.unregister(key.fileobj)
                        continue
                    last_output = time.monotonic()
                    if key.data == "out":
                        out_file.write(chunk)
                        out_file.flush()
                        stdout_buf += chunk
                        while b"\n" in stdout_buf:
                            raw_line, stdout_buf = stdout_buf.split(b"\n", 1)
                            text = raw_line.decode("utf-8", errors="replace").strip()
                            if not text.startswith("{"):
                                continue
                            try:
                                event = json.loads(text)
                            except ValueError:
                                continue
                            kind = event.get("type")
                            if kind == "tool_execution_start":
                                call_id = event.get("toolCallId")
                                if call_id is not None and call_id != "":
                                    open_tools.add(call_id)
                                else:
                                    open_anonymous_tools += 1
                            elif kind == "tool_execution_end":
                                call_id = event.get("toolCallId")
                                if call_id is not None and call_id != "":
                                    open_tools.discard(call_id)
                                elif open_anonymous_tools > 0:
                                    open_anonymous_tools -= 1
                            if bash_started_or_ended(event):
                                saw_bash = True
                            if quota_error_event(event):
                                abort_reason = "429 or quota"
                                break
                    else:
                        err_file.write(chunk)
                        err_file.flush()
                        stderr_buf += chunk
                        if QUOTA.search(stderr_buf.decode("utf-8", errors="replace")):
                            abort_reason = "429 or quota"
                            break
                        if len(stderr_buf) > 4096:
                            stderr_buf = stderr_buf[-1024:]
                    if abort_reason:
                        break
                if abort_reason:
                    break
    finally:
        sel.close()
        if abort_reason is not None or proc.poll() is None:
            terminate_group(proc)
        else:
            proc.wait()
            try:
                os.killpg(proc.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
        proc.stdout.close()
        proc.stderr.close()

    if abort_reason is not None:
        return abort_reason

    trace, noise = read(path), read(path + ".err")
    if proc.returncode == 0 and bash_evidence(trace) and verdict(trace):
        return None
    reasons = []
    if proc.returncode:
        reasons.append("exit %d" % proc.returncode)
    if QUOTA.search(trace) or QUOTA.search(noise):
        reasons.append("429 or quota")
    if not trace.strip():
        reasons.append("empty output")
    elif not bash_evidence(trace):
        reasons.append("no bash evidence")
    elif not verdict(trace):
        reasons.append("no verdict line")
    return ", ".join(reasons) or None


def run(out, prompt_file, event, extra, env, limit=None,
        idle_timeout=DEFAULT_IDLE_TIMEOUT, no_bash_timeout=DEFAULT_NO_BASH_TIMEOUT):
    prompt = read(prompt_file)
    pi = shlex.split(env.get("PI_BIN") or "pi")
    wanted = models(event)
    planned = [(lane, ids.get(model, model)) for lane, key, ids in LANES if env.get(key) for model in wanted]
    failures = []
    with tempfile.TemporaryDirectory() as scratch:
        last = None
        for index, (lane, model) in enumerate(planned):
            path = os.path.join(scratch, "attempt-%d.jsonl" % index)
            last = path
            reason = attempt(pi, lane, model, extra, prompt, path, env, limit, idle_timeout, no_bash_timeout)
            if reason is None:
                shutil.move(path, out)
                if env.get("GITHUB_ENV"):
                    with open(env["GITHUB_ENV"], "a", encoding="utf-8") as handle:
                        handle.write("VERIFIER_MODEL=%s/%s\n" % (lane, model))
                sys.stderr.write("run-verifier: verdict from %s/%s\n" % (lane, model))
                return 0
            failures.append((lane, model, reason))
            sys.stderr.write(FAILURE % (lane, model, reason))
        if last:
            shutil.copyfile(last, out)
    sys.stderr.write("run-verifier: no lane gave a verdict\n")
    sys.stderr.write(format_no_verdict(failures) + "\n")
    return 1


def self_test():
    with tempfile.TemporaryDirectory() as scratch:
        fake = os.path.join(scratch, "pi")
        with open(fake, "w", encoding="utf-8") as handle:
            handle.write(FAKE_PI)
        os.chmod(fake, 0o755)
        event = os.path.join(scratch, "event.json")
        prompt = os.path.join(scratch, "prompt.txt")
        with open(prompt, "w", encoding="utf-8") as handle:
            handle.write("PROMPT-TEXT-NEVER-PRINTED")
        log = os.path.join(scratch, "attempts.log")
        verdicts = os.path.join(scratch, "env")
        out = os.path.join(scratch, "verifier.jsonl")
        cases = [
            ("first lane empty, second answers",
             {"glm-5.3-flash": "pass"}, {"OPENCODE_API_KEY": "x"},
             "Author model: anthropic/claude-sonnet", 0, "opencode-go/glm-5.3-flash",
             ["opencode-go deepseek-v4.1-flash", "opencode-go glm-5.3-flash"]),
            ("429 then FAIL still counts as a verdict",
             {"deepseek-v4.1-flash": "429", "glm-5.3-flash": "fail"}, {"OPENCODE_API_KEY": "x"},
             "Author model: anthropic/claude-sonnet", 0, "opencode-go/glm-5.3-flash",
             ["opencode-go deepseek-v4.1-flash", "opencode-go glm-5.3-flash"]),
            ("every attempt empty",
             {}, {"OPENCODE_API_KEY": "x"},
             "Author model: anthropic/claude-sonnet", 1, None,
             ["opencode-go deepseek-v4.1-flash", "opencode-go glm-5.3-flash", "opencode-go kimi-k3"]),
            ("no opencode key, only the gateway",
             {"deepseek/deepseek-v4.1-flash": "pass"}, {"AI_GATEWAY_API_KEY": "x"},
             "Author model: anthropic/claude-sonnet", 0, "vercel-ai-gateway/deepseek/deepseek-v4.1-flash",
             ["vercel-ai-gateway deepseek/deepseek-v4.1-flash"]),
            ("deepseek author is never attempted",
             {}, {"OPENCODE_API_KEY": "x"},
             "Author model: deepseek/deepseek-v4.1-flash", 1, None,
             ["opencode-go glm-5.3-flash", "opencode-go kimi-k3"]),
            ("a hung model times out and the next answers",
             {"deepseek-v4.1-flash": "hang", "glm-5.3-flash": "pass"}, {"OPENCODE_API_KEY": "x"},
             "Author model: anthropic/claude-sonnet", 0, "opencode-go/glm-5.3-flash",
             ["opencode-go deepseek-v4.1-flash", "opencode-go glm-5.3-flash"]),
        ]
        for name, plan, keys, body, code, model, attempts in cases:
            with open(event, "w", encoding="utf-8") as handle:
                json.dump({"pull_request": {"body": body}}, handle)
            for path in (log, verdicts, out):
                if os.path.exists(path):
                    os.unlink(path)
            env = {"PATH": os.environ.get("PATH", ""), "PI_BIN": fake, "FAKE_LOG": log,
                   "FAKE_PLAN": json.dumps(plan), "GITHUB_ENV": verdicts}
            env.update(keys)
            stderr = io.StringIO()
            with contextlib.redirect_stderr(stderr):
                got = run(out, prompt, event, ["--thinking", "low"], env, 2)
            text = stderr.getvalue()
            assert got == code, (name, got, code, text)
            assert read(log).splitlines() == attempts, (name, read(log), attempts)
            assert "PROMPT-TEXT-NEVER-PRINTED" not in text, name
            if model:
                assert "VERIFIER_MODEL=%s\n" % model in read(verdicts), (name, model, read(verdicts))
            else:
                assert not os.path.exists(verdicts), name
            assert os.path.exists(out), name
            if model:
                assert "verdict from %s\n" % model in text, (name, text)
            else:
                assert "no lane gave a verdict\n" in text, (name, text)
                assert "NO VERDICT: every model lane failed:" in text, (name, text)
                assert "This is not a code failure." in text, (name, text)
    print("run-verifier self-test ok")


FAKE_PI = '''#!/usr/bin/env python3
import json
import os
import sys

args = sys.argv[1:]
lane = args[args.index("--provider") + 1]
model = args[args.index("--model") + 1]
with open(os.environ["FAKE_LOG"], "a", encoding="utf-8") as log:
    log.write(lane + " " + model + "\\n")
mode = json.loads(os.environ["FAKE_PLAN"]).get(model, "empty")
text = {"pass": "PASS", "fail": "FAIL\\nReason: broken"}.get(mode)
if text:
    print(json.dumps({"type": "tool_execution_end", "toolCallId": "1", "toolName": "bash",
                      "result": {"structuredContent": {"output": "ok", "exit_code": 0}, "isError": False}}))
    print(json.dumps({"type": "message_end", "message": {"role": "assistant",
                                                         "content": [{"type": "text", "text": text}]}}))
elif mode == "hang":
    import time
    time.sleep(30)
elif mode == "429":
    sys.stderr.write("429 Too Many Requests: quota used up\\n")
    sys.exit(1)
'''


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("--out")
    parser.add_argument("--prompt-file")
    parser.add_argument("--event", default=os.environ.get("GITHUB_EVENT_PATH"))
    parser.add_argument("--attempt-timeout", type=float, default=960)
    parser.add_argument("--idle-timeout", type=float, default=DEFAULT_IDLE_TIMEOUT)
    parser.add_argument("--no-bash-timeout", type=float, default=DEFAULT_NO_BASH_TIMEOUT)
    parser.add_argument("--self-test", action="store_true")
    parser.add_argument("extra", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    if args.self_test:
        return self_test()
    if not args.out or not args.prompt_file:
        parser.error("--out and --prompt-file are required")
    extra = args.extra[1:] if args.extra[:1] == ["--"] else args.extra
    return run(args.out, args.prompt_file, args.event, extra, os.environ,
               args.attempt_timeout, args.idle_timeout, args.no_bash_timeout)


if __name__ == "__main__":
    sys.exit(main())
