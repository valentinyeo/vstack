#!/usr/bin/env python3
"""Find missing hook scripts in live settings or the configuration vstack ships.

Live: check-hook-paths --root PROJECTS [--home HOME]
CI:   check-hook-paths --repo CHECKOUT (never reads home settings)
"""
import argparse
import ast
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import sys

FIX = 'reinstall vstack: ~/.local/share/vstack/install or remove the hook'
JSON_COMMAND = re.compile(r'"command"\s*:\s*("(?:[^"\\]|\\.)*")')
YAML_COMMAND = re.compile(r'^\s*command:\s*(.+)$', re.M)
ROOT_REF = re.compile(r'\$ROOT/((?:hooks|skills)/[\w./-]+)')
INTERPRETERS = {'python', 'python3', 'bash', 'sh', 'node', 'perl', 'ruby'}
BUILTINS = {'[', 'test', 'echo', 'printf', 'true', 'false', 'exit', ':', 'cd'}
SKIP = {'.git', 'node_modules', '__pycache__', '.venv'}


def allowed(path):
    # Fleet reports must never inspect the inne user's files, even through a link.
    return not path.resolve().is_relative_to(Path('/home/inne'))


def settings_files(root, home=None):
    files = set()
    if home:
        files.update(home / '.claude' / name for name in ('settings.json', 'settings.local.json'))
    if allowed(root):
        for directory, dirs, names in os.walk(root, followlinks=False):
            dirs[:] = [d for d in dirs if d not in SKIP and allowed(Path(directory) / d)]
            if Path(directory).name == '.claude':
                files.update(Path(directory) / n for n in names
                             if n.startswith('settings') and n.endswith('.json'))
    return sorted(p for p in files if allowed(p) and p.is_file())


def json_commands(data, location=''):
    if isinstance(data, dict):
        for key, value in data.items():
            where = f'{location}.{key}' if location else key
            if key == 'command' and isinstance(value, str):
                yield where, value
            else:
                yield from json_commands(value, where)
    elif isinstance(data, list):
        for index, value in enumerate(data):
            yield from json_commands(value, f'{location}[{index}]')


def references(path):
    text = path.read_text()
    if path.suffix == '.json':
        yield from json_commands(json.loads(text))
    elif path.suffix == '.py':
        for node in ast.walk(ast.parse(text)):
            if isinstance(node, ast.Dict):
                for key, value in zip(node.keys, node.values):
                    if (isinstance(key, ast.Constant) and key.value == 'command'
                            and isinstance(value, ast.Constant) and isinstance(value.value, str)):
                        yield f'line {value.lineno}', value.value
    else:
        for pattern in (JSON_COMMAND, YAML_COMMAND):
            for match in pattern.finditer(text):
                command = json.loads(match[1]) if pattern is JSON_COMMAND else match[1]
                yield f'line {text.count(chr(10), 0, match.start()) + 1}', command


def expand(value, variables):
    for name, replacement in variables.items():
        value = value.replace('${' + name + '}', str(replacement))
        value = re.sub(r'\$' + re.escape(name) + r'\b', lambda _: str(replacement), value)
    if value.startswith('~/'):
        value = str(variables['HOME']) + value[1:]
    return value


def command_files(command, variables):
    """Executable and interpreter/launcher operands, including legacy sh -c wrappers."""
    lexer = shlex.shlex(command, posix=True, punctuation_chars=';&|()')
    lexer.whitespace_split = True
    lexer.commenters = ''
    tokens = list(lexer)
    variables = dict(variables)
    groups = [[]]
    for token in tokens:
        if token and all(c in ';&|()' for c in token):
            groups.append([])
        else:
            groups[-1].append(token)
    for group in groups:
        while group and re.match(r'^\w+=', group[0]):
            name, value = group.pop(0).split('=', 1)
            variables[name] = expand(value, variables)
        while group and group[0] in ('exec', 'env'):
            group.pop(0)
        if not group:
            continue
        executable = expand(group[0], variables)
        name = Path(executable).name
        if name in BUILTINS:
            continue
        yield executable
        args = group[1:]
        if name in INTERPRETERS:
            if '-c' in args:
                if name in ('sh', 'bash'):
                    yield from command_files(args[args.index('-c') + 1], variables)
                continue
            if '-m' in args:
                continue
            operand = next((arg for arg in args if not arg.startswith('-')), None)
            if operand:
                yield expand(operand, variables)
        elif name == 'run-hook' and args:
            yield expand(args[0], variables)


def resolve_file(value, project, home, repo=None):
    path = Path(value)
    if repo:
        for prefix, target in ((home / '.claude/hooks', repo / 'hooks'),
                               (home / '.local/share/vstack', repo),
                               (home / '.claude/skills', repo / 'skills'),
                               (home / '.agents/skills', repo / 'skills')):
            if path.is_relative_to(prefix):
                path = target / path.relative_to(prefix)
                break
    if not path.is_absolute():
        if '/' not in value and shutil.which(value):
            return Path(shutil.which(value))
        path = project / path
    return path


def check(root, home, repo=False):
    files = settings_files(root, None if repo else home)
    if repo:
        files = sorted(set(files) | {p for folder in ('config', 'scripts', 'skills')
                                   for p in (root / folder).rglob('*')
                                   if p.suffix in ('.json', '.md', '.py') and allowed(p)})
    problems = []
    for path in files:
        project = (path.parent.parent if path.parent.name == '.claude'
                   and path.parent != home / '.claude' else root)
        variables = {'HOME': home, 'CLAUDE_PROJECT_DIR': project,
                     'CLAUDE_PLUGIN_ROOT': path.parent, 'ROOT': root}
        try:
            for location, command in references(path):
                for value in dict.fromkeys(command_files(command, variables)):
                    target = resolve_file(value, project, home, root if repo else None)
                    if not allowed(target) or not target.is_file():
                        problems.append(f'{path}:{location}: missing {target}; command {command!r}; {FIX}')
        except (OSError, ValueError, SyntaxError) as error:
            problems.append(f'{path}: cannot check hook commands: {error}; {FIX}')
    if repo and (root / 'install').is_file():
        for number, line in enumerate((root / 'install').read_text().splitlines(), 1):
            for reference in ROOT_REF.findall(line):
                if not (root / reference).is_file():
                    problems.append(f'{root / "install"}:{number}: missing {reference}; reference {line.strip()}; {FIX}')
    return problems


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument('--root', type=Path, default=Path.cwd(), help='root containing project settings')
    mode.add_argument('--repo', type=Path, help='check shipped settings, snippets, skill hooks, examples and install')
    parser.add_argument('--home', type=Path, default=Path.home(), help='only this home is checked')
    args = parser.parse_args(argv)
    root = (args.repo or args.root).resolve()
    # Repo mode resolves installation aliases against the checkout, not this user's home.
    home = Path('/vstack-check-home') if args.repo else args.home.resolve()
    problems = check(root, home, repo=bool(args.repo))
    for problem in problems:
        print(f'check-hook-paths: {problem}', file=sys.stderr)
    if not problems:
        print('check-hook-paths: PASS')
    return int(bool(problems))


if __name__ == '__main__':
    sys.exit(main())
