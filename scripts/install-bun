#!/usr/bin/env bash
# install-bun: give the server user bun in their own home, no sudo (VSTA-229).
# pstack's watch-pr runs on bun, and a chat cannot install it on this shared host.
# One pinned release, checked against that release's SHASUMS256.txt. A download that
# fails prints one warning and exits 0, so ./install still finishes.
set -uo pipefail

BUN_VERSION=1.4.5
BIN="$HOME/.bun/bin/bun"
LINK="$HOME/.local/bin/bun"
RELEASE="https://github.com/oven-sh/bun/releases/download/bun-v$BUN_VERSION"

stop() {
  printf 'vstack install: %s\n' "$1" >&2
  exit 0
}

place_link() {
  mkdir -p "${LINK%/*}"
  if [ -e "$LINK" ] && [ ! -L "$LINK" ]; then
    stop "bun $BUN_VERSION is at $BIN, and $LINK is a real file, so I left it alone"
  fi
  ln -sfn "$BIN" "$LINK"
}

if [ -x "$BIN" ] && [ "$("$BIN" --version 2>/dev/null)" = "$BUN_VERSION" ]; then
  place_link
  exit 0
fi

case $(uname -m) in
  x86_64 | amd64) asset=bun-linux-x64.zip ;;
  aarch64 | arm64) asset=bun-linux-aarch64.zip ;;
  *) stop "no bun $BUN_VERSION build for $(uname -m), so pstack watch-pr will not run" ;;
esac

work=$(mktemp -d) || stop "no temp dir, so bun $BUN_VERSION is not installed and pstack watch-pr will not run"
trap 'rm -rf "$work"' EXIT

fetch() {
  curl -fsSL --retry 2 --connect-timeout 20 --max-time 300 -o "$2" "$1"
}

if ! fetch "$RELEASE/$asset" "$work/$asset" || ! fetch "$RELEASE/SHASUMS256.txt" "$work/sums"; then
  stop "could not download bun $BUN_VERSION, so pstack watch-pr will not run; run ./install again when the network is back"
fi

want=$(awk -v name="$asset" '$2 == name { print $1 }' "$work/sums")
if [ -z "$want" ]; then
  stop "$RELEASE/SHASUMS256.txt lists no checksum for $asset, so bun $BUN_VERSION was not installed"
fi
if ! printf '%s  %s\n' "$want" "$work/$asset" | sha256sum --check --status -; then
  stop "the bun $BUN_VERSION download does not match its published checksum, so nothing was installed"
fi

unzip -q -o "$work/$asset" -d "$work" || stop "could not unpack bun $BUN_VERSION, so it was not installed"
mkdir -p "${BIN%/*}"
install -m 0755 "$work/${asset%.zip}/bun" "$BIN" || stop "could not write $BIN"

place_link
printf 'vstack install: bun %s at %s, linked from %s\n' "$BUN_VERSION" "$BIN" "$LINK"
