#!/usr/bin/env python3
"""pr-overlap: fail a newer open PR that collides with an older one on a guarded file or ticket.

  pr-overlap --repo OWNER/REPO --pr N
  pr-overlap --self-test

Reads every other open PR in the repo through the GitHub REST API (GITHUB_TOKEN or GH_TOKEN).
The older PR always wins. Bot PRs (dependabot, renovate, github-actions) are ignored.
"""
import argparse
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import sys
import urllib.error
import urllib.request

ROOT = Path(__file__).resolve().parents[1]
GUARDED_DEFAULT = ROOT / 'config/pr-overlap-guarded.txt'


def load(name, path):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


_prq = load('pr_overlap_queue', ROOT / 'skills/pr-housekeeping/pr-queue')
ticket_key = _prq.ticket_key
is_bot = _prq.is_bot


def read_guarded(path):
    lines = []
    for line in Path(path).read_text().splitlines():
        line = line.split('#', 1)[0].strip()
        if line:
            lines.append(line)
    return lines


def guarded_hits(paths, guarded):
    g = set(guarded)
    return [p for p in paths if p in g]


def pr_key(row):
    return ticket_key(row.get('title'), (row.get('head') or {}).get('ref'))


def parse_created(value):
    return value or ''


def findings(this, all_prs, guarded, key_fn, bot_fn):
    """Return collision findings where this PR is newer than the blocking PR."""
    this_no = this['number']
    this_created = parse_created(this.get('created_at'))
    this_files = set(this.get('files') or ())
    this_ticket = key_fn(this.get('title'), (this.get('head') or {}).get('ref'))
    if bot_fn((this.get('user') or {}).get('login')):
        return []

    out = []
    for other in all_prs:
        if other['number'] == this_no:
            continue
        if bot_fn((other.get('user') or {}).get('login')):
            continue
        other_created = parse_created(other.get('created_at'))
        if other_created >= this_created:
            continue
        other_files = set(other.get('files') or ())
        overlap = guarded_hits(this_files & other_files, guarded)
        for path in sorted(overlap):
            out.append({
                'kind': 'SAME-FILE',
                'other_pr': other['number'],
                'path_or_key': path,
            })
        other_ticket = key_fn(other.get('title'), (other.get('head') or {}).get('ref'))
        if this_ticket and other_ticket and this_ticket == other_ticket:
            out.append({
                'kind': 'SAME-TICKET',
                'other_pr': other['number'],
                'path_or_key': this_ticket,
            })
    return out


def format_finding(this, finding):
    """One-line message for stderr."""
    key = pr_key(this) or 'this PR'
    other = finding['other_pr']
    if finding['kind'] == 'SAME-FILE':
        path = finding['path_or_key']
        return (f'{key} blocked: PR #{other} (older) also edits {path}. '
                f'Next: land or close #{other} first, or fold this change into it; '
                f'then push to rerun this check.')
    ticket = finding['path_or_key']
    return (f'{key} blocked: PR #{other} (older) also carries ticket {ticket}. '
            f'Next: land or close #{other} first, or fold this change into it; '
            f'then push to rerun this check.')


def api_request(url, token):
    req = urllib.request.Request(
        url,
        headers={
            'Accept': 'application/vnd.github+json',
            'Authorization': f'Bearer {token}',
            'X-GitHub-Api-Version': '2022-11-28',
        },
    )
    with urllib.request.urlopen(req, timeout=60) as resp:
        return json.loads(resp.read().decode())


def list_open_pulls(owner, repo, token):
    pulls = []
    page = 1
    while True:
        url = (f'https://api.github.com/repos/{owner}/{repo}/pulls'
               f'?state=open&per_page=100&page={page}')
        batch = api_request(url, token)
        if not batch:
            break
        pulls.extend(batch)
        if len(batch) < 100:
            break
        page += 1
    return pulls


def pull_files(owner, repo, number, token):
    files = []
    page = 1
    while True:
        url = (f'https://api.github.com/repos/{owner}/{repo}/pulls/{number}/files'
               f'?per_page=100&page={page}')
        batch = api_request(url, token)
        if not batch:
            break
        files.extend(item['filename'] for item in batch)
        if len(batch) < 100:
            break
        page += 1
    return files


def normalize_pull(raw, files):
    return {
        'number': raw['number'],
        'created_at': raw.get('created_at'),
        'title': raw.get('title'),
        'head': {'ref': (raw.get('head') or {}).get('ref')},
        'user': {'login': (raw.get('user') or {}).get('login')},
        'draft': raw.get('draft', False),
        'files': files,
    }


def load_live(repo, pr_number, token, guarded_path):
    owner, name = repo.split('/', 1)
    guarded = read_guarded(guarded_path)
    raw_pulls = list_open_pulls(owner, name, token)
    rows = []
    file_cache = {}
    for raw in raw_pulls:
        num = raw['number']
        if num not in file_cache:
            file_cache[num] = pull_files(owner, name, num, token)
        rows.append(normalize_pull(raw, file_cache[num]))
    this = next((r for r in rows if r['number'] == pr_number), None)
    if this is None:
        raise SystemExit(f'pr-overlap: open PR #{pr_number} not found in {repo}')
    return this, rows, guarded


def self_test():
    guarded = ['skills/valentin-mode/SKILL.md']

    def pr(number, created_at, title=None, branch=None, author='valentinyeo', files=(), draft=False):
        title = title or f'VSTA-{number} work'
        branch = branch or f'vsta-{number}-work'
        return {
            'number': number,
            'created_at': created_at,
            'title': title,
            'head': {'ref': branch},
            'user': {'login': author},
            'draft': draft,
            'files': list(files),
        }

    older = pr(10, '2026-01-01T00:00:00Z', files=['skills/valentin-mode/SKILL.md'])
    newer = pr(20, '2026-01-02T00:00:00Z', files=['skills/valentin-mode/SKILL.md'])
    found = findings(newer, [older, newer], guarded, ticket_key, is_bot)
    assert len(found) == 1 and found[0]['kind'] == 'SAME-FILE', found
    assert findings(older, [older, newer], guarded, ticket_key, is_bot) == []
    assert findings(newer, [pr(10, '2026-01-01T00:00:00Z', files=['README.md']), newer],
                    guarded, ticket_key, is_bot) == []
    dup_new = pr(20, '2026-01-02T00:00:00Z', title='VSTA-61 b', branch='vsta-61-b')
    dup_old = pr(10, '2026-01-01T00:00:00Z', title='VSTA-61 a', branch='vsta-61-a')
    ticket_found = findings(dup_new, [dup_old, dup_new], guarded, ticket_key, is_bot)
    assert any(f['kind'] == 'SAME-TICKET' for f in ticket_found), ticket_found
    bot = pr(10, '2026-01-01T00:00:00Z', author='dependabot[bot]', files=['skills/valentin-mode/SKILL.md'])
    assert findings(newer, [bot, newer], guarded, ticket_key, is_bot) == []
    draft = pr(10, '2026-01-01T00:00:00Z', draft=True, files=['skills/valentin-mode/SKILL.md'])
    assert findings(newer, [draft, newer], guarded, ticket_key, is_bot)
    msg = format_finding(newer, found[0])
    assert '#10' in msg and 'skills/valentin-mode/SKILL.md' in msg, msg
    print('pr-overlap self-test ok')


def main():
    parser = argparse.ArgumentParser(description='block a newer PR that overlaps an older open one')
    parser.add_argument('--repo', help='owner/name')
    parser.add_argument('--pr', type=int, help='PR number to check')
    parser.add_argument('--guarded-file', default=str(GUARDED_DEFAULT))
    parser.add_argument('--self-test', action='store_true')
    args = parser.parse_args()
    if args.self_test:
        self_test()
        return 0
    repo = args.repo or os.environ.get('GITHUB_REPOSITORY')
    pr_number = args.pr
    if pr_number is None:
        env = os.environ.get('PR_NUMBER')
        if env:
            pr_number = int(env)
    if not repo or pr_number is None:
        parser.error('--repo and --pr are required unless --self-test')
    token = os.environ.get('GITHUB_TOKEN') or os.environ.get('GH_TOKEN')
    if not token:
        print('pr-overlap: set GITHUB_TOKEN or GH_TOKEN', file=sys.stderr)
        return 2
    try:
        this, rows, guarded = load_live(repo, pr_number, token, args.guarded_file)
    except urllib.error.HTTPError as err:
        print(f'pr-overlap: GitHub API {err.code}: {err.reason}', file=sys.stderr)
        return 2
    found = findings(this, rows, guarded, ticket_key, is_bot)
    if not found:
        return 0
    for item in found:
        print(format_finding(this, item), file=sys.stderr)
    return 1


if __name__ == '__main__':
    sys.exit(main())