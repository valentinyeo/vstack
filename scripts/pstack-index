#!/usr/bin/env python3
"""Generate the pstack inventory from the newest installed release."""
import argparse
import re
from pathlib import Path

CACHE = Path.home() / '.claude/plugins/cache/cursor-plugins/pstack'
OUTPUT = Path(__file__).resolve().parents[1] / 'pstack-index.md'
IGNORE = {'node_modules', '.git', '__pycache__'}


def newest(cache=CACHE):
    versions = [p for p in cache.glob('*') if p.is_dir() and re.fullmatch(r'\d+(?:\.\d+)+', p.name)]
    return max(versions, key=lambda p: tuple(map(int, p.name.split('.')))) if versions else None


def description(path):
    text = path.read_text(errors='replace')
    # Frontmatter descriptions can span folded YAML lines.
    m = re.search(r'^description:\s*(.+(?:\n[ \t]+.+)*)', text, re.M)
    if m:
        return ' '.join(m[1].strip().strip('"\'').split())
    m = re.search(r'^#{1,6}\s+(.+)', text, re.M)
    if m:
        heading = m[1].strip()
        rest = text[m.end():].strip()
        paragraph = re.split(r'\n\s*\n', rest, maxsplit=1)[0]
        return heading + ': ' + ' '.join(paragraph.split()) if paragraph and not paragraph.startswith('#') else heading
    m = re.search(r'\.description\(\s*[\"\']([^\"\']+)', text)
    if m:
        return m[1].split(r'\n')[0]
    # Script docstrings and leading comments, skipping shebangs/imports.
    for line in text.splitlines():
        line = line.strip()
        if line.startswith('#!'):
            continue
        if line.startswith(('"""', "'''", '//', '# ', '/*', '* ')):
            line = re.sub(r'^(?:["\']{3}|//|#|/\*|\*)\s*', '', line).strip('"\' ')
            if line:
                return line
    # A thin executable wrapper takes its purpose from the CLI it imports.
    if not path.suffix and (path.parent / 'cli.ts').is_file():
        return description(path.parent / 'cli.ts')
    # Executable wrappers often have no heading; use their owner's description.
    for parent in path.parents:
        if (parent / 'SKILL.md') != path and (parent / 'SKILL.md').is_file():
            return description(parent / 'SKILL.md')
    return path.stem


def render(root):
    rows = []
    for path in sorted(root.rglob('*')):
        rel = path.relative_to(root)
        if not path.is_file() or IGNORE.intersection(rel.parts):
            continue
        kind = None
        if path.name == 'SKILL.md':
            kind = 'principle' if path.parent.name.startswith('principle-') else 'skill'
        elif 'playbooks' in rel.parts and path.suffix == '.md':
            kind = 'playbook'
        elif 'scripts' in rel.parts and (path.suffix in {'.py', '.sh', '.ts', '.js', '.mjs'} or not path.suffix):
            kind = 'script'
        if kind:
            name = path.parent.name if path.name == 'SKILL.md' else path.stem
            purpose = description(path).replace('|', '\\|')
            rows.append(f'| {kind} | {name} | {rel.as_posix()} | {purpose} |')
    return (f'# pstack index\n\nGenerated by `scripts/pstack-index` from pstack {root.name}.\n'
            'Paths relative to the installed release.\n\n'
            '| Kind | Name | Path | Purpose |\n| --- | --- | --- | --- |\n' + '\n'.join(rows) + '\n')


def refresh(cache=CACHE, output=OUTPUT):
    root = newest(cache)
    if root is None:
        return output.read_text() if output.is_file() else ''
    text = render(root)
    if not output.is_file() or output.read_text() != text:
        output.write_text(text)
    return text


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--cache', type=Path, default=CACHE)
    parser.add_argument('--output', type=Path, default=OUTPUT)
    args = parser.parse_args()
    if newest(args.cache) is None:
        parser.error(f'no pstack release installed in {args.cache}')
    refresh(args.cache, args.output)


if __name__ == '__main__':
    main()
