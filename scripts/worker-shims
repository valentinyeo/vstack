#!/usr/bin/env python3
"""worker-shims: stand the heavy-local-guard in front of every pacer worker's PATH.

Prior art: pstack checked. `poteto-mode` runs a worker through plan-pick, and plan-pick
prepends its own `worker-shims` folder to PATH (`bin/plan-pick: worker_env`). OpenCode and
Antigravity workers never run Claude Code hooks, so on 2026-11-24 pacer workers ran Gradle
and the Windows desktop build on this shared VPS and drove vps-state to HOLD (VSTA-165).
Each shim here is generated from config/heavy-local.json, the same file the hook reads,
so a blocked runner and its shim cannot drift apart.

  scripts/worker-shims                      write the shims to ~/.local/state/vstack/worker-shims
  scripts/worker-shims --dir DIR            write them where a harness looks
  scripts/worker-shims --dir DIR --path P   look for the real binaries on P
  scripts/worker-shims --dir DIR --hook F   point the shims at an installed hook
  scripts/worker-shims --check --dir DIR    exit 1 when a shim is missing or stale

VSTA-204 adds one more shim from the same folder: `gh` runs hooks/pr-cap-guard.py first,
so a worker that never runs Claude hooks still cannot open a PR on a repo over its cap.
VSTA-249 guards `hypertask`, `vcc` and `poteto-ticket` with hooks/agent-lane-guard.py,
so workers cannot post results, verdicts or done summaries into `activity add`.
"""
import argparse
import json
import os
from pathlib import Path
import shutil
import sys

ROOT = Path(__file__).resolve().parents[1]
HOOK = ROOT / 'hooks/heavy-local-guard.py'
PR_CAP_HOOK = ROOT / 'hooks/pr-cap-guard.py'
AGENT_LANE_HOOK = ROOT / 'hooks/agent-lane-guard.py'
DATA = ROOT / 'config/heavy-local.json'
DEFAULT_DIR = Path.home() / '.local/state/vstack/worker-shims'

SHIM = '''#!/bin/sh
# Generated by vstack scripts/worker-shims from config/heavy-local.json; do not edit (VSTA-165).
h="{hook}"
if [ -f "$h" ]; then exec "{python}" "$h" --shim {name} {real} "$@"; fi
{fallback}
'''
MISSING = '''printf '%s\\n' '{name} is not installed on this host' >&2
exit 127'''
GUARD_SHIM = '''#!/bin/sh
# Generated by vstack scripts/worker-shims; do not edit.
h="{hook}"
if [ -f "$h" ]; then exec "{python}" "$h" --shim {command}{real} "$@"; fi
{fallback}
'''


def names():
    return json.loads(DATA.read_text())['shims']


def script(name, real, python, hook=HOOK):
    if real:
        fallback = f'exec {quote(str(real))} "$@"'
    else:
        fallback = MISSING.format(name=name)
    return SHIM.format(hook=hook, python=python, name=quote(name), real=quote(str(real or '')),
                       fallback=fallback)


def quote(word):
    return "'" + word.replace("'", "'\\''") + "'"


def shims_for(directory, search, python, hook=HOOK, pr_cap_hook=PR_CAP_HOOK,
              agent_lane_hook=AGENT_LANE_HOOK):
    """One shim per blocked name. A runner this host lacks still gets one, so a worker
    that types `gradle assembleDebug` reads the refusal and not a bare command-not-found."""
    directory = Path(directory).resolve()

    def foreign(part):
        # Never point a shim at another shim folder: two shims then exec each other forever.
        if not part:
            return True
        resolved = Path(part).resolve()
        return resolved == directory or resolved.name == 'worker-shims'

    path = os.pathsep.join(part for part in search.split(os.pathsep) if not foreign(part))
    found = {}
    for name in names():
        real = shutil.which(name, path=path)
        found[name] = script(name, Path(real).resolve() if real else None, python, hook)
    for command, guard_hook in (('gh', pr_cap_hook), ('hypertask', agent_lane_hook),
                                ('vcc', agent_lane_hook), ('poteto-ticket', agent_lane_hook)):
        real = shutil.which(command, path=path)
        fallback = (f'exec {quote(str(Path(real).resolve()))} "$@"' if real
                    else MISSING.format(name=command))
        found[command] = GUARD_SHIM.format(hook=guard_hook, python=python,
                                           command='' if command == 'gh' else quote(command) + ' ',
                                           real=quote(str(Path(real).resolve()) if real else ''),
                                           fallback=fallback)
    return found


def write(directory, shims):
    directory = Path(directory)
    directory.mkdir(parents=True, exist_ok=True)
    for name in [entry.name for entry in directory.iterdir() if entry.is_file()]:
        if name not in shims:
            (directory / name).unlink()
    for name, text in shims.items():
        target = directory / name
        target.write_text(text)
        target.chmod(0o755)


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument('--dir', default=str(DEFAULT_DIR), help='where the shims go')
    parser.add_argument('--path', default=os.environ.get('PATH', ''),
                        help='where the real binaries are (default: PATH)')
    parser.add_argument('--hook', default=str(HOOK),
                        help='the heavy-local guard the shims call (default: this checkout)')
    parser.add_argument('--pr-cap-hook', default=str(PR_CAP_HOOK),
                        help='the cap guard the gh shim calls (default: this checkout)')
    parser.add_argument('--agent-lane-hook', default=str(AGENT_LANE_HOOK),
                        help='the guard the hypertask, vcc and poteto-ticket shims call (default: this checkout)')
    parser.add_argument('--check', action='store_true',
                        help='report a missing or stale shim instead of writing one')
    args = parser.parse_args()
    python = sys.executable or '/usr/bin/python3'
    shims = shims_for(args.dir, args.path, python, Path(args.hook).resolve(),
                      Path(args.pr_cap_hook).resolve(), Path(args.agent_lane_hook).resolve())
    stale = [name for name, text in shims.items()
             if not (Path(args.dir) / name).is_file()
             or (Path(args.dir) / name).read_text() != text]
    if args.check:
        for name in sorted(stale):
            print(f'worker-shims: {Path(args.dir) / name} is missing or stale', file=sys.stderr)
        return 1 if stale else 0
    write(args.dir, shims)
    print(f'worker-shims: {len(shims)} shims in {args.dir}, {len(stale)} rewritten')
    return 0


if __name__ == '__main__':
    sys.exit(main())
