#!/usr/bin/env python3
"""up-to-date: refuse a PR built on a base that the target branch moved out from under.

  up-to-date --repo OWNER/REPO --pr N [--max-hours 24]

Two ways a PR goes stale, and both have landed broken merges:

- its base commit is more than a day behind the branch it targets, or
- the target branch changed a file this PR also changes, since their merge base.

Either one fails the check and names the fix: rebase onto the target branch and
rerun the tests. Reads the GitHub REST API with GITHUB_TOKEN or GH_TOKEN.
"""
import argparse
from datetime import datetime
import json
import os
import sys
import urllib.request

API = 'https://api.github.com'
MAX_HOURS = 24


def api_request(url, token):
    req = urllib.request.Request(
        url,
        headers={
            'Accept': 'application/vnd.github+json',
            'Authorization': f'Bearer {token}',
            'X-GitHub-Api-Version': '2022-11-28',
        },
    )
    with urllib.request.urlopen(req, timeout=60) as resp:
        return json.loads(resp.read().decode())


def when(value):
    """One commit's committer date, or None when GitHub sent nothing usable."""
    try:
        return datetime.fromisoformat(str(value).replace('Z', '+00:00'))
    except (TypeError, ValueError):
        return None


def commit_date(commit):
    return when(((commit or {}).get('commit') or {}).get('committer', {}).get('date'))


def changed_files(compare):
    """The files one compare answer lists, deduplicated and ordered."""
    return sorted({item['filename'] for item in compare.get('files') or ()
                   if item.get('filename')})


def target_of(pull):
    return (pull.get('base') or {}).get('ref') or 'main'


def findings(pull, ahead, behind, head_at=None, max_hours=MAX_HOURS):
    """Everything wrong with this PR's base, from its two compares.

    `ahead` is target...head, so it names the files this PR changes. `behind` is
    merge-base...target, so it names what landed underneath the PR.
    """
    merge_base_at = commit_date((ahead.get('merge_base_commit') or {}))
    head_at = head_at or merge_base_at
    out = []
    if merge_base_at and head_at:
        hours = (head_at - merge_base_at).total_seconds() / 3600
        if hours > max_hours:
            out.append({'kind': 'stale-base', 'hours': hours})
    overlap = sorted(set(changed_files(ahead)) & set(changed_files(behind)))
    if overlap:
        out.append({'kind': 'main-moved', 'paths': overlap})
    return out


def line(pull, finding, target, max_hours=MAX_HOURS):
    """One finding, and the one thing its owner must do about it."""
    number = pull.get('number')
    if finding['kind'] == 'stale-base':
        return (f'up-to-date: PR #{number} blocked: its base is {finding["hours"]:.0f}h behind '
                f'{target} ({max_hours}h allowed). '
                f'Next: rebase onto origin/{target} and rerun the tests.')
    return (f'up-to-date: PR #{number} blocked: {target} changed {", ".join(finding["paths"])} '
            f'since this PR\'s merge-base, so nothing here was tested against it. '
            f'Next: rebase onto origin/{target} and rerun the tests.')


def load_live(repo, pr_number, token):
    """The PR, what it changes, what landed since, and the target's head date."""
    owner, name = repo.split('/', 1)
    base = f'{API}/repos/{owner}/{name}'
    pull = api_request(f'{base}/pulls/{pr_number}', token)
    if pull.get('state') != 'open' or pull.get('merged'):
        raise SystemExit(f'up-to-date: PR #{pr_number} is not open in {repo}')
    target, head = target_of(pull), (pull.get('head') or {}).get('sha')
    if not head:
        raise SystemExit(f'up-to-date: PR #{pr_number} names no head commit')
    ahead = api_request(f'{base}/compare/{target}...{head}', token)
    merge_base = (ahead.get('merge_base_commit') or {}).get('sha')
    if not merge_base:
        return pull, ahead, {}, None
    behind = api_request(f'{base}/compare/{merge_base}...{target}', token)
    head_at = commit_date(api_request(f'{base}/commits/{target}', token))
    return pull, ahead, behind, head_at


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument('--repo', help='OWNER/REPO')
    parser.add_argument('--pr', type=int, help='Pull request number')
    parser.add_argument('--max-hours', type=int, default=MAX_HOURS,
                        help=f'Hours a base may trail its target branch; default {MAX_HOURS}')
    parser.add_argument('--self-test', action='store_true',
                        help='Check the refusal logic on the #223 fixture, without the network')
    args = parser.parse_args(argv)
    if args.self_test:
        return self_test()
    if not args.repo or '/' not in args.repo or not args.pr:
        parser.error('--repo OWNER/REPO and --pr N are required')
    token = os.environ.get('GITHUB_TOKEN') or os.environ.get('GH_TOKEN')
    if not token:
        raise SystemExit('up-to-date: set GITHUB_TOKEN or GH_TOKEN')
    pull, ahead, behind, head_at = load_live(args.repo, args.pr, token)
    target = target_of(pull)
    found = findings(pull, ahead, behind, head_at, args.max_hours)
    for finding in found:
        print(line(pull, finding, target, args.max_hours), file=sys.stderr)
    if found:
        return 1
    print(f'up-to-date: PR #{args.pr} is built on current {target}')
    return 0


def self_test():
    """The #223 shape: a 66-hour-old base, and #251 rewriting a file it changed."""
    pull = {'number': 223, 'base': {'ref': 'main'}}
    ahead = {'merge_base_commit': {'commit': {'committer': {'date': '2026-11-20T17:51:02Z'}}},
             'files': [{'filename': 'skills/hypertask-work/reconcile'}]}
    behind = {'files': [{'filename': 'skills/hypertask-work/reconcile'}]}
    head_at = when('2026-11-23T11:51:02Z')
    found = findings(pull, ahead, behind, head_at)
    print('\n'.join(line(pull, finding, 'main') for finding in found) or 'up-to-date: no findings')
    return 0 if [f['kind'] for f in found] == ['stale-base', 'main-moved'] else 1


if __name__ == '__main__':
    sys.exit(main())
