#!/usr/bin/env python3
"""pick-verifier-model: print an opencode-go verifier model whose family differs from every declared author.

  pick-verifier-model [--event PATH]   print the first allowed verifier model
  pick-verifier-model --all [--event PATH]   print every allowed verifier model, one per line, in the same order
  pick-verifier-model --self-test

The PR body declares each author on its own line: `Author model: <provider or family>/<model>`.
A declaration counts only as a whole line, exactly `Author model: <one token without spaces>`, outside fenced
code blocks (``` or ~~~). Transcripts, quotes, bullets and lines with trailing text are not declarations.
The family comes from known model-name tokens anywhere on that line (`opencode-go/deepseek-v4.1-flash` is DeepSeek,
`z.ai/glm-5` is GLM). A string naming two families counts as both. An unknown family exits 1.
Order of verifiers: deepseek-v4.1-flash, glm-5.3-flash, kimi-k3. First one whose family no author uses wins;
--all prints that whole run instead of only the first. No declaration, or every verifier family used by an
author: exit 1 with a message. Never a silent default.
"""
import argparse
import json
import os
import re
import sys
import tempfile
import unicodedata

VERIFIERS = (("deepseek", "deepseek-v4.1-flash"), ("glm", "glm-5.3-flash"), ("kimi", "kimi-k3"))
# Family -> names that identify it anywhere in the declared string. Matched on the string with every
# non-alphanumeric character removed, so `z.ai`, `Z-AI`, `deep_seek` and `DeepSeek` all match.
FAMILY_NAMES = {
    "deepseek": ("deepseek",),
    "glm": ("glm", "zai", "zhipu", "bigmodel"),
    "kimi": ("kimi", "moonshot"),
    "anthropic": ("claude", "anthropic"),
    "openai": ("gpt", "openai", "codex"),
    "google": ("gemini", "gemma", "google"),
    "xai": ("grok", "xai"),
    "qwen": ("qwen", "alibaba"),
    "mimo": ("mimo", "xiaomi"),
    "minimax": ("minimax",),
    "cursor": ("composer", "cursor"),
}
O_SERIES = re.compile(r"^o\d+$")  # o1, o3, o4 (o3-mini splits into o3 + mini)
DECLARATION = re.compile(r"^Author model: (\S+)$")
FENCE_OPEN = re.compile(r"^ {0,3}(`{3,}|~{3,})")


def family_of(declared):
    """Every known family named anywhere in the declared string. Empty set: family unknown."""
    text = unicodedata.normalize("NFKC", declared).lower()
    compact = re.sub(r"[^a-z0-9]", "", text)
    found = {family for family, names in FAMILY_NAMES.items() if any(name in compact for name in names)}
    if any(O_SERIES.match(token) for token in re.split(r"[^a-z0-9]+", text)):
        found.add("openai")
    return found


def declarations(body):
    """Tokens of the whole-line `Author model: <token>` declarations that sit outside fenced code blocks."""
    found = []
    fence = None  # the opening fence string while inside a fenced block
    for line in (body or "").replace("\r\n", "\n").replace("\r", "\n").split("\n"):
        if fence:
            closing = line.strip()
            if closing and set(closing) == {fence[0]} and len(closing) >= len(fence):
                fence = None
            continue
        opening = FENCE_OPEN.match(line)
        if opening:
            fence = opening.group(1)
            continue
        match = DECLARATION.match(line)
        if match:
            found.append(match.group(1))
    return found


def families(body):
    found = set()
    for declared in declarations(body):
        known = family_of(declared)
        if not known:
            raise SystemExit(
                "pick-verifier-model: unknown model family in `Author model: %s`. Name a known model "
                "(%s), then push again." % (declared.strip("`*"), ", ".join(sorted(FAMILY_NAMES)))
            )
        found |= known
    return found


def allowed(body):
    """Every verifier model whose family no author declares, in the fixed order."""
    authors = families(body)
    if not authors:
        raise SystemExit(
            "pick-verifier-model: the PR body has no `Author model: <family>/<model>` line. "
            "Add one line per author, for example `Author model: anthropic/claude-sonnet`, then push again."
        )
    models = [model for family, model in VERIFIERS if family not in authors]
    if not models:
        raise SystemExit(
            "pick-verifier-model: authors cover every verifier family (%s). Ask for a verifier from another family."
            % ", ".join(sorted(authors))
        )
    return models


def pick(body):
    return allowed(body)[0]


def body_from_event(path):
    if not path:
        raise SystemExit("pick-verifier-model: no event payload. Set GITHUB_EVENT_PATH or pass --event.")
    with open(path) as handle:
        event = json.load(handle)
    return (event.get("pull_request") or {}).get("body") or ""


def self_test():
    cases = [
        ("Author model: anthropic/claude-sonnet", "deepseek-v4.1-flash"),
        ("Author model: openai/gpt-6.1-sol\nAuthor model: anthropic/claude-sonnet", "deepseek-v4.1-flash"),
        ("Author model: deepseek/deepseek-v4.1-flash", "glm-5.3-flash"),
        ("Author model: DeepSeek/deepseek-v4.1-flash", "glm-5.3-flash"),
        ("Author model: deepseek/x\r\n", "glm-5.3-flash"),
        ("```\nAuthor model: deepseek/x\n```\nAuthor model: anthropic/claude-sonnet", "deepseek-v4.1-flash"),
        ("Author model: deepseek-ai/DeepSeek-V3", "glm-5.3-flash"),
        ("Author model: opencode-go/deepseek-v4.1-flash", "glm-5.3-flash"),
        ("Author model: deepseek-v4.1-flash", "glm-5.3-flash"),
        ("Author model: z.ai/glm-5.3-flash", "deepseek-v4.1-flash"),
        ("Author model: moonshotai/kimi-k2", "deepseek-v4.1-flash"),
        ("Author model: deepseek/deepseek-v4.1-flash\nAuthor model: glm/glm-5.3-flash", "kimi-k3"),
        ("Author model: zhipu/glm-5.3-flash\nAuthor model: deepseek/x", "kimi-k3"),
        ("Author model: anthropic/claude-sonnet\nAuthor model: deepseek/x", "glm-5.3-flash"),
        ("Author model: opencode-go/glm-5.3-flash\nAuthor model: opencode-go/deepseek-v4.1-flash", "kimi-k3"),
        ("Author model: cursor/composer-2.5", "deepseek-v4.1-flash"),
        ("Author model: cursor/composer-2.5\nAuthor model: deepseek/x", "glm-5.3-flash"),
    ]
    for body, want in cases:
        got = pick(body)
        assert got == want, (body, got, want)
    for body, want in (("Author model: anthropic/claude-sonnet", ["deepseek-v4.1-flash", "glm-5.3-flash", "kimi-k3"]),
                       ("Author model: deepseek/x", ["glm-5.3-flash", "kimi-k3"]),
                       ("Author model: moonshotai/kimi-k2", ["deepseek-v4.1-flash", "glm-5.3-flash"]),
                       ("Author model: deepseek/x\nAuthor model: z.ai/glm-5.3-flash", ["kimi-k3"])):
        got = allowed(body)
        assert got == want, (body, got, want)
    for body in (None, "", "no line here"):
        try:
            allowed(body)
        except SystemExit as stop:
            assert "Author model" in str(stop), body
        else:
            raise AssertionError("expected refusal: %r" % body)
    for body in ("Author model: deepseek/a\nAuthor model: glm/b\nAuthor model: kimi/c",):
        try:
            allowed(body)
        except SystemExit as stop:
            assert "every verifier family" in str(stop), body
        else:
            raise AssertionError("expected refusal when all families authored: %r" % body)
    for body in (None, "", "no line here", "text Author model: deepseek/x", "Author model: deepseek/x trailing", "```\nAuthor model: deepseek/x\n```"):
        try:
            pick(body)
        except SystemExit as stop:
            assert "Author model" in str(stop), body
        else:
            raise AssertionError("expected refusal: %r" % body)
    for body in ("Author model: acme/mystery-1", "Author model: me", "Author model: anthropic/claude\nAuthor model: acme/x"):
        try:
            pick(body)
        except SystemExit as stop:
            assert "unknown model family" in str(stop), body
        else:
            raise AssertionError("expected refusal for unknown family: %r" % body)
    try:
        pick("Author model: deepseek/a\nAuthor model: glm/b\nAuthor model: kimi/c")
    except SystemExit as stop:
        assert "every verifier family" in str(stop)
    else:
        raise AssertionError("expected refusal when all families authored")
    with tempfile.NamedTemporaryFile("w", suffix=".json") as handle:
        json.dump({"pull_request": {"body": "Author model: anthropic/x"}}, handle)
        handle.flush()
        assert pick(body_from_event(handle.name)) == "deepseek-v4.1-flash"
    print("pick-verifier-model self-test ok")


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("--event", default=os.environ.get("GITHUB_EVENT_PATH"))
    parser.add_argument("--all", action="store_true", help="print every allowed verifier model")
    parser.add_argument("--self-test", action="store_true")
    args = parser.parse_args()
    if args.self_test:
        return self_test()
    body = body_from_event(args.event)
    print("\n".join(allowed(body) if args.all else [pick(body)]))


if __name__ == "__main__":
    main()
