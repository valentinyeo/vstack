#!/usr/bin/env bash
# Drive skills/repo-tidy/repo-tidy on a throwaway git world and grade what
# survived. Usage: run [--root DIR] [--keep-sandbox]
# Builds a bare origin, a clone, worktrees in every state, and a fake gh, then
# runs a dry run, an apply run, and grades the result.
set -euo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO=$(cd "$HERE/../../.." && pwd)
TIDY="$REPO/skills/repo-tidy/repo-tidy"
SANDBOX="$HERE/sandbox.py"

ROOT=""
KEEP=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --root) [ "$#" -ge 2 ] || { echo "run: --root needs a directory" >&2; exit 2; }; ROOT=$2; shift 2 ;;
    --keep-sandbox) KEEP=1; shift ;;
    *) echo "run: unknown argument: $1" >&2; exit 2 ;;
  esac
done

RUN_ID=$(date -u +%Y%m%dT%H%M%SZ)
E="$HOME/.local/state/verify-repo-tidy/$RUN_ID"
if [ -e "$E" ]; then
  echo "run: evidence directory already exists: $E" >&2
  exit 2
fi
mkdir -p "$E"

if [ -z "$ROOT" ]; then
  ROOT=$(mktemp -d "${TMPDIR:-/tmp}/verify-repo-tidy.XXXXXX")
fi
mkdir -p "$ROOT"

python3 - "$E/meta.json" "$ROOT" "$TIDY" <<'PY'
import json
import subprocess
import sys

path, root, tidy = sys.argv[1:4]
sha = subprocess.run(["git", "-C", str(__import__("pathlib").Path(tidy).parents[2]),
                      "rev-parse", "HEAD"], capture_output=True, text=True)
open(path, "w").write(json.dumps({
    "skill": "repo-tidy",
    "sandbox": root,
    "script": tidy,
    "git_sha": sha.stdout.strip() or "unknown",
}, indent=2) + "\n")
PY

# Doctor: is this sandbox worth driving?
DOCTOR="$E/doctor.txt"
: > "$DOCTOR"
doctor_exit=0
pass() { printf 'PASS %s\n' "$1" >> "$DOCTOR"; }
fail() { printf 'FAIL %s\n' "$1" >> "$DOCTOR"; doctor_exit=3; }

if [ -f "$TIDY" ] && [ -x "$TIDY" ]; then
  pass "script: $TIDY is executable"
else
  fail "script: $TIDY is missing or not executable"
fi
for tool in python3 git; do
  if command -v "$tool" >/dev/null 2>&1; then
    pass "tool: $tool is on PATH"
  else
    fail "tool: $tool is missing"
  fi
done
if [ -f "$SANDBOX" ]; then
  pass "sandbox: $SANDBOX is present"
else
  fail "sandbox: $SANDBOX is missing"
fi
if git rev-parse --git-dir >/dev/null 2>&1; then
  pass "sandbox: this directory can host a temp repo"
else
  fail "sandbox: git cannot work here"
fi

if [ "$doctor_exit" -ne 0 ]; then
  cat "$DOCTOR" >&2
  echo "run: doctor failed; evidence $E" >&2
  exit 3
fi

# 1. Build the world. It prints the expectations the grader reads back.
python3 "$SANDBOX" build "$ROOT" > "$E/expect.json"

# A live process with its cwd inside one worktree: the in-use gate needs one.
( cd "$ROOT/home/projects/sandbox-in-use" && exec sleep 900 ) &
IN_USE_PID=$!
cleanup() {
  kill "$IN_USE_PID" 2>/dev/null || true
  if [ "$KEEP" -eq 0 ]; then rm -rf "$ROOT"; fi
}
trap cleanup EXIT

drive_env() {
  env HOME="$ROOT/home" \
      GIT_CONFIG_GLOBAL="$ROOT/home/.gitconfig" \
      GIT_CONFIG_NOSYSTEM=1 \
      GIT_TERMINAL_PROMPT=0 \
      PATH="$ROOT/bin:$PATH" \
      GH_FIXTURE="$ROOT/fixture.json" \
      GH_CALL_LOG="$ROOT/gh-calls.log" \
      "$@"
}

# 2. Dry run: the plan, and a snapshot proving it changed nothing.
set +e
drive_env "$TIDY" --all > "$E/dry.out" 2> "$E/dry.err"
dry_exit=$?
set -e
python3 "$SANDBOX" snapshot "$ROOT" > "$E/before.json"

# 3. Apply on the same world.
set +e
drive_env "$TIDY" --all --apply --json > "$E/apply.json" 2> "$E/apply.err"
apply_exit=$?
set -e
printf 'dry_exit %s\napply_exit %s\n' "$dry_exit" "$apply_exit" > "$E/exit.txt"

# 4. Grade what survived.
set +e
python3 "$SANDBOX" grade "$ROOT" "$E"
grade_exit=$?
set -e
echo "Evidence: $E"
exit "$grade_exit"
