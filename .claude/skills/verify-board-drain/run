#!/usr/bin/env bash
# Start one fresh headless Claude Code chat that has just been restarted, and
# grade whether it turns its own board drain loop back on. Usage:
#   run [--break no-board-drain] [--keep]
set -euo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
ROOT=$(cd "$HERE/../../.." && pwd)
GRADE="$HERE/grade.py"
BOARD=2060
LABEL=vvm-test
NAME="VBD Test Chat"
SLUG=vbd-test-chat
TOKEN_FILE="$HOME/.config/hypertask-agents/credentials/sessions/vvm-test-agent-agent-token"

BREAK=""
KEEP=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --break)
      if [ "$#" -lt 2 ]; then
        echo "run: --break needs a value" >&2
        exit 2
      fi
      if [ "$2" != "no-board-drain" ]; then
        echo "run: unknown --break value: $2" >&2
        exit 2
      fi
      BREAK=$2
      shift 2
      ;;
    --keep)
      KEEP=1
      shift
      ;;
    *)
      echo "run: unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

# 1. Claude must be under pace before a Sonnet test chat starts.
if ! gate_output=$("$HOME/.local/bin/plan-pick" --claude-helper 2>&1); then
  printf '%s\n' "$gate_output"
  echo "Claude is ahead of pace; try later" >&2
  exit 3
fi

# 2. Test login token. Never echo it.
if [ ! -s "$TOKEN_FILE" ]; then
  echo "run: test login token missing at $TOKEN_FILE" >&2
  echo "run: do the one-time setup in $HERE/SKILL.md" >&2
  exit 3
fi
TOKEN=$(cat "$TOKEN_FILE")

# 3. Evidence directory.
RUN_ID=$(date -u +%Y%m%dT%H%M%SZ)
E="$HOME/.local/state/verify-board-drain/$RUN_ID${BREAK:+-$BREAK}"
mkdir -p "$E"
date -u +%Y-%m-%dT%H:%M:%SZ > "$E/started_at"

# 4. Scratch git repo the test chat works in. It carries the board-drain and
# hypertask-work skills so the paths in the loop prompt resolve in the project.
W=$(mktemp -d /tmp/vbd-scratch.XXXXXX)
# shellcheck disable=SC2317  # runs from the EXIT trap
cleanup() {
  if [ "$KEEP" -eq 0 ] && [ -n "${W:-}" ] && [ -d "$W" ]; then
    rm -rf "$W"
  fi
}
trap cleanup EXIT

git -C "$W" init -q
mkdir -p "$W/skills"
cp -a "$ROOT/skills/board-drain" "$ROOT/skills/hypertask-work" "$W/skills/"
{
  printf '# Scratch project for the board drain check\n\n'
  printf 'Hypertask board: %s, label: %s\n\n' "$BOARD" "$LABEL"
  printf 'You are the chat "%s". Its login token is already set up.\n' "$NAME"
  printf 'Your board drain loop lives in this project under skills/board-drain/.\n'
} > "$W/CLAUDE.md"
git -C "$W" add CLAUDE.md skills
git -C "$W" -c user.name=vbd -c user.email=vbd@invalid commit -qm init
printf '%s\n' "$W" > "$E/workdir"

# 5. Seed the restart case: an expired loop from a chat session that is gone.
mkdir -p "$W/state"
python3 - "$W/state/$SLUG.json" "$NAME" <<'PY'
import json
import os
import socket
import sys
from datetime import datetime, timedelta, timezone

target, name = sys.argv[1], sys.argv[2]
dead = None
for pid in range(4194303, 4193000, -1):
    if not os.path.exists('/proc/%d' % pid):
        dead = pid
        break
if dead is None:
    raise SystemExit('run: no dead pid to seed the restart case with')


def iso(moment):
    return moment.strftime('%Y-%m-%dT%H:%M:%SZ')


now = datetime.now(timezone.utc)
state = {'name': name, 'every': '15m',
         'armed_at': iso(now - timedelta(days=8)),
         'expires_at': iso(now - timedelta(hours=2)),
         'job': 'dead0000', 'owner_pid': dead, 'host': socket.gethostname()}
with open(target, 'w') as handle:
    handle.write(json.dumps(state, indent=2) + '\n')
PY
cp "$W/state/$SLUG.json" "$E/state-before.json"

# 5b. The seed must read as a dead loop, so the chat has something to re-arm.
set +e
seed_output=$(BOARD_DRAIN_STATE_DIR="$W/state" python3 "$ROOT/skills/board-drain/loop-state" \
  status --name "$NAME" 2>&1)
seed_exit=$?
set -e
printf '%s\n' "$seed_output" > "$E/status-before.txt"
printf '%s\n' "$seed_exit" > "$E/status-before-exit"
if [ "$seed_exit" -ne 2 ]; then
  echo "run: the seeded loop does not read as not armed (exit $seed_exit): $seed_output" >&2
  exit 3
fi

# 6. Prompt and flags. The prompt never names a script; board-drain has to.
JOB=$(cat <<'EOF'
You are VBD Test Chat and just restarted after a crash. Make sure your board work keeps going. Do not start code workers or change tickets in this test; arming, syncing and checking is enough.
EOF
)
CLAUDE_ARGS=(--model sonnet --permission-mode bypassPermissions
             --output-format stream-json --verbose --max-turns 30)
if [ -n "$BREAK" ]; then
  # Board drain is gone for the broken run: no command in the prompt, and no
  # skills, so the chat cannot load the skill and re-arm its loop. Dropping the
  # command alone cannot fail: the installed description says "use after a
  # restart", so a restarted chat loads board drain by itself. Hooks stay on.
  printf '%s\n' "$JOB" > "$E/prompt.txt"
  CLAUDE_ARGS+=(--disable-slash-commands)
else
  printf '/board-drain %s\n' "$JOB" > "$E/prompt.txt"
fi
PROMPT=$(cat "$E/prompt.txt")

# 7. One fresh headless chat in the scratch repo.
echo "run: one test chat, 5 to 15 minutes; evidence $E" >&2
set +e
(cd "$W" && BOARD_DRAIN_STATE_DIR="$W/state" HT_TOKEN="$TOKEN" \
  SHIP_SESSION_NAME="$NAME" timeout 900 "$HOME/.local/bin/claude" \
  -p "$PROMPT" "${CLAUDE_ARGS[@]}" \
  > "$E/stream.jsonl" 2> "$E/stderr.txt")
CLAUDE_EXIT=$?
set -e
printf '%s\n' "$CLAUDE_EXIT" > "$E/claude_exit"

# 8. Collect the evidence: the state file the chat left behind is the proof.
if [ -f "$W/state/$SLUG.json" ]; then
  cp "$W/state/$SLUG.json" "$E/state.json"
fi

# 9. Scrub tokens from anything a person may read.
python3 - "$E/stream.jsonl" "$E/stderr.txt" <<'PY'
import re
import sys

patterns = (
    re.compile(r'eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+'),
    re.compile(r'sk-[A-Za-z0-9_-]{16,}'),
)
for path in sys.argv[1:]:
    text = open(path, errors='replace').read()
    for pattern in patterns:
        text = pattern.sub('REDACTED', text)
    with open(path, 'w') as handle:
        handle.write(text)
PY

# 10. Grade and report.
set +e
"$GRADE" "$E" --board "$BOARD"
GRADE_EXIT=$?
set -e
echo "Evidence: $E"

# 11. Cleanup runs from the EXIT trap; never deletes the evidence.
exit "$GRADE_EXIT"
