#!/usr/bin/env python3
"""verify-vps-tidy: drive skills/vps-tidy/vps-tidy on a real sandbox and grade it.

    .claude/skills/verify-vps-tidy/run                 # this checkout's copy
    .claude/skills/verify-vps-tidy/run --script PATH   # a branch's copy

The proof is never the tool's own claim:

1. It builds a sandbox (its own tmp, home, caches, evidence, process table and
   PATH shims) with stale items, fresh twins of every stale item, protected
   items, a gh-shared-cache and a worktree, and real sleeping child processes.
2. It runs vps-tidy --apply against that sandbox only.
3. It grades the filesystem and the processes itself: PASS only when exactly the
   stale items and the orphan processes are gone and every fresh, foreign,
   protected and shared item survives.
4. It runs one dry run against the real host and saves the report. That run
   deletes and kills nothing.

Exit 0 PASS, 1 FAIL, 3 doctor failure. Evidence:
~/.local/state/verify-vps-tidy/<run-id>/
"""

import json
import os
import pathlib
import shutil
import subprocess
import sys
import time
import uuid

ROOT = pathlib.Path(__file__).resolve().parents[3]
DEFAULT_SCRIPT = ROOT / "skills" / "vps-tidy" / "vps-tidy"
EVIDENCE_ROOT = pathlib.Path.home() / ".local" / "state" / "verify-vps-tidy"
DAY = 86400
MB = 1024 * 1024
UID = os.getuid()
RUN_TIMEOUT = 240
HOST_PARTS = (("tmp", 200, 300), ("evidence", 60, 120), ("caches", 60, 120),
              ("docker", 60, 120), ("processes", 30, 60), ("tmux", 30, 120))


def run_id():
    return time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())


def run_cmd(cmd, cwd=None, timeout=60, env=None):
    started = time.monotonic()
    try:
        done = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True,
                              timeout=timeout, env=env)
        return done, round(time.monotonic() - started, 3)
    except (OSError, subprocess.SubprocessError) as error:
        return None, round(time.monotonic() - started, 3)


def git_sha(path):
    done, _ = run_cmd(["git", "rev-parse", "--short", "HEAD"], cwd=str(path), timeout=5)
    return done.stdout.strip() if done and done.returncode == 0 else None


def backdate(path, seconds):
    when = time.time() - seconds
    os.utime(str(path), (when, when), follow_symlinks=False)


def tree(root, seconds_old, files=("deep/file",)):
    """A tree whose entries are all older than the rule, top directory included."""
    for name in files:
        path = root / name
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text("x")
    for dirpath, dirnames, filenames in os.walk(root):
        for name in filenames:
            backdate(pathlib.Path(dirpath) / name, seconds_old)
        for name in dirnames:
            backdate(pathlib.Path(dirpath) / name, seconds_old)
    backdate(root, seconds_old)
    return root


class Sandbox:
    """Everything the tool is allowed to act on, and nothing else."""

    def __init__(self, base):
        self.base = base
        self.root = base / "sandbox"
        self.tmp = self.root / "tmp"
        self.home = self.root / "home"
        self.state = self.home / ".local" / "state"
        self.proc = self.root / "proc"
        self.bin = self.root / "bin"
        self.ps_file = self.root / "ps.txt"
        self.tool_log = self.root / "docker.log"
        self.statvfs = self.root / "statvfs.json"
        self.children = []
        self.rows = []
        for path in (self.tmp, self.home, self.state, self.proc, self.bin):
            path.mkdir(parents=True, exist_ok=True)
        self.remove = []
        self.keep = []
        self.gone_pids = []
        self.alive_pids = []
        self.expect = {"zombie": None, "docker": []}

    def make(self, relative, body="x", seconds_old=None):
        path = self.root / relative.lstrip("/")
        if body is None:
            path.mkdir(parents=True, exist_ok=True)
        else:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(body)
        if seconds_old is not None:
            backdate(path, seconds_old)
        return path

    def tool_shim(self, name):
        script = self.bin / name
        script.write_text(
            "#!/bin/sh\n"
            'printf "%s %s\\n" "' + name + '" "$*" >> "' + str(self.tool_log) + '"\n'
            'case "$1 $2" in\n'
            '  "volume ls") echo "ht-smoke-build-1"; echo "ht-smoke-state-2" ;;\n'
            '  "image ls") echo "sha256:bbbb 900MB" ;;\n'
            "  *) : ;;\n"
            "esac\n"
            "exit 0\n")
        script.chmod(0o755)

    def spawn(self, cwd, args=None):
        argv = args or [sys.executable, "-c", "import time; time.sleep(600)"]
        proc = subprocess.Popen(argv, cwd=str(cwd), start_new_session=True,
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.children.append(proc)
        return proc

    def add_process(self, pid, ppid, args, etimes, cwd, home=None, uid=None, stat="S"):
        self.rows.append({"pid": pid, "ppid": ppid, "uid": UID if uid is None else uid,
                          "rss": 2048, "cpu": 0.0, "etimes": etimes, "stat": stat,
                          "args": args})
        case = self.proc / str(pid)
        case.mkdir(parents=True, exist_ok=True)
        for link in ("cwd", "root"):
            target = case / link
            if target.is_symlink():
                target.unlink()
        os.symlink(str(cwd), case / "cwd")
        os.symlink("/", case / "root")
        (case / "environ").write_bytes("HOME={}\0".format(home or self.home).encode())
        init = self.proc / "1"
        init.mkdir(exist_ok=True)
        if not (init / "cwd").is_symlink():
            os.symlink("/", init / "cwd")
            os.symlink("/", init / "root")
        self.write_ps()

    def write_ps(self):
        lines = ["  PID  PPID   UID   RSS %CPU ELAPSED STAT COMMAND",
                 "    1     0     0  1024  0.0       1 Ss   /sbin/init"]
        for row in self.rows:
            lines.append("{:>5} {:>5} {:>5} {:>5} {:>4} {:>7} {:<4} {}".format(
                row["pid"], row["ppid"], row["uid"], row["rss"], row["cpu"],
                row["etimes"], row["stat"], row["args"]))
        self.ps_file.write_text("\n".join(lines) + "\n")

    def env(self):
        env = dict(os.environ)
        env["HOME"] = str(self.home)
        env["PATH"] = str(self.bin) + os.pathsep + env.get("PATH", "")
        env.pop("VPS_TIDY_ROOT", None)
        env.pop("VPS_TIDY_BOARD_CMD", None)
        env.pop("VPS_TIDY_PROC", None)
        return env

    def build(self):
        """Stale and fresh twin items for every part, plus protected ones."""
        # tmp: stale, fresh, excluded by name, scratch session, template stage.
        stale_tmp = tree(self.tmp / "verify-stale", 5 * DAY)
        self.remove.append(stale_tmp)
        fresh_tmp = self.make("tmp/verify-fresh/deep/file")
        self.keep.append(fresh_tmp.parent.parent)
        self.make("tmp/tmux-verify/deep/file", seconds_old=5 * DAY)
        self.keep.append(self.tmp / "tmux-verify")
        self.make("tmp/.X11-unix/X9", seconds_old=5 * DAY)
        self.keep.append(self.tmp / ".X11-unix")
        git_tree = self.make("tmp/verify-git/.git/config", seconds_old=5 * DAY).parent.parent
        backdate(git_tree, 5 * DAY)
        self.keep.append(git_tree)
        session = tree(self.tmp / "claude-{}".format(UID) / "verify-project" / str(uuid.uuid4()),
                       2 * DAY)
        self.remove.append(session)
        skipped = tree(self.tmp / "claude-{}".format(UID) / "verify-hypertask" / str(uuid.uuid4()),
                       2 * DAY)
        self.keep.append(skipped)
        stage = tree(self.tmp / "agent-template-stage.verify", 2 * DAY)
        self.remove.append(stage)
        scratch = tree(self.tmp / "igshverify", 2 * DAY)
        self.remove.append(scratch)

        # a symlink out of the sandbox and the cache it points at
        shared = self.make("home/.local/state/gh-shared-cache/verify/pack",
                           seconds_old=40 * DAY).parent.parent
        self.keep.append(shared)
        link = self.tmp / "verify-escape"
        os.symlink(str(shared), link)
        backdate(link, 40 * DAY)
        self.keep.append(link)

        # evidence: the 30 day folder, the 2 day builds, the state tmp dir.
        evidence_old = tree(self.state / "vcc-evidence" / "VERIFY-OLD" / "run", 40 * DAY,
                            files=("out.txt",))
        self.remove.append(self.state / "vcc-evidence" / "VERIFY-OLD")
        evidence_new = self.make("home/.local/state/vcc-evidence/VERIFY-NEW/run/out.txt")
        self.keep.append(evidence_new.parent.parent)
        build = tree(self.state / "vcc-evidence" / "VERIFY-NEW" / "run" / "app" / ".next",
                     3 * DAY, files=("build/index.js",))
        self.remove.append(build)
        fresh_build = tree(self.state / "vcc-evidence" / "VERIFY-NEW" / "run2" / "app" / ".next",
                           0, files=("live/index.js",))
        self.keep.append(fresh_build)
        state_tmp = tree(self.state / "hax" / "tmp", 3 * DAY)
        self.remove.append(state_tmp)
        video = self.make("home/.local/state/vcc-evidence/VERIFY-NEW/run-keep/demo.mp4",
                          seconds_old=20 * DAY)
        self.keep.append(video)  # no board reader here: the video must stay

        # caches: npx, tool caches, playwright, a repo target, a ceo run file.
        npx_old = tree(self.home / ".npm" / "_npx" / "stale", 8 * DAY,
                       files=("node_modules/x/index.js",))
        self.remove.append(npx_old)
        npx_new = tree(self.home / ".npm" / "_npx" / "fresh", 0,
                       files=("node_modules/x/index.js",))
        self.keep.append(npx_new)
        cache_old = tree(self.home / ".cache" / "go-build", 3 * DAY, files=("aa/bb",))
        self.remove.append(cache_old)
        cache_new = tree(self.home / ".cache" / "zig", 0, files=("aa/bb",))
        self.keep.append(cache_new)
        old_browser = tree(self.home / ".cache" / "ms-playwright" / "chromium-1000", 9 * DAY,
                           files=("chrome",))
        self.remove.append(old_browser)
        current = tree(self.home / ".cache" / "ms-playwright" / "chromium-1200", 9 * DAY,
                       files=("chrome",))
        self.keep.append(current)
        repo = self.home / "projects" / "verify-repo"
        tagged = tree(repo / "target", 3 * DAY, files=("debug/x",))
        (tagged / "CACHEDIR.TAG").write_text("Signature: 8a477f597d28d172789f06886806bc55\n")
        backdate(tagged / "CACHEDIR.TAG", 3 * DAY)
        self.remove.append(tagged)
        untagged = tree(self.home / "projects" / "verify-other" / "target", 3 * DAY,
                        files=("debug/x",))
        self.keep.append(untagged)
        big = self.make("home/projects/ceo/runs/big.log", "x" * (6 * MB), seconds_old=3 * DAY)
        self.remove.append(big)
        small = self.make("home/projects/ceo/runs/small.json", "{}", seconds_old=3 * DAY)
        self.keep.append(small)

        # a worktree with files: repo-tidy owns it, vps-tidy must not touch it.
        worktree = self.make("home/projects/worktrees/wt-verify/app/package.json",
                             "{}", seconds_old=40 * DAY).parent
        backdate(worktree.parent, 40 * DAY)
        self.keep.append(worktree)

        # docker: the fake daemon answers, the disk is over the 80% gate.
        self.write_ps()
        self.statvfs.write_text(json.dumps({"total": 100 * 1024 ** 3,
                                            "free": 10 * 1024 ** 3}))
        for name in ("npm", "uv", "pnpm", "docker"):
            self.tool_shim(name)

        # processes: real sleeping children, a process table that says ppid 1.
        orphan_worktree = self.make("home/projects/worktrees/wt-orphan/app/package.json",
                                    "{}").parent
        guarded_worktree = self.make("home/projects/worktrees/wt-guarded/app/package.json",
                                     "{}").parent
        orphan = self.spawn(cwd=orphan_worktree)
        self.add_process(orphan.pid, 1, "node /x/.bin/next dev", 3 * 3600, orphan_worktree)
        self.gone_pids.append(("dev-server", orphan))
        guarded = self.spawn(cwd=guarded_worktree)
        self.add_process(guarded.pid, 1, "node /x/.bin/next dev", 3 * 3600, guarded_worktree)
        chat = self.spawn(cwd=guarded_worktree)
        self.add_process(chat.pid, 1, "claude -p verify", 60, guarded_worktree)
        self.alive_pids.append(("dev-server with a live claude", guarded))
        self.alive_pids.append(("live claude", chat))
        young = self.spawn(cwd=orphan_worktree)
        self.add_process(young.pid, 1, "next dev", 600, orphan_worktree)
        self.alive_pids.append(("young dev-server", young))
        browser = self.spawn(cwd=orphan_worktree)
        self.add_process(browser.pid, 1, "chrome --headless --dump-dom", 9 * 3600,
                         orphan_worktree)
        self.gone_pids.append(("headless browser", browser))
        agent_state = self.make("home/.local/state/hypertask-verify/marker", "x").parent
        protected = self.spawn(cwd=agent_state)
        self.add_process(protected.pid, 1, "codex exec verify", 99 * 3600, agent_state)
        self.alive_pids.append(("codex, never killed", protected))
        foreign = self.spawn(cwd=orphan_worktree)
        self.add_process(foreign.pid, 1, "chrome --headless", 9 * 3600, orphan_worktree,
                         uid=UID + 1)
        self.alive_pids.append(("another user's chrome", foreign))
        provider = self.spawn(cwd=agent_state)
        self.add_process(provider.pid, 1, "hax run", 3600, agent_state)
        self.gone_pids.append(("orphan provider", provider))
        self.add_process(999999, 1, "node stuck", 5 * 3600, orphan_worktree, stat="Z")
        self.expect["zombie"] = 999999
        return self

    def command(self, script, *args):
        return [sys.executable, str(script), "--root", str(self.root),
                "--proc-root", str(self.proc), "--ps-file", str(self.ps_file),
                "--statvfs-json", str(self.statvfs)] + list(args)

    def cleanup(self):
        for proc in self.children:
            try:
                proc.kill()
                proc.wait(timeout=5)
            except (OSError, subprocess.SubprocessError):
                pass


def docker_calls(sandbox):
    if not sandbox.tool_log.exists():
        return []
    return [line.strip() for line in sandbox.tool_log.read_text().splitlines() if line.strip()]


def fmt(count):
    if count >= 1024 ** 3:
        return "{:.1f}G".format(count / 1024 ** 3)
    if count >= 1024 ** 2:
        return "{:.1f}M".format(count / 1024 ** 2)
    return "{}B".format(int(count))


def host_dry_run(script, directory):
    """One dry run per part against the real host, merged. Nothing is deleted."""
    parts = {}
    started = time.monotonic()
    for part, budget, timeout in HOST_PARTS:
        done, seconds = run_cmd(
            [sys.executable, str(script), "--only", part, "--json",
             "--budget", str(budget)], timeout=timeout)
        text = done.stdout if done else ""
        (directory / "host-{}.json".format(part)).write_text(text)
        try:
            payload = json.loads(text) if text else {}
        except ValueError:
            payload = {}
        summary = payload.get("summary") or {}
        parts[part] = {"exit": done.returncode if done else None,
                       "seconds": seconds, "items": len(payload.get("items") or []),
                       "removable": sum(1 for item in payload.get("items") or []
                                        if item.get("action") in ("remove", "kill", "prune")),
                       "would_free_bytes": summary.get("would_free_bytes"),
                       "budget_reached": summary.get("time_budget_reached"),
                       "disk": {key: (payload.get("disk") or {}).get(key)
                                for key in ("used_percent", "free_gb", "freed_bytes")}}
    merged = {"mode": "dry-run", "seconds": round(time.monotonic() - started, 1),
              "parts": parts,
              "exit": 0 if all(part["exit"] == 0 for part in parts.values()) else 1,
              "removable": sum(part["removable"] for part in parts.values()),
              "would_free_bytes": sum((part["would_free_bytes"] or 0)
                                      for part in parts.values()),
              "disk": next(iter(parts.values()))["disk"] if parts else {}}
    (directory / "host-dry-run.json").write_text(json.dumps(merged, indent=2) + "\n")
    (directory / "host-dry-run.txt").write_text(
        "vps-tidy dry run against this host, one run per part\n"
        + "\n".join("{:<10} exit {} {:>6.1f}s {:>7} items {:>6} removable {:>8}{}".format(
            part, data["exit"], data["seconds"], data["items"], data["removable"],
            fmt(data["would_free_bytes"] or 0),
            "  budget reached" if data["budget_reached"] else "")
            for part, data in parts.items())
        + "\n\ndisk: {}% used, {}G free\ntotal removable: {} items, {} would free\n".format(
            merged["disk"].get("used_percent"), merged["disk"].get("free_gb"),
            merged["removable"], fmt(merged["would_free_bytes"])))
    return merged


def grade(checks):
    """PASS only when every check passed; an empty result is a FAIL."""
    if not checks:
        return "FAIL"
    return "PASS" if all(checks.values()) else "FAIL"


def grade_sandbox(sandbox, payload, docker):
    """Decide every check from the filesystem and the processes, not the report."""
    checks = {}
    missing = [str(path) for path in sandbox.remove if path.exists()]
    checks["stale_gone"] = not missing
    kept = [str(path) for path in sandbox.keep if not path.exists()]
    checks["fresh_alive"] = not kept
    dead = [label for label, proc in sandbox.gone_pids if proc.poll() is None]
    checks["orphan_gone"] = not dead
    alive = [label for label, proc in sandbox.alive_pids if proc.poll() is not None]
    checks["protected_alive"] = not alive
    zombie = sandbox.expect["zombie"]
    reports = [item for item in payload.get("items", [])
               if item.get("pid") == zombie and item.get("kind") == "zombie"]
    checks["zombie_reported"] = bool(reports) and all(
        item.get("action") == "report" for item in reports)
    calls = docker
    checks["docker_prune"] = (any(call.startswith("docker image prune -f") for call in calls)
                              and any(call.startswith("docker builder prune -f") for call in calls)
                              and "until=72h" in " ".join(calls)
                              and not any("docker volume prune" in call for call in calls)
                              and sum(1 for call in calls
                                      if call.startswith("docker volume rm")) == 2)
    expected = {str(path) for path in sandbox.remove}
    prefix = str(sandbox.root) + os.sep
    removed_items = [item.get("path") for item in payload.get("items", [])
                     if item.get("result") == "removed" and item.get("path")
                     and item["path"].startswith(prefix)]
    surprise = [path for path in removed_items if path not in expected]
    checks["nothing_else_removed"] = not surprise
    checks["removed_count"] = len(removed_items) == len(sandbox.remove)
    return checks, {"missing_stale": missing, "missing_fresh": kept,
                    "alive_that_died": dead, "dead_that_lived": alive,
                    "surprise_removals": surprise}


def doctor(script, directory):
    lines = []
    ok = True

    def check(name, good, detail):
        nonlocal ok
        ok = ok and good
        lines.append("{} {}: {}".format("PASS" if good else "FAIL", name, detail))

    check("script", script.is_file() and os.access(script, os.X_OK),
          str(script) + (" is executable" if os.access(script, os.X_OK)
                         else " is missing or not executable"))
    check("python3", shutil.which("python3") is not None, "python3 on PATH")
    check("ps", shutil.which("ps") is not None, "ps on PATH")
    check("disk", os.statvfs(str(directory)).f_blocks > 0, "statvfs works")
    check("writable", os.access(str(directory), os.W_OK), str(directory) + " is writable")
    (directory / "doctor.txt").write_text("\n".join(lines) + "\n")
    return ok, lines


def main(argv=None):
    args = list(sys.argv[1:] if argv is None else argv)
    script = DEFAULT_SCRIPT
    if "--script" in args:
        index = args.index("--script")
        if index + 1 >= len(args):
            print("usage: run [--script PATH]")
            return 3
        script = pathlib.Path(args[index + 1]).resolve()
    directory = EVIDENCE_ROOT / run_id()
    directory.mkdir(parents=True, exist_ok=True)

    ok, doctor_lines = doctor(script, directory)
    print("\n".join(doctor_lines))
    if not ok:
        print("verdict: FAIL (doctor)")
        return 3

    (directory / "meta.json").write_text(json.dumps({
        "run_id": directory.name,
        "script": str(script),
        "script_sha": git_sha(script.parent),
        "repo_sha": git_sha(ROOT),
        "host": os.uname().nodename,
        "started": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    }, indent=2) + "\n")

    sandbox = Sandbox(directory).build()
    (directory / "sandbox.json").write_text(json.dumps({
        "root": str(sandbox.root),
        "remove": [str(path) for path in sandbox.remove],
        "keep": [str(path) for path in sandbox.keep],
        "gone_pids": [pid for _, proc in sandbox.gone_pids for pid in [proc.pid]],
        "alive_pids": [pid for _, proc in sandbox.alive_pids for pid in [proc.pid]],
        "zombie_pid": sandbox.expect["zombie"],
    }, indent=2) + "\n")

    try:
        done, elapsed = run_cmd(sandbox.command(script, "--apply", "--json"),
                                timeout=RUN_TIMEOUT, env=sandbox.env())
        (directory / "json.out").write_text(done.stdout if done else "")
        (directory / "json.err").write_text(done.stderr if done else "")
        payload = {}
        try:
            payload = json.loads(done.stdout) if done and done.stdout else {}
        except ValueError:
            payload = {}
        (directory / "items.json").write_text(json.dumps(payload.get("items", []),
                                                         indent=2) + "\n")
        human, _ = run_cmd(sandbox.command(script, "--only", "tmp,evidence,caches,docker"),
                           timeout=RUN_TIMEOUT, env=sandbox.env())
        (directory / "human.out").write_text(human.stdout if human else "")

        for _, proc in sandbox.gone_pids + sandbox.alive_pids:
            try:
                proc.wait(timeout=5)
            except subprocess.SubprocessError:
                pass

        checks, detail = grade_sandbox(sandbox, payload, docker_calls(sandbox))
        checks["exit_code"] = done is not None and done.returncode == 0
        checks["json"] = bool(payload)
        checks["within_time_budget"] = elapsed < RUN_TIMEOUT
        verdict = grade(checks)
        lines = ["{} {}  {}".format("PASS" if value else "FAIL", key, "")
                 for key, value in checks.items()]
        (directory / "verdict.txt").write_text(
            "verdict: {}\n".format(verdict) + "\n".join(lines) + "\n"
            + json.dumps(detail, indent=2) + "\n")
        (directory / "verdict.json").write_text(json.dumps({
            "verdict": verdict, "run_id": directory.name, "checks": checks,
            "detail": detail, "seconds": elapsed,
        }, indent=2) + "\n")
    finally:
        sandbox.cleanup()

    host = host_dry_run(script, directory)

    print("\n".join(lines))
    print("host dry run: exit {}, {:.1f}s, {} removable, {} would free".format(
        host["exit"], host["seconds"], host["removable"],
        fmt(host["would_free_bytes"])))
    print("verdict: {}".format(verdict))
    print("evidence: {}".format(directory))
    return 0 if verdict == "PASS" else 1


if __name__ == "__main__":
    sys.exit(main())
