#!/usr/bin/env bash
# Start one fresh headless Claude Code chat with /hypertask in an empty scratch
# repo, then grade whether it set itself up on board 2060 and worked a tiny task.
# Usage: run [--keep]
set -euo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
GRADE="$HERE/grade.py"
TICKET=SOFT-2849
AGENT="VVM Test Agent"
BOARD=2060
LABEL=vvm-test

KEEP=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --keep) KEEP=1; shift ;;
    *) echo "run: unknown argument: $1" >&2; exit 2 ;;
  esac
done

# 1. Claude must be under pace before a Sonnet test chat starts.
if ! gate_output=$("$HOME/.local/bin/plan-pick" --claude-helper 2>&1); then
  printf '%s\n' "$gate_output"
  echo "Claude is ahead of pace; try later" >&2
  exit 3
fi

# 2. Test login token. Never echo it.
TOKEN_FILE="$HOME/.config/hypertask-agents/credentials/sessions/vvm-test-agent-agent-token"
if [ ! -s "$TOKEN_FILE" ]; then
  echo "run: test login token missing at $TOKEN_FILE" >&2
  echo "run: do the one-time setup in $HERE/SKILL.md" >&2
  exit 3
fi
TOKEN=$(cat "$TOKEN_FILE")

# 3. Evidence directory.
RUN_ID=$(date -u +%Y%m%dT%H%M%SZ)
E="$HOME/.local/state/verify-hypertask/$RUN_ID"
mkdir -p "$E"
date -u +%Y-%m-%dT%H:%M:%SZ > "$E/started_at"

# 4. Empty scratch git repo: no project notes, so the chat writes them itself.
W=$(mktemp -d /tmp/vh-scratch.XXXXXX)
# shellcheck disable=SC2317  # runs from the EXIT trap
cleanup() {
  if [ "$KEEP" -eq 0 ] && [ -n "${W:-}" ] && [ -d "$W" ]; then
    rm -rf "$W"
  fi
}
trap cleanup EXIT
git -C "$W" init -q
git -C "$W" -c user.name=vh -c user.email=vh@invalid commit -q --allow-empty -m init
printf '%s\n' "$W" > "$E/workdir"

# 5. Prompt. It starts with the skill and never names a tool.
printf '/hypertask Get me set up to work on Hypertask board %s, then do one tiny task.\n' "$BOARD" > "$E/prompt.txt"
cat >> "$E/prompt.txt" <<EOF
Your own board login and name are already prepared: the name is in SHIP_SESSION_NAME.
Write this project's board line into its notes, make or find your own view and label,
file one ticket in that label for the tiny job, do it, then sync the board.
The tiny job: write hello.txt in this folder with exactly the line "hello from hypertask".
Work without asking me anything.
EOF
PROMPT=$(cat "$E/prompt.txt")

# 5b. The installed skill as the chat sees it.
INSTALLED="$HOME/.local/share/vstack/skills/hypertask/SKILL.md"
: > "$E/installed-hypertask.md"
if [ -f "$INSTALLED" ]; then
  cp "$INSTALLED" "$E/installed-hypertask.md"
fi

# 6. One fresh headless chat in the scratch repo.
CLAUDE_ARGS=(--model sonnet --permission-mode bypassPermissions
             --output-format stream-json --verbose --max-turns 40)
echo "run: one test chat, 5 to 15 minutes; evidence $E" >&2
set +e
(cd "$W" && SHIP_SESSION_NAME="$AGENT" timeout 1500 "$HOME/.local/bin/claude" \
  -p "$PROMPT" "${CLAUDE_ARGS[@]}" \
  > "$E/stream.jsonl" 2> "$E/stderr.txt")
CLAUDE_EXIT=$?
set -e
printf '%s\n' "$CLAUDE_EXIT" > "$E/claude_exit"

# 7. Collect the evidence.
: > "$E/notes.md"
for name in CLAUDE.md AGENTS.md; do
  if [ -f "$W/$name" ]; then
    cp "$W/$name" "$E/notes.md"
    break
  fi
done
if [ -f "$W/hello.txt" ]; then
  cp "$W/hello.txt" "$E/hello.txt"
fi

export PATH="$HOME/.local/bin:$PATH"
hypertask --json --token "$TOKEN" task list --project "$BOARD" --label "$LABEL" --limit 100 \
  > "$E/tasks.json" 2>/dev/null || true
hypertask --json --token "$TOKEN" view list --project "$BOARD" > "$E/views.json" 2>/dev/null || true
hypertask --json --token "$TOKEN" task agent-log "$TICKET" > "$E/agent-log.json" 2>/dev/null || true
hypertask --json --token "$TOKEN" comment list "$TICKET" > "$E/comments.json" 2>/dev/null || true

# 8. Scrub tokens from anything a person may read.
python3 - "$E/stream.jsonl" "$E/stderr.txt" <<'PY'
import re
import sys

patterns = (
    re.compile(r'eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+'),
    re.compile(r'sk-[A-Za-z0-9_-]{16,}'),
)
for path in sys.argv[1:]:
    text = open(path, errors='replace').read()
    for pattern in patterns:
        text = pattern.sub('REDACTED', text)
    with open(path, 'w') as handle:
        handle.write(text)
PY

# 9. Grade and report.
set +e
"$GRADE" "$E"
GRADE_EXIT=$?
set -e
echo "Evidence: $E"
echo "New tickets in $LABEL:"
python3 - "$E/tasks.json" <<'PY'
import json
import sys

data = json.load(open(sys.argv[1]))
for task in data.get('tasks') or []:
    print(task.get('ticketNumber'), task.get('title'))
PY

exit "$GRADE_EXIT"
