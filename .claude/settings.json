{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/share/vstack/hooks/run-hook\" \"$HOME/.claude/hooks/skill-update.py\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/share/vstack/hooks/run-hook\" \"$HOME/.claude/hooks/board-drain-guard.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/share/vstack/hooks/run-hook\" \"$HOME/.claude/hooks/board-drain-guard.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/share/vstack/hooks/run-hook\" \"$HOME/.claude/hooks/heavy-local-guard.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$HOME/.local/share/vstack/hooks/run-hook\" \"$CLAUDE_PROJECT_DIR\"/hooks/ticket-way.py"
          },
          {
            "type": "command",
            "command": "\"$HOME/.local/share/vstack/hooks/run-hook\" \"$CLAUDE_PROJECT_DIR\"/hooks/pstack-new-gates.py"
          },
          {
            "type": "command",
            "command": "\"$HOME/.local/share/vstack/hooks/run-hook\" \"$HOME/.claude/hooks/pr-cap-guard.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "mcp__.*create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/share/vstack/hooks/run-hook\" \"$HOME/.claude/hooks/pr-cap-guard.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
