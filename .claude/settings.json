{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'f=\"$HOME/.claude/hooks/skill-update.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\"'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR\"/hooks/ticket-way.py"
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR\"/hooks/pstack-new-gates.py"
          }
        ]
      }
    ]
  }
}
