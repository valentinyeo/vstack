#!/usr/bin/env bash
# SessionStart hook: the shared server's capacity in one line, plus a hint.
# Prints nothing and exits 0 when the probe fails, so a session always starts.
# Budget: under 3 seconds. VPS_STATE_BIN overrides which vps-state runs.
# Nothing registers this hook for you: each chat adds it to its own project's
# .claude/settings.json, as skills/vps-state/SKILL.md says.

set +e
here=$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")")" 2>/dev/null && pwd)

if [ -n "${VPS_STATE_BIN:-}" ]; then
  bin=$VPS_STATE_BIN
else
  # Absolute paths only, never a PATH lookup: a Claude Code Bash shell's PATH
  # carries no ~/.local/bin, and a hook must not fail to find its own script.
  bin=""
  for candidate in "$HOME/.local/bin/vps-state" "$here/../skills/vps-state/vps-state"; do
    if [ -x "$candidate" ]; then bin=$candidate; break; fi
  done
fi
[ -n "$bin" ] && [ -x "$bin" ] || exit 0

line=$(timeout 2 "$bin" --brief 2>/dev/null | head -1)
[ -n "$line" ] || exit 0

printf 'Server: %s\nrun ~/.local/bin/vps-state before starting chats or workers\n' "$line"
exit 0
