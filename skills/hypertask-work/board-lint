def sibling(name, path):
    """A sibling script as a module, loaded once: a caller that read it first keeps one copy.

    drain-check calls this lint in the same process, so both must share `reconcile`:
    one board read, one GitHub count, and a test patches the module either caller holds.
    """
    path = str(path)
    module = sys.modules.get(name)
    if module is not None and getattr(module, '__file__', None) == path:
        return module
    loader = importlib.machinery.SourceFileLoader(name, path)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    sys.modules[loader.name] = module
    loader.exec_module(module)
    return module


