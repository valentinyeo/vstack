OPEN = frozenset({'Todo', 'Doing', 'Building', 'Checks', 'AI Review', 'Verifier', 'Verification Backlog'})
DONE = 'Done'
WORKING = frozenset({'Doing', 'Building', 'Checks', 'AI Review', 'Verifier'})
TODO = 'Todo'
FALLBACK_AGENT = frozenset({'valentins claude code cli', 'valentins claude code'})
