def loop_armed_chat_names(board_id):
    """Live chat names from armed loop files, including loops expiring within 24h."""
    names = set()
    for name in armed_chats(board_id):
        names.add(slug_agent(name))
    return names


def armed_chats(board_id):
    names = []
    try:
        paths = sorted(loop_state.state_dir().glob('*.json'))
    except OSError:
        return names
    for path in paths:
        try:
            state = json.loads(path.read_text())
        except (OSError, TypeError, ValueError):
            continue
        if not isinstance(state, dict):
            continue
        if str(state.get('board')) != str(board_id):
            continue
        name = (state.get('name') or '').strip()
        if not name:
            continue
        try:
            if loop_state.state_path(name) != path or loop_state.status(name)[0] not in (0, 3):
                continue
        except ERRORS:
            continue
        names.append(name)
    return names


def waiting_or_blocked(task):
    return bool(task.get('waitingOnUserId') or task.get('blockerCommentId'))


def mp_session_names():
    """Every chat the desktop app publishes. Closed chats keep their published name."""
    try:
        done = subprocess.run(['mp-sessions', '--json'], capture_output=True, text=True,
                              timeout=SESSION_TIMEOUT)
    except ERRORS:
        return set()
    if done.returncode:
        return set()
    try:
        rows = json.loads(done.stdout or '[]')
    except ValueError:
        return set()
    return {slug_agent(row.get('name')) for row in rows
            if isinstance(row, dict) and row.get('name')}


def published_names():
    """Names the app has stored for chats, closed ones included; mp-sessions reads the same store."""
    try:
        names = json.loads(session_login.chat_names_path(Path.home()).read_text())
    except (OSError, ValueError):
        return set()
    if not isinstance(names, dict):
        return set()
    return {slug_agent(entry.get('name')) for entry in names.values()
            if isinstance(entry, dict) and entry.get('name')}


def known_chats(args, data):
    """Chat names that ever existed: live now, published by the app, or on the roster.

    A closed chat is not an abandoned ticket, so a name in this set never counts as
    stale. Only a name that matches no chat at all does.
    """
    names = live_names(args)
    if args.fixture:
        if 'chats' in data:
            names |= {slug_agent(name) for name in data.get('chats') or ()
                      if isinstance(name, str) and name.strip()}
        return names
    return names | mp_session_names() | published_names()


def member_agents(board_id, data, args):
    """Agent identities still on the board. None when a fixture does not model them."""
    if args.fixture:
        rows = data.get('agents')
        if rows is None:
            return None
        return {str(row.get('id') if isinstance(row, dict) else row) for row in rows}
    rows = reconcile.api('project', 'members', str(board_id)).get('members') or []
    return {str(row['id']) for row in rows
            if isinstance(row, dict) and row.get('id') and not str(row['id']).isdigit()}


def live_worker(task, facts, data, args):
    """A live worker for a Doing card: reconcile's own fact, pinned in a fixture."""
    if args.fixture:
        workers = data.get('workers')
        return bool(workers.get(task['ticketNumber'])) if isinstance(workers, dict) else False
    return bool(facts.alive)


def read_views(board_id):
    """Every view on the board, keyed by slug, from `hypertask view list`."""
    rows = reconcile.api('view', 'list', '--project', str(board_id), '--limit', '100').get('views') or []
    views = {}
    for row in rows:
        if not isinstance(row, dict):
            continue
        slug = (row.get('slug') or session_login.slug(row.get('title') or '')).strip()
        if slug:
            views[slug] = row
    return views


def view_detail(view):
    """One view with its board_filters: `view list` omits them, `view get` carries them."""
    if 'board_filters' in view or not view.get('id'):
        return view
    return reconcile.api('view', 'get', str(view['id'])).get('view') or view


def fixture_views(data):
    return {view['slug']: view for view in data.get('views') or ()
            if isinstance(view, dict) and view.get('slug')}


def read_label_ids(board_id):
    """Label name to id, the way `board_filters` stores its label filter."""
    rows = reconcile.api('label', 'list', '--project', str(board_id)).get('labels') or []
    return {slug_agent(row.get('name')): str(row.get('id')) for row in rows
            if isinstance(row, dict) and row.get('id') and row.get('name')}


def fixture_label_ids(data):
    return {slug_agent(row.get('name')): str(row.get('id')) for row in data.get('labels') or ()
            if isinstance(row, dict) and row.get('id') and row.get('name')}


def view_label_ids(view):
    ids = set()
    filters = view.get('board_filters') if isinstance(view.get('board_filters'), dict) else {}
    for item in filters.get('addedFilters') or ():
        if not isinstance(item, dict) or not (item.get('type') or '').casefold().startswith('label'):
            continue
        for payload in item.get('searchPayload') or ():
            if isinstance(payload, dict) and payload.get('id'):
                ids.add(str(payload['id']))
    return ids


def board_chat_views(tasks, known, views):
    """One (label, view or None) per label on this board that names a chat."""
    labels = {}
    for task in tasks:
        for label in chat_labels(task):
            if slug_agent(label) in known:
                labels.setdefault(slug_agent(label), label)
    for key in sorted(labels):
        label = labels[key]
        yield label, views.get(session_login.slug(label))


def check_agent_assignee(task, facts, live, known, members, data, args, breaks):
    """A person, a revoked agent, a name no chat ever had, or Doing with no worker."""
    if task.get('section') not in OPEN:
        return
    if waiting_or_blocked(task):
        return
    rows = [row for row in task.get('assignees') or () if isinstance(row, dict)]
    agents = agent_assignees(task)
    for row in rows:
        if (row.get('type') or '').strip().lower() != 'agent':
            name = (row.get('displayName') or '').strip() or '(person)'
            breaks.append(Break(task['ticketNumber'], 'agent-assignee', name,
                                f'assignee {name!r} is a person, not an agent; assign the chat agent'))
            return
    for name in agents:
        if slug_agent(name) in FALLBACK_AGENT:
            continue
        agent_id = next((str(row.get('agentId') or '') for row in rows
                         if (row.get('displayName') or '').strip() == name), '')
        if members is not None and agent_id and agent_id not in members:
            breaks.append(Break(task['ticketNumber'], 'agent-assignee', name,
                                f'assignee {name!r} is revoked or no longer a board member; reassign a live agent'))
            return
        if slug_agent(name) not in known:
            breaks.append(Break(task['ticketNumber'], 'agent-assignee', name,
                                f'assignee {name!r} matches no Multibot chat ever; fix the name or reassign'))
            return
    if not agents and task.get('section') in WORKING:
        breaks.append(Break(task['ticketNumber'], 'agent-assignee', owner_chat(task),
                            'assign a live agent or move back to Todo'))
        return
    if task.get('section') == 'Doing' and not live_worker(task, facts, data, args):
        breaks.append(Break(task['ticketNumber'], 'agent-assignee', owner_chat(task),
                            'Doing with no live worker; start a worker or move back to Todo'))


def check_view_filter(board, label, view, label_ids, breaks):
    """A chat's view must exist and filter on the chat's own label."""
    if not view:
        breaks.append(Break('(view)', 'view-filter', label,
                            f'no view for label {label!r}; create it: hypertask view create --project '
                            f'{board.id} --title "{label}" --label "{label}" {CHAT_LOGIN}'))
        return
    wanted = label_ids.get(slug_agent(label))
    if not wanted:
        return
    filters = view_label_ids(view)
    if wanted in filters:
        return
    reason = 'view shows the whole board (no label filter)' if not filters else 'view filters on another label'
    breaks.append(Break('(view)', 'view-filter', label,
                        f'{reason}; fix with hypertask view update {view.get("id")} --label '
                        f'"{label}" {CHAT_LOGIN}'))


def check_view_owner(label, view, breaks):
    """A chat's view belongs to the chat's agent, never to a person."""
    if not view:
        return
    owner = ((view.get('owner') or {}).get('displayName') or '').strip()
    if not owner:
        return
    if session_login.is_person(owner) or slug_agent(owner) != slug_agent(label):
        breaks.append(Break('(view)', 'view-owner', label,
                            f'view {label!r} is owned by {owner!r}, not the chat agent; '
                            'recreate the view as the agent login'))


def chat_naming_labels(args, board_id):
    """Labels that name a chat: live roster names, or a loop label only when it equals the chat name."""
    names = set(live_names(args))
    try:
        paths = sorted(loop_state.state_dir().glob('*.json'))
    except OSError:
        return names
    for path in paths:
        try:
            state = json.loads(path.read_text())
        except (OSError, TypeError, ValueError):
            continue
        if not isinstance(state, dict) or str(state.get('board')) != str(board_id):
            continue
        chat = (state.get('name') or '').strip()
        label = (state.get('label') or '').strip()
        if not chat:
            continue
        try:
            if loop_state.state_path(chat) != path or loop_state.status(chat)[0] not in (0, 3):
                continue
        except ERRORS:
            continue
        names.add(slug_agent(chat))
        if label and slug_agent(label) == slug_agent(chat):
            names.add(slug_agent(label))
    return names


def check_true_column(task, facts, board, names, breaks):
    if task.get('section') not in board.managed:
        return
    column, reason = reconcile.target(facts, board, names)
    if column == task.get('section'):
        return
    breaks.append(Break(task['ticketNumber'], 'true-column', owner_chat(task),
                        f'move {task.get("section")} -> {column} ({reason}) or run reconcile dry'))


def check_done_proof(task, pulls, comments, board, breaks):
    if task.get('section') != DONE:
        return
    if done_comment_proof(comments.get(task['ticketNumber'])):
        return
    ticket_pulls = pulls.get(task['ticketNumber'], ())
    if reconcile.product_board(board) and merged_proof(ticket_pulls):
        return
    breaks.append(Break(task['ticketNumber'], 'done-proof', owner_chat(task),
                        'add live Done proof (Done comment with evidence); merged PR alone is not Done'))


def check_label_assignee(task, chat_names, breaks):
    if task.get('section') not in OPEN:
        return
    labels = chat_labels(task)
    agents = agent_assignees(task)
    if not labels or not agents:
        return
    for label in labels:
        if slug_agent(label) not in chat_names:
            continue
        for agent in agents:
            if slug_agent(agent) != slug_agent(label):
                breaks.append(Break(task['ticketNumber'], 'label-assignee', label,
                                    f'label {label!r} names chat {label!r} but assignee is {agent!r}; relabel or reassign'))
                return


def check_no_owner_label(task, breaks):
    if task.get('section') != TODO:
        return
    if chat_labels(task):
        return
    breaks.append(Break(task['ticketNumber'], 'no-owner-label', '(none)',
                        'add your chat label so your view shows this ticket'))


def check_unnamed_identity(task, breaks):
    for name in agent_assignees(task):
        if slug_agent(name) in FALLBACK_AGENT:
            breaks.append(Break(task['ticketNumber'], 'unnamed-identity', name,
                                'rename the chat session so ship-identity sets a real agent name'))


def check_stale(task, now, breaks):
    if task.get('section') not in OPEN:
        return
    # A card waiting on Valentin or BlockedBy stays put; its age is not idleness.
    if waiting_or_blocked(task):
        return
    limit = STALE_SEC.get(task.get('section'))
    if not limit:
        return
    moment = section_changed_at(task)
    if moment is None:
        return
    if now - moment > limit:
        days = int((now - moment) // 86400)
        breaks.append(Break(task['ticketNumber'], 'stale-idle', owner_chat(task),
                            f'idle {days}d in {task.get("section")} since section change; work or re-triage'))


def check_duplicates(tasks, breaks):
    buckets = defaultdict(list)
    for task in tasks:
        if task.get('section') not in OPEN:
            continue
        norm = normalize_title(task.get('title'))
        if norm:
            buckets[norm].append(task['ticketNumber'])
    for _norm, keys in buckets.items():
        if len(keys) < 2:
            continue
        keys = sorted(keys)
        for key in keys:
            others = ', '.join(k for k in keys if k != key)
            breaks.append(Break(key, 'duplicate-title', owner_chat(next(t for t in tasks if t['ticketNumber'] == key)),
                                f'suggestion: possible duplicate of {others}'))


def pull_row(pull):
    if isinstance(pull, dict):
        return pull
    return {'url': pull.url, 'state': pull.state, 'title': '', 'body': '', 'headRefName': ''}


def check_unlinked_prs(board, tasks, pulls, breaks):
    keys = {t['ticketNumber'] for t in tasks}
    seen = set()
    for rows in pulls.values():
        for pull in rows:
            row = pull_row(pull)
            url = row.get('url')
            if not url or url in seen:
                continue
            seen.add(url)
            state = (row.get('state') or '').upper()
            if state != 'OPEN':
                continue
            body = {'title': row.get('title'), 'body': row.get('body'),
                    'headRefName': row.get('headRefName')}
            if any(reconcile.names_ticket(body, ticket, board) for ticket in keys):
                continue
            breaks.append(Break('(board)', 'unlinked-work', '(board)',
                                f'suggestion: open PR {url} names no ticket on this board'))


def check_sync(board_id, chats, now, breaks):
    for name in chats:
        for line in drain_check.sync_findings(name, now):
            breaks.append(Break('(sync)', 'sync-record', name, line))


def check_human_writes(board_id, tasks_by_key, comments_by_ticket, breaks):
    if board_id not in HUMAN_BOARDS:
        return
    for key, comments in comments_by_ticket.items():
        for row in comments:
            if row.get('agent') or row.get('agent_display_name'):
                continue
            creator = row.get('creator') or {}
            if not isinstance(creator, dict):
                continue
            if 'valentin' in (creator.get('displayName') or '').casefold():
                task = tasks_by_key.get(key, {'ticketNumber': key, 'labels': []})
                breaks.append(Break(key, 'human-board-write', owner_chat(task),
                                    'human wrote on a board lane; use agent login for agent work'))
                break


def collect_comments(tasks, data, args, board_id):
    out = dict(data.get('comments') or {})
    if args.fixture or args.skip_comments:
        return out
    for task in tasks:
        key = task['ticketNumber']
        if task.get('section') != DONE:
            if board_id not in HUMAN_BOARDS:
                continue
        if key in out:
            continue
        try:
            page = reconcile.api('comment', 'list', key, '--limit', '50')
            out[key] = page.get('comments') or []
        except ERRORS:
            out[key] = []
    return out


def lint(args):
    reconcile.reset_github_count()
    data, board, tasks, fixture_pulls = rows_for(args)
    now = float(data.get('now') or time.time())
    pulls = load_pulls(board, tasks, fixture_pulls)
    if fixture_pulls is not None:
        seed_fixture_pulls(pulls)
    sections = {t['section'] for t in tasks}
    if board.columns:
        sections |= board.columns
    elif not args.fixture and not reconcile.product_board(board):
        sections |= reconcile.read_sections(board)
    names = {} if reconcile.product_board(board) else reconcile.stage_names(sections=sections)
    options = {} if board.id == reconcile.BOARD else {'board': board}
    live = live_names(args) | owners.owned_labels(args.board) | loop_armed_chat_names(args.board)
    known = known_chats(args, data)
    members = member_agents(board.id, data, args)
    # A fixture that models no views cannot judge them; a live run always can.
    view_rules = not args.fixture or 'views' in data
    views = fixture_views(data) if args.fixture else read_views(board.id)
    label_ids = fixture_label_ids(data) if args.fixture else read_label_ids(board.id)
    chat_names = chat_naming_labels(args, args.board)
    comments = collect_comments(tasks, data, args, board.id)
    breaks = []
    for task in tasks:
        if str(task.get('projectId', board.id)) != str(board.id):
            continue
        ticket_pulls = pulls.get(task['ticketNumber'], ()) if pulls else ()
        try:
            facts = (reconcile.collect(task, ticket_pulls, now, **options)
                     if task.get('section') in board.managed
                     else reconcile.Facts(task.get('section', ''), now - reconcile.stamp(task.get('updatedAt', now))))
        except ERRORS:
            continue
        if args.fixture and isinstance(data.get('workers'), dict):
            # One fixture fact for both the column rule and the Doing worker rule.
            facts = reconcile.Facts(facts.column, facts.age,
                                    bool(data['workers'].get(task['ticketNumber'])),
                                    facts.pulls, facts.waiting, facts.blocked, facts.verification)
        check_agent_assignee(task, facts, live, known, members, data, args, breaks)
        check_true_column(task, facts, board, names, breaks)
        check_done_proof(task, pulls, comments, board, breaks)
        check_label_assignee(task, chat_names, breaks)
        check_no_owner_label(task, breaks)
        check_unnamed_identity(task, breaks)
        check_stale(task, now, breaks)
    check_duplicates(tasks, breaks)
    if pulls and args.fixture:
        check_unlinked_prs(board, tasks, pulls, breaks)
    for label, view in (board_chat_views(tasks, known, views) if view_rules else ()):
        detail = view_detail(view) if view else None
        check_view_filter(board, label, detail, label_ids, breaks)
        check_view_owner(label, detail, breaks)
    check_sync(args.board, armed_chats(args.board), now, breaks)
    tasks_by_key = {t['ticketNumber']: t for t in tasks}
    check_human_writes(args.board, tasks_by_key, comments, breaks)
    return breaks


def emit(breaks, args):
    if args.json:
        print(json.dumps([{'ticket': b.ticket, 'rule': b.rule, 'owner': b.owner, 'fix': b.fix} for b in breaks],
                         indent=2))
    else:
        for item in breaks:
            print(f'{item.ticket} | {item.rule} | {item.owner} | {item.fix}')
        counts = Counter(b.rule for b in breaks)
        if counts:
            summary = ', '.join(f'{rule}={counts[rule]}' for rule in sorted(counts))
            print(f'board-lint: {len(breaks)} breaks ({summary})', flush=True)
        else:
            print('board-lint: clean', flush=True)
    print(reconcile.github_summary(), file=sys.stderr, flush=True)


def ensure_token():
    """The caller's own login first; the read-only Reconciler login only when it has none.

    A chat that runs the lint keeps its own token, so reads never pretend to be
    another chat. A scheduled or headless run borrows the Reconciler's read-only
    login, and HT_TOKEN set by the caller always wins.
    """
    if not os.environ.get('HT_TOKEN'):
        login = session_login.login_for_session()
        path = login[1] if login else None
        if path is None or not path.is_file():
            path = session_login.token_path(Path.home(), 'Hypertask Reconciler')
        if path.is_file():
            os.environ['HT_TOKEN'] = path.read_text().strip()
    reconcile.session_bus()


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--board', type=int, required=True)
    parser.add_argument('--label', help='Only tickets carrying this label')
    parser.add_argument('--fixture', help='JSON board snapshot instead of the API')
    parser.add_argument('--roster', help='roster-live output file for tests')
    parser.add_argument('--json', action='store_true')
    parser.add_argument('--skip-comments', action='store_true', help='Skip Done comment fetches')
    args = parser.parse_args(argv)
    if args.board < 1:
        parser.error('--board must be positive')
    try:
        if not args.fixture:
            ensure_token()
        breaks = lint(args)
        emit(breaks, args)
        return 1 if breaks else 0
    except (reconcile.BudgetRefused, reconcile.RateLimit) + ERRORS as error:
        print(f'board-lint: read failed: {error}', file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())