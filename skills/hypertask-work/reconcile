def _open_pr_reason(board):
    return 'open PR' if product_board(board) else 'open PR checks green; verifier or merge pending'


def _worker_reason(board):
    return 'live worker' if product_board(board) else 'live worker: lease or process'


def open_pr_in_checks(pull, board):
    if pull.state != 'OPEN':
        return False
    if product_board(board):
        return pull.checks not in ('', 'green')
    return pull.checks != 'green'


def merged_since_entry(pull, facts, here):
    """A merge counts as evidence by stage.

    Reopened backlog cards ignore merges that landed before the column entry.
    Verification backlog uses the same clock. Work and review columns treat a merged
    PR as evidence regardless of entry time. A missing merge time keeps the old
    reading; a missing entry on backlog or verification is not a guess.
    """
    if here in (Stage.IN_PROGRESS, Stage.CHECKS, Stage.REVIEW):
        return True
    if pull.merged_at is None:
        return True
    if facts.column_entered is None:
        return False
    return pull.merged_at > facts.column_entered


def merged_with_pass(pulls):
    """A merged PR with a PASS verdict on its head, and only that counts as proof.

    Reads the same `passed` fact the plan reads, so board-lint and `plan_stage`
    cannot disagree about what makes a merge proven.
    """
    for pull in pulls or ():
        state = pull.get('state') if isinstance(pull, dict) else pull.state
        passed = pull.get('passed') if isinstance(pull, dict) else pull.passed
        if (state or '').upper() == 'MERGED' and passed is True:
            return True
    return False


def plan_stage(facts, here, board):
    """One evidence order for every board: PR, worker, verification routing, grace, idle."""
    if facts.waiting or facts.blocked:
        return None, 'waiting or blocked; kept'
    if any(open_pr_in_checks(p, board) for p in facts.pulls):
        if facts.pr_idle and not facts.alive:
            # The PR has not moved for a day and nobody runs it. The card holds Todo
            # until the PR itself moves, so a red PR cannot bounce it back to Checks.
            return Stage.BACKLOG, 'red PR idle 24h; owner must fix or close'
        return Stage.CHECKS, 'open PR checks running, red, or missing'
    if any(p.state == 'OPEN' for p in facts.pulls):
        return Stage.REVIEW, _open_pr_reason(board)
    merged = [p for p in facts.pulls if p.state == 'MERGED']
    if merged and here == Stage.BACKLOG and facts.column_entered is None:
        return None, 'column entry unreadable; kept'
    fresh = [p for p in merged if merged_since_entry(p, facts, here)]
    if fresh and product_board(board):
        # The product board runs no verifier gate, so a merge is review evidence alone.
        return Stage.REVIEW, 'merged PR; live proof pending'
    if fresh and merged_with_pass(fresh):
        # One merged PR carrying the verifier's PASS settles the card (VSTA-189): a PR
        # that only names the key, or one merged before the gate existed, never had a
        # PASS of its own. A PASS runs before the merge, so merged with PASS is proven: Done.
        return Stage.DONE, 'merged with PASS'
    if fresh:
        if facts.alive:
            # A live owner still on the card keeps it in work while they verify the
            # merge. Sending it to Todo now and back to work next run would flap it.
            return Stage.IN_PROGRESS, _worker_reason(board)
        # Merging without a verdict breaks the one rule that makes Done mean proven.
        return Stage.BACKLOG, 'merged without PASS: rule break; owner must verify'
    if here == Stage.IN_PROGRESS and not facts.alive and nothing_ran():
        # plan-pick exited 75: every lane was used up and no worker ran (VSTA-182).
        # Say so and wait, instead of leaving the card reading as started for 2h.
        # A live worker from a later launch keeps its card where it is.
        return Stage.BACKLOG, NOTHING_RAN
    if facts.alive:
        return Stage.IN_PROGRESS, _worker_reason(board)
    if here == Stage.VERIFICATION and not facts.verification:
        return Stage.BACKLOG, 'not a verification ticket'
    if here == Stage.VERIFICATION:
        return None, 'verification backlog; kept'
    if here == Stage.BACKLOG and facts.verification and Stage.VERIFICATION in stage_column_map(board):
        return Stage.VERIFICATION, 'verification ticket'
    if merged and here == Stage.BACKLOG:
        # Older than the backlog entry: history on a reopened card, not evidence.
        return None, 'merged PR older than column entry; kept'
    if facts.age < GRACE_SECONDS:
        return None, 'touched within 2h'
    if here in board.idle_demotion:
        return Stage.BACKLOG, ('idle In Progress; no live worker or open PR' if product_board(board)
                               else 'no live worker and no PR')
    if board.demote_all_idle:
        return Stage.BACKLOG, 'no live worker and no PR'
    return None, 'no live worker or open PR; kept'


def planned_stage(stage, board):
    """The stage this board can show: Checks folds into review when it has no Checks."""
    if stage == Stage.CHECKS and Stage.CHECKS not in stage_column_map(board):
        return Stage.REVIEW
    return stage


def resolve_column(stage, board, names):
    targets = stage_column_map(board)
    stage = planned_stage(stage, board)
    if stage == Stage.IN_PROGRESS:
        return names.get('Doing', targets[Stage.IN_PROGRESS])
    if stage == Stage.REVIEW:
        return names.get('AI Review', targets[Stage.REVIEW])
    return targets[stage]


def column_stage_of(board, column):
    if column in board.protected or column.startswith('Flag:'):
        return Stage.PROTECTED
    stage = column_stage_map(board).get(column)
    return stage if stage is not None else Stage.UNMANAGED


def stage_names(column=None, sections=()):
    """Resolve each stage against the column names this board actually shows."""
    present = set(sections) | ({column} if column else set())
    return {'Doing': 'Building' if 'Building' in present else 'Doing',
            'AI Review': 'Verifier' if 'Verifier' in present else 'AI Review'}


def read_sections(board=DEFAULT):
    try:
        value = api('project', 'sections', '--project', str(board.id))
        return {section['section_title'] for section in value.get('sections', [])}
    except (ValueError, KeyError, TypeError, OSError, RuntimeError, subprocess.SubprocessError):
        return set()


def product_board(board):
    """Board 15 runs the product's own workers; every other board uses fleet leases."""
    return board.id == 15


def session_bus(env=None):
    """The user session bus a headless chat does not always have.

    `systemctl --user` needs both paths, so a timer or a bare shell gets the
    usual ones filled in. The lease borrows this same helper for its card sync.
    """
    env = os.environ if env is None else env
    uid = os.getuid()
    env.setdefault('XDG_RUNTIME_DIR', f'/run/user/{uid}')
    env.setdefault('DBUS_SESSION_BUS_ADDRESS', f'unix:path=/run/user/{uid}/bus')
    return env


def dynamic_stage_maps(columns, names):
    """Map a board's real columns onto the factory stage model."""
    stage_column = dict(FACTORY_STAGE_COLUMN)
    column_stage = dict(FACTORY_COLUMN_STAGE)
    if names['Doing'] != 'Doing':
        stage_column[Stage.IN_PROGRESS] = names['Doing']
        column_stage[names['Doing']] = Stage.IN_PROGRESS
    if names['AI Review'] != 'AI Review':
        stage_column[Stage.REVIEW] = names['AI Review']
        column_stage[names['AI Review']] = Stage.REVIEW
    if 'Checks' not in columns:
        stage_column.pop(Stage.CHECKS, None)
        column_stage.pop('Checks', None)
    if 'Done' not in columns:
        stage_column.pop(Stage.DONE, None)
        column_stage.pop('Done', None)
    if VERIFICATION_BACKLOG not in columns:
        stage_column.pop(Stage.VERIFICATION, None)
        column_stage.pop(VERIFICATION_BACKLOG, None)
    return stage_column, column_stage


# Read once per run, so the same board object keys the process scan and its lease.
@lru_cache(maxsize=None)
def board_config(board_id):
    """Any board a project names: its own prefix and columns, the one stage model.

    Only columns carrying a known stage can be moved between; every other
    column is protected, and a target stage this board lacks keeps its ticket.
    """
    if board_id in BOARDS:
        return BOARDS[board_id]
    project = api('project', 'show', str(board_id)).get('project') or {}
    prefix = (project.get('uniqueIdentifier') or '').strip().upper()
    if not prefix:
        raise ValueError(f'board {board_id} has no ticket prefix')
    columns = frozenset(section['section_title'] for section in project.get('sections') or ()
                        if section.get('section_title'))
    names = stage_names(sections=columns)
    managed = columns & frozenset({'Todo', 'Checks', VERIFICATION_BACKLOG,
                                   names['Doing'], names['AI Review']})
    protected = columns - managed
    stage_column, column_stage = dynamic_stage_maps(columns, names)
    return make_board(board_id, prefix, managed, protected, stage_column, column_stage,
                      columns=columns)


def target(facts, board=DEFAULT, names=None):
    if names is None:
        names = {} if product_board(board) else stage_names(facts.column, board.columns or ())
    here = column_stage_of(board, facts.column)
    if here in (Stage.PROTECTED, Stage.UNMANAGED):
        reason = 'protected column' if here is Stage.PROTECTED else 'unknown column; kept'
        return facts.column, reason
    planned, reason = plan_stage(facts, here, board)
    if planned is None:
        return facts.column, reason
    planned = planned_stage(planned, board)
    if planned not in stage_column_map(board):
        return facts.column, 'target column missing; kept'
    column = resolve_column(planned, board, names)
    if board.columns is not None and column not in board.columns:
        return facts.column, 'target column missing; kept'
    if column == facts.column:
        return facts.column, reason
    return column, reason


def stamp(value):
    if isinstance(value, (int, float)):
        return float(value)
    return datetime.fromisoformat(value.replace('Z', '+00:00')).timestamp()


def moment(value):
    """One timestamp as epoch seconds, or None when the board sent nothing usable."""
    try:
        return stamp(value) if value else None
    except (TypeError, ValueError):
        return None


SECTION_CHANGED = {}


def column_entered(task):
    """When this card entered its current column."""
    key = task['ticketNumber']
    if key in SECTION_CHANGED:
        return SECTION_CHANGED[key]
    staleness = task.get('staleness') or {}
    return moment(staleness.get('sectionChangedAt'))


def needs_column_entry(task, pulls, board):
    if column_stage_of(board, task['section']) is not Stage.BACKLOG:
        return False
    return any(p.get('state') == 'MERGED' for p in pulls.get(task['ticketNumber'], ()))


def fill_section_changed(candidates, pulls, board):
    """One task read per reopened backlog card that still carries a merged PR."""
    SECTION_CHANGED.clear()
    for task in candidates:
        if not needs_column_entry(task, pulls, board):
            continue
        key = task['ticketNumber']
        direct = moment((task.get('staleness') or {}).get('sectionChangedAt'))
        if direct is not None:
            SECTION_CHANGED[key] = direct
            continue
        try:
            row = api('task', 'get', key)['tasks'][0]
            SECTION_CHANGED[key] = moment((row.get('staleness') or {}).get('sectionChangedAt'))
        except (ValueError, KeyError, TypeError, OSError, RuntimeError, subprocess.SubprocessError):
            SECTION_CHANGED[key] = None


def pid_alive(pid):
    if not isinstance(pid, int) or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        # Zombies still answer kill(0), but no worker runs there.
        stat = Path(f'/proc/{pid}/stat')
        return not stat.exists() or stat.read_text().rsplit(')', 1)[1].split()[0] != 'Z'
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def live_lease(key, now, directory=None):
    path = (directory or LEASES) / (key + '.json')
    try:
        lease = json.loads(path.read_text())
    except FileNotFoundError:
        return False
    age = now - stamp(lease['last_beat'])
    if age >= 900:
        return False
    if lease['host'] != socket.gethostname():
        raise ValueError('lease belongs to another host; PID cannot be checked')
    started = stamp(lease['started'])
    return 0 <= age < 900 and started <= now and pid_alive(lease['pid'])


def process_chain(pid=None, directory=None):
    """This process and its parents. A brief that names a ticket is not that worker."""
    directory = directory or PROC
    chain, pid = set(), os.getpid() if pid is None else pid
    while pid and pid not in chain:
        chain.add(pid)
        try:
            fields = (directory / str(pid) / 'stat').read_text().rsplit(')', 1)[1].split()
            pid = int(fields[1])
        except (OSError, ValueError, IndexError):
            break
    return chain


def is_worker(argv):
    wrapper = None
    index = 0
    while index < len(argv):
        text = argv[index].strip().split()[0] if argv[index].strip() else ''
        name = Path(text).name
        if not text:
            index += 1
            continue
        if name in WRAPPERS and not text.startswith('-'):
            wrapper = name
            index += 1
            continue
        if text.startswith('-'):
            flag = text.split('=', 1)[0]
            if flag in VALUE_FLAGS.get(wrapper or '', ()) and '=' not in text and index + 1 < len(argv):
                nxt = argv[index + 1]
                if wrapper in SHELLS:
                    return any(is_worker(words) for words in shell_commands(nxt))
                if Path(nxt.strip().split()[0]).name in AGENTS:
                    return True
                index += 2
                continue
            index += 1
            continue
        if re.fullmatch(r'\d+[smhd]?', text) or re.fullmatch(r'[A-Za-z_]\w*=.*', text):
            index += 1
            continue
        if name in NON_WORKERS:
            return False
        if name == LEASE_TOOL:
            return lease_run(argv, index)
        return name in AGENTS
    return False


def shell_commands(text):
    """Each simple command inside a `shell -c` string, so `cd x && pi -p URL` still counts."""
    return [part.split() for part in SHELL_SEPARATOR.split(text)]


def lease_run(argv, index):
    """`lease KEY run -- COMMAND` is the wrapper the house rules start workers through."""
    words = [word.strip() for word in argv[index + 1:index + 4] if word.strip()]
    if not (len(words) >= 2 and words[1] == 'run' and KEY_WORD.fullmatch(words[0])):
        return False
    wrapped = [word.strip() for word in argv[index + 4:] if word.strip() and word.strip() != '--']
    return not wrapped or Path(wrapped[0]).name not in NON_WORKERS


def lease_roots(now, directory=None):
    """PIDs recorded on a fresh lease on this host."""
    directory = directory or LEASES
    host = socket.gethostname()
    roots = set()
    try:
        paths = list(directory.glob('*.json'))
    except OSError:
        return roots
    for path in paths:
        try:
            lease = json.loads(path.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        if lease.get('host') != host:
            continue
        if now - stamp(lease['last_beat']) >= 900:
            continue
        pid = lease.get('pid')
        if isinstance(pid, int) and pid > 0 and pid_alive(pid):
            roots.add(pid)
    return roots


def leased_process_tree(now, proc_dir=None, leases_dir=None):
    """A leased worker PID and every descendant; argv scan must not see them."""
    proc_dir = proc_dir or PROC
    roots = lease_roots(now, leases_dir)
    if not roots:
        return set()
    parent = {}
    try:
        entries = proc_dir.iterdir()
    except OSError:
        return set(roots)
    for entry in entries:
        if not entry.name.isdigit():
            continue
        pid = int(entry.name)
        try:
            fields = (entry / 'stat').read_text().rsplit(')', 1)[1].split()
            parent[pid] = int(fields[1])
        except (OSError, ValueError, IndexError):
            continue
    tree = set(roots)
    changed = True
    while changed:
        changed = False
        for pid, ppid in parent.items():
            if pid not in tree and ppid in tree:
                tree.add(pid)
                changed = True
    return tree


@lru_cache(maxsize=2)
def process_tickets(board=DEFAULT):
    """Fallback liveness for an agent CLI started without the lease wrapper.

    Word boundaries keep SOFT-27 out of SOFT-2730.
    """
    ignore = process_chain()
    leased = leased_process_tree(time.time())
    url = re.compile(r'https://app\.hypertask\.ai/detail/project-' + str(board.id) + r'/([1-9]\d*)(?!\w)')
    key = re.compile(r'(?<![\w-])' + re.escape(board.prefix) + r'-[1-9]\d*(?![\w-])', re.I)
    found = set()
    try:
        entries = sorted(PROC.iterdir())
    except OSError:
        return found
    for entry in entries:
        pid = int(entry.name) if entry.name.isdigit() else 0
        if not pid or pid in ignore or pid in leased:
            continue
        try:
            argv = [os.fsdecode(part) for part in (entry / 'cmdline').read_bytes().split(b'\0') if part]
        except OSError:
            continue
        if not argv or not is_worker(argv):
            continue
        line = ' '.join(argv)
        found |= {board.prefix + '-' + match[1] for match in url.finditer(line)}
        found |= {match[0].upper() for match in key.finditer(line)}
    return found


def worker_alive(key, now, board=DEFAULT):
    """A lease, a live command line, or a product worker proves a live worker."""
    if product_board(board):
        return (live_product_worker(key, now) or live_lease(key, now)
                or key.upper() in process_tickets(board))
    return live_lease(key, now) or key.upper() in process_tickets(board)


def worker_state_directory(slug, pid):
    environment = (PROC / str(pid) / 'environ').read_bytes().split(b'\0')
    for item in environment:
        if item.startswith(b'HT_AGENT_STATE_DIR='):
            return Path(os.fsdecode(item.split(b'=', 1)[1]))
    return Path.home() / '.local/state' / f'hypertask-{slug}'


@lru_cache(maxsize=1)
def product_workers(now):
    units = run('systemctl', '--user', 'list-units', '--all', '--plain', '--no-legend',
                'hypertask-agent-worker@*.service')
    live = set()
    for line in units.splitlines():
        parts = line.split()
        if not parts:
            continue
        unit = parts[0]
        match = re.fullmatch(r'hypertask-agent-worker@([\w.-]+)\.service', unit)
        if not match:
            raise ValueError('unrecognized product worker unit')
        properties = dict(line.split('=', 1) for line in run('systemctl', '--user', 'show', unit,
                          '--property=MainPID', '--property=ActiveState').splitlines() if '=' in line)
        pid = int(properties['MainPID'])
        if properties['ActiveState'] != 'active' or not pid_alive(pid):
            continue
        path = worker_state_directory(match[1], pid) / 'queue.sqlite3'
        try:
            with closing(sqlite3.connect(path.resolve().as_uri() + '?mode=ro', uri=True)) as db:
                rows = db.execute("""SELECT ticket,progress_at,started_at FROM deliveries
                    WHERE project_id=15 AND state IN ('claiming','launching','running')
                    AND ticket IS NOT NULL
                    AND (event IS NULL OR event NOT IN ('task.unassigned','chat.message'))""").fetchall()
        except sqlite3.Error as error:
            raise ValueError('product worker queue unavailable') from error
        for key, progress, started in rows:
            ticket_index(key, BOARDS[15])
            if 0 <= now - stamp(progress or started) < 900:
                live.add(key)
    return live


def live_product_worker(key, now):
    return key in product_workers(now)


BOARD15_LEADS = ('Valentins Claude Code', 'HT Product Lead')


def board15_member(context):
    """The agent's own project list proves board 15 membership; nothing else does."""
    return any(str(project.get('id')) == '15' for project in context.get('projects') or ())


def require_board15_agent(label=None):
    """vcc and HT Product Lead move any board 15 card. Any other login needs a board 15
    membership and moves only cards carrying the one label that names its agent, so no
    lead ever touches another lead's cards or an unlabelled card."""
    if not os.environ.get('HT_TOKEN'):
        raise ValueError('board 15 requires HT_TOKEN from its service environment file')
    context = api('context')
    agent = context.get('connected_agent') or {}
    name = agent.get('displayName') or ''
    # Valentin's personal token carries no connected agent, so identity decides, not the user.
    if not agent.get('id'):
        raise ValueError('board 15 requires the vcc or HT Product Lead agent token')
    if name in BOARD15_LEADS:
        return
    if not board15_member(context):
        raise ValueError('board 15 requires the vcc or HT Product Lead agent token')
    if not label:
        raise ValueError('board 15 requires --label for an agent other than vcc or HT Product Lead')
    if label.strip().casefold() != name.strip().casefold():
        raise ValueError(f'board 15 syncs only the label that names the agent ({name!r})')


class RateLimit(Exception):
    """GitHub's budget is spent. The run stops before it can make a wrong move."""

    def __init__(self, reset='unknown'):
        self.reset = reset
        super().__init__(f'GitHub rate limit; reset {reset}')


class BudgetRefused(Exception):
    """The shared gh wrapper refused a read for this chat's hourly budget."""

    def __init__(self, line):
        self.line = line
        super().__init__(line)


BUDGET_WAIT = re.compile(r'wait until [^.\n]+', re.I)


def budget_skip_line(refused):
    """The one line a tick over the gh budget prints: gh's own wait-until text.

    A refused budget is a skipped tick, never a failed run: nothing moves, no saved
    fact is rewritten, and the run exits 0. Sync, its watcher and drain-check all
    read this line as skipped.
    """
    found = BUDGET_WAIT.search(getattr(refused, 'line', '') or '')
    wait = found[0].strip() if found else 'reset time unknown'
    return f'sync skipped: gh budget ({wait})'


# Only an error surface counts. Prose that mentions a rate limit is not one, so a
# ticket or PR body quoting this failure can never stop a run.
RATE_LIMIT_TYPE = re.compile(r'"type"\s*:\s*"RATE_LIMITED"')
RATE_LIMIT_TEXT = re.compile(r'(?:API|secondary)\s+rate\s+limit', re.I)


def rate_limited(text):
    return bool(RATE_LIMIT_TYPE.search(text) or RATE_LIMIT_TEXT.search(text))


def format_reset(epoch):
    return datetime.fromtimestamp(float(epoch), timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')


def budget_reset():
    """Reset time from the free rate_limit call: a failed response's headers are
    not printed by gh. This call does not count against any limit."""
    try:
        resources = json.loads(subprocess.run(['gh', 'api', 'rate_limit'], capture_output=True,
                                              text=True, timeout=60).stdout)['resources']
        spent = [r['reset'] for r in resources.values()
                 if isinstance(r, dict) and r.get('remaining') == 0 and r.get('reset')]
        resets = spent or [r['reset'] for r in resources.values()
                           if isinstance(r, dict) and r.get('reset')]
    except (OSError, KeyError, TypeError, ValueError, subprocess.SubprocessError):
        return 'unknown'
    return format_reset(min(resets)) if resets else 'unknown'


CACHE_LOCK = threading.Lock()
TIMING = {}
TIMING_LOCK = threading.Lock()
CURRENT = ['setup']
# Moves this run has written, so a late rate limit never claims to have applied none.
APPLIED = [0]


class phase:
    """One progress line on stderr per phase, with its time and external calls."""

    def __init__(self, name):
        self.name = name

    def __enter__(self):
        self.began = time.monotonic()
        CURRENT[0] = self.name
        with TIMING_LOCK:
            TIMING.setdefault(self.name, [0.0, 0])
        return self

    def __exit__(self, kind, value, trace):
        with TIMING_LOCK:
            TIMING[self.name][0] = time.monotonic() - self.began
            calls = TIMING[self.name][1]
        print(f'reconcile: {self.name} done in {TIMING[self.name][0]:.1f}s ({calls} external calls)',
              file=sys.stderr, flush=True)


def timing_table():
    lines = [f'{"phase":<10} {"seconds":>8} {"calls":>6}']
    lines += [f'{name:<10} {seconds:>8.1f} {calls:>6}' for name, (seconds, calls) in TIMING.items()]
    return '\n'.join(lines + [f'{"total":<10} {sum(row[0] for row in TIMING.values()):>8.1f} {sum(row[1] for row in TIMING.values()):>6}'])


GITHUB = {'graphql': 0, 'rest': 0}


def reset_github_count():
    GITHUB.update(graphql=0, rest=0)


def github_calls():
    return GITHUB['graphql'], GITHUB['rest']


def github_summary():
    graphql, rest = github_calls()
    return f'reconcile: github calls={graphql + rest} (graphql={graphql}, rest={rest})'


def run(*args):
    with TIMING_LOCK:
        TIMING.setdefault(CURRENT[0], [0.0, 0])[1] += 1
        if args[0] == 'gh':
            GITHUB['graphql' if 'graphql' in args or args[1:2] == ('pr',) else 'rest'] += 1
    result = subprocess.run(args, capture_output=True, text=True, timeout=180)
    if result.returncode:
        # Only gh's error channel: a failed batch still carries resolved PRs on
        # stdout, and a comment there may quote a rate limit without being one.
        if result.returncode == 75 and BUDGET_REFUSED.search(result.stderr):
            raise BudgetRefused(result.stderr.strip().splitlines()[0])
        if rate_limited(result.stderr):
            raise RateLimit(budget_reset())
        raise RuntimeError(f'{args[0]} {args[1]} failed: {result.stderr.strip()[-250:]}')
    if RATE_LIMIT_TYPE.search(result.stdout):
        # GraphQL reports a spent budget in a 200 response.
        raise RateLimit(budget_reset())
    return result.stdout


def cache_file():
    return Path(os.environ.get('RECONCILE_CACHE') or Path.home() / '.cache/vstack/reconcile/cache.json')


def cache_read_all():
    try:
        data = json.loads(cache_file().read_text())
        return data if isinstance(data, dict) else {}
    except (OSError, TypeError, ValueError):
        return {}


def cache_read(key):
    return cache_read_all().get(key)


def cache_update(updater):
    """Best effort atomic read-modify-write on the shared cache file."""
    path = cache_file()
    with CACHE_LOCK:
        temporary = None
        try:
            path.parent.mkdir(parents=True, exist_ok=True)
            with path.with_name(f'{path.name}.lock').open('a') as lock:
                fcntl.flock(lock, fcntl.LOCK_EX)
                try:
                    data = json.loads(path.read_text())
                    if not isinstance(data, dict):
                        data = {}
                except (OSError, TypeError, ValueError):
                    data = {}
                updater(data)
                if len(data) > 5000:
                    data = dict(list(data.items())[-2000:])
                temporary = path.with_name(f'{path.name}.{os.getpid()}.{threading.get_ident()}.tmp')
                temporary.write_text(json.dumps(data))
                os.replace(temporary, path)
                temporary = None
        except OSError:
            if temporary is not None:
                try:
                    temporary.unlink(missing_ok=True)
                except OSError:
                    pass


def cache_write_many(updates):
    """Write several cache keys in one locked read-modify-write."""
    if updates:
        cache_update(lambda data: data.update(updates))


def cache_write(key, value):
    """Best effort: a broken or racing cache costs calls, never correctness."""
    cache_write_many({key: value})


def board_facts_key(board_id):
    return f'board-facts-{board_id}.json'


def read_board_facts(board_id):
    value = cache_read(board_facts_key(board_id))
    return value if isinstance(value, dict) else None


def write_board_facts(board_id, payload):
    cache_write(board_facts_key(board_id), payload)


def saved_facts_usable(saved):
    """Can these saved facts serve a run at all? Age is a per-ticket question now.

    An entry written before a field existed cannot answer the rules: a merged pull
    with no merge time would read as a ship on every run and flap the card.
    """
    for entry in (saved.get('tickets') or {}).values():
        if any(p.get('state') == 'MERGED' and 'mergedAt' not in p
               for p in entry.get('pulls') or ()):
            return False
        if any(f.get('state') == 'MERGED' and 'merged_at' not in f
               for f in (entry.get('facts') or {}).values()):
            return False
        # An open PR whose checks are not green is the idle rule's whole input, so a
        # fact read before this field existed is re-read instead of read as active.
        if any(f.get('state') == 'OPEN' and f.get('checks') != 'green' and 'activity' not in f
               for f in (entry.get('facts') or {}).values()):
            return False
    return True


def saved_ticket_at(saved, key):
    """When one ticket's facts were last read. Older caches saved one time for all."""
    entry = (saved.get('tickets') or {}).get(key) or {}
    for value in (entry.get('at'), saved.get('at')):
        try:
            return float(value)
        except (TypeError, ValueError):
            continue
    return 0.0


def alias_changed(saved, keys, board):
    """Cards whose old keys differ from the ones their saved facts were read with.

    Facts read before a card had an alias cannot contain the PR that alias finds, so
    that card is re-read on the next run instead of keeping a column it earned under
    another key.
    """
    known = saved.get('tickets') or {}
    return {key for key in keys if key in known and
            sorted(aliases_of(key, board)) != sorted(known[key].get('aliases') or ())}


def rolling_refresh(saved, keys, changed, now):
    """The tickets this run reads GitHub for, when saved facts already exist.

    A run never re-reads the whole board. What the probe or the board flagged is
    read at once; a ticket whose facts have reached FACTS_STALE is read whatever the
    slice says, so nothing left behind is older than FACTS_MAX_AGE; and once the
    oldest facts pass FACTS_QUIET, the oldest ROLLING_SLICE'th of the rest is read
    too, so a chat back after hours catches up in a few short runs instead of one
    long one. New tickets arrive in `changed` and are read whole.
    """
    known = saved.get('tickets') or {}
    ages = {key: now - saved_ticket_at(saved, key) for key in keys if key in known}
    forced = {key for key, age in ages.items() if age >= FACTS_STALE}
    rest = sorted((key for key in ages if key not in forced and key not in changed),
                  key=lambda key: ages[key], reverse=True)
    rolling = -(-len(rest) // ROLLING_SLICE) if ages and max(ages.values()) >= FACTS_QUIET else 0
    return set(changed) | forced | set(rest[:rolling])


def probe_scope(board, repos=()):
    """Every repository one board ships from, plus any it has already seen.

    The quiet probe covers them all in one query, so its call count does not grow
    with the number of repos a board ships from.
    """
    known = tuple(dict.fromkeys([repo for repo, _ in board.repos] + list(repos)))
    # GitHub's issue search answers a parenthesized OR with 422 Validation Failed,
    # so the fleet fallback is the same space-separated form every other search uses.
    return ' '.join(f'repo:{repo}' for repo in known) if known else search_scope(board)


def saved_pull_index(saved):
    """Saved pull metadata keyed by URL for probe rows that omit branch names."""
    index = {}
    for entry in (saved.get('tickets') or {}).values():
        for pull in entry.get('pulls') or []:
            url = pull.get('url')
            if url:
                index[url] = pull
    return index


def search_item_to_pull(item, saved_index=()):
    url = item.get('html_url') or item.get('url') or ''
    match = re.search(r'github\.com/([^/]+/[^/]+)/pull/(\d+)', url)
    repo = match.group(1) if match else ''
    number = int(item.get('number') or (match.group(2) if match else 0) or 0)
    state = (item.get('state') or 'open').upper()
    if state == 'OPEN':
        state = 'OPEN'
    elif state == 'CLOSED':
        pull = item.get('pull_request') or {}
        state = 'MERGED' if pull.get('merged_at') else 'CLOSED'
    saved = saved_index.get(url) if isinstance(saved_index, dict) else {}
    head = item.get('headRefName') or (saved or {}).get('headRefName') or ''
    return {'url': url, 'title': item.get('title') or '', 'body': item.get('body') or '',
            'headRefName': head, 'state': state, 'number': number,
            'mergedAt': (item.get('pull_request') or {}).get('merged_at') or (saved or {}).get('mergedAt'),
            'repository': {'nameWithOwner': repo or (saved or {}).get('repository', {}).get('nameWithOwner', '')}}


def probe_items(board, saved):
    """The change probe's rows, or None when GitHub will not answer the search."""
    try:
        with phase('probe'):
            return probe_changed_prs(board, saved['probe_since'], saved.get('repos') or ())
    except (ValueError, KeyError, TypeError, OSError, RuntimeError, subprocess.SubprocessError) as error:
        # A refused probe is a missed probe, never a dead sync: read every fact instead.
        print(f'reconcile: probe failed: {error}; reading every fact instead',
              file=sys.stderr, flush=True)
        return None


def probe_changed_prs(board, since_iso, repos=()):
    """One REST search: what PRs changed since the last sync (wrapper-cacheable)."""
    query = f'is:pr {probe_scope(board, repos)} updated:>={since_iso}'
    page = json.loads(run('gh', 'api', '--method', 'GET', 'search/issues',
                          '-f', f'q={query}', '-f', 'per_page=100'))
    items = [item for item in page.get('items') or [] if item.get('html_url')]
    total = int(page.get('total_count') or 0)
    if total > len(items):
        # A longer gap than one page covers: the rolling read still refreshes a
        # quarter of the rest, so say so rather than look like a full probe.
        print(f'reconcile: probe truncated: {len(items)} of {total} changed PRs; '
              f'refreshing a rolling slice too', file=sys.stderr, flush=True)
    return items


def board_task_changes(saved, tasks, keys):
    touched, known = set(), saved.get('tickets') or {}
    keys = set(keys)
    for task in tasks:
        key = task['ticketNumber']
        if key not in keys:
            continue
        if key not in known or known[key].get('updated_at') != task.get('updatedAt'):
            touched.add(key)
    return touched


def probe_ticket_keys(pull, url_keys, lookup):
    """The cards one probe row names: its saved links, plus what the row itself says."""
    matched = set(url_keys.get(pull['url'], ()))
    matched |= matching_keys(pull, *lookup)
    return matched


def tickets_from_probe(items, keys, board, saved=None):
    """Tickets whose PRs appeared in the change probe."""
    touched = set()
    saved_index = saved_pull_index(saved or {})
    lookup = key_lookup(keys, board)
    url_keys = {}
    for key in keys:
        for pull in ((saved or {}).get('tickets') or {}).get(key, {}).get('pulls') or []:
            url = pull.get('url')
            if url:
                url_keys.setdefault(url, set()).add(key)
    for item in items:
        pull = search_item_to_pull(item, saved_index)
        if not pull['url'] or not allowed_repository(pull, board):
            continue
        touched |= probe_ticket_keys(pull, url_keys, lookup)
    return touched


def merge_probe_pulls(found, items, keys, board, saved=None):
    saved_index = saved_pull_index(saved or {})
    lookup = key_lookup(keys, board)
    url_keys = {}
    for key in keys:
        for pull in ((saved or {}).get('tickets') or {}).get(key, {}).get('pulls') or []:
            url = pull.get('url')
            if url:
                url_keys.setdefault(url, set()).add(key)
    for item in items:
        pull = search_item_to_pull(item, saved_index)
        if not pull['url'] or not allowed_repository(pull, board):
            continue
        matched = probe_ticket_keys(pull, url_keys, lookup)
        if not matched:
            continue
        if pull['state'] == 'CLOSED':
            for key in matched:
                found[key] = [p for p in found[key] if p['url'] != pull['url']]
            continue
        for key in matched:
            urls = {p['url'] for p in found[key]}
            if pull['url'] not in urls:
                found[key].append(pull)
            else:
                found[key] = [pull if p['url'] == pull['url'] else p for p in found[key]]


def restore_pull_facts(saved):
    for entry in (saved.get('tickets') or {}).values():
        for ref, fact in (entry.get('facts') or {}).items():
            repo, number = ref.rsplit('#', 1)
            PULLS[(repo, int(number))] = Pull(fact['url'], fact['state'], fact['checks'], fact['passed'],
                                             fact.get('merged_at'), activity=fact.get('activity'))


def serialize_board_facts(board, tasks, pulls, now, probe_since=None, saved=None, refreshed=()):
    """One board's facts, each ticket stamped with the run that read it."""
    tickets = {}
    kept = saved if isinstance(saved, dict) else None
    for task in tasks:
        key = task['ticketNumber']
        plist = pulls.get(key)
        if plist is None:
            continue
        facts_at = now if key in refreshed or not kept else saved_ticket_at(kept, key)
        entry = {'at': facts_at, 'updated_at': task.get('updatedAt'), 'pulls': plist, 'facts': {},
                 'aliases': list(aliases_of(key, board))}
        if not product_board(board):
            for pull in plist:
                repo = pull['repository']['nameWithOwner']
                ref = (repo, pull['number'])
                if ref in PULLS:
                    got = PULLS[ref]
                    entry['facts'][f'{repo}#{pull["number"]}'] = {
                        'url': got.url, 'state': got.state, 'checks': got.checks, 'passed': got.passed,
                        'merged_at': got.merged_at, 'activity': got.activity}
        tickets[key] = entry
    repos = sorted({pull['repository']['nameWithOwner'] for plist in pulls.values() for pull in plist})
    return {'at': now, 'probe_since': probe_since or format_reset(now),
            'repos': repos, 'tickets': tickets}


SEARCH_FIELDS = ('url title body headRefName state mergedAt number baseRefName '
                 'repository{nameWithOwner}')


def search_data(queries):
    """The data of one aliased GraphQL search call, splitting a refused call in half.

    Each half keeps its aliases, so the answers merge under the names they arrived
    with. One alias GitHub will not answer costs one call, never the ones beside it.
    """
    body = ' '.join(f'{alias}:search(query:{json.dumps(query)},type:ISSUE,first:100)'
                    '{pageInfo{hasNextPage} nodes{... on PullRequest{' + SEARCH_FIELDS + '}}}'
                    for alias, query in queries.items())
    try:
        result = json.loads(run('gh', 'api', 'graphql', '-f', 'query=query{' + body + '}'))
        if result.get('errors') or not result.get('data'):
            raise ValueError('GitHub search errors')
        return result['data']
    except RateLimit:
        raise
    except (ValueError, KeyError, TypeError, OSError, RuntimeError, subprocess.SubprocessError):
        if len(queries) == 1:
            raise
        pairs = list(queries.items())
        middle = len(pairs) // 2
        found = {}
        for half in (pairs[:middle], pairs[middle:]):
            found.update(search_data(dict(half)))
        return found


def search_pages(pairs, size=SEARCH_BATCH):
    """One page per (id, query) pair, a batch of them per GitHub call."""
    pages = {}
    for offset in range(0, len(pairs), size):
        batch = pairs[offset:offset + size]
        data = search_data({f'q{n}': query for n, (_, query) in enumerate(batch)})
        for n, (ident, _) in enumerate(batch):
            pages[ident] = data.get(f'q{n}')
    return pages


def ticket_terms(key, board=DEFAULT):
    """The quoted search terms one card's PRs answer to: its key, URL fragment, and old keys."""
    terms = [f'"{key}"', f'"project-{board.id}/{ticket_index(key, board)}"']
    terms += [f'"{old}"' for old in aliases_of(key, board)]
    return terms


def ticket_query(key, board=DEFAULT):
    """The one search query a card's PRs answer to: its key, and the keys it moved from.

    A move keeps the task's internal id and rewrites its key, and the PRs already open
    against the card keep the key they were written with. The old key joins the same
    query, so an alias costs a term in a call the run already pays for, not a call.
    """
    return f'is:pr {search_scope(board)} ' + ' OR '.join(ticket_terms(key, board))


def pack_ticket_queries(keys, board=DEFAULT):
    """Pack cards into OR-joined search queries within GitHub's 5-OR (6-term) limit."""
    scope = search_scope(board)
    groups, current_keys, current_terms = [], [], []
    for key in keys:
        terms = ticket_terms(key, board)
        if current_keys and len(current_terms) + len(terms) > SEARCH_MAX_TERMS:
            groups.append((tuple(current_keys), f'is:pr {scope} ' + ' OR '.join(current_terms)))
            current_keys, current_terms = [], []
        current_keys.append(key)
        current_terms.extend(terms)
    if current_keys:
        groups.append((tuple(current_keys), f'is:pr {scope} ' + ' OR '.join(current_terms)))
    return groups


def text_pulls(keys, board=DEFAULT, seen=None):
    """Every PR whose title or body names its ticket, packing cards within GitHub's OR limit."""
    groups = pack_ticket_queries(keys, board)
    with phase('search'):
        pages = search_pages(groups)
        overflow = [key for group, _ in groups if pages[group]['pageInfo']['hasNextPage']
                    for key in group]
        single_pages = {}
        if overflow:
            if len(groups) == 1 and len(groups[0][0]) == 1:
                raise ValueError(f'{overflow[0]}: GitHub search truncated')
            single_pages = search_pages([(key, ticket_query(key, board)) for key in overflow])
    found = {key: [] for key in keys}

    def collect_group(group_keys, nodes):
        by_name, by_url = key_lookup(group_keys, board)
        for pull in nodes:
            if not pull or not pull.get('url'):
                continue
            if seen is not None:
                seen.append(pull)
            if (pull.get('state') == 'CLOSED' or not allowed_repository(pull, board)
                    or not shipped(pull, board)):
                continue
            for key in matching_keys(pull, by_name, by_url):
                if all(p['url'] != pull['url'] for p in found[key]):
                    found[key].append(pull)

    for group, _ in groups:
        page = pages[group]
        if page['pageInfo']['hasNextPage']:
            if len(group) == 1:
                raise ValueError(f'{group[0]}: GitHub search truncated')
            continue
        collect_group(group, page['nodes'])
    for key, page in single_pages.items():
        if page['pageInfo']['hasNextPage']:
            raise ValueError(f'{key}: GitHub search truncated')
        collect_group((key,), page['nodes'])
    return found


def branch_pulls(keys, board=DEFAULT, seen=None):
    """PRs whose head branch starts with a ticket key, one aliased search per key.

    GitHub search does not index branch substrings and head: matches only a branch's
    start. This replaces the fleet-wide merged sweep, which read thousands of other
    tickets' PRs to match a handful, and finds a merge from any date. A card that
    moved also looks for branches written with its old key.
    """
    if not keys:
        return []
    pairs = [((key, term), f'is:pr {search_scope(board)} head:{term}')
             for key in keys for term in (key,) + aliases_of(key, board)]
    pages = search_pages(pairs, BRANCH_BATCH)
    pulls = []
    for (key, term), page in pages.items():
        if page['pageInfo']['hasNextPage']:
            raise ValueError(f'{key}: GitHub branch search truncated')
        for pull in page['nodes']:
            if seen is not None and pull and pull.get('url'):
                seen.append(pull)
            if (pull and pull.get('url') and pull['state'] != 'CLOSED'
                    and allowed_repository(pull, board) and shipped(pull, board)
                    and all(p['url'] != pull['url'] for p in pulls)):
                pulls.append(pull)
    return pulls


def open_pulls(board=DEFAULT):
    """Every open PR in the board's scope: the ones that move a card today."""
    return scan_window(board, 'is:open', 'created', date(2008, 1, 1), today())


def ticket_pulls(keys, board=DEFAULT, sweep=None):
    """Every PR that names each ticket in its title, its body, or its branch.

    The ticket search packs cards into OR-joined queries within GitHub's limit.
    A board-sized run also sweeps every open PR once, because a branch that carries
    its key past the start of the name shows up nowhere else and that sweep replaces
    many lookups. A ticket still silent after text search and the open sweep gets
    one branch lookup, which is how a merge from years ago is found without reading
    the whole merge history.
    """
    if not keys:
        return {}
    sweep = len(keys) >= SWEEP_MIN_TICKETS if sweep is None else sweep
    seen = []
    found = text_pulls(keys, board, seen)
    by_key = {key.upper(): key for key in keys}
    by_key.update({old.upper(): key for key in keys for old in aliases_of(key, board)})

    def match_branches(pulls):
        for pull in pulls:
            for match in BRANCH_TOKEN.finditer(pull.get('headRefName') or ''):
                key = by_key.get(match[0].upper())
                if key and all(p['url'] != pull['url'] for p in found[key]):
                    found[key].append(pull)

    with phase('branches'):
        opened = open_pulls(board) if sweep else []
        match_branches(opened)
        silent = [key for key in keys if not found[key]]
        branched = branch_pulls(silent, board, seen)
    match_branches(branched)
    scanned = opened + branched
    attribute(found, seen + scanned, keys, board)
    return undone(found, scanned)


def discover_quiet(keys, board=DEFAULT, saved=None, probe_items=(), refresh=()):
    """Reuse saved PR links; read GitHub only for tickets this run refreshes."""
    saved = saved or {}
    found = {key: list((saved.get('tickets') or {}).get(key, {}).get('pulls', [])) for key in keys}
    probed = [search_item_to_pull(item, saved_pull_index(saved)) for item in probe_items]
    # A PR that changed since the last sync may carry the old key of a card that moved
    # to this board; resolving it here costs no search, only one read per unseen key.
    attribute(found, probed, keys, board)
    merge_probe_pulls(found, probe_items, keys, board, saved)
    missing = [key for key in keys if key not in (saved.get('tickets') or {})]
    read = [key for key in refresh if key not in missing]
    to_read = missing + read
    searched = []
    if to_read:
        # Only a large batch of unseen tickets pays for the open-PR sweep; a refreshed
        # ticket already has its saved links and rides along in the same search batch.
        sweep = len(missing) >= SWEEP_MIN_TICKETS
        for key, pulls in ticket_pulls(to_read, board, sweep=sweep).items():
            urls = {p['url'] for p in found[key]}
            found[key] += [pull for pull in pulls if pull['url'] not in urls]
            searched += pulls
    restore_pull_facts(saved)
    # Saved facts and the probe's own rows carry the revert, so a quiet sync cannot
    # keep counting a merge another merge took back.
    saved_pulls = [pull for key in keys for pull in
                   ((saved.get('tickets') or {}).get(key, {}).get('pulls') or [])]
    return undone(found, [p for p in saved_pulls + probed + searched if p.get('url')])


def api(*args):
    value = json.loads(run('hypertask', '--json', *args))
    if value.get('success') is False:
        raise ValueError('Hypertask request failed')
    return value


def read_ticket(key):
    """The one ticket a --ticket run syncs. Unreadable facts refuse the run."""
    rows = api('task', 'get', key).get('tasks') or []
    if not rows:
        raise ValueError(f'{key} unreadable')
    return rows[0]


def tickets(section=None, board=DEFAULT):
    rows, cursor, seen = [], None, set()
    while True:
        args = ['task', 'list', '--project', str(board.id), '--status', 'Normal', '--limit', '100']
        if section:
            args += ['--section', section]
        if cursor:
            args += ['--cursor', cursor]
        page = api(*args)
        rows += page['tasks']
        cursor = page.get('nextCursor')
        if not cursor:
            if isinstance(page.get('total'), int) and len(rows) < page['total']:
                raise ValueError('incomplete board pagination')
            break
        if cursor in seen:
            raise ValueError('repeated board cursor')
        seen.add(cursor)
    if any(str(t['projectId']) != str(board.id) for t in rows):
        raise ValueError(f'ticket outside board {board.id}')
    return rows


def ticket_index(key, board=DEFAULT):
    match = re.fullmatch(re.escape(board.prefix) + r'-([1-9]\d*)', key, re.I)
    if not match:
        raise ValueError(f'invalid board-{board.id} ticket key')
    return match[1]


ALIAS_CACHE = {}
# One noisy sweep must not turn into a thousand Hypertask reads on the run that first
# meets it. Anything over the cap is learned by a later run; nothing is ever re-asked.
ALIAS_RESOLVE_MAX = 10
SEED_DIR = Path(__file__).resolve().parent / 'aliases'
KEY_TOKEN = re.compile(r'(?<![A-Za-z0-9_-])([A-Z][A-Z0-9]*-[1-9]\d*)(?![A-Za-z0-9_-])', re.I)
EXACT_TOKEN = re.compile(r'(?<![\w-])([A-Z][A-Z0-9]*-[1-9]\d*)(?![\w-])', re.I)
# A branch runs the key into the rest of its name, so only letters and digits end it.
BRANCH_TOKEN = re.compile(r'(?<![A-Za-z0-9])([A-Za-z][A-Za-z0-9]*-[1-9]\d*)(?![A-Za-z0-9])', re.I)
DETAIL_URL = re.compile(
    r'https://app\.hypertask\.ai/detail/project-(\d+)/([1-9]\d*)(?=$|[\s?#)\]>,.])', re.I)
TICKET_FIELD = re.compile(
    r'^[ \t]*(?:[-*][ \t]+)?(?:\*\*)?Ticket:(?:\*\*)?[ \t]*\[?'
    r'(?:(?<![\w-])([A-Z][A-Z0-9]*-[1-9]\d*)(?![\w-])'
    r'|https://app\.hypertask\.ai/detail/project-(\d+)/([1-9]\d*)(?=$|[\s?#)\]>,.]))',
    re.I | re.M)
CLOSE_LINE = re.compile(
    r'^[ \t]*(?:[-*][ \t]+)?(?:\*\*)?'
    r'(?:close|closes|closed|fix|fixes|fixed|resolve|resolves|resolved)'
    r'(?:\*\*)?[ \t]([^\n]*)',
    re.I | re.M)
# The lines a PR writes a ticket key on, never the prose that mentions one.
STRUCT_LINE = re.compile(r'^[ \t]*(?:[-*][ \t]+)?(?:\*\*)?(?:Ticket:|(?:close|closes|closed|fix|'
                         r'fixes|fixed|resolve|resolves|resolved)[ \t])', re.I)


def named_keys(pull):
    """The keys a pull structurally names: title, branch, ticket line, closing line."""
    keys = KEY_TOKEN.findall(pull.get('title') or '')
    keys += KEY_TOKEN.findall(pull.get('headRefName') or '')
    for line in (pull.get('body') or '').splitlines():
        if STRUCT_LINE.match(line):
            keys += KEY_TOKEN.findall(line)
    return keys


def seed_aliases(board):
    """The committed old-key map for one board: keys only, no ticket content."""
    try:
        data = json.loads((SEED_DIR / f'{board.id}.json').read_text())
    except (OSError, TypeError, ValueError):
        return {}
    seeded = {}
    for old, row in (data or {}).items():
        new = row.get('newKey') if isinstance(row, dict) else row
        if isinstance(new, str) and new:
            seeded[str(old).upper()] = new.upper()
    return seeded


def learned_aliases(board):
    """Old keys this host already resolved: a board key, or None for another board."""
    value = cache_read(f'aliases-{board.id}.json')
    if not isinstance(value, dict):
        return {}
    return {key: (new if isinstance(new, str) else None) for key, new in value.items()
            if isinstance(key, str)}


def alias_map(board):
    """(board key -> old keys, every old key already resolved) for one board, once a run."""
    if board.id in ALIAS_CACHE:
        return ALIAS_CACHE[board.id]
    learned = learned_aliases(board)
    seeded = seed_aliases(board)
    by_new = {}
    for old, new in {**seeded, **{k: v for k, v in learned.items() if v}}.items():
        if old == new:
            continue
        try:
            ticket_index(new, board)
        except ValueError:
            continue
        by_new.setdefault(new, []).append(old)
    resolved = set(learned) | set(seeded)
    ALIAS_CACHE[board.id] = ({key: list(olds) for key, olds in by_new.items()}, resolved)
    return ALIAS_CACHE[board.id]


def aliases_of(key, board=DEFAULT):
    """The keys one card answered to before it moved."""
    return tuple(alias_map(board)[0].get(key, ()))


def reset_aliases():
    """Forget what this process learned; the disk cache still holds it."""
    ALIAS_CACHE.clear()


def learn_aliases(pulls, keys, board=DEFAULT):
    """Record the old key each unseen pull names, once, as an alias of its own card.

    A move keeps the task's internal id and rewrites its key, so PRs already open
    against the card still name the key it left. Hypertask still resolves that key
    without a project: one read per unseen key turns it into an alias for good. A key
    that resolves to another board is remembered as not this board's, so no run asks
    about it again. Keys this board already knows cost nothing.
    """
    by_new, resolved = alias_map(board)
    board_keys = {key.upper() for key in keys}
    own_prefix = re.compile(re.escape(board.prefix) + r'-[1-9]\d*$', re.I)
    unknown = []
    seen_urls = set()
    for pull in pulls:
        if not pull:
            continue
        url = pull.get('url')
        if url:
            if url in seen_urls:
                continue
            seen_urls.add(url)
        for key in named_keys(pull):
            key = key.upper()
            # A board's prefix belongs to that one project, so a key carrying it is
            # this board's own ticket (or nobody's): it can never be a moved-in key.
            if key in resolved or key in board_keys or own_prefix.match(key):
                continue
            unknown.append(key)
    unknown = list(dict.fromkeys(unknown))
    if not unknown:
        return set()
    learned = learned_aliases(board)
    before = dict(learned)
    fresh = set()
    for key in unknown[:ALIAS_RESOLVE_MAX]:
        try:
            rows = api('task', 'get', key).get('tasks') or []
        except (ValueError, KeyError, TypeError, OSError, RuntimeError,
                subprocess.SubprocessError):
            continue
        new = None
        if rows and str(rows[0].get('projectId')) == str(board.id):
            new = str(rows[0].get('ticketNumber') or '').upper() or None
            try:
                if new:
                    ticket_index(new, board)
            except ValueError:
                new = None
        learned[key] = new
        resolved.add(key)
        if new and new != key:
            by_new.setdefault(new, []).append(key)
            fresh.add(new)
    if len(unknown) > ALIAS_RESOLVE_MAX:
        print(f'reconcile: board {board.id} learned {ALIAS_RESOLVE_MAX} old keys; '
              f'{len(unknown) - ALIAS_RESOLVE_MAX} wait for a later run',
              file=sys.stderr, flush=True)
    if learned != before:
        cache_write(f'aliases-{board.id}.json', learned)
        print(f'reconcile: board {board.id} learned {len(learned) - len(before)} old key(s), '
              f'{len(fresh)} of them on this board', file=sys.stderr, flush=True)
    if fresh:
        # The map this run started with is stale now: rebuild it from what was learned.
        ALIAS_CACHE.pop(board.id, None)
        alias_map(board)
    return fresh


def pull_refs(pull):
    """All ticket keys and board detail URLs structurally named by one pull."""
    keys = {match.upper() for match in EXACT_TOKEN.findall(pull.get('title') or '')}
    keys.update(match.upper() for match in BRANCH_TOKEN.findall(pull.get('headRefName') or ''))
    urls = set()
    body = pull.get('body') or ''
    if body:
        for match in TICKET_FIELD.finditer(body):
            if match[1]:
                keys.add(match[1].upper())
            else:
                urls.add((match[2], match[3]))
        for match in CLOSE_LINE.finditer(body):
            rest = match[1]
            keys.update(m.upper() for m in EXACT_TOKEN.findall(rest))
            urls.update(DETAIL_URL.findall(rest))
    return keys, urls


def key_lookup(keys, board=DEFAULT):
    """Map every current key, alias, and (board_id, index) back to the card's key."""
    by_name = {}
    by_url = {}
    board_id = str(board.id)
    for key in keys:
        try:
            index = ticket_index(key, board)
        except ValueError:
            continue
        by_name[key.upper()] = key
        by_url[(board_id, index)] = key
        for old in aliases_of(key, board):
            by_name[old.upper()] = key
    return by_name, by_url


def matching_keys(pull, by_name, by_url):
    """Every board ticket this pull structurally names, in one pass over the pull."""
    ref_keys, ref_urls = pull_refs(pull)
    matched = {by_name[name] for name in ref_keys if name in by_name}
    matched.update(by_url[ref] for ref in ref_urls if ref in by_url)
    return matched


def attribute(found, pulls, keys, board=DEFAULT):
    """Give a card the pulls that name an old key this run just learned."""
    fresh = learn_aliases(pulls, keys, board)
    targets = [key for key in fresh if key in found]
    if not targets:
        return
    by_name, by_url = key_lookup(targets, board)
    seen_urls = set()
    for pull in pulls:
        url = pull.get('url') if pull else None
        if not url or url in seen_urls:
            continue
        seen_urls.add(url)
        if (pull.get('state') == 'CLOSED' or not allowed_repository(pull, board)
                or not shipped(pull, board)):
            continue
        for key in matching_keys(pull, by_name, by_url):
            if all(p['url'] != url for p in found[key]):
                found[key].append(pull)


def names_ticket(pull, key, board=DEFAULT):
    try:
        index = ticket_index(key, board)
    except ValueError:
        return False
    keys, urls = pull_refs(pull)
    if key.upper() in keys or (str(board.id), index) in urls:
        return True
    # A moved card keeps the key its PRs, branches and ticket lines were written with.
    return any(old.upper() in keys for old in aliases_of(key, board))


def today():
    return datetime.now(timezone.utc).date()


def search_scope(board=DEFAULT):
    """Every repository one board ships from, in the one query the search pays for."""
    if board.repos:
        return ' '.join(f'repo:{repo}' for repo, _ in board.repos)
    return 'user:valentinyeo user:hypertask-ai'


def release_branch(repo, board=DEFAULT):
    """The branch a merge must reach to ship, or None when the repo is unknown here."""
    known = dict(board.repos) if board.repos else FLEET_RELEASES
    return known.get(repo)


def shipped(pull, board=DEFAULT):
    """A merged PR counts only when its base is its repository's release branch.

    A stacked PR merged into a feature branch is still open work, not a ship.
    """
    if pull.get('state') != 'MERGED':
        return True
    release = release_branch(pull['repository']['nameWithOwner'], board)
    # A repo this board names no release branch for keeps the old reading, and so
    # does a cached pull read before this rule existed: re-reading the whole window
    # to refill one field would blow the run's GitHub budget, and every pull read
    # from now on carries its base.
    return release is None or pull.get('baseRefName') in (None, release)


# The three ways GitHub writes a revert. One merged revert undoes one merged PR.
REVERT_TITLE = re.compile(r'^[ \t]*Revert[ \t]+"(.+)"[ \t]*(?:\(#\d+\))?[ \t]*$', re.I)
REVERT_NUMBER = re.compile(r'^[ \t]*Reverts?[ \t]+(?:[\w.-]+/[\w.-]+)?#(\d+)[ \t]*$', re.I | re.M)
REVERT_COMMIT = re.compile(r'^[ \t]*This reverts commit ([0-9a-f]{7,40})', re.I | re.M)
SQUASH_SUFFIX = re.compile(r'[ \t]*\(#\d+\)$')


def squashless(title):
    """A title without the ` (#123)` a squash merge appends to it."""
    return SQUASH_SUFFIX.sub('', title or '').strip()


def merge_commit(pull):
    commit = pull.get('mergeCommit') or {}
    return ((commit.get('oid') if isinstance(commit, dict) else commit) or '').lower()


def revert_markers(pull):
    """What one pull says it undoes: a quoted title, a `Reverts #n` line, or a commit."""
    repo = (pull.get('repository') or {}).get('nameWithOwner') or ''
    title, body = pull.get('title') or '', pull.get('body') or ''
    quoted = REVERT_TITLE.match(title)
    found = [('title', repo, squashless(quoted[1]))] if quoted else []
    found += [('number', repo, int(match[1])) for match in REVERT_NUMBER.finditer(body)]
    found += [('commit', repo, match[1].lower()) for match in REVERT_COMMIT.finditer(body)]
    return found


def undone_urls(pulls):
    """Every merged pull that is not a ship, by url: a revert, and what it reverts.

    #282 reverted #223 while its ticket's card still counted #223 as shipped, so
    the card planned review on one sync and Todo on the next. An undo is not a
    ship of the work, so it leaves the facts on every run, and the run that lands
    it also takes the reverted merge out.
    """
    merged = [p for p in pulls if p and p.get('state') == 'MERGED' and p.get('url')]
    gone = set()
    for pull in merged:
        markers = revert_markers(pull)
        if not markers:
            continue
        gone.add(pull['url'])
        for kind, repo, want in markers:
            for other in merged:
                if (other['url'] == pull['url'] or
                        (other.get('repository') or {}).get('nameWithOwner') != repo):
                    continue
                if kind == 'number' and other.get('number') == want:
                    gone.add(other['url'])
                elif kind == 'title' and squashless(other.get('title')) == want:
                    gone.add(other['url'])
                elif kind == 'commit' and merge_commit(other).startswith(want):
                    gone.add(other['url'])
    return gone


def undone(found, seen=()):
    """The pulls a board may trust as a ship: nothing a merged revert took back."""
    known = list(seen) + [pull for pulls in found.values() for pull in pulls]
    gone = undone_urls(known)
    if not gone:
        return found
    return {key: [p for p in pulls if p.get('url') not in gone] for key, pulls in found.items()}


def scan_window(board, kind, field, start, end):
    """Every PR of one kind in a date range. GitHub search shows 1,000 results at
    most, so a range over that is split until nothing can be hidden.
    """
    found, windows = [], [(start, end)]
    scope = search_scope(board)
    while windows:
        start, end = windows.pop()
        cursor = None
        while True:
            query = f'is:pr {kind} {scope} {field}:{start}..{end}'
            after = ',after:' + json.dumps(cursor) if cursor else ''
            result = json.loads(run('gh', 'api', 'graphql', '-f', 'query=query{search(query:' + json.dumps(query) +
                                    ',type:ISSUE,first:100' + after + '){issueCount pageInfo{hasNextPage endCursor} '
                                    'nodes{... on PullRequest{url title body headRefName state number mergedAt baseRefName '
                                    'mergeCommit{oid} repository{nameWithOwner}}}}}'))
            if result.get('errors'):
                raise ValueError('GitHub branch search errors')
            page = result['data']['search']
            if page['issueCount'] > 1000:
                if start == end:
                    raise ValueError('GitHub branch search exceeds daily limit')
                middle = start + (end - start) // 2
                windows.extend([(start, middle), (middle + timedelta(days=1), end)])
                break
            found += [pull for pull in page['nodes']
                      if pull and pull['state'] != 'CLOSED' and allowed_repository(pull, board)
                      and shipped(pull, board)]
            if not page['pageInfo']['hasNextPage']:
                break
            next_cursor = page['pageInfo']['endCursor']
            if not next_cursor or next_cursor == cursor:
                raise ValueError('invalid GitHub branch cursor')
            cursor = next_cursor
    return found


def allowed_repository(pull, board):
    repo = pull['repository']['nameWithOwner']
    if board.repos:
        return repo in dict(board.repos)
    return repo.split('/')[0] in ('valentinyeo', 'hypertask-ai')


def discover(keys, board=DEFAULT):
    """Every PR that ships each ticket, for a run that has no saved facts.

    One batched ticket search, one open sweep for the board, one branch lookup per
    silent ticket. Nothing here reads another board's PRs one ticket at a time.
    """
    valid = []
    for key in keys:
        try:
            ticket_index(key, board)
            valid.append(key)
        except ValueError:
            continue
    found = {key: [] for key in keys}
    found.update(ticket_pulls(valid, board))
    return found


def check_state(checks):
    if not checks:
        return 'missing'
    for check in checks:
        if check.get('status') not in (None, 'COMPLETED') or check.get('state') in ('PENDING', 'EXPECTED'):
            return 'running'
    return 'green' if all((c.get('conclusion') in ('SUCCESS', 'NEUTRAL', 'SKIPPED') if c.get('__typename') == 'CheckRun' or 'conclusion' in c else c.get('state') == 'SUCCESS') for c in checks) else 'red'


POLICY_FIELDS = '... on Blob{text}'
# The cache answers for a commit once, so this is only a miss marker.
UNREAD = object()


def cached_policy(repo, ref):
    """The policy saved for one commit, or UNREAD when this run must ask GitHub."""
    # Old entries used {} for both a missing policy and an existing empty one.
    cached = cache_read(f'policy-v2:{repo}@{ref}')
    if isinstance(cached, dict) and 'policy' in cached:
        return cached['policy']
    return UNREAD


def policy_query(refs):
    """One GraphQL query for many commits' policy files, whatever repo each is in.

    The file is read at the PR's base commit, because that is the policy the merge
    has to satisfy, and a commit's policy never changes.
    """
    fields = []
    for n, (repo, ref) in enumerate(refs):
        owner, name = repo.split('/')
        fields.append(f'p{n}:repository(owner:{json.dumps(owner)},name:{json.dumps(name)})'
                      f'{{object(expression:{json.dumps(f"{ref}:.verify/policy.json")}){{{POLICY_FIELDS}}}}}')
    return 'query{' + ' '.join(fields) + '}'


def read_policies(refs):
    """Cache the policy at many commits, one call per batch, and save what it finds.

    Best effort: an alias GitHub refuses is left uncached, so verifier_policy reads
    that one commit itself and fails on it alone instead of on its whole group.
    """
    cached = cache_read_all()
    pending = []
    for ref in dict.fromkeys(refs):
        entry = cached.get(f'policy-v2:{ref[0]}@{ref[1]}')
        if not (isinstance(entry, dict) and 'policy' in entry):
            pending.append(ref)
    updates = {}
    for offset in range(0, len(pending), POLICY_BATCH):
        batch = pending[offset:offset + POLICY_BATCH]
        try:
            result = json.loads(run('gh', 'api', 'graphql', '-f', 'query=' + policy_query(batch)))
        except (RateLimit, BudgetRefused):
            raise
        except (ValueError, KeyError, TypeError, OSError, RuntimeError, subprocess.SubprocessError):
            continue
        data = result.get('data') or {}
        for n, (repo, ref) in enumerate(batch):
            node = data.get(f'p{n}')
            if node is None:
                continue
            # No file, or not a blob at that path: this repo has no policy.
            text = (node.get('object') or {}).get('text')
            try:
                policy = None if text is None else json.loads(text)
            except ValueError:
                continue
            updates[f'policy-v2:{repo}@{ref}'] = {'policy': policy}
    cache_write_many(updates)


def verifier_policy(repo, ref):
    """The trusted base policy at one commit. A commit's policy never changes, so
    the answer, including a repo that has no policy, is cached on disk."""
    policy = cached_policy(repo, ref)
    if policy is not UNREAD:
        return policy
    read_policies([(repo, ref)])
    policy = cached_policy(repo, ref)
    if policy is UNREAD:
        raise ValueError(f'{repo}@{ref} policy unreadable')
    return policy


def pass_on_head(comments, head, author, repo, policy):
    """Use the same trusted base policy and verdict schema as verify-collect."""
    candidates = []
    for comment in comments:
        match = re.search(r'```verify-verdict\s*\n(.*?)\n```', comment.get('body', ''), re.S)
        login = comment['user']['login']
        if not match or login == author or login not in policy.get('verifiers', {}):
            continue
        verdict = json.loads(match[1])
        if verdict.get('head_sha') == head:
            candidates.append((comment['updated_at'], comment['id'], login, verdict))
    if not candidates:
        return False
    _, _, login, verdict = max(candidates)
    verifier = policy['verifiers'][login]
    author_family = policy.get('authors', {}).get(author)
    if (verdict.get('status') not in ('PASS', 'PASS+NOTES') or not author_family or
            not verifier.get('family') or verifier['family'] == author_family):
        return False
    match = re.fullmatch(r'https://github\.com/' + re.escape(repo) + r'/actions/runs/(\d+)', verdict.get('run_url', ''))
    if not match:
        return False
    workflow = json.loads(run('gh', 'api', f'repos/{repo}/actions/runs/{match[1]}'))
    if not (workflow['head_sha'] == head and workflow['status'] == 'completed' and
            workflow['conclusion'] == 'success' and workflow['path'] == verifier.get('workflow')):
        return False
    pages = json.loads(run('gh', 'api', '--paginate', '--slurp', f'repos/{repo}/actions/runs/{match[1]}/jobs?per_page=100'))
    jobs = [job for page in pages for job in page['jobs']]
    return bool(jobs) and all(job.get('runner_name', '').startswith('GitHub Actions') and
                              'self-hosted' not in job.get('labels', []) for job in jobs)


# A workflow run's jobs, read once however many of its checks are candidates.
PSTACK_JOBS = {}


def pstack_jobs(repo, run_id):
    """The jobs GitHub lists for one workflow run.

    A check run a workflow creates through the checks API is listed among that run's
    jobs with no runner and no labels at all, so a job only proves where it ran when
    GitHub reports a runner for it.
    """
    key = (repo, run_id)
    if key not in PSTACK_JOBS:
        pages = json.loads(run('gh', 'api', '--paginate', '--slurp',
                               f'repos/{repo}/actions/runs/{run_id}/jobs?per_page=100'))
        PSTACK_JOBS[key] = [job for page in pages for job in page['jobs']]
    return PSTACK_JOBS[key]


def self_hosted(job):
    """Positive evidence that this job ran on somebody's own machine."""
    runner = job.get('runner_name')
    return 'self-hosted' in (job.get('labels') or []) or bool(runner) and not runner.startswith('GitHub Actions')


def jobs_evidence(repo, run_id):
    """Where one finished workflow run's jobs ran, cached on disk for good.

    GitHub answers this only per run, so a merged PR's verifier evidence cost one
    call per sync. A finished run's jobs never change, so one call ever is enough.
    """
    key = f'jobs-v2:{repo}@{run_id}'
    cached = cache_read(key)
    if isinstance(cached, dict) and 'jobs' in cached and 'self_hosted' in cached:
        return cached
    jobs = pstack_jobs(repo, run_id)
    evidence = {'jobs': bool(jobs), 'self_hosted': any(self_hosted(job) for job in jobs)}
    cache_write(key, evidence)
    return evidence


# The check run each repo's own verifier workflow posts, one row per repo so no repo
# accepts another repo's verifier name. vstack's verifier answers as the `verifier` job
# of .github/workflows/pstack-sources.yml (VSTA-193, house delta
# github-actions-verifier in skills/pstack-diff/house.txt); every repo that runs the
# pstack verifier workflow posts `pstack-verifier`, so that name is the default and
# needs no row.
VERIFIER_CHECKS = {'valentinyeo/vstack': ('verifier',)}
PSTACK_VERIFIER_CHECK = 'pstack-verifier'


def verifier_check_names(repo):
    """The check run names that count as this repo's verifier, and no others."""
    return VERIFIER_CHECKS.get(repo, (PSTACK_VERIFIER_CHECK,))


def pstack_pass_on_head(checks, head, repo):
    names = verifier_check_names(repo)
    for check in checks:
        suite = check.get('checkSuite') or {}
        workflow = suite.get('workflowRun') or {}
        if (check.get('__typename') != 'CheckRun' or check.get('name') not in names or
                check.get('status') != 'COMPLETED' or check.get('conclusion') != 'SUCCESS' or
                (suite.get('commit') or {}).get('oid') != head or not workflow.get('databaseId')):
            continue
        evidence = jobs_evidence(repo, workflow['databaseId'])
        if evidence['jobs'] and not evidence['self_hosted']:
            return True
    return False


def pull_facts(pull, board=DEFAULT):
    """A product board needs only the state its search already returned; every other
    board reads checks, base and verifier verdicts in batches of its own.
    """
    if product_board(board):
        return Pull(pull['url'], pull['state'], '', False, moment(pull.get('mergedAt')))
    return read_pull(pull['repository']['nameWithOwner'], pull['number'])


PULL_FIELDS = '''url state mergedAt updatedAt headRefOid baseRefOid mergeable author{login}
 commits(last:1){nodes{commit{committedDate}}}
 statusCheckRollup{state contexts(first:100){pageInfo{hasNextPage} nodes{__typename
 ... on CheckRun{name status conclusion completedAt checkSuite{commit{oid} workflowRun{databaseId}}}
 ... on StatusContext{state}}}}
 comments(last:100){totalCount nodes{databaseId body updatedAt author{login}}}'''
# Open PRs never read verdicts, comments, or workflow runs; skipping checkSuite
# joins and comments lets a 50-PR GraphQL batch finish without timing out.
OPEN_PULL_FIELDS = '''url state mergedAt updatedAt headRefOid baseRefOid mergeable
 commits(last:1){nodes{commit{committedDate}}}
 statusCheckRollup{state contexts(first:100){pageInfo{hasNextPage} nodes{__typename
 ... on CheckRun{name status conclusion completedAt}
 ... on StatusContext{state}}}}'''
# PR facts read once per run, and refilled by the batched read.
PULLS = {}
# A PR or repository GitHub will not describe, so it costs one call a run, not one
# per ticket that points at it.
FAILED = {}
FAILED_REPOS = {}
# Per-prefetch batch state: search states for slim open reads, and an adaptive batch
# cap so a batch GitHub will not answer in time shrinks instead of failing.
PULL_LIMIT = [PULL_BATCH]
IN_PREFETCH = [False]
PULL_STATES = {}
ROLLUP_STATE = {'SUCCESS': 'green', 'PENDING': 'running', 'EXPECTED': 'running',
                'FAILURE': 'red', 'ERROR': 'red'}


def pull_query(refs, fields=PULL_FIELDS):
    """One GraphQL query for many PRs, whatever repository each sits in."""
    fields_out = []
    for n, (repo, number) in enumerate(refs):
        owner, name = repo.split('/')
        fields_out.append(f'p{n}:repository(owner:{json.dumps(owner)},name:{json.dumps(name)})'
                          f'{{pullRequest(number:{int(number)}){{{fields}}}}}')
    return 'query{' + ' '.join(fields_out) + '}'


def graphql_comments(node):
    comments = node.get('comments') or {}
    return ([{'user': {'login': (c.get('author') or {}).get('login') or ''},
              'body': c.get('body') or '', 'updated_at': c.get('updatedAt') or '',
              'id': c.get('databaseId')} for c in comments.get('nodes') or []],
            int(comments.get('totalCount') or 0))


def pull_mergeable(node):
    """Tri-state from GitHub: True, False, or None when GitHub did not say."""
    mergeable = node.get('mergeable')
    return None if mergeable in (None, 'UNKNOWN') else mergeable == 'MERGEABLE'


def pull_activity(node):
    """The newest moment one PR showed work: a push, a finished check, or a comment.

    GitHub's own `updatedAt` moves on a push, a comment and a review. A check run
    that finishes on an unchanged head moves no PR field we read, so its completion
    time is read beside it. None means this read carried no usable time.
    """
    moments = [moment(node.get('updatedAt'))]
    for row in ((node.get('commits') or {}).get('nodes') or ()):
        moments.append(moment(((row or {}).get('commit') or {}).get('committedDate')))
    rollup = node.get('statusCheckRollup') or {}
    for check in ((rollup.get('contexts') or {}).get('nodes') or ()):
        if isinstance(check, dict) and check.get('__typename') == 'CheckRun':
            moments.append(moment(check.get('completedAt')))
    found = [one for one in moments if one is not None]
    return max(found) if found else None


def pull_from_node(repo, number, node):
    """The same facts a PR read gives, from one GraphQL node."""
    rollup = node.get('statusCheckRollup') or {}
    contexts = rollup.get('contexts') or {}
    if (contexts.get('pageInfo') or {}).get('hasNextPage'):
        # Over a hundred checks: the nodes are partial, GitHub's own summary is not.
        checks = ROLLUP_STATE.get(rollup.get('state'), 'red')
    else:
        checks = check_state(contexts.get('nodes') or [])
    comments, total = graphql_comments(node)
    head = node['headRefOid']
    author = (node.get('author') or {}).get('login') or ''
    activity = pull_activity(node)
    if node['state'] != 'MERGED':
        # No rule reads a verdict on an open PR: its checks alone decide the card, so
        # an open PR never pays for its policy or its verifier run.
        return Pull(node['url'], node['state'], checks, False, moment(node.get('mergedAt')),
                    pull_mergeable(node), activity)
    policy = verifier_policy(repo, node['baseRefOid'])
    if policy is None:
        passed = pstack_pass_on_head(contexts.get('nodes') or [], head, repo)
    else:
        passed = pass_on_head(comments, head, author, repo, policy)
        if not passed and total > len(comments):
            # A verdict older than the newest hundred still counts; read them all.
            passed = pass_on_head(all_comments(repo, number), head, author, repo, policy)
    return Pull(node['url'], node['state'], checks, passed, moment(node.get('mergedAt')),
                pull_mergeable(node), activity)


def read_pull_group(refs, slim=False):
    """The one call, for a group small enough that GitHub answers every alias."""
    fields = OPEN_PULL_FIELDS if slim else PULL_FIELDS
    result = json.loads(run('gh', 'api', 'graphql', '-f', 'query=' + pull_query(refs, fields)))
    if result.get('errors') and not result.get('data'):
        raise ValueError('GitHub pull request errors')
    found = {}
    for n, (repo, number) in enumerate(refs):
        node = (result['data'].get(f'p{n}') or {}).get('pullRequest')
        if node is not None:
            found[(repo, number)] = node
    if len(refs) == 1 and not found:
        raise ValueError(f'{refs[0][0]}#{refs[0][1]} unreadable')
    if slim:
        # If an open PR merged between search and read, re-read that PR with full fields.
        merged_since = [ref for ref, node in found.items() if node.get('state') == 'MERGED']
        if merged_since:
            found.update(read_pull_group(merged_since, slim=False))
        return found
    # Every policy these PRs need, in one call per fifty commits. One PR pays the
    # same either way, so only a group shares the read. A miss here is filled in by
    # pull_from_node, so a repo the token cannot read still fails alone.
    policies = list(dict.fromkeys((repo, node['baseRefOid']) for (repo, _), node in found.items()
                                 if node.get('baseRefOid')))
    if len(policies) > 1:
        read_policies(policies)
    return found


def _read_pull_chunk(refs, slim=False):
    if not refs:
        return {}
    limit = PULL_LIMIT[0] if slim else min(PULL_LIMIT[0], MERGED_PULL_BATCH)
    if IN_PREFETCH[0] and len(refs) > limit:
        found = {}
        for offset in range(0, len(refs), limit):
            try:
                found.update(_read_pull_chunk(refs[offset:offset + limit], slim=slim))
            except (ValueError, KeyError, TypeError, OSError, RuntimeError, subprocess.SubprocessError):
                pass
        return found
    try:
        nodes = read_pull_group(refs, slim=slim)
    except RateLimit:
        raise
    except (ValueError, KeyError, TypeError, OSError, RuntimeError, subprocess.SubprocessError) as error:
        if len(refs) == 1:
            FAILED[refs[0]] = str(error)
            FAILED_REPOS[refs[0][0]] = str(error)
            raise
        middle = len(refs) // 2
        if IN_PREFETCH[0]:
            PULL_LIMIT[0] = min(PULL_LIMIT[0], middle)
        found = {}
        for half in (refs[:middle], refs[middle:]):
            try:
                found.update(_read_pull_chunk(half, slim=slim))
            except (ValueError, KeyError, TypeError, OSError, RuntimeError, subprocess.SubprocessError):
                pass
        return found
    found = {ref: pull_from_node(*ref, nodes[ref]) for ref in nodes}
    PULLS.update(found)
    return found


def read_pull_batch(refs):
    """Read many PRs per call. A batch GitHub refuses is split, so one repository
    the token cannot see never hides the forty-nine PRs beside it."""
    refs = [ref for ref in dict.fromkeys(refs) if ref not in FAILED and ref[0] not in FAILED_REPOS]
    if not refs:
        return {}
    if not IN_PREFETCH[0]:
        return _read_pull_chunk(refs, slim=False)
    open_refs = [ref for ref in refs if PULL_STATES.get(ref) == 'OPEN']
    other_refs = [ref for ref in refs if PULL_STATES.get(ref) != 'OPEN']
    found = {}
    if open_refs:
        found.update(_read_pull_chunk(open_refs, slim=True))
    if other_refs:
        found.update(_read_pull_chunk(other_refs, slim=False))
    return found


def read_pull(repo, number):
    key = (repo, number)
    if key not in PULLS:
        if key in FAILED or repo in FAILED_REPOS:
            raise ValueError(FAILED.get(key) or FAILED_REPOS[repo])
        read_pull_batch([key])
    if key not in PULLS:
        raise ValueError(f'{repo}#{number} unreadable')
    return PULLS[key]


def all_comments(repo, number):
    pages = json.loads(run('gh', 'api', '--paginate', '--slurp', f'repos/{repo}/issues/{number}/comments?per_page=100'))
    return [comment for page in pages for comment in page]


def read_product_pull(pull):
    """One PR's live state, for an apply preflight that must not trust a search.

    Never read on a dry run: board 15 takes its PR state from the search result
    it already paid for. The search names the repository, so a PR found in a
    second repo is read from that repo and not from the product one.
    """
    detail = json.loads(run('gh', 'pr', 'view', str(pull['number']), '--repo',
                            pull['repository']['nameWithOwner'], '--json', 'url,state'))
    return Pull(detail['url'], detail['state'], '', False)


def refreshed(pulls, board=DEFAULT):
    """The pulls an apply preflight acts on, re-read once each, and only when it writes."""
    if not product_board(board):
        return pulls
    return [{**pull, 'state': read_product_pull(pull).state} for pull in pulls]


def prefetch(pulls, board=DEFAULT, clear=True):
    """Read every PR once, a batch at a time. A failed read is retried and reported
    by collect, so it still prints UNKNOWN for its own ticket only.
    """
    if product_board(board):
        # The search result already carries the one fact these rules read.
        return

    def load(batch):
        try:
            read_pull_batch(batch)
        except (ValueError, KeyError, TypeError, OSError, RuntimeError, subprocess.SubprocessError):
            pass
    if clear:
        PULLS.clear()
        PSTACK_JOBS.clear()
    states = {}
    for found in pulls.values():
        for p in found:
            ref = (p['repository']['nameWithOwner'], p['number'])
            # Preserve MERGED over OPEN if both ever appeared for the same PR.
            if states.get(ref) != 'MERGED':
                states[ref] = p.get('state')
    refs = sorted(states)
    PULL_LIMIT[0] = PULL_BATCH
    IN_PREFETCH[0] = True
    PULL_STATES.clear()
    PULL_STATES.update(states)
    try:
        for n in range(0, len(refs), PULL_BATCH):
            load(refs[n:n + PULL_BATCH])
    finally:
        PULL_STATES.clear()
        IN_PREFETCH[0] = False
        PULL_LIMIT[0] = PULL_BATCH


def carries_label(task, name):
    """Trimmed and case-insensitive, the same way every label on this board is read."""
    wanted = name.strip().casefold()
    return any((label.get('name') or '').strip().casefold() == wanted
               for label in task.get('labels') or ())


def is_verification(task):
    """The board marks verification work with one label; nothing else makes it verification."""
    return carries_label(task, VERIFICATION)


def pr_idle(details, now):
    """This card's open PR showed nothing new for RED_PR_IDLE_SECONDS.

    A read that carried no activity time keeps the card where it is: an unknown is
    never an idle PR, because that would demote work somebody is still doing.
    """
    open_pulls = [p for p in details if p.state == 'OPEN']
    if not open_pulls:
        return False
    moments = [p.activity for p in open_pulls if p.activity is not None]
    return bool(moments) and now - max(moments) > RED_PR_IDLE_SECONDS


def collect(task, pulls, now, board=DEFAULT):
    ticket_index(task['ticketNumber'], board)
    alive = worker_alive(task['ticketNumber'], now, board)
    details = tuple(pull_facts(p, board) for p in pulls)
    return Facts(task['section'], now - stamp(task['updatedAt']), alive, details,
                 bool(task.get('waitingOnUserId')), bool(task.get('blockerCommentId')),
                 is_verification(task), column_entered(task),
                 False if product_board(board) else pr_idle(details, now))


def reconcile(task, facts, apply=False, board=DEFAULT, names=None, label=None):
    if str(task['projectId']) != str(board.id):
        raise ValueError(f'ticket outside board {board.id}')
    column, reason = target(facts, board, names)
    key = task['ticketNumber']
    if apply and board.id == 15 and label and not carries_label(task, label):
        # A label lead touches its own cards only: another lead's card, and an
        # unlabelled card, stay where they are.
        print(f'SKIP {key} | carries no {label!r} label; board 15 label sync leaves it alone',
              flush=True)
        return task['section']
    action = 'KEEP' if column == task['section'] else ('MOVE' if apply else 'PLAN')
    line = f'{action} {key} {task["section"]} -> {column} | {reason}'
    if action == 'MOVE':
        if board.id == 15:
            require_board15_agent(label)
        api('task', 'move', key, '--section', column)
        APPLIED[0] += 1
        # Only the column changes: owner and assignees are retained.
        run('hypertask', 'activity', 'add', key, *(['--text'] if board.id == 15 else []),
            f'fleet/reconcile: {reason}; {task["section"]} -> {column}.')
    print(line, flush=True)
    return column


def apply_plan(plans, limit, pulls, board=DEFAULT, names=None, label=None):
    if board.id == 15:
        limit = min(limit, 5)
    options = {} if board.id == BOARD else {'board': board}
    moves = [(task, facts) for task, facts in plans if target(facts, board, names)[0] != task['section']]
    if len(moves) > limit:
        # Moves backed by a live lease or PR go first; moves back to Todo go last.
        backlog = stage_column_map(board)[Stage.BACKLOG]
        moves.sort(key=lambda m: (target(m[1], board, names)[0] == backlog,
                                  int(ticket_index(m[0]['ticketNumber'], board))))
        for old, facts in moves[limit:]:
            column, reason = target(facts, board, names)
            print(f'DEFERRED {old["ticketNumber"]} {old["section"]} -> {column} | {reason}; over limit={limit}', flush=True)
        moves = moves[:limit]
    fresh_tasks = []
    for old, facts in moves:
        fresh = api('task', 'get', old['ticketNumber'])['tasks'][0]
        if fresh['section'] != old['section'] or fresh['updatedAt'] != old['updatedAt']:
            print(f'SKIP {old["ticketNumber"]} | ticket changed since preview', flush=True)
            continue
        if str(fresh['projectId']) != str(board.id) or fresh['section'] not in board.managed:
            raise ValueError('ticket no longer eligible')
        fresh_tasks.append((fresh, facts))
    PULLS.clear()
    PSTACK_JOBS.clear()
    ready = []
    for fresh, facts in fresh_tasks:
        latest = collect(fresh, refreshed(pulls[fresh['ticketNumber']], board), time.time(), **options)
        if target(latest, board, names) != target(facts, board, names):
            print(f'SKIP {fresh["ticketNumber"]} | facts changed since preview', flush=True)
            continue
        ready.append((fresh, latest))
    for task, facts in ready:
        current = api('task', 'get', task['ticketNumber'])['tasks'][0]
        if current['section'] != task['section'] or current['updatedAt'] != task['updatedAt']:
            print(f'SKIP {task["ticketNumber"]} | ticket changed during preflight', flush=True)
            continue
        final = collect(current, refreshed(pulls[current['ticketNumber']], board), time.time(), **options)
        if target(final, board, names) != target(facts, board, names):
            print(f'SKIP {task["ticketNumber"]} | facts changed during preflight', flush=True)
            continue
        reconcile(current, final, apply=True, names=names, label=label, **options)
    return 0


def lock_path(board=DEFAULT):
    name = 'reconcile.lock' if board == DEFAULT else f'reconcile-{board.id}.lock'
    return Path.home() / '.local/state/fleet' / name


def own_lock_path(board, kind, name):
    """Beside the board lock: reconcile-label-verification-backlog.lock."""
    path = lock_path(board)
    slug = re.sub(r'[^a-z0-9]+', '-', name.lower())
    return path.with_name(f'{path.name[:-len(".lock")]}-{kind}-{slug}.lock')


def label_lock_path(board, label):
    return own_lock_path(board, 'label', label)


def ticket_lock_path(board, ticket):
    return own_lock_path(board, 'ticket', ticket)


LOCK_WAIT_SECONDS = 180
LOCK_POLL_SECONDS = 0.1


def _lock_scope(board, label=None, ticket=None):
    own = f' ticket={ticket}' if ticket else (f' label={label}' if label else '')
    return f'board={board.id}{own}'


def _try_acquire_locks(board=DEFAULT, label=None, ticket=None):
    """One non-blocking try for the board lock and, when scoped, its own lock."""
    own = ticket or label
    path = lock_path(board)
    path.parent.mkdir(parents=True, exist_ok=True)
    handles = []
    try:
        handles.append(path.open('a'))
        fcntl.flock(handles[0], (fcntl.LOCK_SH if own else fcntl.LOCK_EX) | fcntl.LOCK_NB)
        if own:
            second = ticket_lock_path(board, ticket) if ticket else label_lock_path(board, label)
            handles.append(second.open('a'))
            fcntl.flock(handles[1], fcntl.LOCK_EX | fcntl.LOCK_NB)
        return handles
    except BlockingIOError:
        for handle in handles:
            handle.close()
        return None


def acquire_locks(board=DEFAULT, label=None, ticket=None, wait=0.0, poll=None):
    """Open handles, or None when another apply run still holds this board, label or ticket.

    A whole-board apply excludes every apply on the board. A label apply or a ticket
    apply shares the board lock and holds its own exclusive one, so two labels or
    two tickets apply at once while a whole-board apply still excludes them all.
    When `wait` is positive, poll until the lock frees or the deadline expires,
    printing one stderr line with the seconds waited.
    """
    handles = _try_acquire_locks(board, label, ticket)
    if handles is not None or wait <= 0:
        return handles
    step = LOCK_POLL_SECONDS if poll is None else poll
    began = time.monotonic()
    deadline = began + wait
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        time.sleep(min(step, remaining))
        handles = _try_acquire_locks(board, label, ticket)
        if handles is not None:
            waited = time.monotonic() - began
            print(f'reconcile: waited {waited:.1f}s for {_lock_scope(board, label, ticket)} lock',
                  file=sys.stderr, flush=True)
            return handles
    waited = time.monotonic() - began
    print(f'reconcile: waited {waited:.1f}s for {_lock_scope(board, label, ticket)} lock; still held',
          file=sys.stderr, flush=True)
    return None


def probe_budget():
    """Stop before reading anything when GitHub has nothing left to give."""
    try:
        resources = json.loads(run('gh', 'api', 'rate_limit'))['resources']
    except BudgetRefused:
        raise
    except (ValueError, KeyError, TypeError, OSError, RuntimeError, subprocess.SubprocessError):
        return
    spent = [r['reset'] for r in resources.values()
             if isinstance(r, dict) and r.get('remaining') == 0 and r.get('reset')]
    if any(isinstance(r, dict) and r.get('remaining') == 0 for r in resources.values()):
        raise RateLimit(format_reset(min(spent)) if spent else 'unknown')


CARD = {'board': None, 'ticket': None}


class Tee:
    """Everything a card sync prints, kept for its status record."""

    def __init__(self, streams):
        self.streams, self.parts = tuple(streams), []

    def write(self, text):
        self.parts.append(text)
        for stream in self.streams:
            stream.write(text)

    def flush(self):
        for stream in self.streams:
            stream.flush()

    def isatty(self):
        return False

    def text(self):
        return ''.join(self.parts)


def card_phase():
    return session.slug(os.environ.get('RECONCILE_CARD_PHASE') or '')


def worker_exit():
    """The worker's own exit code, when a lease ran one and recorded it."""
    raw = os.environ.get('RECONCILE_WORKER_EXIT')
    try:
        return int(raw) if raw is not None and raw.strip() else None
    except ValueError:
        return None


def nothing_ran():
    """A lease run that ended with plan-pick's 75 started no worker at all."""
    return worker_exit() == 75


def write_card_record(tee, code):
    """One status record per lease-synced card, in the hook's status store."""
    board, ticket, phase = CARD['board'], CARD['ticket'], card_phase()
    if not (board and ticket and phase):
        return
    where = Path.home()
    log = session.card_log_path(where, board, ticket, phase)
    log.parent.mkdir(parents=True, exist_ok=True)
    log.write_text(tee.text())
    moved, unknown, summary = session.parse_output(tee.text())
    ran = worker_exit()
    session.write_record(session.card_record_path(where, board, ticket, phase), {
        'at': time.time(), 'session_name': os.environ.get('SHIP_SESSION_NAME') or '',
        'board': board, 'label': None, 'ticket': ticket, 'phase': phase,
        'exit': int(code), 'worker_exit': ran,
        'worker_note': NOTHING_RAN if ran == 75 else None,
        'moved': moved, 'unknown': unknown,
        'summary_line': summary, 'log': str(log)})


def main():
    reset_github_count()
    tee = None
    if card_phase():
        tee = Tee((sys.stdout, sys.stderr))
        sys.stdout, sys.stderr = tee, tee
    code = 1
    try:
        try:
            code = board_run()
        except BudgetRefused as refused:
            # Over budget: skip this tick in one line. Nothing moved and no saved
            # fact was rewritten, so the next tick inside the budget carries on.
            print(budget_skip_line(refused), flush=True)
            code = 0
        except RateLimit as stop:
            # One line and a clean exit: a spent budget is not a failed run, and no move
            # from it may land. The timer must not show a red unit for it.
            moved = f'{APPLIED[0]} moves already applied before it' if APPLIED[0] else 'no moves applied'
            print(f'reconcile: GitHub rate limit; reset {stop.reset}; {moved}', flush=True)
            code = 0
        finally:
            print(github_summary(), file=sys.stderr, flush=True)
    finally:
        if tee is not None:
            sys.stdout, sys.stderr = tee.streams
            try:
                write_card_record(tee, code)
            except OSError:
                pass
    return code


def board_run():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--board', type=int,
                        help='Any board a project names; 2060 and 15 keep their own rules')
    parser.add_argument('--apply', action='store_true')
    parser.add_argument('--section', help='Restrict the dry run to one column')
    parser.add_argument('--label', help='Sync only tickets carrying this label')
    parser.add_argument('--ticket', help='Sync exactly one ticket, on the board it belongs to')
    parser.add_argument('--self-test', action='store_true')
    parser.add_argument('--limit', type=int, default=5, help='Maximum moves per apply run; default 5')
    args = parser.parse_args()
    if args.self_test:
        return subprocess.call([sys.executable, '-m', 'unittest', 'tests.test_hypertask_work'], cwd=Path(__file__).resolve().parents[2])
    if args.ticket:
        if not re.fullmatch(r'[A-Z][A-Z0-9]*-[1-9]\d*', args.ticket.upper()):
            parser.error('--ticket takes one ticket key')
        args.ticket = args.ticket.upper()
        if args.label or args.section:
            parser.error('--ticket syncs one ticket; it takes no --label or --section')
        if args.board is not None:
            parser.error('--ticket reads its board from the ticket')
    elif args.board is not None and args.board < 1:
        parser.error('--board must be a positive board id')
    if args.apply and args.section:
        parser.error('--section is read-only')
    if args.limit < 1:
        parser.error('--limit must be positive')
    if os.environ.get('RECONCILE_AUTO_DRY') and args.apply:
        # The dry switch of the lease sync: same reads, same plan, nothing moves.
        print('reconcile: RECONCILE_AUTO_DRY is set; --apply dropped, nothing moves',
              file=sys.stderr, flush=True)
        args.apply = False
    # Before any board read: a board read at runtime asks the CLI for its prefix.
    os.environ['PATH'] = f'{Path.home()}/.local/bin:' + os.environ.get('PATH', '')
    # Before any worker fact: a timer or a bare shell has no user bus to ask.
    session_bus()
    if args.ticket:
        # The ticket names its own board, so a card sync never needs a configured one.
        try:
            one = read_ticket(args.ticket)
            board = board_config(int(one['projectId']))
            ticket_index(one['ticketNumber'], board)
        except (ValueError, KeyError, TypeError, OSError, RuntimeError, subprocess.SubprocessError) as error:
            print(f'UNKNOWN {args.ticket} | {error}', flush=True)
            if card_phase():
                # A card sync that cannot read its ticket leaves a line for the owner.
                session.append_failure(Path.home(), {
                    'at': time.time(), 'board': None, 'label': None, 'ticket': args.ticket,
                    'session_name': os.environ.get('SHIP_SESSION_NAME') or '',
                    'summary': str(error), 'log': None})
            return 1
    else:
        board = board_config(args.board or BOARD)
    options = {} if board.id == BOARD else {'board': board}
    if args.apply and board.id == 15:
        require_board15_agent(args.label)
    if args.apply and not product_board(board) and (not os.environ.get('SHIP_SESSION_NAME') or session.is_person(os.environ['SHIP_SESSION_NAME'])):
        parser.error('--apply requires SHIP_SESSION_NAME for an agent login')
    # Dry runs write nothing to the board and take no board or label lock.
    # Apply runs serialize on the board/label/ticket lock, waiting up to the
    # deadline before skipping so overlapping chats finish instead of going stale.
    CARD.update(board=board.id, ticket=args.ticket)
    handles = []
    if args.apply:
        handles = acquire_locks(board, args.label, args.ticket, wait=LOCK_WAIT_SECONDS)
        if handles is None:
            print(f'SKIP {_lock_scope(board, args.label, args.ticket)} | reconciliation already running', flush=True)
            return 0
    with contextlib.ExitStack() as stack:
        for handle in handles:
            stack.enter_context(handle)
        if args.apply:
            # A spent budget can only fail slowly, one 403 per ticket. The rate_limit
            # call is free, so an --apply run checks before it reads anything. A
            # refusal unwinds to main(), which prints the one skip line and exits 0.
            with phase('budget'):
                probe_budget()
        with phase('tickets'):
            tasks = [one] if args.ticket else tickets(args.section, **options)
        with phase('sections'):
            sections = {t['section'] for t in tasks}
            if board.columns is not None:
                # A board read at runtime already listed its columns, empty ones too.
                sections |= board.columns
            elif not product_board(board):
                sections |= read_sections(board)
        if args.ticket:
            print(f'reconcile: ticket {args.ticket} on board {board.id}',
                  file=sys.stderr, flush=True)
        if args.label:
            # Before any GitHub lookup: a session's run pays only for its own tickets.
            kept = [t for t in tasks if carries_label(t, args.label)]
            print(f'reconcile: label {args.label!r} kept {len(kept)} of {len(tasks)} tickets',
                  file=sys.stderr, flush=True)
            tasks = kept
        names = {} if product_board(board) else stage_names(sections=sections)
        candidates = [t for t in tasks if t['section'] in board.managed]
        keys = [t['ticketNumber'] for t in candidates]
        saved = None if args.ticket else read_board_facts(board.id)
        probe_since = None
        refreshed = set(keys)
        quiet = bool(saved and saved_facts_usable(saved) and not args.ticket and keys)
        if quiet:
            probe_since = format_reset(time.time())
            items = probe_items(board, saved)
            if items is None:
                quiet, probe_since = False, None
        if not quiet:
            pulls = discover(keys, **options)
            with phase('pulls'):
                prefetch(pulls, **options)
        else:
            board_changed = board_task_changes(saved, candidates, keys)
            probed = tickets_from_probe(items, keys, board, saved)
            refreshed = rolling_refresh(saved, keys, board_changed | probed |
                                        alias_changed(saved, keys, board), time.time())
            pulls = discover_quiet(keys, saved=saved, probe_items=items,
                                   refresh=refreshed, **options)
            reading = {key: pulls[key] for key in refreshed if pulls.get(key)}
            if reading:
                with phase('pulls'):
                    prefetch(reading, clear=False, **options)
            print(f'reconcile: quiet sync; probe={len(items)} PR updates, '
                  f'refresh={len(refreshed)} tickets', file=sys.stderr, flush=True)
        with phase('column_entry'):
            if candidates:
                fill_section_changed(candidates, pulls, board)
        now, errors = time.time(), 0
        if product_board(board) and candidates:
            # One read for the whole board, before the loop. A failure here is not
            # per ticket, so it gets one line and no move rather than one per card.
            try:
                with phase('workers'):
                    product_workers(now)
            except (ValueError, KeyError, TypeError, OSError, RuntimeError, sqlite3.Error,
                    subprocess.SubprocessError) as error:
                print(f'reconcile: worker facts unreadable: {error}; nothing moved', flush=True)
                return 1
        plans = []
        with phase('facts'):
            for task in tasks:
                try:
                    if task['section'] not in board.managed:
                        facts = Facts(task['section'], now - stamp(task['updatedAt']),
                                      waiting=bool(task.get('waitingOnUserId')),
                                      blocked=bool(task.get('blockerCommentId')))
                    else:
                        facts = collect(task, pulls[task['ticketNumber']], now, **options)
                    reconcile(task, facts, names=names, label=args.label, **options)
                    plans.append((task, facts))
                except (ValueError, KeyError, TypeError, OSError, RuntimeError, subprocess.SubprocessError) as error:
                    errors += 1
                    print(f'UNKNOWN {task["ticketNumber"]} | {error}', flush=True)
        if os.environ.get('RECONCILE_TIMING'):
            print(timing_table(), file=sys.stderr, flush=True)
        print(f'{"PREVIEW" if args.apply else "DRY RUN"} board={board.id} tickets={len(tasks)} unknown={errors}', flush=True)
        # A label or section run reads a slice of the board, so it must not overwrite
        # the whole board's facts with a snapshot that only covers its own cards.
        scoped = bool(args.label or args.section)
        if not args.ticket and not scoped and not errors and candidates:
            write_board_facts(board.id, serialize_board_facts(board, candidates, pulls, time.time(),
                                                              probe_since=probe_since, saved=saved,
                                                              refreshed=refreshed))
        if args.apply and not errors:
            return apply_plan(plans, args.limit, pulls, names=names, label=args.label, **options)
        return bool(errors)


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (ValueError, KeyError, TypeError, OSError, RuntimeError, subprocess.SubprocessError) as error:
        sys.exit(f'fleet/reconcile: {error}')
