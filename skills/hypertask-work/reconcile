def stage_names(column=None, sections=()):
    """Resolve each stage against the column names this board actually shows."""
    present = set(sections) | ({column} if column else set())
    return {'Doing': 'Building' if 'Building' in present else 'Doing',
            'AI Review': 'Verifier' if 'Verifier' in present else 'AI Review'}


def read_sections(board=DEFAULT):
    try:
        value = api('project', 'sections', '--project', str(board.id))
        return {section['section_title'] for section in value.get('sections', [])}
    except (ValueError, KeyError, TypeError, OSError, RuntimeError, subprocess.SubprocessError):
        return set()


def product_board(board):
    """Board 15 runs the product's own rules and workers; every other board uses 2060's."""
    return board.id == 15


def session_bus(env=None):
    """The user session bus a headless chat does not always have.

    `systemctl --user` needs both paths, so a timer or a bare shell gets the
    usual ones filled in. The lease borrows this same helper for its card sync.
    """
    env = os.environ if env is None else env
    uid = os.getuid()
    env.setdefault('XDG_RUNTIME_DIR', f'/run/user/{uid}')
    env.setdefault('DBUS_SESSION_BUS_ADDRESS', f'unix:path=/run/user/{uid}/bus')
    return env


def board_rules(managed, protected):
    """2060's rule table with one board's own column sets in place of its two globals."""
    return ((lambda f: f.column in protected, None, 'protected column'),
            (lambda f: f.column not in managed, None, 'unknown column; kept')) + RULES[2:]


# Read once per run, so the same board object keys the process scan and its lease.
@lru_cache(maxsize=None)
def board_config(board_id):
    """Any board a project names: its own prefix and columns, 2060's safe rules.

    Only columns carrying a 2060 stage name can be moved between; every other
    column is protected, and a rule pointing at a column this board lacks keeps
    its ticket instead of inventing one.
    """
    if board_id in BOARDS:
        return BOARDS[board_id]
    project = api('project', 'show', str(board_id)).get('project') or {}
    prefix = (project.get('uniqueIdentifier') or '').strip().upper()
    if not prefix:
        raise ValueError(f'board {board_id} has no ticket prefix')
    columns = frozenset(section['section_title'] for section in project.get('sections') or ()
                        if section.get('section_title'))
    names = stage_names(sections=columns)
    managed = columns & frozenset({'Todo', 'Checks', VERIFICATION_BACKLOG,
                                   names['Doing'], names['AI Review']})
    protected = columns - managed
    return BoardConfig(board_id, prefix, managed, protected, board_rules(managed, protected),
                       columns=columns)


def target(facts, board=DEFAULT, names=None):
    names = names if names is not None else ({} if product_board(board) else
                                             stage_names(facts.column, board.columns or ()))
    for matches, column, reason in board.rules:
        if matches(facts):
            column = names.get(column, column) or facts.column
            if board.columns is not None and column not in board.columns:
                return facts.column, 'target column missing; kept'
            return column, reason


def stamp(value):
    if isinstance(value, (int, float)):
        return float(value)
    return datetime.fromisoformat(value.replace('Z', '+00:00')).timestamp()


def ticket_date(value):
    """Ticket creation date, or None when the board sent nothing usable."""
    try:
        return datetime.fromtimestamp(stamp(value), timezone.utc).date() if value else None
    except (TypeError, ValueError):
        return None


def pid_alive(pid):
    if not isinstance(pid, int) or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        # Zombies still answer kill(0), but no worker runs there.
        stat = Path(f'/proc/{pid}/stat')
        return not stat.exists() or stat.read_text().rsplit(')', 1)[1].split()[0] != 'Z'
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def live_lease(key, now, directory=None):
    path = (directory or LEASES) / (key + '.json')
    try:
        lease = json.loads(path.read_text())
    except FileNotFoundError:
        return False
    age = now - stamp(lease['last_beat'])
    if age >= 900:
        return False
    if lease['host'] != socket.gethostname():
        raise ValueError('lease belongs to another host; PID cannot be checked')
    started = stamp(lease['started'])
    return 0 <= age < 900 and started <= now and pid_alive(lease['pid'])


def process_chain(pid=None, directory=None):
    """This process and its parents. A brief that names a ticket is not that worker."""
    directory = directory or PROC
    chain, pid = set(), os.getpid() if pid is None else pid
    while pid and pid not in chain:
        chain.add(pid)
        try:
            fields = (directory / str(pid) / 'stat').read_text().rsplit(')', 1)[1].split()
            pid = int(fields[1])
        except (OSError, ValueError, IndexError):
            break
    return chain


def is_worker(argv):
    wrapper = None
    index = 0
    while index < len(argv):
        text = argv[index].strip().split()[0] if argv[index].strip() else ''
        name = Path(text).name
        if not text:
            index += 1
            continue
        if name in WRAPPERS and not text.startswith('-'):
            wrapper = name
            index += 1
            continue
        if text.startswith('-'):
            flag = text.split('=', 1)[0]
            if flag in VALUE_FLAGS.get(wrapper or '', ()) and '=' not in text and index + 1 < len(argv):
                nxt = argv[index + 1]
                if wrapper in SHELLS:
                    return any(is_worker(words) for words in shell_commands(nxt))
                if Path(nxt.strip().split()[0]).name in AGENTS:
                    return True
                index += 2
                continue
            index += 1
            continue
        if re.fullmatch(r'\d+[smhd]?', text) or re.fullmatch(r'[A-Za-z_]\w*=.*', text):
            index += 1
            continue
        if name in NON_WORKERS:
            return False
        if name == LEASE_TOOL:
            return lease_run(argv, index)
        return name in AGENTS
    return False


def shell_commands(text):
    """Each simple command inside a `shell -c` string, so `cd x && pi -p URL` still counts."""
    return [part.split() for part in SHELL_SEPARATOR.split(text)]


def lease_run(argv, index):
    """`lease KEY run -- COMMAND` is the wrapper the house rules start workers through."""
    words = [word.strip() for word in argv[index + 1:index + 4] if word.strip()]
    if not (len(words) >= 2 and words[1] == 'run' and KEY_WORD.fullmatch(words[0])):
        return False
    wrapped = [word.strip() for word in argv[index + 4:] if word.strip() and word.strip() != '--']
    return not wrapped or Path(wrapped[0]).name not in NON_WORKERS


def lease_roots(now, directory=None):
    """PIDs recorded on a fresh lease on this host."""
    directory = directory or LEASES
    host = socket.gethostname()
    roots = set()
    try:
        paths = list(directory.glob('*.json'))
    except OSError:
        return roots
    for path in paths:
        try:
            lease = json.loads(path.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        if lease.get('host') != host:
            continue
        if now - stamp(lease['last_beat']) >= 900:
            continue
        pid = lease.get('pid')
        if isinstance(pid, int) and pid > 0 and pid_alive(pid):
            roots.add(pid)
    return roots


def leased_process_tree(now, proc_dir=None, leases_dir=None):
    """A leased worker PID and every descendant; argv scan must not see them."""
    proc_dir = proc_dir or PROC
    roots = lease_roots(now, leases_dir)
    if not roots:
        return set()
    parent = {}
    try:
        entries = proc_dir.iterdir()
    except OSError:
        return set(roots)
    for entry in entries:
        if not entry.name.isdigit():
            continue
        pid = int(entry.name)
        try:
            fields = (entry / 'stat').read_text().rsplit(')', 1)[1].split()
            parent[pid] = int(fields[1])
        except (OSError, ValueError, IndexError):
            continue
    tree = set(roots)
    changed = True
    while changed:
        changed = False
        for pid, ppid in parent.items():
            if pid not in tree and ppid in tree:
                tree.add(pid)
                changed = True
    return tree


@lru_cache(maxsize=2)
def process_tickets(board=DEFAULT):
    """Fallback liveness for an agent CLI started without the lease wrapper.

    Word boundaries keep SOFT-27 out of SOFT-2730.
    """
    ignore = process_chain()
    leased = leased_process_tree(time.time())
    url = re.compile(r'https://app\.hypertask\.ai/detail/project-' + str(board.id) + r'/([1-9]\d*)(?!\w)')
    key = re.compile(r'(?<![\w-])' + re.escape(board.prefix) + r'-[1-9]\d*(?![\w-])', re.I)
    found = set()
    try:
        entries = sorted(PROC.iterdir())
    except OSError:
        return found
    for entry in entries:
        pid = int(entry.name) if entry.name.isdigit() else 0
        if not pid or pid in ignore or pid in leased:
            continue
        try:
            argv = [os.fsdecode(part) for part in (entry / 'cmdline').read_bytes().split(b'\0') if part]
        except OSError:
            continue
        if not argv or not is_worker(argv):
            continue
        line = ' '.join(argv)
        found |= {board.prefix + '-' + match[1] for match in url.finditer(line)}
        found |= {match[0].upper() for match in key.finditer(line)}
    return found


def worker_alive(key, now, board=DEFAULT):
    """A lease, a live command line, or a product worker proves a live worker."""
    if product_board(board):
        return (live_product_worker(key, now) or live_lease(key, now)
                or key.upper() in process_tickets(board))
    return live_lease(key, now) or key.upper() in process_tickets(board)


def worker_state_directory(slug, pid):
    environment = (PROC / str(pid) / 'environ').read_bytes().split(b'\0')
    for item in environment:
        if item.startswith(b'HT_AGENT_STATE_DIR='):
            return Path(os.fsdecode(item.split(b'=', 1)[1]))
    return Path.home() / '.local/state' / f'hypertask-{slug}'


@lru_cache(maxsize=1)
def product_workers(now):
    units = run('systemctl', '--user', 'list-units', '--all', '--plain', '--no-legend',
                'hypertask-agent-worker@*.service')
    live = set()
    for line in units.splitlines():
        parts = line.split()
        if not parts:
            continue
        unit = parts[0]
        match = re.fullmatch(r'hypertask-agent-worker@([\w.-]+)\.service', unit)
        if not match:
            raise ValueError('unrecognized product worker unit')
        properties = dict(line.split('=', 1) for line in run('systemctl', '--user', 'show', unit,
                          '--property=MainPID', '--property=ActiveState').splitlines() if '=' in line)
        pid = int(properties['MainPID'])
        if properties['ActiveState'] != 'active' or not pid_alive(pid):
            continue
        path = worker_state_directory(match[1], pid) / 'queue.sqlite3'
        try:
            with closing(sqlite3.connect(path.resolve().as_uri() + '?mode=ro', uri=True)) as db:
                rows = db.execute("""SELECT ticket,progress_at,started_at FROM deliveries
                    WHERE project_id=15 AND state IN ('claiming','launching','running')
                    AND ticket IS NOT NULL
                    AND (event IS NULL OR event NOT IN ('task.unassigned','chat.message'))""").fetchall()
        except sqlite3.Error as error:
            raise ValueError('product worker queue unavailable') from error
        for key, progress, started in rows:
            ticket_index(key, BOARDS[15])
            if 0 <= now - stamp(progress or started) < 900:
                live.add(key)
    return live


def live_product_worker(key, now):
    return key in product_workers(now)


