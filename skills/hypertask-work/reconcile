@dataclass(frozen=True)
class Pull:
    url: str
    state: str
    checks: str
    passed: bool
    merged_at: float | None = None


@dataclass(frozen=True)
class Facts:
    column: str
    age: float
    alive: bool = False
    pulls: tuple = ()
    waiting: bool = False
    blocked: bool = False
    verification: bool = False
    # When this card entered its column (`staleness.sectionChangedAt`), or None when unknown.
    column_entered: float | None = None


class Stage(Enum):
    BACKLOG = 'backlog'
    IN_PROGRESS = 'in_progress'
    CHECKS = 'checks'
    REVIEW = 'review'
    VERIFICATION = 'verification'
    PROTECTED = 'protected'
    UNMANAGED = 'unmanaged'


GRACE_SECONDS = 7200


