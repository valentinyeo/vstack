@dataclass(frozen=True)
class Pull:
    url: str
    state: str
    checks: str
    passed: bool


@dataclass(frozen=True)
class Facts:
    column: str
    age: float
    alive: bool = False
    pulls: tuple = ()
    waiting: bool = False
    blocked: bool = False
    verification: bool = False


# An open or merged PR is the true stage; a live worker comes after it.
RULES = (
    (lambda f: f.column in PROTECTED, None, 'protected column'),
    (lambda f: f.column not in MANAGED, None, 'unknown column; kept'),
    (lambda f: f.waiting or f.blocked, None, 'waiting or blocked; kept'),
    (lambda f: any(p.state == 'OPEN' and p.checks != 'green' for p in f.pulls), 'Checks', 'open PR checks running, red, or missing'),
    (lambda f: any(p.state == 'OPEN' for p in f.pulls), 'AI Review', 'open PR checks green; verifier or merge pending'),
    (lambda f: bool(f.pulls) and all(p.state == 'MERGED' and p.passed for p in f.pulls), 'AI Review', 'merged PR with PASS; live proof pending'),
    (lambda f: any(p.state == 'MERGED' for p in f.pulls), 'AI Review', 'merged PR missing PASS on current head'),
    (lambda f: f.alive, 'Doing', 'live worker: lease or process'),
    # A verification ticket rests in its own backlog, and only a labelled ticket belongs there.
    (lambda f: f.column == VERIFICATION_BACKLOG and not f.verification, 'Todo', 'not a verification ticket'),
    (lambda f: f.column == VERIFICATION_BACKLOG, None, 'verification backlog; kept'),
    (lambda f: f.column == 'Todo' and f.verification, VERIFICATION_BACKLOG, 'verification ticket'),
    (lambda f: f.age < 7200, None, 'touched within 2h'),
    (lambda f: True, 'Todo', 'no live worker and no PR'),
)


@dataclass(frozen=True)
