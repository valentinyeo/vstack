    id: int
    prefix: str
    managed: frozenset
    protected: frozenset
    rules: tuple
    repository: str | None = None
    # A board read at runtime carries its real column titles; a configured board
    # keeps None and lets each stage name resolve from the ticket's own column.
    columns: frozenset | None = None


