#!/usr/bin/env python3
"""Write worker leases. fleet/lease KEY run -- COMMAND beats until COMMAND ends."""
import argparse
import fcntl
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import time


def load(name, path):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    sys.modules[loader.name] = module
    loader.exec_module(module)
    return module


reconcile = load('fleet_reconcile', Path(__file__).with_name('reconcile'))
session = load('fleet_session', Path(__file__).with_name('session_login.py'))
wip = load('board_drain_wip_cap', Path(__file__).resolve().parents[1] / 'board-drain' / 'wip-cap')


def write(key, action, pid, directory=None, now=None):
    directory = directory or reconcile.LEASES
    now = time.time() if now is None else now
    directory.mkdir(parents=True, exist_ok=True)
    path = directory / (key + '.json')
    with (directory / (key + '.lock')).open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            old = json.loads(path.read_text())
        except FileNotFoundError:
            old = None
        mine = old and old['pid'] == pid and old['host'] == socket.gethostname()
        if action == 'end':
            if mine:
                path.unlink()
            return
        if old and not mine:
            if 0 <= now - reconcile.stamp(old['last_beat']) < 900 and (old['host'] != socket.gethostname() or reconcile.pid_alive(old['pid'])):
                raise ValueError('another live worker owns this lease')
        if action == 'beat' and not mine:
            raise ValueError('no matching lease to beat')
        if not reconcile.pid_alive(pid):
            raise ValueError('worker PID does not exist')
        lease = dict(pid=pid, host=socket.gethostname(), started=old['started'] if mine else now, last_beat=now)
        with tempfile.NamedTemporaryFile(mode='w', dir=directory, prefix=key + '.', delete=False) as temp:
            try:
                json.dump(lease, temp)
                temp.flush()
                os.fsync(temp.fileno())
                os.replace(temp.name, path)
            finally:
                Path(temp.name).unlink(missing_ok=True)


def take_card(key, name, token, env=None):
    """Assign the chat's agent to the ticket when it has no agent assignee.

    Leaves an existing agent assignee alone and never assigns a person. Any
    failure answers False: a lease never blocks and never fails on assignment.
    """
    env = dict(os.environ if env is None else env)
    try:
        token_value = Path(token).read_text().strip()
    except OSError:
        return False
    if not token_value:
        return False
    cli = shutil.which('hypertask')
    if cli is None:
        return False
    run_env = dict(env, HYPERTASKS_JWT_TOKEN=token_value, SHIP_SESSION_NAME=name)
    try:
        read = subprocess.run([cli, '--json', 'task', 'get', key], capture_output=True,
                              text=True, env=run_env, timeout=30, check=False)
        task = (json.loads(read.stdout or '{}').get('tasks') or [{}])[0]
        if any(isinstance(row, dict) and row.get('agent')
               for row in task.get('assignees') or ()):
            return False
        command = [cli, 'agent', 'take', key]
        if task.get('projectId'):
            command += ['--project', str(task['projectId'])]
        took = subprocess.run(command, capture_output=True, text=True, env=run_env,
                              timeout=30, check=False)
        return took.returncode == 0
    except (OSError, ValueError, subprocess.SubprocessError):
        return False


def spawn_card(command, env):
    """Start one card sync and return at once. Detached, silent, never waited on."""
    subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True, close_fds=True,
                     env=env, cwd=str(Path.home()))


LANE_WAITING = 'nothing ran, waiting for a lane'
# The card's start is refused, not its worker run: nothing runs and the chat must
# finish what is already in Checks and AI Review first (VSTA-206).
CAP_HELD = 'lease: {key} held: {line}'


def board_tasks(board_id):
    """The cards in this board's two busy columns, read through the CLI's board read."""
    board = reconcile.board_config(board_id)
    return [task for name in wip.BUSY for task in reconcile.tickets(section=name, board=board)]


def cap_refusal(key):
    """The line that refuses a start while the board is over cap, or None.

    Reads the card this run would start. A card already in a working column is a
    resume, and an urgent card may start first, so neither is refused. Any read
    that fails answers None: a board outage never stops a worker.
    """
    try:
        task = reconcile.read_ticket(key)
        if not wip.starts_work(task) or wip.urgent(task):
            return None
        board_id = int(task['projectId'])
    except wip.ERRORS as error:
        wip.warn_once(f'{key} read failed ({error})')
        return None
    over, cards, cap = wip.board_over_cap(board_id, board_tasks)
    return CAP_HELD.format(key=key, line=wip.held_line(board_id, cards, cap)) if over else None


def report(key, code):
    """One loud line on the worker's own exit, which a pipeline cannot hide.

    plan-pick exits 75 when every lane is used up and no worker ran (VSTA-182).
    The chat's launch command ends in `| tail`, so bash hands it tail's 0 and the
    run reads as a success. This line is the last one it prints, so `tail` shows
    it and the chat can no longer call a run that ran nothing started.
    """
    note = f': {LANE_WAITING}' if code == 75 else ''
    print(f'lease: {key} worker exited {code}{note}', file=sys.stderr, flush=True)


def sync_card(key, phase, env=None, worker_exit=None):
    """Sync this card on start and on end, as the chat's own login.

    The run is `reconcile --ticket KEY --apply --limit 1`, fully detached, and it
    writes its own status record. No login, no token, or no reconcile script
    starts nothing: a lease never blocks and never fails on a sync.
    """
    env = dict(os.environ if env is None else env)
    try:
        login = session.login_for_session(env)
        if login is None:
            return False
        name, token = login
        if not Path(token).is_file():
            return False
        script = Path(__file__).resolve().with_name('reconcile')
        if not script.is_file():
            return False
        reconcile.session_bus(env)
        env['HT_TOKEN'] = Path(token).read_text().strip()
        env['SHIP_SESSION_NAME'] = name
        env['RECONCILE_CARD_PHASE'] = phase
        if worker_exit is not None:
            env['RECONCILE_WORKER_EXIT'] = str(worker_exit)
        env.setdefault('GH_CALLER', 'lease:' + key)
        if phase == 'start':
            take_card(key, name, token, env)
        command = [sys.executable, str(script), '--ticket', key, '--apply', '--limit', '1']
        spawn_card(command, env)
        return True
    except (OSError, ValueError, KeyError, subprocess.SubprocessError):
        return False


def watch(key, pid):
    write(key, 'start', pid)
    sync_card(key, 'start')
    try:
        while reconcile.pid_alive(pid):
            write(key, 'beat', pid)
            time.sleep(60)
    finally:
        write(key, 'end', pid)
        sync_card(key, 'end')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('key')
    parser.add_argument('action', choices=('start', 'beat', 'end', 'watch', 'run'), default='start', nargs='?')
    parser.add_argument('--pid', type=int, default=os.getppid())
    args, command = parser.parse_known_args()
    if not re.fullmatch(r'[A-Z][A-Z0-9]*-\d+', args.key):
        parser.error('KEY must be a ticket key')
    if args.pid <= 0:
        parser.error('PID must be positive')
    if args.action == 'run':
        if command[:1] == ['--']:
            command = command[1:]
        if not command:
            parser.error('run requires -- COMMAND')
        refusal = cap_refusal(args.key)
        if refusal is not None:
            print(refusal, file=sys.stderr, flush=True)
            return 75
        child = subprocess.Popen(command)
        for signum in (signal.SIGTERM, signal.SIGINT):
            signal.signal(signum, lambda number, frame: child.send_signal(number))
        try:
            try:
                write(args.key, 'start', child.pid)
            except ValueError:
                if child.poll() is not None:
                    return child.returncode
                raise
            sync_card(args.key, 'start')
            while child.poll() is None:
                try:
                    write(args.key, 'beat', child.pid)
                except ValueError:
                    if child.poll() is not None:
                        return child.returncode
                    raise
                try:
                    child.wait(timeout=60)
                except subprocess.TimeoutExpired:
                    pass
            return child.returncode
        except BaseException:
            if child.poll() is None:
                child.terminate()
            child.wait()
            raise
        finally:
            write(args.key, 'end', child.pid)
            report(args.key, child.returncode)
            sync_card(args.key, 'end', worker_exit=child.returncode)
    if command:
        parser.error('unexpected arguments')
    if args.action == 'watch':
        try:
            watch(args.key, args.pid)
        except KeyboardInterrupt:
            return 0
    else:
        write(args.key, args.action, args.pid)
        if args.action in ('start', 'end'):
            sync_card(args.key, args.action)
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (ValueError, KeyError, OSError) as error:
        sys.exit(f'fleet/lease: {error}')
