#!/usr/bin/env python3
"""Write worker leases. fleet/lease KEY run -- COMMAND beats until COMMAND ends.

A run refuses to start in a shared checkout: a worker edits in a git worktree only.
It counts a start against the starting chat's own board label and nothing else
(VSTA-266).
"""
import argparse
import fcntl
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import signal
import socket
import subprocess
import sys
import tempfile
import time

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / 'scripts'))
from bin_path import local_bin


def load(name, path):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    sys.modules[loader.name] = module
    loader.exec_module(module)
    return module


reconcile = load('fleet_reconcile', Path(__file__).with_name('reconcile'))
session = load('fleet_session', Path(__file__).with_name('session_login.py'))
wip = load('board_drain_wip_cap', Path(__file__).resolve().parents[1] / 'board-drain' / 'wip-cap')
LOOP_STATE = Path(__file__).resolve().parents[1] / 'board-drain' / 'loop-state'
LOOP_ERRORS = (*wip.ERRORS, ImportError)
_loop_state = None


def loop_state():
    """The one owner of loop state, loaded on first use, the way the hook loads it."""
    global _loop_state
    if _loop_state is None:
        _loop_state = (sys.modules.get('board_drain_loop_state')
                       or load('board_drain_loop_state', LOOP_STATE))
    return _loop_state


def own_label():
    """The board label of the chat starting this worker, or '' when it cannot be read."""
    try:
        return loop_state().own_label()
    except LOOP_ERRORS:
        return ''


def chat_labels():
    """The labels chats here drain; a label outside these is no start's cap."""
    try:
        return loop_state().chat_labels()
    except LOOP_ERRORS:
        return frozenset()


def write(key, action, pid, directory=None, now=None):
    directory = directory or reconcile.LEASES
    now = time.time() if now is None else now
    directory.mkdir(parents=True, exist_ok=True)
    path = directory / (key + '.json')
    with (directory / (key + '.lock')).open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            old = json.loads(path.read_text())
        except FileNotFoundError:
            old = None
        mine = old and old['pid'] == pid and old['host'] == socket.gethostname()
        if action == 'end':
            if mine:
                path.unlink()
            return
        if old and not mine:
            # The same window live_lease reads: a beat ahead of `now` (a slow write,
            # or another reader's slower clock) still means a live owner (VSTA-257).
            if (reconcile.lease_fresh(now, old)
                    and (old['host'] != socket.gethostname()
                         or reconcile.pid_alive(old['pid']))):
                raise ValueError('another live worker owns this lease')
        if action == 'beat' and not mine:
            raise ValueError('no matching lease to beat')
        if not reconcile.pid_alive(pid):
            raise ValueError('worker PID does not exist')
        lease = dict(pid=pid, host=socket.gethostname(), started=old['started'] if mine else now, last_beat=now)
        with tempfile.NamedTemporaryFile(mode='w', dir=directory, prefix=key + '.', delete=False) as temp:
            try:
                json.dump(lease, temp)
                temp.flush()
                os.fsync(temp.fileno())
                os.replace(temp.name, path)
            finally:
                Path(temp.name).unlink(missing_ok=True)


SHIMS = 'worker-shims'


def board_cli(home=None):
    """The real `hypertask`, never a worker shim.

    A worker's PATH leads with `worker-shims` folders, and those shims wrap or refuse
    board commands (VSTA-165, VSTA-249). A shim asked for the board CLI answered
    nothing at all, so the assignment below vanished with no line and no error
    (VSTA-260). PATH outside those folders still wins, then this server's own copy.
    """
    for part in (os.environ.get('PATH') or '').split(os.pathsep):
        if not part or Path(part).name == SHIMS:
            continue
        candidate = Path(part) / 'hypertask'
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return str(candidate)
    local = local_bin(home) / 'hypertask'
    return str(local) if local.is_file() else None


def one_line(text):
    """The first non-empty line of a command's error, never a page of it."""
    for line in str(text or '').splitlines():
        if line.strip():
            return line.strip()
    return ''


def take_card(key, name, token, env=None):
    """Assign this chat's own agent to the ticket when nobody is assigned to it.

    A ticket with any assignee stays as it is: a person on it put themselves there and
    that is a manual override, and another agent already owns it otherwise. Answers the
    one plain line saying why the ticket is still unassigned, or '' when it was taken or
    rightly left alone. A lease never blocks and never fails on assignment.
    """
    env = dict(os.environ if env is None else env)
    try:
        token_value = Path(token).read_text().strip()
    except OSError:
        token_value = ''
    if not token_value:
        return UNASSIGNED.format(key=key, why='no agent login token to read')
    cli = board_cli()
    if cli is None:
        return UNASSIGNED.format(key=key, why='no hypertask CLI on this host')
    run_env = dict(env, HYPERTASKS_JWT_TOKEN=token_value, SHIP_SESSION_NAME=name)
    try:
        read = subprocess.run([cli, '--json', 'task', 'get', key], capture_output=True,
                              text=True, env=run_env, timeout=30, check=False)
        if read.returncode != 0:
            return UNASSIGNED.format(key=key, why=one_line(read.stderr) or 'ticket read failed')
        task = (json.loads(read.stdout or '{}').get('tasks') or [{}])[0]
        if task.get('assignees'):
            return ''
        command = [cli, 'agent', 'take', key]
        if task.get('projectId'):
            command += ['--project', str(task['projectId'])]
        took = subprocess.run(command, capture_output=True, text=True, env=run_env,
                              timeout=30, check=False)
        if took.returncode == 0:
            return ''
        return UNASSIGNED.format(key=key, why=one_line(took.stderr) or 'agent take failed')
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        return UNASSIGNED.format(key=key, why=str(error) or 'board call failed')


def spawn_card(command, env):
    """Start one card sync and return at once. Detached, silent, never waited on."""
    subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True, close_fds=True,
                     env=env, cwd=str(Path.home()))


LANE_WAITING = 'nothing ran, waiting for a lane'
# The assignment is a notice, never a gate: a ticket that stays unassigned gets one
# plain line and the worker still starts (VSTA-260).
UNASSIGNED = 'lease: {key} left unassigned: {why}'
NO_LOGIN = 'this chat has no agent login'
# The card's start is refused, not its worker run: nothing runs and the chat must
# ship one of its open tickets first (VSTA-206).
CAP_HELD = 'lease: {key} held: {line}'
# Other chats read the shared checkout live, so a worker never starts in one. The
# launch line's `cd` can fail and bash carries on in the shared checkout (VSTA-259).
SHARED = ('lease: refusing to run a worker in a shared checkout ({path} on {branch}); '
          'make a git worktree on a branch first')
NO_BRIEF = ('lease: refusing to run a worker in {path}, which is no git checkout and '
            'holds no brief.txt; make a git worktree on a branch first')
DEFAULT_BRANCHES = frozenset({'main', 'master'})
BRIEF = 'brief.txt'
GIT_TIMEOUT = 5


def board_tasks(board_id):
    """The cards in this board's working columns, read through the CLI's board read."""
    board = reconcile.board_config(board_id)
    return [task for name in wip.WORKING
            for task in reconcile.tickets(section=name, board=board)]


def cap_refusal(key):
    """The line that refuses a start while the starting chat's own label is at cap.

    A card carries every label its work touches, so only the starting chat's own
    label counts (`wip.cap_labels`, VSTA-266). Reads the card this run would start.
    A card already in a working column is a resume, and an urgent card may start
    first, so neither is refused. Any read that fails answers None: a board outage
    never stops a worker.
    """
    try:
        task = reconcile.read_ticket(key)
        if not wip.starts_work(task) or wip.urgent(task):
            return None
        board_id = int(task['projectId'])
        labels = wip.cap_labels(task, own_label(), chat_labels())
    except wip.ERRORS as error:
        wip.warn_once(f'{key} read failed ({error})')
        return None
    if not labels:
        return None
    line = wip.read_held(board_id, labels, board_tasks)
    return CAP_HELD.format(key=key, line=line) if line else None


def git_read(*args, cwd=None):
    """One git answer, or None when git cannot give one."""
    try:
        done = subprocess.run(['git', *args], cwd=cwd, capture_output=True, text=True,
                              timeout=GIT_TIMEOUT)
    except (OSError, subprocess.SubprocessError):
        return None
    return done.stdout.strip() if done.returncode == 0 else None


def checkout(path=None):
    """(top, branch, shared) for a launch directory, or None outside git.

    A checkout is shared when it is the repo's main worktree, or when its current
    branch is the branch that repo checks out by default. Anything git cannot answer
    reads as shared: a launch never proves itself a worktree.
    """
    here = str(path or os.getcwd())
    top = git_read('rev-parse', '--show-toplevel', cwd=here)
    if not top:
        return None
    branch = git_read('rev-parse', '--abbrev-ref', 'HEAD', cwd=here) or 'HEAD'
    common = git_read('rev-parse', '--git-common-dir', cwd=here)
    if common and not os.path.isabs(common):
        common = os.path.join(top, common)
    main = os.path.realpath(os.path.join(top, '.git'))
    linked = common is not None and os.path.realpath(common) != main
    return top, branch, not linked or branch in DEFAULT_BRANCHES


def shared_refusal(path=None):
    """The one line that refuses a launch in a shared checkout, or None.

    A linked worktree on a branch is the normal launch directory. A directory outside
    git is allowed only when it holds the brief a plan-pick launch reads.
    """
    here = str(path or os.getcwd())
    where = checkout(here)
    if where is None:
        return None if (Path(here) / BRIEF).is_file() else NO_BRIEF.format(path=here)
    top, branch, shared = where
    return SHARED.format(path=top, branch=branch) if shared else None


def report(key, code):
    """One loud line on the worker's own exit, which a pipeline cannot hide.

    plan-pick exits 75 when every lane is used up and no worker ran (VSTA-182).
    The chat's launch command ends in `| tail`, so bash hands it tail's 0 and the
    run reads as a success. This line is the last one it prints, so `tail` shows
    it and the chat can no longer call a run that ran nothing started.
    """
    note = f': {LANE_WAITING}' if code == 75 else ''
    print(f'lease: {key} worker exited {code}{note}', file=sys.stderr, flush=True)


def sync_card(key, phase, env=None, worker_exit=None):
    """Sync this card on start and on end, as the chat's own login.

    The run is `reconcile --ticket KEY --apply --limit 1`, fully detached, and it
    writes its own status record. No login, no token, or no reconcile script
    starts nothing: a lease never blocks and never fails on a sync.
    """
    env = dict(os.environ if env is None else env)
    try:
        name, token = session.login_for_session(env) or ('', None)
        if not token or not Path(token).is_file():
            if phase == 'start':
                print(UNASSIGNED.format(key=key, why=NO_LOGIN), file=sys.stderr, flush=True)
            return False
        script = Path(__file__).resolve().with_name('reconcile')
        if not script.is_file():
            return False
        reconcile.session_bus(env)
        env['HT_TOKEN'] = Path(token).read_text().strip()
        env['SHIP_SESSION_NAME'] = name
        env['RECONCILE_CARD_PHASE'] = phase
        if worker_exit is not None:
            env['RECONCILE_WORKER_EXIT'] = str(worker_exit)
        env.setdefault('GH_CALLER', 'lease:' + key)
        if phase == 'start':
            line = take_card(key, name, token, env)
            if line:
                print(line, file=sys.stderr, flush=True)
        command = [sys.executable, str(script), '--ticket', key, '--apply', '--limit', '1']
        spawn_card(command, env)
        return True
    except (OSError, ValueError, KeyError, subprocess.SubprocessError):
        return False


def watch(key, pid):
    write(key, 'start', pid)
    sync_card(key, 'start')
    try:
        while reconcile.pid_alive(pid):
            write(key, 'beat', pid)
            time.sleep(60)
    finally:
        write(key, 'end', pid)
        sync_card(key, 'end')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('key')
    parser.add_argument('action', choices=('start', 'beat', 'end', 'watch', 'run'), default='start', nargs='?')
    parser.add_argument('--pid', type=int, default=os.getppid())
    args, command = parser.parse_known_args()
    if not re.fullmatch(r'[A-Z][A-Z0-9]*-\d+', args.key):
        parser.error('KEY must be a ticket key')
    if args.pid <= 0:
        parser.error('PID must be positive')
    if args.action == 'run':
        if command[:1] == ['--']:
            command = command[1:]
        if not command:
            parser.error('run requires -- COMMAND')
        refusal = shared_refusal()
        if refusal is not None:
            print(refusal, file=sys.stderr, flush=True)
            return 2
        refusal = cap_refusal(args.key)
        if refusal is not None:
            print(refusal, file=sys.stderr, flush=True)
            return 75
        child = subprocess.Popen(command)
        for signum in (signal.SIGTERM, signal.SIGINT):
            signal.signal(signum, lambda number, frame: child.send_signal(number))
        try:
            try:
                write(args.key, 'start', child.pid)
            except ValueError:
                if child.poll() is not None:
                    return child.returncode
                raise
            sync_card(args.key, 'start')
            while child.poll() is None:
                try:
                    write(args.key, 'beat', child.pid)
                except ValueError:
                    if child.poll() is not None:
                        return child.returncode
                    raise
                try:
                    child.wait(timeout=60)
                except subprocess.TimeoutExpired:
                    pass
            return child.returncode
        except BaseException:
            if child.poll() is None:
                child.terminate()
            child.wait()
            raise
        finally:
            write(args.key, 'end', child.pid)
            report(args.key, child.returncode)
            sync_card(args.key, 'end', worker_exit=child.returncode)
    if command:
        parser.error('unexpected arguments')
    if args.action == 'watch':
        try:
            watch(args.key, args.pid)
        except KeyboardInterrupt:
            return 0
    else:
        write(args.key, args.action, args.pid)
        if args.action in ('start', 'end'):
            sync_card(args.key, args.action)
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (ValueError, KeyError, OSError) as error:
        sys.exit(f'fleet/lease: {error}')
