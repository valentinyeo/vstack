#!/usr/bin/env python3
"""File feedback about vstack on this board, under this chat's agent identity.

Usage:
  vstack-feedback "<want>" --why "<what it blocks>"
  vstack-feedback "<want>" --why "<why>" --label "Long Chat Handover" --label brain-medium \
      --fact "Chat: Demo Chat" --count

A repeat of the same title updates that open ticket with a count instead of filing a second
one, when `--count` is given. `--board` picks the board (default 13556).

A chat that board 13556 refuses, or an agent that is not a member of it, files through the
Vstack Maintainer login instead, and the ticket carries `Filed for: <chat name>`. A person's
login is never used, and no token is ever printed.
"""
import argparse
import html
import importlib.util
import json
import os
import re
import shutil
import subprocess
import sys
import time
import unicodedata
from pathlib import Path

BOARD = '13556'
LABEL = 'Vstack'
SEEN = re.compile(r'Seen (\d+) times')
DONE_WHEN = 'The request works in vstack.'
FALLBACK = 'Vstack Maintainer'
REFUSED = re.compile(
    r'access denied|not a member|not found|forbidden|unauthorized|\b40[134]\b', re.I)


class Refused(ValueError):
    """The board refused this login: not a member, unknown to it, or forbidden."""


def hypertask_binary():
    """The hypertask CLI on PATH, else the one this server installs in ~/.local/bin."""
    found = shutil.which('hypertask')
    if found:
        return found
    local = Path.home() / '.local' / 'bin' / 'hypertask'
    return str(local) if local.is_file() else None


def fallback_token(env):
    """The Vstack Maintainer agent token, or '' when this server has not got one."""
    session = load_session()
    path = session.token_path(session.home(env), FALLBACK)
    try:
        return path.read_text().strip()
    except OSError:
        return ''


def agent_tokens():
    """Every agent token on this server, longest first, so a redaction leaves no piece."""
    folder = Path.home() / '.config' / 'hypertask-agents' / 'credentials' / 'sessions'
    try:
        paths = list(folder.glob('*-agent-token'))
    except OSError:
        return []
    tokens = []
    for path in paths:
        try:
            token = path.read_text().strip()
        except OSError:
            continue
        if token:
            tokens.append(token)
    return sorted(tokens, key=len, reverse=True)


def redact(text, token):
    """The text with every agent token removed, never only the caller's."""
    for secret in sorted({token, *agent_tokens()}, key=len, reverse=True):
        if secret:
            text = text.replace(secret, '[redacted]')
    return text


def load_session():
    path = Path(__file__).resolve().parent.parent / 'hypertask-work' / 'session_login.py'
    spec = importlib.util.spec_from_file_location('session_login', path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def normalized(text):
    return ' '.join(unicodedata.normalize('NFKC', text).split()).casefold()


def ticket_url(number, board=BOARD):
    suffix = number.split('-', 1)[1] if '-' in number else number
    return f'https://app.hypertask.ai/detail/project-{board}/{suffix}'


def now_iso():
    return time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())


def description(title, why, facts, done, seen=None, now=None):
    """Ticket body in the parts the writing guard asks for: Problem, Fix, Done when, Risk, Decision."""
    parts = [
        '<p><strong>Problem</strong></p>',
        '<p>' + html.escape(why or 'No reason given.') + '</p>',
    ]
    if facts:
        parts.append('<ul>' + ''.join(
            '<li>' + html.escape(fact) + '</li>' for fact in facts) + '</ul>')
    if seen:
        parts.append('<p>Seen ' + str(seen) + ' times. Last at '
                     + html.escape(now or now_iso()) + '.</p>')
    parts.extend([
        '<p><strong>Fix</strong></p><p>' + html.escape(title) + '</p>',
        '<p><strong>Done when</strong></p><p>' + html.escape(done or DONE_WHEN) + '</p>',
        '<p><strong>Risk</strong></p><p>Worst case: duplicate or noisy tickets. Undo: archive.</p>',
        '<p><strong>Decision</strong></p><p>none</p>',
    ])
    return ''.join(parts)


class Client:
    def __init__(self, token, board=BOARD):
        self.token = token.strip()
        if not self.token:
            raise ValueError('agent token is empty')
        self.board = str(board)
        self.binary = hypertask_binary()
        if not self.binary:
            raise ValueError(
                'install hypertask on PATH or at ~/.local/bin/hypertask before using '
                'vstack-feedback')

    def call(self, *args):
        result = subprocess.run(
            [self.binary, '--token', self.token, '--json', *args],
            capture_output=True, text=True, timeout=60)
        try:
            data = json.loads(result.stdout)
        except ValueError:
            data = None
        if result.returncode or not isinstance(data, dict) or data.get('success') is False:
            reason = data.get('error') if isinstance(data, dict) else None
            detail = reason if isinstance(reason, str) and reason.strip() else (
                result.stderr or result.stdout)
            detail = redact(detail, self.token).strip()
            message = f'hypertask failed: {detail or "unknown"}'
            raise Refused(message) if REFUSED.search(detail) else ValueError(message)
        return data

    def open_titles(self, label):
        data = self.call(
            'task', 'list', '--project', self.board, '--labels', label, '--status', 'Normal')
        rows = data.get('tasks') or []
        by_title = {}
        for row in rows:
            if not isinstance(row, dict):
                continue
            title = row.get('title')
            ref = row.get('ticketNumber')
            if isinstance(title, str) and isinstance(ref, str):
                by_title[normalized(title)] = ref
        return by_title

    def current(self, ref):
        """The open ticket's description, so a repeat can raise its own count."""
        data = self.call('task', 'get', ref)
        rows = data.get('tasks') or []
        row = rows[0] if rows and isinstance(rows[0], dict) else {}
        return row.get('description') if isinstance(row.get('description'), str) else ''

    def create(self, title, body, labels):
        return self.call(
            'task', 'create', '--project', self.board, '--title', title,
            '--description', body, '--labels', ','.join(labels))

    def update_description(self, ref, body):
        return self.call('task', 'update', ref, '--description', body)


def seen_count(text):
    found = SEEN.search(text or '')
    try:
        return int(found.group(1)) if found else 1
    except ValueError:
        return 1


def resolve_login(env):
    """(chat name, token) for this chat's own login, or ('', '') when it has none."""
    login = load_session().login_for_session(env)
    if not login:
        return '', ''
    name, path = login
    if not path.is_file():
        raise ValueError(f'no agent token for {name}; run the session login flow first')
    return name, path.read_text().strip()


def file_with(client, title, why, facts, labels, board, done, count, now):
    """File, bump or report a duplicate, and return the line to print."""
    existing = client.open_titles(labels[0]).get(normalized(title))
    if existing:
        url = ticket_url(existing, board)
        if not count:
            return f'duplicate: open ticket already titled like this: {url}'
        seen = seen_count(client.current(existing)) + 1
        client.update_description(existing, description(
            title, why, facts, done, seen=seen, now=now))
        return f'bumped: {url} (seen {seen} times)'
    body = description(title, why, facts, done, seen=1 if count else None, now=now)
    task = client.create(title, body, labels).get('task') or {}
    ref = task.get('ticketNumber')
    if not isinstance(ref, str) or not ref:
        raise ValueError('ticket creation returned no number')
    return ticket_url(ref, board)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('want')
    parser.add_argument('--why', default='')
    parser.add_argument('--done', default='')
    parser.add_argument('--label', action='append', default=[],
                        help='ticket label; repeat for more than one')
    parser.add_argument('--board', default=BOARD, help='board id (default 13556)')
    parser.add_argument('--fact', action='append', default=[],
                        help='one fact line for the Problem list, like "Chat: Demo Chat"')
    parser.add_argument('--count', action='store_true',
                        help='a repeat of this title raises a count on the open ticket')
    parser.add_argument('--now', default='', help='the time a repeat shows, ISO 8601')
    args = parser.parse_args(argv)
    title = ' '.join(args.want.split())
    if not title:
        print('vstack-feedback: say what you want from vstack', file=sys.stderr)
        return 2
    why = ' '.join(args.why.split())
    facts = [' '.join(fact.split()) for fact in args.fact if fact.strip()]
    labels = [label.strip() for label in args.label if label.strip()] or [LABEL]
    board = str(args.board).strip() or BOARD
    try:
        name, token = resolve_login(os.environ)
    except ValueError as exc:
        print(f'vstack-feedback: {exc}', file=sys.stderr)
        return 2
    if not token:
        print('vstack-feedback: this chat has no agent token; never use a person token', file=sys.stderr)
        return 2
    try:
        print(file_with(Client(token, board), title, why, facts, labels, board,
                        args.done, args.count, args.now))
        return 0
    except Refused as exc:
        refused = exc
    except ValueError as exc:
        print(f'vstack-feedback: {exc}', file=sys.stderr)
        return 1
    spare = '' if name == FALLBACK or board != BOARD else fallback_token(os.environ)
    if not spare:
        print(f'vstack-feedback: {refused}', file=sys.stderr)
        return 1
    try:
        print(file_with(Client(spare, board), title, why,
                        facts + [f'Filed for: {name}'], labels, board,
                        args.done, args.count, args.now))
        return 0
    except ValueError as exc:
        print(f'vstack-feedback: board {board} refused {name} ({refused}) and the '
              f'{FALLBACK} login ({exc})', file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
