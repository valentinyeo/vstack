#!/usr/bin/env python3
"""Finish before starting: how many open tickets one agent label may hold (VSTA-206).

Valentin's rule, 2026-11-24: "finish before starting". Each agent owns at most 5
open tickets at a time, one worker each, and starts a new ticket only after one
ships. An agent's tickets are the cards carrying its label; a card is open while it
sits in Doing, Checks or AI Review. Done, Todo, Backlog and the waiting-on-Valentin
columns are not open. pstack's autopilot-full runs one owner per PR in parallel and
sets no WIP limit, so this is a house rule (house.txt id `wip-cap`).

One table holds the cap, keyed by agent label. `skills/board-drain/drain-check`
counts the board rows its tick already read and fails `over cap`;
`skills/hypertask-work/lease` reads the same board before it starts a worker and
refuses with exit 75.

Only the starting chat's own label counts against it, never a product label that
sits on most of a board's cards (VSTA-266).

A second table freezes new starts on a whole board while its review debt is over a
cap (VSTA-271): the cards in Checks and AI Review, every label.

A read that fails fails open with one warning line: a board outage must never stop
work.

  wip-cap --self-test
"""
import subprocess
import sys

WORKING = ('Doing', 'Building', 'Checks', 'AI Review')
WORKING_LABEL = 'Doing+Checks+AI Review'
_WORKING = frozenset(name.casefold() for name in WORKING)
# The columns a chat starts work from. A card already in a working column is a resume.
NOT_STARTED = frozenset({'todo', 'backlog', 'verification backlog'})
# Labels that classify work, never name a chat, so no cap counts against them.
GENERIC = frozenset({'bug', 'infra', 'verification', 'needs-design', 'triage', 'ci',
                     'agent feedback'})
GENERIC_PREFIX = 'brain-'
# One table: open tickets one agent label may hold, keyed by casefolded label name.
# None covers every label with no row of its own, so moving the fleet's cap is this
# one number.
CAPS = {None: 5, 'ht bugs': 10}
# A board's review-debt freeze: no new start while it holds more of these than its cap.
REVIEW_DEBT_CAPS = {13734: 10}
_REVIEWING = frozenset({'checks', 'ai review'})
# One table reads Hypertask priority: index 0 is No Priority, 1 Urgent, 2 High,
# 3 Medium, 4 Low. A smaller index is higher, so the rank below is urgent first and
# a card with no priority is last.
PRIORITY_RANKS = {'urgent': 0, 'high': 1, 'medium': 2, 'low': 3}
NONE_RANK = len(PRIORITY_RANKS)
ERRORS = (ValueError, KeyError, TypeError, OSError, RuntimeError, AttributeError,
          subprocess.SubprocessError)
_warned = set()


def name_of(label):
    """A label's name, whether the board sent a dict or a plain string."""
    if isinstance(label, dict):
        return str(label.get('name') or '').strip()
    return str(label or '').strip()


def section(task):
    return str(task.get('section') or '').strip().casefold()


def is_agent_label(name):
    """A label that names a chat, so the cap counts its cards."""
    folded = (name or '').strip().casefold()
    return bool(folded) and folded not in GENERIC and not folded.startswith(GENERIC_PREFIX)


def agent_labels(task):
    """The ticket's chat labels, one per label, in board order.

    A chat label only means "not one of GENERIC", so a product label lands here
    too. A cap reads `cap_labels` instead, which counts one chat's own label.
    """
    names, seen = [], set()
    for label in task.get('labels') or ():
        name = name_of(label)
        if not is_agent_label(name) or name.casefold() in seen:
            continue
        seen.add(name.casefold())
        names.append(name)
    return names


def carries(task, label):
    """Trimmed and case-insensitive, the way every label on the board is read."""
    wanted = (label or '').strip().casefold()
    return any(name_of(item).casefold() == wanted for item in task.get('labels') or ())


def own_labels(task, own):
    """The card's own copies of this label, one per label, generic or not.

    A label a chat armed with names that chat on its own board even when GENERIC
    lists it: a chat may drain a classification label like Triage (VSTA-291).
    """
    folded = (own or '').strip().casefold()
    names, seen = [], set()
    if not folded:
        return names
    for label in task.get('labels') or ():
        name = name_of(label)
        if name.casefold() != folded or name.casefold() in seen:
            continue
        seen.add(name.casefold())
        names.append(name)
    return names


def cap_labels(task, own='', known=None):
    """The labels a start counts against: the starting chat's own label only.

    The label a chat armed with always counts, even a GENERIC label or a brain-
    tier: it names that chat's board, so a card carrying it spends that chat's cap
    (VSTA-291). With `own` unreadable, a label counts only when a chat here drains
    it (`known`, casefolded), so a product label no chat drains never blocks a start.
    """
    if (own or '').strip():
        return own_labels(task, own)
    return [name for name in agent_labels(task) if name.casefold() in (known or frozenset())]


def cap_for(label):
    """The open tickets this agent label may hold."""
    return CAPS.get((label or '').strip().casefold(), CAPS[None])


def count(tasks, label):
    """The open tickets carrying this label: the working columns only."""
    return sum(1 for task in tasks or ()
               if section(task) in _WORKING and carries(task, label))


def at_cap(tasks, label):
    """(at_cap, count, cap): a start takes one more slot, so the cap itself is full."""
    cap = cap_for(label)
    cards = count(tasks, label)
    return cards >= cap, cards, cap


def rank(task):
    """Hypertask priority as a rank, urgent 0 and no priority last."""
    priority = task.get('priority')
    value, index = '', None
    if isinstance(priority, dict):
        value = str(priority.get('Priority_Value') or '')
        try:
            index = int(str(priority.get('priority_index') or '').strip())
        except (TypeError, ValueError):
            index = None
    elif priority is not None:
        value = str(priority)
    if index is not None:
        return index - 1 if 1 <= index <= 4 else NONE_RANK
    return PRIORITY_RANKS.get(value.strip().casefold(), NONE_RANK)


def urgent(task):
    """Hypertask priority urgent: the highest rank."""
    return rank(task) == 0


def starts_work(task):
    """True when the card waits in a not-started column, where a start takes a slot."""
    return section(task) in NOT_STARTED


def held_line(label, cards, cap):
    """The one sentence that names the full label and what to ship first."""
    return f'label {label} has {cards} open tickets in {WORKING_LABEL} (cap {cap}); ship one first'


def review_debt(board_tasks):
    """The board's review debt: its cards in Checks and AI Review, every label."""
    return sum(1 for task in board_tasks or () if section(task) in _REVIEWING)


def review_debt_cap(board_id):
    """This board's review-debt cap, or None when the board has no row."""
    try:
        return REVIEW_DEBT_CAPS.get(int(board_id))
    except (TypeError, ValueError):
        return None


def review_debt_over(board_id, board_tasks):
    """(cards, cap) while this board is over its review debt, else None."""
    cap = review_debt_cap(board_id)
    if cap is None:
        return None
    cards = review_debt(board_tasks)
    return (cards, cap) if cards > cap else None


def review_debt_held(board_id, board_tasks):
    """The one sentence the lease prints holding a start on this board, or None."""
    over = review_debt_over(board_id, board_tasks)
    if over is None:
        return None
    cards, cap = over
    return (f'board {board_id} review debt {cards} > {cap} (Checks + AI Review); '
            'ship or review first')


def warn_once(detail):
    """One line per run; a repeated failure in the same tick stays quiet."""
    if detail in _warned:
        return
    _warned.add(detail)
    print(f'wip-cap: {detail}; cap not enforced', file=sys.stderr, flush=True)


def read_held(board_id, labels, read):
    """The held line for the first of these labels at cap, or None.

    `read(board_id)` answers that board's cards. The lease passes the starting
    chat's own label through here (`cap_labels`); drain-check counts its tick's rows
    with `at_cap`. A read that fails answers None, so a board outage never stops a
    worker.
    """
    try:
        tasks = read(board_id)
        if tasks is None:
            raise ValueError('no board rows')
    except ERRORS as error:
        warn_once(f'board {board_id} read failed ({error})')
        return None
    for label in labels:
        over, cards, cap = at_cap(tasks, label)
        if over:
            return held_line(label, cards, cap)
    return None


def self_test():
    mine = [{'section': 'Doing'}, {'section': 'Checks'}, {'section': 'AI Review'},
            {'section': 'Todo'}, {'section': 'Done'}]
    rows = [dict(task, labels=[{'name': 'Vstack'}]) for task in mine]
    assert count(rows, 'Vstack') == 3, 'Doing, Checks and AI Review are open'
    assert count(rows, 'vstack') == 3, 'a label reads case-insensitively'
    assert count(rows, 'Other') == 0, 'another label owns other cards'
    assert at_cap(rows, 'Vstack') == (False, 3, 5), 'three open is fine'
    full = [{'section': 'Checks', 'labels': [{'name': 'Vstack'}]}] * 5
    assert at_cap(full, 'Vstack') == (True, 5, 5), 'five open is already full'
    assert cap_for('Vstack') == 5, 'a label with no row of its own takes the one cap'
    assert cap_for('HT Bugs') == 10, 'the HT Bugs chat may run 10 workers'
    assert urgent({'priority': {'priority_index': 1, 'Priority_Value': 'Urgent'}}), 'index 1'
    assert urgent({'priority': {'Priority_Value': 'Urgent'}}), 'the word'
    assert urgent({'priority': 'urgent'}), 'a plain word'
    assert not urgent({'priority': {'priority_index': 3, 'Priority_Value': 'Medium'}}), 'medium'
    assert not urgent({}), 'no priority'
    assert rank({'priority': {'priority_index': 0, 'Priority_Value': 'No Priority'}}) == NONE_RANK, \
        'index 0 is no priority, never urgent'
    assert rank({'priority': {'priority_index': 4, 'Priority_Value': 'Low'}}) == 3, 'index 4 is low'
    assert rank({'priority': {'priority_index': 2}}) == 1, 'the index alone names high'
    assert not urgent({'priority': {'priority_index': 0, 'Priority_Value': 'No Priority'}}), \
        'a no-priority card never starts first'
    assert starts_work({'section': 'Todo'}), 'Todo starts work'
    assert starts_work({'section': 'Backlog'}), 'a product backlog starts work'
    assert not starts_work({'section': 'Doing'}), 'Doing is a resume'
    assert not starts_work({'section': 'Checks'}), 'Checks is already started'
    assert agent_labels({'labels': [{'name': 'Vstack'}, {'name': 'Bug'},
                                    {'name': 'brain-light'}, {'name': 'vstack'}]}) == ['Vstack'], \
        'chat labels only, one per label'
    assert agent_labels({}) == [], 'a card with no label counts against nothing'
    shared = {'labels': [{'name': 'Multiprompt'}, {'name': 'Multi Bot Verification'}]}
    assert cap_labels(shared, 'Multi Bot Verification', {'multiprompt'}) == \
        ['Multi Bot Verification'], 'a start counts its own label only'
    assert cap_labels(shared, '', {'multi bot verification'}) == ['Multi Bot Verification'], \
        'with no own label, only a chat label counts'
    assert cap_labels({'labels': [{'name': 'Multiprompt'}]}, '', {'multi bot verification'}) == [], \
        'a product label alone counts against nothing'
    assert cap_labels(shared, 'Vstack', {'multi bot verification'}) == [], \
        'a label the card does not carry counts nothing'
    triage = {'labels': [{'name': 'Triage'}, {'name': 'brain-hard'}]}
    assert agent_labels(triage) == [], 'a generic label is not an agent label'
    assert cap_labels(triage, 'Triage', frozenset()) == ['Triage'], \
        'the label a chat armed with counts even when it is generic'
    assert cap_labels(triage, 'brain-hard', frozenset()) == ['brain-hard'], \
        'and so does a brain tier it armed with'

    def broken(_board_id):
        raise OSError('board unreadable')

    assert read_held(13556, ['Vstack'], broken) is None, 'a failed read fails open'
    assert read_held(13556, ['Vstack'], lambda _board: None) is None, 'no rows fails open'
    assert read_held(13556, ['Vstack'], lambda _board: rows) is None, 'under cap is not held'
    assert held_line('Vstack', 5, 5) == ('label Vstack has 5 open tickets in '
                                        'Doing+Checks+AI Review (cap 5); ship one first')
    debt = [{'section': 'Checks'}, {'section': 'AI Review'}]
    assert review_debt(debt * 5) == 10, 'Checks and AI Review are the debt, every label'
    assert review_debt([{'section': 'Doing'}, {'section': 'Todo'}]) == 0, 'other columns owe nothing'
    at_cap_debt = debt * 5
    over_cap_debt = at_cap_debt + [{'section': 'Checks'}]
    assert review_debt_cap(13734) == 10, 'board 13734 carries a review-debt cap'
    assert review_debt_cap('13734') == 10, 'a board id reads as text too'
    assert review_debt_cap(13556) is None, 'a board with no row is never frozen'
    assert review_debt_over(13556, over_cap_debt) is None, 'no row, no hold'
    assert review_debt_over(13734, at_cap_debt) is None, 'at the cap is not over'
    assert review_debt_over(13734, over_cap_debt) == (11, 10), 'one card over the cap is over'
    assert review_debt_held(13734, at_cap_debt) is None, 'a board at its cap holds nothing'
    assert review_debt_held(13734, over_cap_debt) == (
        'board 13734 review debt 11 > 10 (Checks + AI Review); ship or review first'), \
        'the held line names the board, the debt and the cap'
    print('wip-cap self-test ok')


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if argv == ['--self-test']:
        self_test()
        return 0
    print('usage: wip-cap --self-test', file=sys.stderr)
    return 2


if __name__ == '__main__':
    sys.exit(main())
