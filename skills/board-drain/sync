#!/usr/bin/env python3
"""Sync this chat's board view as its own login, and record the result for drain-check."""
import argparse
import hashlib
import importlib.machinery
import importlib.util
import os
import re
from pathlib import Path
import subprocess
import sys

HERE = Path(__file__).resolve().parent
RECONCILE = HERE.parent / 'hypertask-work' / 'reconcile'
BAD_WORDS = ('usage:', 'error:')
ERRORS = (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError)
# A tick over the gh budget is skipped, not failed: reconcile prints this one line
# and exits 0, and the watcher keeps watching.
SKIP_PREFIX = 'sync skipped:'
BOARD_TITLE = re.compile(r'^reconcile:\s+board\s+(\d+)\s+title=(.+)$')

loader = importlib.machinery.SourceFileLoader('board_drain_loop_state', str(HERE / 'loop-state'))
spec = importlib.util.spec_from_loader(loader.name, loader)
loop_state = importlib.util.module_from_spec(spec)
sys.modules[loader.name] = loop_state
loader.exec_module(loop_state)

BOARD_TITLES = {
    board_id: cfg.title
    for board_id, cfg in loop_state.reconcile.BOARDS.items()
    if getattr(cfg, 'title', '')
}
BOARD15_LEADS = frozenset(name.strip().casefold()
                          for name in loop_state.reconcile.BOARD15_LEADS)

# Before the reconcile steps: a worker `hypertask` shim earlier on PATH exits 3.
loop_state.ensure_cli_path()


def credentials_dir():
    return Path(os.environ.get('BOARD_DRAIN_CRED_DIR')
                or Path.home() / '.config/hypertask-agents/credentials/sessions')


def token_path(name):
    return credentials_dir() / (loop_state.slug(name) + '-agent-token')


def environment(name, own_token=False):
    """The reconcile runs as this chat: its token, and its own name in SHIP_SESSION_NAME."""
    env = dict(os.environ)
    if own_token or not env.get('HT_TOKEN'):
        try:
            env['HT_TOKEN'] = token_path(name).read_text().strip()
        except OSError as error:
            raise ValueError(f'no HT_TOKEN and no token file at {token_path(name)}') from error
        if not env['HT_TOKEN']:
            raise ValueError(f'the token file at {token_path(name)} is empty')
    if own_token or not env.get('SHIP_SESSION_NAME'):
        env['SHIP_SESSION_NAME'] = name
    return env


def caller(board, label):
    """The gh budget session for this board and label, short enough for the wrapper's 32 chars."""
    slug = re.sub(r'[^a-z0-9]', '-', label.lower())[:8]
    digest = hashlib.sha1(label.encode('utf-8')).hexdigest()[:4]
    return f'sync:{board}:{slug}-{digest}'


def with_caller(env, board, label):
    """Name this caller for the GitHub budget unless the environment already names one."""
    if not env.get('GH_CALLER'):
        env['GH_CALLER'] = caller(board, label)
    return env


def echo(text):
    if text and text.strip():
        print(text.rstrip('\n'))


def sync_skip_line(text):
    """The skip line reconcile printed, or '' when this run was no skip."""
    for line in (text or '').splitlines():
        if line.strip().startswith(SKIP_PREFIX):
            return line.strip()
    return ''


def board_title_from(text, board):
    """The board title reconcile reported on stderr, or '' when absent."""
    for line in (text or '').splitlines():
        match = BOARD_TITLE.match(line.strip())
        if match and int(match.group(1)) == board:
            return match.group(2).strip()
    return ''


def is_board_lead(board, label, name='', board_title=''):
    """True when this chat's label (or name) is the board's lead.

    Board 15 uses reconcile.BOARD15_LEADS (HT Product Lead / vcc), matching
    require_board15_agent. Every other board identifies its lead by matching the
    board's title (e.g. label 'Multi Bot' on board 13734 'Multi Bot', or label
    'Vstack' on board 13556 'Vstack').
    """
    folded_label = (label or '').strip().casefold()
    folded_name = (name or '').strip().casefold()
    if board == 15:
        return folded_label in BOARD15_LEADS or folded_name in BOARD15_LEADS
    title = (board_title or BOARD_TITLES.get(board) or '').strip().casefold()
    if not title:
        return False
    return folded_label == title or folded_name == title


def run_with_output(step, args, env):
    """Run one reconcile step: ('ok'|'skipped'|'failed', one-line reason, combined output).

    A refused gh budget is a skipped tick, not a failure: the apply step does not
    run after it, and only its one skip line is printed.
    """
    command = [sys.executable, str(RECONCILE), *args]
    done = subprocess.run(command, capture_output=True, text=True, env=env)
    text = '\n'.join(part for part in (done.stdout, done.stderr) if part)
    skipped = sync_skip_line(text)
    if skipped:
        return 'skipped', skipped, text
    echo(done.stdout)
    echo(done.stderr)
    lines = (done.stdout or '').splitlines() + (done.stderr or '').splitlines()
    offending = [line.strip() for line in lines
                 if any(bad in line.lower() for bad in BAD_WORDS)]
    if offending:
        return 'failed', f'{step} printed: {offending[0]}', text
    if done.returncode:
        return 'failed', f'{step} exited {done.returncode}', text
    return 'ok', '', text


def run(step, args, env):
    """Run one reconcile step: ('ok'|'skipped'|'failed', one-line reason)."""
    status, detail, _text = run_with_output(step, args, env)
    return status, detail


def steps(board, label, limit):
    base = ['--board', str(board), '--label', label]
    return ('preview', base), ('apply', [*base, '--apply', '--limit', str(limit)])


def unlabeled_steps(board, limit):
    base = ['--board', str(board), '--unlabeled']
    return (('unlabeled-preview', base),
            ('unlabeled-apply', [*base, '--apply', '--limit', str(limit)]))


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--board', type=int, required=True)
    parser.add_argument('--label', required=True)
    parser.add_argument('--name', required=True, help="This chat's Multibot name")
    parser.add_argument('--limit', type=int, default=5, help='Maximum moves per apply run; default 5')
    parser.add_argument('--own-token', action='store_true',
                        help='Use only this named chat token file, ignoring inherited identity')
    args = parser.parse_args(argv)
    if args.board < 1:
        parser.error('--board must be a positive board id')
    reason = None
    board_title = ''
    try:
        env = with_caller(environment(args.name, args.own_token), args.board, args.label)
        for step, step_args in steps(args.board, args.label, args.limit):
            status, detail, text = run_with_output(step, step_args, env)
            if not board_title:
                board_title = board_title_from(text, args.board)
            if status == 'skipped':
                # One line, then stop: the apply step would only be refused again.
                print(detail)
                record(args.name, True, detail, skipped=True)
                return 0
            if status == 'failed':
                reason = detail
                break
        if not reason and is_board_lead(args.board, args.label, args.name, board_title):
            for step, step_args in unlabeled_steps(args.board, args.limit):
                status, detail, _text = run_with_output(step, step_args, env)
                if status == 'skipped':
                    print(detail)
                    record(args.name, True, detail, skipped=True)
                    return 0
                if status == 'failed':
                    reason = detail
                    break
    except (*ERRORS, RuntimeError) as error:
        reason = str(error) or error.__class__.__name__
    if not reason:
        print('sync: ok')
        record(args.name, True, '')
        return 0
    print(f'sync: FAIL {reason}')
    record(args.name, False, reason)
    return 1


def record(name, ok, reason, skipped=False):
    try:
        loop_state.record_sync(name, ok, reason, skipped=skipped)
    except ERRORS as error:
        print(f'sync: could not record the result: {error}', file=sys.stderr)


if __name__ == '__main__':
    sys.exit(main())
