#!/usr/bin/env python3
"""Poll this chat's own board view, report changes, and keep running across cycles.

The watcher pulses into this chat's loop state on every poll. View changes, sync failures,
and quiet heartbeats send a prompt to its own Multibot tab, keeping the watcher alive.
If that wake is unavailable, exit so the tracked job wakes the chat. After a crash or hang,
the last pulse is the marker the chat's own hook reads to say "your watcher is dead: re-arm"
and push Valentin after 10 minutes (VSTA-151).
"""
import argparse
import contextlib
import importlib.machinery
import importlib.util
import io
import json
import math
import os
from pathlib import Path
import shutil
import subprocess
import sys
import time

HERE = Path(__file__).resolve().parent
# The harness ends a tracked background job at two hours, so the heartbeat lands inside it.
LIMIT = 7200
FAILURES = 3


def sibling(name, filename):
    """The module when this process already loaded it, else load it the way the tests do."""
    if name in sys.modules:
        return sys.modules[name]
    loader = importlib.machinery.SourceFileLoader(name, str(HERE / filename))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    sys.modules[loader.name] = module
    loader.exec_module(module)
    return module


# drain-check owns every read, every verdict and loop-state; nothing is copied here.
drain = sibling('board_drain_check', 'drain-check')
loop_state = drain.loop_state
# The watcher runs the tick's sync itself; the chat wakes on change or heartbeat.
sync = sibling('board_drain_sync', 'sync')


def window(seconds):
    """The heartbeat in its shortest honest unit: 7020 seconds reads as 2h."""
    if seconds >= 3600:
        return f'{math.ceil(seconds / 3600)}h'
    return f'{max(1, round(seconds / 60))}m'


def heartbeat_seconds(args):
    """Default is one poll short of the plan pace (capped at 2h), so the watcher ends first."""
    if args.heartbeat is not None:
        return args.heartbeat
    paced = min(loop_state.loop_interval(), LIMIT)
    return paced - args.every


def waiting_mark(task):
    return [task.get('waitingOnUserId'), task.get('blockerCommentId')]


def newest_id(comments):
    """The newest comment's id, by time, else the last one the API sent."""
    rows = [comment for comment in comments or () if isinstance(comment, dict)]
    if not rows:
        return None
    ranked = max(enumerate(rows), key=lambda pair: (drain.said(pair[1]) or 0, pair[0]))
    return ranked[1].get('id')


def snapshot(args, now):
    """One read of the view: each open ticket's state, plus drain-check's finding kinds."""
    view = drain.read_view(args, now)
    board, tickets = view['board'], {}
    for row in view['rows']:
        task = row['task']
        comments = row.get('comments') or []
        tickets[task['ticketNumber']] = {
            'column': task.get('section'),
            'waiting': waiting_mark(task),
            'answered': drain.answered(comments),
            'newest_comment': newest_id(comments),
            'stalled': task.get('section') in drain.DOING and not drain.alive(task, now, board),
        }
    return {'tickets': tickets,
            'findings': sorted({kind for kind, _ in view['findings']})}


def changes(before, after):
    """One line per difference, so the chat wakes knowing what moved and why."""
    lines, old, new = [], before['tickets'], after['tickets']
    for key in sorted(new):
        state = new[key]
        if key not in old:
            lines.append(f'changed: {key} new in {state["column"]}')
            continue
        was = old[key]
        if was['column'] != state['column']:
            lines.append(f'changed: {key} {was["column"]} -> {state["column"]}')
        if state['stalled'] and not was['stalled']:
            lines.append(f'changed: {key} worker died')
        elif was['stalled'] and not state['stalled']:
            lines.append(f'changed: {key} worker back')
        if state['answered'] and not was['answered']:
            lines.append(f'changed: {key} Valentin replied')
        elif was['newest_comment'] != state['newest_comment']:
            lines.append(f'changed: {key} new comment')
        if was['waiting'] != state['waiting']:
            mark = 'wait mark set' if state['waiting'] else 'wait mark cleared'
            lines.append(f'changed: {key} {mark}')
    for key in sorted(set(old) - set(new)):
        lines.append(f'changed: {key} gone')
    for kind in sorted(set(after['findings']) - set(before['findings'])):
        lines.append(f'changed: drain-check {kind}')
    for kind in sorted(set(before['findings']) - set(after['findings'])):
        lines.append(f'changed: drain-check {kind} cleared')
    return lines


def sync_reason(args):
    """Run this chat's own board sync: (one-line failure reason, one-line skip).

    A sync skipped over the gh budget is not a failure: its one line comes back in
    the second slot, and the watcher prints it and keeps watching.
    """
    quiet = io.StringIO()
    with contextlib.redirect_stdout(quiet), contextlib.redirect_stderr(quiet):
        code = sync.main(['--board', str(args.board), '--label', args.label,
                          '--name', args.name])
    record = sync.loop_state.sync_state(args.name) or {}
    skipped = (record.get('skipped') or {}).get('reason')
    if skipped:
        return None, skipped
    if code == 0:
        return None, None
    return record.get('reason') or f'sync exited {code}', None


def wake(lines):
    """Send a prompt only to this process's own tab; False means use the job-exit wake."""
    try:
        tab = os.environ.get('MULTIPROMPT_TAB')
        if not tab and os.environ.get('TMUX'):
            tab = subprocess.run(['tmux', 'display-message', '-p', '#S'],
                                 check=True, capture_output=True, text=True, timeout=5).stdout.strip()
        if not tab:
            return False
        sender = Path(shutil.which('mp-send') or Path.home() / '.multiprompt-runtime/mp-send')
        if not sender.is_file():
            return False
        # Run an executable sender as its own program: some senders are shell wrappers.
        command = [str(sender)] if os.access(sender, os.X_OK) else [sys.executable, str(sender)]
        matches = []
        for path in sorted((Path.home() / '.local/state/multiprompt/agent-host').glob('*.config.json')):
            try:
                config = json.loads(path.read_text())
            except (OSError, ValueError):
                continue
            if not isinstance(config, dict) or config.get('tmux') != tab:
                continue
            sid = config.get('sid')
            if not isinstance(sid, str) or not sid:
                continue
            matches.append(config)
        if not matches:
            return False
        config = next((config for config in matches if config.get('enabled')), matches[0])
        prompt = '; '.join(lines) + '; run drain-check'
        for attempt in range(2):
            if attempt:
                time.sleep(5)
            try:
                sent = subprocess.run(
                    command + ['--tmux', tab, 'claude', config['sid'], prompt],
                    capture_output=True, timeout=30)
                if sent.returncode == 0:
                    return True
                status, stderr = sent.returncode, sent.stderr
            except subprocess.TimeoutExpired as error:
                status, stderr = 'timeout', error.stderr
            last = (stderr or b'').decode(errors='replace').splitlines()
            print(f'wake: failed ({status}): {last[-1] if last else ""}', flush=True)
    except (OSError, subprocess.SubprocessError):
        pass
    return False


def follow(args, clock=time.time, sleep=time.sleep):
    """Poll and wake our own chat; exit 0 on wake failure or --cycles, 1 on API loss."""
    heartbeat, baseline, started, failures = heartbeat_seconds(args), None, clock(), 0
    every_sync = 0 if args.no_sync else args.sync_every
    synced = None
    reported = 0
    pending, last_wake = [], None
    max_cycles = getattr(args, 'cycles', 0) or 0
    while True:
        lines = []
        # The pulse comes first: a watcher that stops here is dead, and its last pulse says when.
        try:
            loop_state.beat(args.name, now=clock())
        except loop_state.ERRORS:
            pass
        # Before the snapshot, so a sync that moved a card is a change on this read.
        if every_sync and (synced is None or clock() - synced >= every_sync):
            synced = clock()
            reason, skipped = sync_reason(args)
            if skipped:
                # Over the gh budget: one line, then keep watching this tick.
                print(skipped, flush=True)
            elif reason:
                lines.append(f'changed: sync failed: {reason}')
        try:
            current = snapshot(args, clock())
        except drain.ERRORS as error:
            failures += 1
            if failures >= FAILURES:
                print(f'watch: FAIL {error}', flush=True)
                return 1
        else:
            failures = 0
            if baseline is None:
                baseline, started = current, clock()
            elif current != baseline:
                lines.extend(changes(baseline, current))
                baseline, started = current, clock()
            elif clock() - started >= heartbeat:
                lines.append(f'heartbeat: no change in {window(heartbeat)}')
                started = clock()
        if lines:
            for line in lines:
                print(line, flush=True)
                if line not in pending:
                    pending.append(line)
            reported += 1
        if pending and (last_wake is None or clock() - last_wake >= 60):
            if not wake(pending):
                return 0
            pending.clear()
            last_wake = clock()
        if max_cycles and reported >= max_cycles:
            return 0
        # Do not strand a coalesced wake until the next poll or heartbeat.
        left = heartbeat - (clock() - started)
        if pending:
            left = min(left, 60 - (clock() - last_wake))
        sleep(max(1, min(args.every, left)))


def once(args, clock):
    """The one snapshot, as JSON, for a live check or a test."""
    print(json.dumps(snapshot(args, clock()), indent=2, sort_keys=True))
    return 0


def main(argv=None, clock=time.time, sleep=time.sleep):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--board', type=int, required=True)
    parser.add_argument('--label', required=True)
    parser.add_argument('--name', required=True, help="This chat's Multibot name")
    parser.add_argument('--every', type=int, default=180, help='Seconds between polls; default 180')
    parser.add_argument('--heartbeat', type=int,
                        help='Seconds without a change before printing a heartbeat; default 2h minus one poll')
    parser.add_argument('--cycles', type=int, default=0,
                        help='Reported cycles before exiting; 0 (default) keeps polling until stopped')
    parser.add_argument('--sync-every', type=int, default=900,
                        help='Seconds between board syncs; default 900')
    parser.add_argument('--no-sync', action='store_true',
                        help='Never run or schedule the board sync, for tests')
    parser.add_argument('--fixture',
                        help='Read a JSON list of {"task", "comments"} instead of the API')
    parser.add_argument('--once', action='store_true',
                        help='Print one snapshot as JSON and exit, for a live check')
    args = parser.parse_args(argv)
    if args.board < 1:
        parser.error('--board must be a positive board id')
    if args.every < 1:
        parser.error('--every must be at least one second')
    if heartbeat_seconds(args) < 1:
        parser.error('--heartbeat must be at least one second')
    if args.cycles < 0:
        parser.error('--cycles must be zero or positive')
    if args.sync_every < 1:
        parser.error('--sync-every must be at least one second')
    try:
        if args.once:
            return once(args, clock)
        if not args.no_sync:
            loop_state.arm_timer(args.name, args.board, args.label)
        loop_state.record_watch(args.name, os.getpid(), now=clock(), every=args.every)
    except drain.ERRORS as error:
        print(f'watch: FAIL {error}')
        return 1
    try:
        return follow(args, clock, sleep)
    finally:
        # The chat wakes on this exit and starts a fresh watcher; until it does, the last
        # pulse is what reads as "watcher dead since" in this chat's own check (VSTA-151).
        try:
            loop_state.clear_watch(args.name, pid=os.getpid())
        except loop_state.ERRORS as error:
            print(f'watch: could not clear the watcher: {error}', file=sys.stderr)


if __name__ == '__main__':
    sys.exit(main())
