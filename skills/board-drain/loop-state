#!/usr/bin/env python3
"""Record, read and clear the state of a chat's own board drain loop.

One record per chat holds the armed loop, the last sync, and the watcher's pulse. Every
reader of "is anything going to wake this chat" goes through here, so drain-check, the
chat's own hook and the fleet report cannot disagree (VSTA-151).

    loop-state status --name <chat>    # 0 armed, 3 expires soon, 4 paused, 2 not armed or watcher dead
    loop-state pause --name <chat> [--until <ISO or 6h>] [--reason "<text>"]
    loop-state resume --name <chat>    # clears a pause; so does arm
    loop-state watcher --name <chat>   # one line: watcher ok / watcher dead since <time>
    loop-state notice --name <chat>    # one line: notice sent <time> (<via>) / notice not sent
    loop-state beat --name <chat>      # refresh this chat's heartbeat in the same loop record
"""
import argparse
import fcntl
from datetime import datetime, timezone
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import socket
import subprocess
import sys
import tempfile
import time

loader = importlib.machinery.SourceFileLoader(
    'fleet_reconcile', str(Path(__file__).resolve().parents[1] / 'hypertask-work' / 'reconcile'))
spec = importlib.util.spec_from_loader(loader.name, loader)
reconcile = importlib.util.module_from_spec(spec)
sys.modules[loader.name] = reconcile
loader.exec_module(reconcile)

AGENTS = frozenset({'claude', 'codex', 'pi', 'agy'})
NODES = frozenset({'node', 'nodejs'})
WEEK = 7 * 86400
SOON = 86400
SYNC_STALE = 45 * 60
PACER_FLOOR = 7200
# The watcher pulses every poll, so a pulse older than a few polls is a dead watcher.
DEFAULT_EVERY = 180
BEAT_FLOOR = 300
DEAD_NOTICE_AFTER = 10 * 60
# A paused chat was told to go idle, so it is neither armed nor nagged (VSTA-309).
PAUSED = 4
PAUSE_FIELDS = ('paused_at', 'paused_until', 'paused_reason')
DURATION = re.compile(r'^(\d+)([smhdw])$')
PAUSE_UNITS = {'s': 1, 'm': 60, 'h': 3600, 'd': 86400, 'w': WEEK}
PLAN_PICK = Path.home() / '.local/bin' / 'plan-pick'
ERRORS = (ValueError, KeyError, TypeError, OSError, subprocess.SubprocessError)


def iso(seconds):
    return datetime.fromtimestamp(seconds, timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')


def window(seconds):
    return f'{seconds // 86400}d{seconds % 86400 // 3600}h'


def state_dir():
    return Path(os.environ.get('BOARD_DRAIN_STATE_DIR') or Path.home() / '.local/state/board-drain')


def slug(name):
    value = re.sub(r'[^a-z0-9]+', '-', name.strip().lower()).strip('-')
    if not value:
        raise ValueError('--name needs letters or digits')
    return value


def state_path(name):
    return state_dir() / (slug(name) + '.json')


def cli_bin_dir():
    """The real CLI's home. A worker shim earlier on PATH exits 3, no board login."""
    return Path.home() / '.local/bin'


def ensure_cli_path():
    """Put the real CLI's directory first on PATH, once, when this host has it."""
    directory = str(cli_bin_dir())
    if not cli_bin_dir().is_dir():
        return
    entries = [entry for entry in os.environ.get('PATH', '').split(os.pathsep) if entry]
    if entries[:1] == [directory]:
        return
    kept = [entry for entry in entries if entry != directory]
    os.environ['PATH'] = os.pathsep.join([directory, *kept])


def command_line(pid):
    try:
        return [os.fsdecode(part) for part in
                (reconcile.PROC / str(pid) / 'cmdline').read_bytes().split(b'\0') if part]
    except OSError:
        return []


def agent_process(argv):
    """A chat program, and node only when it is running claude.

    `agy` is Antigravity's chat CLI, which runs under the agent host (VSTA-331).
    """
    if not argv:
        return False
    name = Path(argv[0]).name
    if name in AGENTS:
        return True
    return name in NODES and 'claude' in ' '.join(argv[1:]).lower()


def parent_pid(pid):
    try:
        fields = (reconcile.PROC / str(pid) / 'stat').read_text().rsplit(')', 1)[1].split()
        return int(fields[1])
    except (OSError, ValueError, IndexError):
        return None


def ancestors(start=None):
    """The processes above this one, nearest first."""
    pid, seen = (os.getppid() if start is None else start), []
    while pid and pid > 1 and pid not in seen:
        seen.append(pid)
        pid = parent_pid(pid)
    return seen


def owner_pid(start=None):
    """The nearest chat process above this one, so a new chat reads as a new owner."""
    for pid in ancestors(start):
        if agent_process(command_line(pid)):
            return pid
    return os.getppid()


def records():
    """Every chat's loop record in this state folder, readable ones only."""
    found = []
    try:
        paths = sorted(state_dir().glob('*.json'))
    except OSError:
        return found
    for path in paths:
        try:
            state = json.loads(path.read_text())
        except (OSError, ValueError):
            continue
        if isinstance(state, dict) and isinstance(state.get('name'), str) and state['name'].strip():
            found.append(state)
    return found


def chat_labels():
    """The board labels the chats recorded in this state folder drain, casefolded."""
    return frozenset(str(state.get('label')).strip().casefold() for state in records()
                     if isinstance(state.get('label'), str) and state['label'].strip())


def env_name(env=None):
    """This chat's own Multibot name from its environment, or ''.

    BOARD_DRAIN_NAME names the chat outright; otherwise its tab becomes a Multibot
    name through the roster, the same read `session_login` makes for the chat's
    login.
    """
    env = os.environ if env is None else env
    explicit = str(env.get('BOARD_DRAIN_NAME') or '').strip()
    if explicit:
        return explicit
    for key in reconcile.session.TAB_KEYS:
        here = str(env.get(key) or '').strip()
        if not here:
            continue
        try:
            name = reconcile.session.session_name(
                Path(env.get('HOME') or Path.home()), here)
        except ERRORS:
            name = ''
        if name:
            return name
    return ''


def own_record(env=None):
    """The loop record of the chat running this process, {} when it has none.

    Named first by the chat's own environment. A launch with no tab is found by the
    chat process above it: the record already holds that pid, so the lease started
    inside that chat reads the label the chat armed with (VSTA-266).
    """
    named = env_name(env)
    if named:
        state = stored(named)
        if isinstance(state.get('label'), str) and state['label'].strip():
            return state
    above = set(ancestors())
    mine = [state for state in records()
            if state.get('host') == socket.gethostname()
            and state.get('owner_pid') in above
            and isinstance(state.get('label'), str) and state['label'].strip()]
    if not mine:
        return {}
    return max(mine, key=lambda state: reconcile.moment(state.get('armed_at')) or 0.0)


def own_label(env=None):
    """The board label this chat drains, or '' when it cannot be read."""
    label = own_record(env).get('label')
    return label.strip() if isinstance(label, str) else ''


def stored(name):
    """The state file's object, {} when there is none or it is unreadable."""
    try:
        state = json.loads(state_path(name).read_text())
    except (OSError, TypeError, ValueError):
        return {}
    return state if isinstance(state, dict) else {}


def store(name, state, drop=()):
    """Merge only changed fields, atomically: the timer and chat write independently."""
    target = state_path(name)
    target.parent.mkdir(parents=True, exist_ok=True)
    directory = os.open(target.parent, os.O_RDONLY)
    temporary = None
    try:
        fcntl.flock(directory, fcntl.LOCK_EX)
        merged = {'name': name, **stored(name), **state}
        for key in drop:
            merged.pop(key, None)
        with tempfile.NamedTemporaryFile(mode='w', dir=target.parent, delete=False) as out:
            temporary = Path(out.name)
            out.write(json.dumps(merged, indent=2) + '\n')
        temporary.replace(target)
        return merged
    finally:
        if temporary:
            temporary.unlink(missing_ok=True)
        os.close(directory)


def record_watch(name, pid, now=None, every=None):
    """Record the watcher this chat leaves running, and its first pulse.

    The pulse is the marker the watcher leaves behind: whatever kills it, the chat's own
    hook reads the last pulse and knows when it died (VSTA-151).
    """
    moment = time.time() if now is None else now
    patch = {'watch_pid': int(pid), 'watch_started': iso(moment), 'watch_beat': iso(moment)}
    if every is not None:
        patch['watch_every'] = int(every)
    return store(name, patch, drop=('dead_notice',))


def beat(name, now=None):
    """The watcher's pulse, refreshed on every poll so a silence has a time on it."""
    moment = time.time() if now is None else now
    if not stored(name):
        return {}
    return store(name, {'watch_beat': iso(moment)})


def beat_limit(state):
    """How long a watcher may go quiet before it is dead: three polls, never under five minutes."""
    try:
        every = int(state.get('watch_every') or DEFAULT_EVERY)
    except (TypeError, ValueError):
        every = DEFAULT_EVERY
    return max(BEAT_FLOOR, 3 * max(1, every))


def watch_health(name, now=None):
    """('ok' | 'dead' | 'none', line) for this chat's watcher, judged by its last pulse.

    A watcher that exited, was killed with the chat process, or hung past its poll rhythm
    is dead, and the line names when it was last seen alive. A live recorded pid without a
    watch_beat yet (an older watcher running during an upgrade) counts as alive so upgrades
    never raise a fleet-wide false alarm. A loop that never recorded a watcher reads 'none':
    a chat whose recurring job is the loop (Codex) has no watcher.
    """
    moment = time.time() if now is None else now
    state = stored(name)
    pid = state.get('watch_pid')
    beat_at = None
    try:
        beat_at = reconcile.stamp(state['watch_beat'])
    except ERRORS:
        pass
    started_at = None
    try:
        started_at = reconcile.stamp(state['watch_started'])
    except ERRORS:
        pass
    seen = beat_at if beat_at is not None else started_at
    if pid is None and seen is None:
        return 'none', 'no watcher recorded'
    fresh = beat_at is not None and moment - beat_at <= beat_limit(state)
    unit_backed = bool(state.get('watch_unit'))
    if pid is not None and (unit_backed or reconcile.pid_alive(pid)) and (
            beat_at is None or fresh):
        return 'ok', 'watcher ok'
    since = iso(seen) if seen is not None else 'before this loop was armed'
    return 'dead', f'watcher dead since {since}'


def clear_watch(name, pid=None):
    """Drop only this watcher's pid, or clear unconditionally when no pid is given."""
    state = stored(name)
    if 'watch_pid' not in state or (pid is not None and state['watch_pid'] != pid):
        return state
    return store(name, {'watch_pid': None})


def dead_since(name, now=None):
    """(epoch, iso) when this chat's loop or watcher went dead, else (None, '')."""
    moment = time.time() if now is None else now
    state = stored(name)
    if not state:
        return None, ''
    if pause_state(name, moment):
        return None, ''
    kind, _line = watch_health(name, moment)
    if kind == 'dead':
        for key in ('watch_beat', 'watch_started'):
            try:
                seen = reconcile.stamp(state[key])
                return seen, iso(seen)
            except ERRORS:
                pass
        return None, 'before this loop was armed'
    code, line = status(name, moment)
    if code == 2 and line == 'not armed' and state.get('armed_at'):
        for key in ('watch_beat', 'watch_started'):
            try:
                seen = reconcile.stamp(state[key])
                return seen, iso(seen)
            except ERRORS:
                pass
        try:
            expires = reconcile.stamp(state['expires_at'])
            if moment >= expires:
                return expires, iso(expires)
        except ERRORS:
            pass
    return None, ''


def dead_notice(name):
    """The recorded dead-loop notice for this chat, or None when none is stored."""
    notice = stored(name).get('dead_notice')
    if isinstance(notice, dict) and notice.get('at') and notice.get('since'):
        return notice
    return None


def notice_sent_for(state, since):
    """True when Valentin was already notified for this dead spell."""
    notice = state.get('dead_notice') if isinstance(state, dict) else None
    return isinstance(notice, dict) and notice.get('since') == since and bool(notice.get('at'))


def record_dead_notice(name, since, via, now=None):
    """Record that Valentin was pushed once for this chat's current dead spell."""
    moment = time.time() if now is None else now
    record = {'at': iso(moment), 'since': since, 'via': via or ''}
    store(name, {'dead_notice': record})
    return record


def notice_status(name, now=None):
    """('sent' | 'pending' | 'none', line) for whether a dead-loop notice went out."""
    _epoch, since = dead_since(name, now)
    if not since:
        return 'none', 'no notice'
    state = stored(name)
    if notice_sent_for(state, since):
        notice = state['dead_notice']
        via = notice.get('via') or ''
        suffix = f' ({via})' if via else ''
        return 'sent', f'notice sent {notice["at"]}{suffix}'
    return 'pending', 'notice not sent'


def timer_unit(name):
    return f'board-sync@{slug(name)}.timer'


def watch_unit(name):
    return f'board-watch@{slug(name)}.service'


def bus_environment():
    runtime = f'/run/user/{os.getuid()}'
    return {'XDG_RUNTIME_DIR': runtime, 'DBUS_SESSION_BUS_ADDRESS': f'unix:path={runtime}/bus'}


def systemctl(*args):
    return subprocess.run(['systemctl', '--user', *args], capture_output=True, text=True,
                          timeout=30, env={**os.environ, **bus_environment()})


def systemd_user():
    try:
        return systemctl('show-environment').returncode == 0
    except ERRORS:
        return False


def timer_enabled(name):
    try:
        return systemctl('is-enabled', '--quiet', timer_unit(name)).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def unit_quote(value):
    """Quote systemd syntax, including specifiers; ExecStart also escapes dollars."""
    return '"' + str(value).replace('\\', '\\\\').replace('"', '\\"').replace(
        '%', '%%').replace('\n', '\\n').replace('\r', '\\r') + '"'


def write_unit(directory, filename, content):
    target = directory / filename
    if target.exists() and target.read_text() == content:
        return False
    with tempfile.NamedTemporaryFile(mode='w', dir=directory, delete=False) as out:
        temporary = Path(out.name)
        out.write(content)
    temporary.replace(target)
    return True


def prune_timers(name, now):
    for path in state_dir().glob('*.json'):
        if path == state_path(name):
            continue
        try:
            state = json.loads(path.read_text())
            if not isinstance(state, dict) or not isinstance(state.get('name'), str):
                continue
            other = state['name']
            unit = timer_unit(other)
            if path != state_path(other) or state.get('sync_timer') != unit:
                continue
            touched = [reconcile.stamp(state[key]) for key in
                       ('armed_at', 'watch_started', 'sync_timer_armed_at') if state.get(key)]
            # Scheduled syncs refresh mtime, but must never extend a dead chat's lease.
            last_chat = min(path.stat().st_mtime, max(touched)) if touched else path.stat().st_mtime
        except (OSError, ValueError, KeyError, TypeError):
            continue
        if now - last_chat > WEEK:
            systemctl('disable', '--now', unit).check_returncode()


def unit_environment():
    return {
        **bus_environment(),
        'PATH': f'{Path.home()}/.local/bin:/usr/local/bin:/usr/bin:/bin',
        'BOARD_DRAIN_STATE_DIR': str(state_dir().resolve()),
        'BOARD_DRAIN_CRED_DIR': str(Path(os.environ.get('BOARD_DRAIN_CRED_DIR') or
            Path.home() / '.config/hypertask-agents/credentials/sessions').resolve()),
    }


def arm_timer(name, board, label, now=None):
    """Converge only this chat's units, then disable abandoned chats' recorded timers."""
    moment = time.time() if now is None else now
    if board < 1:
        raise ValueError('--board must be positive')
    unit = timer_unit(name)
    config = Path(os.environ.get('XDG_CONFIG_HOME') or Path.home() / '.config')
    directory = config / 'systemd/user'
    directory.mkdir(parents=True, exist_ok=True)
    environment = unit_environment()
    command = ['/usr/bin/timeout', '600', sys.executable,
               str(Path(__file__).resolve().with_name('sync')), '--board', str(board),
               '--label', label, '--name', name, '--own-token']
    service = ('[Unit]\nDescription=Sync this chat board view\n\n[Service]\nType=oneshot\n'
               'TimeoutStartSec=610\n' +
               ''.join('Environment=' + unit_quote(f'{key}={value}') + '\n'
                       for key, value in environment.items()) +
               'ExecStart=' + ' '.join(unit_quote(arg.replace('$', '$$')) for arg in command) + '\n')
    timer = ('[Unit]\nDescription=Keep this chat board view synced\n\n[Timer]\n'
             'OnStartupSec=1min\nOnUnitActiveSec=15min\nRandomizedDelaySec=3min\n'
             'Unit=' + unit.removesuffix('.timer') + '.service\n\n[Install]\nWantedBy=timers.target\n')
    for filename, content in ((unit, timer), (unit.removesuffix('.timer') + '.service', service)):
        write_unit(directory, filename, content)
    # Retry reload even after a crash between replacing a unit and reloading it.
    systemctl('daemon-reload').check_returncode()
    systemctl('enable', '--now', unit).check_returncode()
    state = store(name, {'board': board, 'label': label, 'sync_timer': unit,
                         'sync_timer_armed_at': iso(moment)})
    prune_timers(name, moment)
    return state


def environment_line(key, value):
    text = str(value).replace('\\', '\\\\').replace('"', '\\"').replace('\n', ' ')
    return f'{key}="{text}"\n'


def watch_env(name):
    """This chat's watcher environment file, the one its unit reads on every start."""
    return state_dir().resolve() / f'watch-{slug(name)}.env'


def retarget_watch(name, tab):
    """Point this chat's watcher environment file at a new tab, so a unit restart keeps it.

    False means there was no file to rewrite.
    """
    target = watch_env(name)
    try:
        lines = target.read_text().splitlines()
    except OSError:
        return False
    kept = [line + '\n' for line in lines]
    wanted = environment_line('MULTIPROMPT_TAB', tab)
    current = [line for line in kept if line.startswith('MULTIPROMPT_TAB=')]
    if current == [wanted]:
        return True
    kept = [line for line in kept if not line.startswith('MULTIPROMPT_TAB=')] + [wanted]
    with tempfile.NamedTemporaryFile(mode='w', dir=target.parent, delete=False) as out:
        temporary = Path(out.name)
        out.write(''.join(kept))
    temporary.replace(target)
    return True


def arm_watch(name, board, label, watcher, every=DEFAULT_EVERY, environment=None, now=None):
    moment = time.time() if now is None else now
    if board < 1:
        raise ValueError('--board must be positive')
    unit = watch_unit(name)
    directory = Path(os.environ.get('XDG_CONFIG_HOME') or Path.home() / '.config') / 'systemd/user'
    directory.mkdir(parents=True, exist_ok=True)
    values = {
        **unit_environment(),
        'BOARD': board, 'LABEL': label, 'NAME': name, 'EVERY': int(every),
        **(environment or {}),
    }
    environment_file = watch_env(name)
    environment_file.parent.mkdir(parents=True, exist_ok=True)
    environment_file.write_text(''.join(environment_line(key, value)
                                       for key, value in values.items()))
    command = [sys.executable, str(watcher), '--detached',
               '--board', '${BOARD}', '--label', '${LABEL}', '--name', '${NAME}',
               '--every', '${EVERY}']
    service = ('[Unit]\nDescription=Board drain watcher %i\n\n[Service]\nType=simple\n'
               f'EnvironmentFile={state_dir().resolve()}/watch-%i.env\n'
               'ExecStart=' + ' '.join(unit_quote(arg) for arg in command) +
               '\nRestart=on-failure\nRestartSec=30\n')
    write_unit(directory, 'board-watch@.service', service)
    systemctl('daemon-reload').check_returncode()
    systemctl('restart', unit).check_returncode()
    return store(name, {'watch_unit': unit, 'watch_detached_at': iso(moment),
                        'board': board, 'label': label})


def loop_interval(timeout=20):
    """Seconds from plan-pick --loop-interval; PACER_FLOOR on any error or missing binary."""
    if not PLAN_PICK.is_file():
        return PACER_FLOOR
    try:
        done = subprocess.run([str(PLAN_PICK), '--loop-interval'],
                              capture_output=True, text=True, timeout=timeout, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return PACER_FLOOR
    if done.returncode != 0:
        return PACER_FLOOR
    parts = (done.stdout or '').strip().split(None, 1)
    if not parts:
        return PACER_FLOOR
    try:
        seconds = int(parts[0])
    except ValueError:
        return PACER_FLOOR
    return max(PACER_FLOOR, seconds)


def arm(name, every='2h', expires=None, job=None, now=None, board=None, label=None):
    """Record the armed loop, plus the board and label it drains when the chat passes them."""
    moment = time.time() if now is None else now
    expiry = reconcile.stamp(expires) if expires else moment + WEEK
    state = {'name': name, 'every': every, 'armed_at': iso(moment), 'expires_at': iso(expiry),
             'job': job, 'owner_pid': owner_pid(), 'host': socket.gethostname()}
    if board is not None:
        state['board'] = board
    if label is not None:
        state['label'] = label
    return store(name, state, drop=('dead_notice',) + PAUSE_FIELDS)


def stale_job(name, job, now=None):
    """One line naming the old loop job a fresh arm leaves running, else None.

    Session crons are stored nowhere on disk, so a chat that re-arms after a restart
    cannot count its old loops; Hypertask Reconciler reached six at once (VSTA-318).
    """
    if not job:
        return None
    state = stored(name)
    old = state.get('job')
    if not old or old == job:
        return None
    moment = time.time() if now is None else now
    try:
        if moment >= reconcile.stamp(state['expires_at']):
            return None
    except ERRORS:
        return None
    return f'loop-state: delete the old loop job {old} (CronDelete) so only {job} runs'


def interval_seconds(text):
    value = str(text or '').strip().lower()
    match = DURATION.match(value)
    if match:
        return int(match.group(1)) * PAUSE_UNITS[match.group(2)]
    try:
        return int(value)
    except ValueError:
        return None


def arm_refusal(name, every, now=None):
    """One line when a live watcher makes an under-2h loop interval a second idle wake.

    A chat with a live watcher already wakes on that watcher's change and on its 2h exit,
    so a shorter armed interval only spends quota (VSTA-317).
    """
    seconds = interval_seconds(every)
    if seconds is None or seconds >= PACER_FLOOR:
        return None
    kind, _line = watch_health(name, now)
    if kind != 'ok':
        return None
    return f'loop-state: a chat with a live watcher arms 2h or more; got {every}'


def until_moment(text, now=None):
    """Epoch seconds for an ISO time or a duration like 6h, 90m or 2d."""
    moment = time.time() if now is None else now
    seconds = interval_seconds(text)
    if seconds is not None:
        return moment + seconds
    return reconcile.stamp(text)


def pause(name, until=None, reason='', now=None):
    """Record that this chat was told to go idle, so no hook nags it to re-arm.

    No `until` means the pause holds until someone runs resume or arm.
    """
    moment = time.time() if now is None else now
    ends = iso(until_moment(until, moment)) if str(until or '').strip() else None
    return store(name, {'paused_at': iso(moment), 'paused_until': ends,
                        'paused_reason': str(reason or '').strip()},
                 drop=('dead_notice',))


def resume(name):
    """Clear this chat's pause, so its loop may be armed again from here."""
    if not any(field in stored(name) for field in PAUSE_FIELDS):
        return stored(name)
    return store(name, {}, drop=PAUSE_FIELDS)


def pause_state(name, now=None):
    """This chat's pause record, {} when it is not paused or its end time has passed."""
    moment = time.time() if now is None else now
    state = stored(name)
    if not state.get('paused_at'):
        return {}
    ends = state.get('paused_until')
    if ends:
        try:
            if moment >= reconcile.stamp(ends):
                return {}
        except ERRORS:
            return {}
    return state


def pause_line(state):
    """One line naming the pause and its reason, for status and drain-check."""
    ends = state.get('paused_until')
    head = f'paused until {ends}' if ends else 'paused until further notice'
    reason = str(state.get('paused_reason') or '').strip()
    return f'{head}: {reason}' if reason else head


def status(name, now=None):
    """(0 armed, 3 expires within a day, 4 paused, 2 not armed or watcher dead) with its line."""
    moment = time.time() if now is None else now
    pause = pause_state(name, moment)
    if pause:
        return PAUSED, pause_line(pause)
    state = stored(name)
    if not state:
        return 2, 'not armed'
    try:
        expires = reconcile.stamp(state['expires_at'])
        # A restarted chat has a new pid and host, so its old loop is gone.
        if state.get('host') != socket.gethostname():
            return 2, 'not armed'
        if not reconcile.pid_alive(state.get('owner_pid')):
            return 2, 'not armed'
    except ERRORS:
        return 2, 'not armed'
    # A cleared pulse is a watcher that exited without the chat re-arming; that silence
    # is the failure VSTA-151 was about, so it fails here instead of reading armed.
    kind, line = watch_health(name, moment)
    if kind == 'dead':
        return 2, line
    remaining = int(expires - moment)
    if remaining <= 0:
        return 2, 'not armed'
    return (3 if remaining < SOON else 0), (
        'expires soon (<24h): re-arm now' if remaining < SOON
        else f'armed, expires in {window(remaining)}')


def is_armed(name, now=None):
    """True when this chat's loop will wake it: armed, or expiring soon. A pause is not armed."""
    return status(name, now)[0] in (0, 3)


def record_sync(name, ok, reason, now=None, skipped=False):
    """Record this chat's last board sync. A record alone never arms the loop.

    A skipped sync (the chat is over its gh budget) is not a failure: it never reads
    as failed, and it does not refresh the clock either, so skips that outlast
    SYNC_STALE still read as a stale sync.
    """
    moment = time.time() if now is None else now
    if skipped:
        prior = sync_state(name) or {}
        record = {'at': prior.get('at'), 'ok': bool(prior.get('ok', True)), 'reason': '',
                  'skipped': {'at': iso(moment), 'reason': reason or ''}}
    else:
        record = {'at': iso(moment), 'ok': bool(ok), 'reason': reason or ''}
    store(name, {'last_sync': record})
    return record


def sync_state(name):
    """The last_sync this chat recorded, or None when it never recorded one."""
    record = stored(name).get('last_sync')
    return record if isinstance(record, dict) else None


def clear(name):
    state_path(name).unlink(missing_ok=True)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='command', required=True)
    for command in ('arm', 'status', 'clear', 'watch', 'watcher', 'beat', 'notice', 'timer',
                    'pause', 'resume'):
        sub = commands.add_parser(command)
        if command in ('watcher', 'beat', 'notice'):
            sub.add_argument('--name', required=True, help="This chat's Multibot name")
        else:
            sub.add_argument('--name', required=True)
        if command == 'timer':
            sub.add_argument('--board', type=int, required=True)
            sub.add_argument('--label', required=True)
        if command == 'watch':
            sub.add_argument('--pid', type=int, required=True, help='The watcher process id')
            sub.add_argument('--every', type=int, help='Seconds between the watcher\'s polls')
        if command == 'pause':
            sub.add_argument('--until', help='ISO time or a duration like 6h; default no end')
            sub.add_argument('--reason', default='', help='Why this chat is idle')
        if command == 'arm':
            sub.add_argument('--every', default='2h')
            sub.add_argument('--expires', help='ISO expiry; default is 7 days (recurring cron limit)')
            sub.add_argument('--job', help='The cron or job id this chat armed')
            sub.add_argument('--board', type=int, help='The board this loop drains')
            sub.add_argument('--label', help='The board label this loop drains')
    args = parser.parse_args(argv)
    try:
        if args.command == 'timer':
            state = arm_timer(args.name, args.board, args.label)
            print(f'enabled {state["sync_timer"]}')
            return 0
        if args.command == 'arm':
            refusal = arm_refusal(args.name, args.every)
            if refusal:
                print(refusal)
                return 2
            old_job = stale_job(args.name, args.job)
            state = arm(args.name, args.every, args.expires, args.job,
                        board=args.board, label=args.label)
            remaining = int(reconcile.stamp(state['expires_at']) - reconcile.stamp(state['armed_at']))
            print(f'armed, expires in {window(remaining)}')
            if old_job:
                print(old_job)
            return 0
        if args.command == 'clear':
            clear(args.name)
            print('cleared')
            return 0
        if args.command == 'pause':
            print(pause_line(pause(args.name, args.until, args.reason)))
            return 0
        if args.command == 'resume':
            resume(args.name)
            print('resumed')
            return 0
        if args.command == 'watch':
            state = record_watch(args.name, args.pid, every=args.every)
            print(f'watching, started {state["watch_started"]}')
            return 0
        if args.command == 'watcher':
            kind, line = watch_health(args.name)
            print(line)
            return 0 if kind == 'ok' else 1
        if args.command == 'beat':
            state = beat(args.name)
            if not state:
                print('not armed')
                return 2
            print(f'beat {state["watch_beat"]}')
            return 0
        if args.command == 'notice':
            kind, line = notice_status(args.name)
            print(line)
            return 0 if kind in ('sent', 'none') else 1
        code, text = status(args.name)
        print(text)
        return code
    except ERRORS as error:
        print(f'board-drain/loop-state: {error}', file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())
