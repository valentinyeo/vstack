#!/usr/bin/env python3
"""Record, read and clear the state of a chat's own board drain loop."""
import argparse
import fcntl
from datetime import datetime, timezone
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import socket
import subprocess
import sys
import tempfile
import time

loader = importlib.machinery.SourceFileLoader(
    'fleet_reconcile', str(Path(__file__).resolve().parents[1] / 'hypertask-work' / 'reconcile'))
spec = importlib.util.spec_from_loader(loader.name, loader)
reconcile = importlib.util.module_from_spec(spec)
sys.modules[loader.name] = reconcile
loader.exec_module(reconcile)

AGENTS = frozenset({'claude', 'codex', 'pi'})
NODES = frozenset({'node', 'nodejs'})
WEEK = 7 * 86400
SOON = 86400
SYNC_STALE = 45 * 60
PACER_FLOOR = 7200
PLAN_PICK = Path.home() / '.local/bin' / 'plan-pick'
ERRORS = (ValueError, KeyError, TypeError, OSError, subprocess.SubprocessError)


def iso(seconds):
    return datetime.fromtimestamp(seconds, timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')


def window(seconds):
    return f'{seconds // 86400}d{seconds % 86400 // 3600}h'


def state_dir():
    return Path(os.environ.get('BOARD_DRAIN_STATE_DIR') or Path.home() / '.local/state/board-drain')


def slug(name):
    value = re.sub(r'[^a-z0-9]+', '-', name.strip().lower()).strip('-')
    if not value:
        raise ValueError('--name needs letters or digits')
    return value


def state_path(name):
    return state_dir() / (slug(name) + '.json')


def cli_bin_dir():
    """The real CLI's home. A worker shim earlier on PATH exits 3, no board login."""
    return Path.home() / '.local/bin'


def ensure_cli_path():
    """Put the real CLI's directory first on PATH, once, when this host has it."""
    directory = str(cli_bin_dir())
    if not cli_bin_dir().is_dir():
        return
    entries = [entry for entry in os.environ.get('PATH', '').split(os.pathsep) if entry]
    if entries[:1] == [directory]:
        return
    kept = [entry for entry in entries if entry != directory]
    os.environ['PATH'] = os.pathsep.join([directory, *kept])


def command_line(pid):
    try:
        return [os.fsdecode(part) for part in
                (reconcile.PROC / str(pid) / 'cmdline').read_bytes().split(b'\0') if part]
    except OSError:
        return []


def agent_process(argv):
    """claude, codex or pi, and node only when it is running claude."""
    if not argv:
        return False
    name = Path(argv[0]).name
    if name in AGENTS:
        return True
    return name in NODES and 'claude' in ' '.join(argv[1:]).lower()


def parent_pid(pid):
    try:
        fields = (reconcile.PROC / str(pid) / 'stat').read_text().rsplit(')', 1)[1].split()
        return int(fields[1])
    except (OSError, ValueError, IndexError):
        return None


def owner_pid(start=None):
    """The nearest chat process above this one, so a new chat reads as a new owner."""
    pid, seen = os.getppid() if start is None else start, set()
    while pid and pid > 1 and pid not in seen:
        seen.add(pid)
        if agent_process(command_line(pid)):
            return pid
        pid = parent_pid(pid)
    return os.getppid()


def stored(name):
    """The state file's object, {} when there is none or it is unreadable."""
    try:
        state = json.loads(state_path(name).read_text())
    except (OSError, TypeError, ValueError):
        return {}
    return state if isinstance(state, dict) else {}


def store(name, state):
    """Merge only changed fields, atomically: the timer and chat write independently."""
    target = state_path(name)
    target.parent.mkdir(parents=True, exist_ok=True)
    directory = os.open(target.parent, os.O_RDONLY)
    temporary = None
    try:
        fcntl.flock(directory, fcntl.LOCK_EX)
        merged = {'name': name, **stored(name), **state}
        with tempfile.NamedTemporaryFile(mode='w', dir=target.parent, delete=False) as out:
            temporary = Path(out.name)
            out.write(json.dumps(merged, indent=2) + '\n')
        temporary.replace(target)
        return merged
    finally:
        if temporary:
            temporary.unlink(missing_ok=True)
        os.close(directory)


def record_watch(name, pid, now=None):
    """Record the watcher this chat leaves running; a dead pid is a dead loop."""
    moment = time.time() if now is None else now
    return store(name, {'watch_pid': int(pid), 'watch_started': iso(moment)})


def clear_watch(name):
    """The watcher exited; keep the rest of the record and drop its pid."""
    state = stored(name)
    if 'watch_pid' not in state:
        return state
    return store(name, {'watch_pid': None})


def timer_unit(name):
    return f'board-sync@{slug(name)}.timer'


def bus_environment():
    runtime = f'/run/user/{os.getuid()}'
    return {'XDG_RUNTIME_DIR': runtime, 'DBUS_SESSION_BUS_ADDRESS': f'unix:path={runtime}/bus'}


def systemctl(*args):
    return subprocess.run(['systemctl', '--user', *args], capture_output=True, text=True,
                          timeout=30, env={**os.environ, **bus_environment()})


def timer_enabled(name):
    try:
        return systemctl('is-enabled', '--quiet', timer_unit(name)).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def unit_quote(value):
    """Quote systemd syntax, including specifiers; ExecStart also escapes dollars."""
    return '"' + str(value).replace('\\', '\\\\').replace('"', '\\"').replace(
        '%', '%%').replace('\n', '\\n').replace('\r', '\\r') + '"'


def prune_timers(name, now):
    for path in state_dir().glob('*.json'):
        if path == state_path(name):
            continue
        try:
            state = json.loads(path.read_text())
            if not isinstance(state, dict) or not isinstance(state.get('name'), str):
                continue
            other = state['name']
            unit = timer_unit(other)
            if path != state_path(other) or state.get('sync_timer') != unit:
                continue
            touched = [reconcile.stamp(state[key]) for key in
                       ('armed_at', 'watch_started', 'sync_timer_armed_at') if state.get(key)]
            # Scheduled syncs refresh mtime, but must never extend a dead chat's lease.
            last_chat = min(path.stat().st_mtime, max(touched)) if touched else path.stat().st_mtime
        except (OSError, ValueError, KeyError, TypeError):
            continue
        if now - last_chat > WEEK:
            systemctl('disable', '--now', unit).check_returncode()


def arm_timer(name, board, label, now=None):
    """Converge only this chat's units, then disable abandoned chats' recorded timers."""
    moment = time.time() if now is None else now
    if board < 1:
        raise ValueError('--board must be positive')
    unit = timer_unit(name)
    config = Path(os.environ.get('XDG_CONFIG_HOME') or Path.home() / '.config')
    directory = config / 'systemd/user'
    directory.mkdir(parents=True, exist_ok=True)
    environment = {
        **bus_environment(),
        'PATH': f'{Path.home()}/.local/bin:/usr/local/bin:/usr/bin:/bin',
        'BOARD_DRAIN_STATE_DIR': str(state_dir().resolve()),
        'BOARD_DRAIN_CRED_DIR': str(Path(os.environ.get('BOARD_DRAIN_CRED_DIR') or
            Path.home() / '.config/hypertask-agents/credentials/sessions').resolve()),
    }
    command = ['/usr/bin/timeout', '600', sys.executable,
               str(Path(__file__).resolve().with_name('sync')), '--board', str(board),
               '--label', label, '--name', name, '--own-token']
    service = ('[Unit]\nDescription=Sync this chat board view\n\n[Service]\nType=oneshot\n'
               'TimeoutStartSec=610\n' +
               ''.join('Environment=' + unit_quote(f'{key}={value}') + '\n'
                       for key, value in environment.items()) +
               'ExecStart=' + ' '.join(unit_quote(arg.replace('$', '$$')) for arg in command) + '\n')
    timer = ('[Unit]\nDescription=Keep this chat board view synced\n\n[Timer]\n'
             'OnStartupSec=1min\nOnUnitActiveSec=15min\nRandomizedDelaySec=3min\n'
             'Unit=' + unit.removesuffix('.timer') + '.service\n\n[Install]\nWantedBy=timers.target\n')
    for filename, content in ((unit, timer), (unit.removesuffix('.timer') + '.service', service)):
        target = directory / filename
        if target.exists() and target.read_text() == content:
            continue
        with tempfile.NamedTemporaryFile(mode='w', dir=directory, delete=False) as out:
            temporary = Path(out.name)
            out.write(content)
        temporary.replace(target)
    # Retry reload even after a crash between replacing a unit and reloading it.
    systemctl('daemon-reload').check_returncode()
    systemctl('enable', '--now', unit).check_returncode()
    state = store(name, {'board': board, 'label': label, 'sync_timer': unit,
                         'sync_timer_armed_at': iso(moment)})
    prune_timers(name, moment)
    return state


def loop_interval(timeout=20):
    """Seconds from plan-pick --loop-interval; PACER_FLOOR on any error or missing binary."""
    if not PLAN_PICK.is_file():
        return PACER_FLOOR
    try:
        done = subprocess.run([str(PLAN_PICK), '--loop-interval'],
                              capture_output=True, text=True, timeout=timeout, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return PACER_FLOOR
    if done.returncode != 0:
        return PACER_FLOOR
    parts = (done.stdout or '').strip().split(None, 1)
    if not parts:
        return PACER_FLOOR
    try:
        seconds = int(parts[0])
    except ValueError:
        return PACER_FLOOR
    return max(PACER_FLOOR, seconds)


def arm(name, every='2h', expires=None, job=None, now=None, board=None, label=None):
    """Record the armed loop, plus the board and label it drains when the chat passes them."""
    moment = time.time() if now is None else now
    expiry = reconcile.stamp(expires) if expires else moment + WEEK
    state = {'name': name, 'every': every, 'armed_at': iso(moment), 'expires_at': iso(expiry),
             'job': job, 'owner_pid': owner_pid(), 'host': socket.gethostname()}
    if board is not None:
        state['board'] = board
    if label is not None:
        state['label'] = label
    return store(name, state)


def status(name, now=None):
    """(0 armed, 3 expires within a day, 2 not armed or watcher dead) with its line."""
    moment = time.time() if now is None else now
    state = stored(name)
    if not state:
        return 2, 'not armed'
    try:
        expires = reconcile.stamp(state['expires_at'])
        # A restarted chat has a new pid and host, so its old loop is gone.
        if state.get('host') != socket.gethostname():
            return 2, 'not armed'
        if not reconcile.pid_alive(state.get('owner_pid')):
            return 2, 'not armed'
    except ERRORS:
        return 2, 'not armed'
    # A cleared watch_pid means the watcher exited on purpose; a recorded dead one
    # means the chat has nothing to wake it. No watcher ever recorded is today's rule.
    if state.get('watch_pid') is not None and not reconcile.pid_alive(state['watch_pid']):
        return 2, 'watcher dead'
    remaining = int(expires - moment)
    if remaining <= 0:
        return 2, 'not armed'
    return (3 if remaining < SOON else 0), (
        'expires soon (<24h): re-arm now' if remaining < SOON
        else f'armed, expires in {window(remaining)}')


def record_sync(name, ok, reason, now=None):
    """Record this chat's last board sync. A record alone never arms the loop."""
    moment = time.time() if now is None else now
    record = {'at': iso(moment), 'ok': bool(ok), 'reason': reason or ''}
    store(name, {'last_sync': record})
    return record


def sync_state(name):
    """The last_sync this chat recorded, or None when it never recorded one."""
    record = stored(name).get('last_sync')
    return record if isinstance(record, dict) else None


def clear(name):
    state_path(name).unlink(missing_ok=True)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='command', required=True)
    for command in ('arm', 'status', 'clear', 'watch', 'timer'):
        sub = commands.add_parser(command)
        sub.add_argument('--name', required=True)
        if command == 'timer':
            sub.add_argument('--board', type=int, required=True)
            sub.add_argument('--label', required=True)
        if command == 'watch':
            sub.add_argument('--pid', type=int, required=True, help='The watcher process id')
        if command == 'arm':
            sub.add_argument('--every', default='2h')
            sub.add_argument('--expires', help='ISO expiry; default is 7 days (recurring cron limit)')
            sub.add_argument('--job', help='The cron or job id this chat armed')
            sub.add_argument('--board', type=int, help='The board this loop drains')
            sub.add_argument('--label', help='The board label this loop drains')
    args = parser.parse_args(argv)
    try:
        if args.command == 'timer':
            state = arm_timer(args.name, args.board, args.label)
            print(f'enabled {state["sync_timer"]}')
            return 0
        if args.command == 'arm':
            state = arm(args.name, args.every, args.expires, args.job,
                        board=args.board, label=args.label)
            remaining = int(reconcile.stamp(state['expires_at']) - reconcile.stamp(state['armed_at']))
            print(f'armed, expires in {window(remaining)}')
            return 0
        if args.command == 'clear':
            clear(args.name)
            print('cleared')
            return 0
        if args.command == 'watch':
            state = record_watch(args.name, args.pid)
            print(f'watching, started {state["watch_started"]}')
            return 0
        code, text = status(args.name)
        print(text)
        return code
    except ERRORS as error:
        print(f'board-drain/loop-state: {error}', file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())
