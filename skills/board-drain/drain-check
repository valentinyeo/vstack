def probe_load():
    """The server's launch verdict for a worker: (exit code, one reason line).

    One call answers both: --can-launch sets the code, --brief prints the line.
    3 means the probe failed, and a failed probe never hides a finding.
    """
    if not os.access(VPS_STATE, os.X_OK):
        return 3, ''
    try:
        done = subprocess.run([str(VPS_STATE), '--can-launch', 'worker', '--brief'],
                              capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return 3, ''
    lines = (done.stdout or '').strip().splitlines()
    return done.returncode, lines[0].strip() if lines else ''


def launch_moments():
    """The log's two kinds of "at" moment; None when the log cannot be read.

    plan-pick mixes two rows in one log: a launch row with "at" and the lane it took,
    and a finish row with "finished_at" and no lane at all. It also logs one row with
    a null lane at the moment it finds no lane free. So a row with "at" and a lane is
    a launch that means a lane came back, and a row with "at" and a null lane is a
    miss. Returns (launched, misses), both in epoch seconds.
    """
    try:
        text = PLAN_PICK_LOG.read_text()
    except FileNotFoundError:
        return [], []
    except OSError:
        return None
    launched, misses = [], []
    for line in text.splitlines():
        if not line.strip():
            continue
        try:
            row = json.loads(line)
        except ValueError:
            return None
        if not isinstance(row, dict) or 'at' not in row:
            continue
        moment = stamp_of(row.get('at'))
        if moment is None:
            return None
        (launched if row.get('lane') is not None else misses).append(moment)
    return launched, misses


def probe_lane(now):
    """When plan-pick last found no free lane, in epoch seconds, or None.

    plan-pick records a miss in two places. A rung attempt per job with failure
    "lane" and exit 75 says every lane is spent; a worker that ran and then hit a
    rate limit also records "lane", but exits 0 or 1, so only exit 75 is a miss. It
    also logs a null-lane launch row at the moment it finds no lane free, and that
    row exists even when the job carries no rung context. The newest of either is
    the no-lane moment. A lane taken strictly after that moment lifts it: the launch
    right after the miss carries no lane and never counts. A probe that cannot read
    never hides a finding.
    """
    try:
        rows = json.loads(PLAN_PICK_STATE.read_text())
    except (OSError, ValueError):
        return None
    if not isinstance(rows, dict):
        return None
    moments = [stamp_of(row.get('finished_at')) for row in rows.values()
               if isinstance(row, dict) and row.get('failure') == 'lane'
               and row.get('exit_code') == 75]
    log = launch_moments()
    if log is not None:
        moments.extend(log[1])
    moments = [moment for moment in moments if moment is not None]
    if not moments:
        return None
    moment = max(moments)
    if not 0 <= now - moment <= LANE_WINDOW:
        return None
    if log is None or any(at > moment for at in log[0]):
        return None
    return moment


def clock_utc(seconds):
    return datetime.fromtimestamp(seconds, timezone.utc).strftime('%H:%M UTC')


def stamp_of(value):
    """Epoch seconds, or None when the field is missing, empty or unparsable."""
    if not value:
        return None
    try:
        return reconcile.stamp(value)
    except (AttributeError, TypeError, ValueError):
        return None


def ticked(task):
    """The board's timestamp in epoch seconds, or None when it sent nothing usable."""
    return stamp_of(task.get('updatedAt'))


def age(task, now):
    value = ticked(task)
    return None if value is None else now - value


def waiting(task):
    return bool(task.get('waitingOnUserId') or task.get('blockerCommentId'))


def done_blocker(key, loaded, other):
    """A blocker is done when its column says so, else when its own status does."""
    if key in loaded:
        return loaded[key].get('section') == DONE
    return (other.get('status') or '').strip().casefold() == DONE.casefold()


def open_blockers(relations, loaded):
    """The keys this ticket is BlockedBy that are still open, in link order."""
    stuck = []
    for relation in relations or ():
        if not isinstance(relation, dict):
            continue
        if (relation.get('relationType') or '').strip().casefold() != 'blockedby':
            continue
        if (relation.get('direction') or '').strip().casefold() != 'outgoing':
            continue
        other = relation.get('otherTask')
        other = other if isinstance(other, dict) else {}
        key = other.get('ticketNumber')
        if key and not done_blocker(key, loaded, other):
            stuck.append(key)
    return stuck


def live_worker(key, now, board):
    """A lease or a live command line on this card; another host's lease proves nothing."""
    try:
        return reconcile.worker_alive(key, now, board)
    except ERRORS:
        return False


def open_pulls(task, pulls):
    """This card's PRs known to be open; an unknown state is not one to resume."""
    return [pull for pull in linked_pulls(task, pulls)
            if pull_field(pull, 'url')
            and (pull_field(pull, 'state') or '').upper() == 'OPEN']


def in_flight(key, pulls, now, board):
    """A card really moving: a live helper on it, or an open PR of its own."""
    if not key:
        return False
    return live_worker(key, now, board) or bool(
        open_pulls({'ticketNumber': key}, pulls))


def orphan_finding(row, pulls, loaded, now, board):
    """An open PR red and idle an hour with no helper: the owner resumes it first.

    A worker pushes, updates its PR and exits, so checks pending or green, or a push
    inside the hour, are someone still moving and not an orphan. A card blocked by
    work already in flight, or one waiting on Valentin, has a reason to idle;
    starting a helper on it would work around that reason. Facts, locks and links
    come from the tick's board facts, so a red row costs no GitHub read; a row with
    no checks state or no push time keeps the old rule only past the hour by the
    card's own clock.
    """
    task = row['task']
    if task.get('section') in (DONE, NOT_NOW) or waits_on_valentin(task):
        return None
    own = open_pulls(task, pulls)
    if not own or live_worker(task['ticketNumber'], now, board):
        return None
    blockers = open_blockers(row.get('relations'), loaded)
    if any(in_flight(key, pulls, now, board) for key in blockers):
        return None
    pull = own[0]
    facts = pull_now(pull, now, now, {'used': False})
    if red_and_idle(facts):
        said = f'is {ORPHAN_FIX}'
    elif undated(facts) and (age(task, now) or 0) > STUCK_AFTER:
        said = f'has {ORPHAN_UNKNOWN}'
    else:
        return None
    return ('orphan PR', f'orphan PR: {task["ticketNumber"]} '
                         f'{pull_field(pull, "url")} {said}')


def agent_assigned(task):
    """An agent on the ticket; a person alone is not an owner."""
    return any((assignee.get('type') or '').strip().lower() == 'agent'
               for assignee in task.get('assignees') or () if isinstance(assignee, dict))


def is_human(comment):
    """Valentin writes with no agent on the comment; his agents always leave one."""
    return not (comment.get('agent') or comment.get('agent_display_name'))


def said(comment):
    return stamp_of(comment.get('createdAt'))


def answered(comments):
    """A human replied after every agent: the waiting-on mark no longer holds."""
    pairs = [(said(comment), is_human(comment)) for comment in comments]
    pairs = [(moment, human) for moment, human in pairs if moment is not None]
    humans = [moment for moment, human in pairs if human]
    agents = [moment for moment, human in pairs if not human]
    return bool(humans) and (not agents or max(humans) > max(agents))


def valentin_column(section):
    """A column that means his call, not an agent's: Valentin Review and its aliases."""
    name = (section or '').strip().casefold()
    return ('valentin' in name and 'review' in name) or name in WAITING_COLUMNS


def waits_on_valentin(task):
    """Marked waiting on him, or parked in a column only he moves out of."""
    return (task.get('waitingOnUserId') == VALENTIN_USER_ID
            or valentin_column(task.get('section')))


def needs_comments(task):
    """Todo, or a ticket that waits on him: the rows whose newest comment decides."""
    if task.get('section') in (DONE, NOT_NOW):
        return False
    return task.get('section') == TODO or waits_on_valentin(task)


def pull_field(pull, name, default=None):
    """One fact from a PR row, whether it is a dict (fixture, saved) or a Pull."""
    if isinstance(pull, dict):
        return pull.get(name, default)
    return getattr(pull, name, default)


def ready_to_merge(pull):
    """Open, green, and not known to conflict. Unknown merge state is not a no."""
    return ((pull_field(pull, 'state') or '').upper() == 'OPEN'
            and pull_field(pull, 'checks') == 'green'
            and pull_field(pull, 'mergeable') is not False)


def newest_comment(comments):
    rows = [comment for comment in comments or () if isinstance(comment, dict)]
    return max(rows, key=lambda comment: said(comment) or 0) if rows else None


def comment_text(comment):
    return (comment.get('text') or comment.get('commentText') or '').strip()


def merge_findings(rows, pulls):
    """A finished PR waiting on Valentin is this chat's work, not his."""
    out = []
    for row in rows:
        task = row['task']
        if task.get('section') in (DONE, NOT_NOW) or not waits_on_valentin(task):
            continue
        key = task['ticketNumber']
        ticket_pulls = (pulls or {}).get(key) or ()
        ready = [pull for pull in ticket_pulls if ready_to_merge(pull)]
        newest = newest_comment(row.get('comments'))
        asked = bool(newest and not is_human(newest) and merge_ask.asks(comment_text(newest)))
        reasons = []
        if ready:
            reasons.append(f'open green PR {pull_field(ready[0], "url") or ""}'.strip())
        if asked:
            reasons.append('its newest chat comment asks him to merge')
        if not reasons:
            continue
        out.append(('wait on merge', f'wait on merge: {key} waits on Valentin with '
                                     f'{" and ".join(reasons)}; {merge_ask.FIX}'))
    return out


def alive(task, now, board):
    """A lease, a live agent command line, or a ticket touched in the last half hour."""
    try:
        if reconcile.worker_alive(task['ticketNumber'], now, board):
            return True
    except ERRORS:
        # A lease from another host cannot be checked, and no local worker owns it.
        pass
    spent = age(task, now)
    return spent is not None and spent < FRESH


def moment_utc(seconds):
    return datetime.fromtimestamp(seconds, timezone.utc).strftime('%Y-%m-%d %H:%M UTC')


def read_pull_facts(url):
    """One PR's state, checks and head push time: the tick's only GitHub read.

    It goes through reconcile's gh wrapper, so a chat over its budget pays nothing
    and reads the refusal as a skip. Every failure comes back empty: a read that
    fails leaves the card alone instead of guessing at it.
    """
    match = PR_URL.search(url or '')
    if match is None:
        return {}
    owner, repo, number = match.groups()
    query = ('query{repository(owner:%s,name:%s){pullRequest(number:%s){state'
             ' headRef{target{... on Commit{committedDate}}}statusCheckRollup{state}}}}'
             % (json.dumps(owner), json.dumps(repo), int(number)))
    try:
        result = json.loads(reconcile.run('gh', 'api', 'graphql', '-f', 'query=' + query))
    except ERRORS + (AttributeError, reconcile.BudgetRefused, reconcile.RateLimit):
        return {}
    node = ((result.get('data') or {}).get('repository') or {}).get('pullRequest') or {}
    rollup = node.get('statusCheckRollup') or {}
    target = (node.get('headRef') or {}).get('target') or {}
    return {'state': (node.get('state') or '').upper(),
            'checks': reconcile.ROLLUP_STATE.get((rollup.get('state') or '').upper(), ''),
            'pushed': stamp_of(target.get('committedDate'))}


def pull_now(pull, now, seen, budget):
    """A PR's state, checks and push time as the tick knows them, plus the moment.

    A row the tick loaded answers without GitHub. A read only fills a row still
    missing checks or its push time, one read per card, recorded in `budget`; a read
    that fails leaves the row unknown rather than guessing at it. A pull read live is
    judged against now, one taken from a listing against the moment it was taken.
    """
    url = pull_field(pull, 'url') or ''
    state = (pull_field(pull, 'state') or '').upper()
    checks = pull_field(pull, 'checks') or ''
    pushed = stamp_of(pull_field(pull, 'pushedAt'))
    if pushed is None:
        pushed = stamp_of(pull_field(pull, 'pushed'))
    facts = {'state': state, 'checks': checks, 'pushed': pushed, 'seen': seen}
    if (state and state != 'OPEN') or (checks and checks != 'red'):
        return facts
    if state and checks and pushed is not None:
        return facts
    if budget.get('used'):
        return facts
    budget['used'] = True
    read = read_pull_facts(url)
    return {'state': read.get('state') or state,
            'checks': read.get('checks') or checks,
            'pushed': read.get('pushed') if read.get('pushed') is not None else pushed,
            'seen': now}


def red_and_idle(facts):
    """Open, red checks and no push for an hour: the rule both PR findings share."""
    pushed = facts['pushed']
    return (facts['state'] == 'OPEN' and facts['checks'] == 'red'
            and pushed is not None and facts['seen'] - pushed > STUCK_AFTER)


def undated(facts):
    """No checks state, or red with no push time: the card's own clock has to decide."""
    return not facts['checks'] or (facts['checks'] == 'red' and facts['pushed'] is None)


def linked_pulls(task, pulls):
    """A ticket's PRs: the rows this tick loaded, else the ones the board links."""
    rows = [row for row in (pulls or {}).get(task.get('ticketNumber')) or ()
            if pull_field(row, 'url')]
    if rows:
        return rows
    return [item for item in task.get('pullRequests') or ()
            if isinstance(item, dict) and item.get('url')]


def listing_path(board):
    return loop_state.state_dir() / f'open-pulls-{board.id}.json'


def saved_listing(board, now):
    """The board's open-PR listing and when it was taken, when under ten minutes old.

    None means this board has to read GitHub again; an empty list is a real answer.
    """
    try:
        data = json.loads(listing_path(board).read_text())
    except (OSError, ValueError):
        return None
    if not isinstance(data, dict) or not isinstance(data.get('pulls'), list):
        return None
    at = stamp_of(data.get('at'))
    if at is None or now < at or now - at > LISTING_TTL:
        return None
    return [row for row in data['pulls'] if isinstance(row, dict)], at


def save_listing(board, rows, now):
    """Best effort: a listing that cannot be saved costs a read next tick, nothing else."""
    path = listing_path(board)
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps({'at': now, 'pulls': rows}))
    except OSError:
        pass


def listing_page(scope, cursor=None):
    """One page of open PRs in one search scope, with their checks and head push."""
    after = f',after:{json.dumps(cursor)}' if cursor else ''
    query = ('query{search(query:%s,type:ISSUE,first:%d%s){issueCount pageInfo{hasNextPage '
             'endCursor} nodes{... on PullRequest{%s}}}}'
             % (json.dumps('is:pr is:open ' + scope), LISTING_PAGE, after, LISTING_FIELDS))
    result = json.loads(reconcile.run('gh', 'api', 'graphql', '-f', 'query=' + query))
    if result.get('errors') or not result.get('data'):
        raise ValueError('GitHub search errors')
    return result['data']['search']


def listing_rows(page):
    """The rows one page of open PRs contributes: the facts a stuck card is judged on."""
    rows = []
    for node in page.get('nodes') or ():
        if not isinstance(node, dict) or not node.get('url'):
            continue
        rollup = node.get('statusCheckRollup') or {}
        commit = ((node.get('commits') or {}).get('nodes') or [{}])[0] or {}
        # The search asked for open PRs only, so each row's state is already known.
        rows.append({'url': node['url'], 'state': 'OPEN', 'title': node.get('title') or '',
                     'headRefName': node.get('headRefName') or '',
                     'checks': reconcile.ROLLUP_STATE.get(
                         (rollup.get('state') or '').upper(), ''),
                     'pushedAt': (commit.get('commit') or {}).get('committedDate') or ''})
    return rows


def open_pull_rows(board):
    """Every open PR in the board's scope, paged as far as GitHub will answer.

    One read covers every Checks card on the board, however many carry no PR link.
    Past GitHub's 1,000-result cap the listing stays partial, which leaves a card
    unflagged rather than guessed at.
    """
    scope = reconcile.probe_scope(board)
    rows, cursor = [], None
    while True:
        page = listing_page(scope, cursor)
        rows += listing_rows(page)
        info = page.get('pageInfo') or {}
        next_cursor = info.get('endCursor')
        if (not info.get('hasNextPage') or not next_cursor or next_cursor == cursor
                or len(rows) >= LISTING_MAX):
            return rows
        cursor = next_cursor


def open_listing(board, now):
    """The board's open-PR listing and its moment, read once every ten minutes for every card.

    A card idle for an hour is exactly the card the board's saved facts never cover,
    so this is where its PR comes from. A read that fails comes back empty: every
    card is then left alone instead of guessed at.
    """
    saved = saved_listing(board, now)
    if saved is not None:
        return saved
    try:
        rows = open_pull_rows(board)
    except ERRORS + (AttributeError, reconcile.BudgetRefused, reconcile.RateLimit):
        return [], now
    save_listing(board, rows, now)
    return rows, now


def names_key(text, key):
    """The card's key as a whole word: MUBO-13 must not match MUBO-130."""
    pattern = r'(?<![A-Za-z0-9])' + re.escape(key or '') + r'(?![0-9])'
    return bool(key) and re.search(pattern, text or '', re.IGNORECASE) is not None


def card_keys(key, board):
    """The keys this card's PRs can carry: its own, and the ones it moved from.

    A card moved between boards keeps its PRs under the key they were written with.
    """
    try:
        return (key,) + tuple(reconcile.aliases_of(key, board) or ())
    except ERRORS + (AttributeError,):
        return (key,)


def card_pulls(key, listing, board):
    """The open PRs whose title or branch name carries this card's key or an old one."""
    keys = card_keys(key, board)
    return [row for row in listing or ()
            if any(names_key(row.get('title'), name) or names_key(row.get('headRefName'), name)
                   for name in keys)]


def pull_repo(pull):
    """`owner/name` for one PR row, from the repository fact it carries or its URL."""
    repo = ''
    if isinstance(pull, dict):
        found = pull.get('repository')
        if isinstance(found, dict):
            repo = found.get('nameWithOwner') or ''
    return repo or merge_gate.repo_from_url(pull_field(pull, 'url') or '')


def view_repos(rows, pulls, listing, board):
    """The repos this chat's own view ships from: the PRs on its cards, and nothing else.

    Three sources, all already in hand for this tick: the PR rows loaded for the view,
    the PRs each card links, and the open-PR listing rows matched to an idle Checks
    card. Another chat's repo is another chat's gate, so it is never judged here.
    """
    found = set()
    for row in rows:
        key = row['task'].get('ticketNumber')
        linked = list((pulls or {}).get(key) or ())
        linked += [item for item in row['task'].get('pullRequests') or ()
                   if isinstance(item, dict)]
        linked += card_pulls(key, listing, board)
        found.update(repo for repo in (pull_repo(pull) for pull in linked) if repo)
    return found


def stuck_finding(task, pulls, now, board, listing=(), listing_at=None):
    """A Checks card on a red PR with no push and no owner for an hour, or None.

    A PR link the tick already holds answers first; a card with no link is matched
    to the board's open listing by its key. One card pays for at most one read, and
    nothing here acts on a view other than this chat's own.

    A listing only sees pushes up to the moment it was taken, so a pull read from it
    is judged against that moment: the card is stuck when the PR was already silent
    for an hour then. Reading the pull live or holding its link counts to now.
    """
    if task.get('section') != CHECKS or alive(task, now, board):
        return None
    budget = {'used': False}
    linked = linked_pulls(task, pulls)
    seen = now if linked or listing_at is None else listing_at
    for pull in linked or card_pulls(task.get('ticketNumber'), listing, board):
        facts = pull_now(pull, now, seen, budget)
        if not red_and_idle(facts):
            continue
        return ('stuck', f'stuck: {task["ticketNumber"]} in Checks, PR '
                         f'{pull_field(pull, "url") or ""} red and idle since '
                         f'{moment_utc(facts["pushed"])}, no live owner. {STUCK_FIX}')
    return None


def start_rank(row, now, board):
    key = row['task']['ticketNumber']
    try:
        index = int(reconcile.ticket_index(key, board))
    except ValueError:
        index = sys.maxsize
    return (wip.rank(row['task']), -(age(row['task'], now) or 0), index)


def top_key(rows, now, board):
    """The ticket to start first: highest priority, then longest idle, then lowest key."""
    return min(rows, key=lambda row: start_rank(row, now, board))['task']['ticketNumber']


def sync_findings(name, now):
    """A broken or over-45-minute-old sync is a finding; a fresh ok one is not.

    A sync skipped over the gh budget is not a failure: it is judged by the last
    sync that really read the board, so skips that last over 45 minutes still read
    as stale.
    """
    record = loop_state.sync_state(name)
    if not record:
        return ['sync stale: no sync recorded yet.']
    skipped = bool(record.get('skipped'))
    if not record.get('ok') and not skipped:
        reason = record.get('reason') or 'no reason recorded'
        return [f'sync failed: {reason}. Fix it, then run ./sync.']
    moment = stamp_of(record.get('at'))
    if moment is None:
        if skipped:
            return ['sync stale: no sync recorded yet.']
        return ['sync stale: no sync time recorded.']
    spent = now - moment
    if spent > loop_state.SYNC_STALE:
        return [f'sync stale: last sync {int(spent // 60)} min ago.']
    return []


def read_fixture(path):
    """Rows of {"task", "comments", "relations"}: the API answers, without the API.

    A JSON list is rows alone; an object carries the same rows under "rows" plus the
    facts the board rules read (chats, agents, views, pulls, roster, workers).
    """
    data = json.loads(Path(path).read_text())
    extra = {}
    if isinstance(data, dict):
        extra = data
        data = data.get('rows')
    if not isinstance(data, list):
        raise ValueError('fixture must be a JSON list, or an object with "rows"')
    rows = []
    for item in data:
        if not isinstance(item, dict) or not isinstance(item.get('task'), dict):
            raise ValueError('each fixture row needs a task')
        rows.append({'task': item['task'], 'comments': item.get('comments') or [],
                     'relations': item.get('relations') or []})
    return rows, extra


def fixture_board(board_id, rows):
    if board_id in reconcile.BOARDS:
        return reconcile.BOARDS[board_id]
    prefix = ''
    if rows:
        prefix = str(rows[0]['task'].get('ticketNumber') or '').split('-')[0]
    return replace(reconcile.DEFAULT, id=board_id, prefix=prefix)


def ticket_relations(key):
    """The links on one ticket: what it is BlockedBy, and what it blocks."""
    page = reconcile.api('task', 'relations', key)
    return page.get('relations') or []


def ticket_comments(key):
    rows, cursor, seen = [], None, set()
    while True:
        args = ['comment', 'list', key, '--limit', '100']
        if cursor:
            args += ['--cursor', cursor]
        page = reconcile.api(*args)
        rows += page.get('comments') or []
        cursor = page.get('nextCursor')
        if not cursor:
            return rows
        if cursor in seen:
            raise ValueError('repeated comment cursor')
        seen.add(cursor)


def rows_for(args):
    """Open tickets carrying the label, each Todo ticket with its comments and links.

    Also the whole loaded board by key, label or not, so a blocker's column is known,
    and that whole board's cards, because the WIP cap counts the ones this label owns.
    """
    extra = {}
    if args.fixture:
        rows, extra = read_fixture(args.fixture)
        board = fixture_board(args.board, rows)
    else:
        board = reconcile.board_config(args.board)
        rows = [{'task': task} for task in reconcile.tickets(board=board)]
    loaded = {row['task'].get('ticketNumber'): row['task'] for row in rows}
    kept = []
    for row in rows:
        task = row['task']
        if 'projectId' in task and str(task['projectId']) != str(args.board):
            raise ValueError(f'ticket outside board {args.board}')
        if not reconcile.carries_label(task, args.label):
            continue
        if not args.fixture and needs_comments(task):
            key = task['ticketNumber']
            row = {'task': task, 'comments': ticket_comments(key),
                   'relations': [] if waiting(task) else ticket_relations(key)}
        kept.append(row)
    return board, kept, loaded, extra, [row['task'] for row in rows]


def pull_facts(args, board, rows, data):
    """This view's PR facts, read once here and shared with the board rules."""
    lint = lint_module()
    fixture_pulls = lint.pull_map_from_fixture(data) if args.fixture else None
    try:
        return lint.load_pulls(board, [row['task'] for row in rows], fixture_pulls,
                               probe_only=not args.fixture)
    except ERRORS + (AttributeError,):
        # A tick that cannot read PR facts stays quiet rather than read as "no PR".
        return None


def own_cap_pulls(rows, board, opened, label):
    """The open PRs this label's own cards carry: only those spend its cap.

    A board read can hand one card another card's pull, and a key can point at a card
    this label does not own. A pull whose only ticket is someone else's is not this
    chat's work, so it neither counts toward the cap nor gets parked by it.
    """
    own = set()
    for row in rows:
        task = row['task']
        if reconcile.carries_label(task, label):
            own.add(str(task.get('ticketNumber') or '').upper())
    board_id = str(board.id)
    kept = {}
    for url, pull in (opened or {}).items():
        named_keys, named_urls = reconcile.pull_refs(pull)
        named = bool(named_keys or named_urls)
        keys = []
        for key in pull.get('keys') or ():
            key = str(key).upper()
            if key not in own:
                continue
            if named:
                try:
                    ref = (board_id, reconcile.ticket_index(key, board))
                except ValueError:
                    continue
                if key not in named_keys and ref not in named_urls:
                    continue
            if key not in keys:
                keys.append(key)
        if keys:
            kept[url] = dict(pull, keys=sorted(keys))
    return kept


def agent_open_pulls(args, board, rows, pulls):
    """The open PRs this label owns, read live or from the fixture, counted by label."""
    if not args.fixture:
        opened = pr_park.owned_pulls([row['task'] for row in rows], board)
    else:
        opened = {}
        for row in rows:
            key = row['task']['ticketNumber']
            for pull in (pulls or {}).get(key) or ():
                if pull.get('state') == 'OPEN':
                    entry = opened.setdefault(pull['url'], dict(pull, keys=[]))
                    entry['keys'].append(key)
    return own_cap_pulls(rows, board, opened, args.label)


def repo_cap_notes(repos, args, data, now):
    notes = []
    for repo in sorted(repos):
        count = ((data.get('repo_counts') or {}).get(repo) if args.fixture
                 else repo_cap.open_count(repo, now=now))
        cap = repo_cap.REPOS.get(repo, repo_cap.CAP)
        if count is not None and count > cap:
            notes.append(f'warning: repo PR cap: {repo} has {count} open PRs (cap {cap}); '
                         'close or land open PRs first')
    return notes


def read_view(args, now):
    """One read of the view: the board, every row, the notes, the findings, the workable rows."""
    board, rows, loaded, data, board_tasks = rows_for(args)
    pulls = pull_facts(args, board, rows, data)
    todos = [row for row in rows if row['task'].get('section') == TODO]
    doings = [row for row in rows if row['task'].get('section') in DOING]
    live = [row for row in doings if alive(row['task'], now, board)]
    workable, waiting_lines, blocked_lines, findings = [], [], [], []
    # The open PRs this label owns; the parking cap reads the same label table.
    opened = {}
    try:
        opened = agent_open_pulls(args, board, rows, pulls)
        findings += pr_park.cap_findings(opened, args.label)
    except ERRORS + (AttributeError, reconcile.BudgetRefused, reconcile.RateLimit) as error:
        waiting_lines.append(f'warning: agent PR cap: read failed ({str(error).splitlines()[0]}); skipped')
    # Valentin's rule: finish before starting. A label already holding its open
    # tickets takes no new Todo work, so the findings that ask for a start stay
    # quiet until it ships one.
    over, cards, cap = wip.at_cap(board_tasks, args.label)
    if over:
        findings.append(('over cap',
                         f'over cap: {wip.held_line(args.label, cards, cap)}'))
    for row in todos:
        task = row['task']
        if waiting(task):
            if answered(row.get('comments') or []):
                findings.append(('answered', f'answered: {task["ticketNumber"]} clear the '
                                             'waiting-on mark and work it'))
            else:
                waiting_lines.append(f'waiting: {task["ticketNumber"]} (marked)')
            continue
        stuck = open_blockers(row.get('relations'), loaded)
        if stuck:
            blocked_lines.append(f'blocked: {task["ticketNumber"]} by {", ".join(stuck)}')
        else:
            workable.append(row)
    # Valentin's priority rule: an urgent ticket is picked up first. A hold pauses
    # launches but never reorders work, and wip-cap already lets urgent start over cap.
    for row in sorted(workable, key=lambda row: start_rank(row, now, board)):
        spent = age(row['task'], now)
        if wip.urgent(row['task']) and spent is not None and spent > URGENT_IDLE:
            findings.append(('urgent', f'urgent: {row["task"]["ticketNumber"]} is urgent and '
                                       'waiting in Todo; start it before any other ticket.'))
    # An urgent Todo card may start while its label is at cap, so its nudge stands.
    # An open PR over the cap is not the same: it gets parked before any new start,
    # urgent or not, because a start would open one more.
    held_by_cap = (len(opened) >= cap
                   or (over and not any(wip.urgent(row['task']) for row in workable)))
    for row in doings:
        if row not in live:
            findings.append(('stalled', f'stalled: {row["task"]["ticketNumber"]} in Doing with no '
                                        'live worker. Start a fresh plan-pick worker.'))
    idle_checks = [row for row in rows if row['task'].get('section') == CHECKS
                   and not alive(row['task'], now, board)]
    stuck_keys = set()
    listing, listing_at = (), None
    if any(not linked_pulls(row['task'], pulls) for row in idle_checks):
        listing, listing_at = open_listing(board, now)
    for row in idle_checks:
        finding = stuck_finding(row['task'], pulls, now, board, listing, listing_at)
        if finding is not None:
            findings.append(finding)
            # The stuck advice already covers this card, so its PR gets one line, not two.
            stuck_keys.add(row['task']['ticketNumber'])
    # Orphans come first: while one of this chat's PRs has no helper, starting on a
    # fresh Todo is the mistake, so the Todo advice below stays quiet.
    orphans = [finding for finding in
               (orphan_finding(row, pulls, loaded, now, board) for row in rows
                if row['task']['ticketNumber'] not in stuck_keys)
               if finding is not None]
    findings[:0] = orphans
    if workable and not live and not orphans and not held_by_cap:
        findings.append(('loop off', f'loop off: {len(workable)} workable Todo, nothing in Doing. '
                                     f'Re-arm your loop and start a worker on '
                                     f'{top_key(workable, now, board)}.'))
    for row in rows:
        task = row['task']
        if task.get('section') in WORKING and not agent_assigned(task):
            findings.append(('unassigned', f'unassigned: {task["ticketNumber"]} in '
                                           f'{task["section"]} has no agent assigned. Assign your '
                                           f'own agent login to it (task assign '
                                           f'{task["ticketNumber"]} --self, with your token).'))
    for row in (sorted(workable, key=lambda row: start_rank(row, now, board))
                if not orphans else ()):
        spent = age(row['task'], now)
        if spent is not None and spent > STALE and not held_by_cap:
            findings.append(('stale', f'stale: {row["task"]["ticketNumber"]} workable in Todo '
                                      f'for {int(spent // 3600)}h.'))
    findings += merge_findings(rows, pulls)
    # The repos this board ships from must refuse a merge until a verifier passed it.
    # Only this view's own repos are judged: another chat's repo is its gate, not this
    # one's. A view with no PRs names no repo, and asks GitHub nothing at all.
    # A fixture names its own gates; with none named, the test reads no GitHub at all.
    repos = view_repos(rows, pulls, listing, board) | {pull_repo(p) for p in opened.values()}
    waiting_lines += repo_cap_notes(repos, args, data, now)
    findings += merge_gate.gate_findings(
        board, now, fixture=((data.get('gates') or []) if args.fixture else None),
        repos=repos)
    # The watcher records its own name and reads the view without a loop state to judge.
    state_name = getattr(args, 'state_name', None)
    if state_name:
        code, text = loop_state.status(state_name, now)
        if code:
            findings.append(('loop state', f'loop state: {text}'))
        if not loop_state.timer_enabled(state_name):
            findings.append(('sync timer', 'sync timer off: re-arm this chat with ./loop-state timer.'))
        findings += [('sync', line) for line in sync_findings(state_name, now)]
    return {'board': board, 'rows': rows, 'tasks': board_tasks, 'workable': workable,
            'data': data, 'pulls': pulls, 'notes': waiting_lines + blocked_lines,
            'findings': findings}


def lint_module():
    """board-lint in this process, so one tick reads the board once and shares the cache."""
    name = 'board_lint'
    module = sys.modules.get(name)
    if module is not None and getattr(module, '__file__', None) == str(LINT):
        return module
    loader = importlib.machinery.SourceFileLoader(name, str(LINT))
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


def rule_breaks(view, args, now):
    """This chat's own board-rule breaks, from the board read this tick already made.

    Only its own label's view and label breaks come back: another chat's view is
    that chat's finding, and no chat reads the board twice to say so.
    """
    lint = lint_module()
    rows, data = view['rows'], view.get('data') or {}
    fixture = bool(args.fixture)
    shared = {'board': view['board'], 'tasks': [row['task'] for row in rows],
              'data': data, 'now': now, 'probe_only': True,
              'pulls': view.get('pulls'),
              'fixture_pulls': (data.get('pulls') or {}) if fixture else None,
              'pull_rules': ('pulls' in data) if fixture else True,
              'reconcile': reconcile, 'loop_state': loop_state,
              'drain_check': sys.modules[__name__]}
    lint_args = argparse.Namespace(board=args.board, label=args.label, fixture=fixture,
                                   roster=None, skip_comments=False, json=False)
    mine = args.label.strip().casefold()
    breaks = lint.lint(lint_args, shared=shared)
    # A sync record files under a chat name, and the lint lists every chat's.
    own = slug(args.state_name) or mine
    kept = []
    for item in breaks:
        if item.rule == 'sync-record':
            if slug(item.owner) == own:
                kept.append(item)
        elif item.rule not in OWN_LABEL_RULES or slug(item.owner) == mine:
            kept.append(item)
    return kept


def slug(name):
    return (name or '').strip().casefold()


def check(args, now):
    view = read_view(args, now)
    workable, findings = view['workable'], view['findings']
    for line in view['notes']:
        print(line)
    held = hold_line(workable, findings, args, now, view.get('tasks'))
    shown, printed_hold, failing = [], False, 0
    for kind, text in findings:
        if held is not None and kind in held[0]:
            if not printed_hold:
                shown.append(held[1])
                printed_hold = True
            continue
        shown.append(text)
        failing += 1
    for line in shown:
        print(line)
    try:
        breaks = rule_breaks(view, args, now)
    except ERRORS + (AttributeError,) as error:
        # A lint that cannot read is reported and never turns a pass into a fail.
        print(f'board-lint: read failed: {error}', file=sys.stderr)
        breaks = []
    for item in breaks:
        print(f'rule-break: {item.ticket} {item.rule}: {item.fix}')
        if item.rule in FAIL_RULES:
            failing += 1
    print('drain-check: PASS' if not failing else f'drain-check: FAIL ({failing} findings)')
    return 0 if not failing else 1


def hold_line(workable, findings, args, now, tasks=None):
    """(findings to collapse, one held line) when the loop holds on purpose, else None.

    Valentin's rule is to launch nothing while the server is overloaded, and
    plan-pick launches nothing while no worker lane is free, so an idle drain in
    either state is holding on purpose, not a broken loop. The server HOLD wins.
    A board over its review-debt cap also holds new starts until someone ships or
    reviews (VSTA-271), after the server and lane holds. Unassigned, answered, urgent,
    loop-state and sync findings always stand.
    """
    kinds = {kind for kind, _ in findings}
    if not args.no_load:
        if kinds & LOAD_FINDINGS:
            code, line = probe_load()
            if code == 2 and line:
                return LOAD_FINDINGS, (f'held: {line}; '
                                       f'{len(workable)} workable Todo wait for the server')
        if kinds & LANE_FINDINGS:
            moment = probe_lane(now)
            if moment is not None:
                return LANE_FINDINGS, (f'held: no worker lane since {clock_utc(moment)}; '
                                       f'{len(workable)} workable Todo wait for a lane')
    over = wip.review_debt_over(args.board, tasks)
    if over is not None:
        cards, cap = over
        return REVIEW_DEBT_FINDINGS, (f'held: review debt {cards} > {cap}; '
                                      f'{len(workable)} workable Todo wait')
    return None


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--board', type=int, required=True)
    parser.add_argument('--label', required=True)
    parser.add_argument('--fixture', help='Read a JSON list of {"task", "comments"}, or an object '
                        'with those rows under "rows", instead of the API')
    parser.add_argument('--now', help='Judge ages against this ISO time instead of the clock')
    parser.add_argument('--state-name', help='Also require this chat\'s loop to be armed')
    parser.add_argument('--no-load', action='store_true',
                        help='Skip the vps-state load probe and the plan-pick lane probe')
    args = parser.parse_args(argv)
    if args.board < 1:
        parser.error('--board must be a positive board id')
    try:
        now = reconcile.stamp(args.now) if args.now else time.time()
        code = check(args, now)
        print(reconcile.github_summary(), file=sys.stderr, flush=True)
        return code
    except ERRORS as error:
        print(f'drain-check: {error}', file=sys.stderr)
        return 2
    except Exception as error:  # noqa: BLE001 - a crash must read as 2, never as 1
        print(f'drain-check: error: {error}', file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())
