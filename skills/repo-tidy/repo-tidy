def utc_stamp():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


class Budget(Exception):
    """The per-repo cap ran out. Stop this repo; do not start another child."""


_STATE = threading.local()


def set_deadline(seconds):
    """Give this thread, and the children it starts, a wall-clock budget."""
    _STATE.deadline = time.monotonic() + max(0.1, float(seconds) - DEADLINE_MARGIN)


def clear_deadline():
    _STATE.deadline = None


def bounded(timeout):
    """A child's own timeout, never longer than what the repo has left."""
    left = getattr(_STATE, "deadline", None)
    if left is None:
        return timeout
    left = left - time.monotonic()
    if left <= 0:
        raise Budget()
    return min(timeout, left)


def run_command(command, timeout, cwd=None):
    """One child in its own process group, killed whole when it overruns.

    subprocess.run's timeout kills only the process it started. A git that
    hangs on the network leaves children holding the pipe, so the caller waits
    anyway. Here the whole group goes.
    """
    try:
        proc = subprocess.Popen([str(part) for part in command], cwd=cwd,
                                stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, text=True,
                                start_new_session=True)
    except OSError as exc:
        return 1, "", str(exc)
    try:
        out, err = proc.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
        except OSError:
            proc.kill()
        try:
            out, err = proc.communicate(timeout=KILL_WAIT)
        except subprocess.TimeoutExpired:
            out, err = "", ""
        return 1, out or "", "timeout after %ss" % round(timeout, 1)
    return proc.returncode, out, err


def git(args, cwd=None, timeout=GIT_TIMEOUT):
    return run_command(["git"] + [str(a) for a in args], bounded(timeout), cwd=cwd)


def gh(args, timeout=GH_TIMEOUT):
    return run_command(["gh"] + [str(a) for a in args], bounded(timeout))


def free_bytes(path):
    try:
        stats = os.statvfs(str(path))
    except OSError:
        return 0
    return stats.f_bavail * stats.f_frsize


# -- discovery -----------------------------------------------------------

def is_repo(path):
    """A normal checkout or a linked worktree, which has .git as a file."""
    dot = Path(path) / ".git"
    if dot.is_dir():
        return True
    target = gitdir_target(path)
    return bool(target and target.exists())


def is_main_checkout(path):
    """Directory discovery: a worktree is not a repo of its own."""
    return (Path(path) / ".git").is_dir()


def under(path, root):
    try:
        Path(path).resolve().relative_to(Path(root).resolve())
        return True
    except ValueError:
        return False


def gitdir_target(path):
    """Where a folder's `.git` file points, or None for a folder that has none."""
    dot = Path(path) / ".git"
    if not dot.is_file():
        return None
    try:
        text = dot.read_text(errors="replace").strip()
    except OSError:
        return None
    if not text.startswith("gitdir:"):
        return None
    target = Path(text[len("gitdir:"):].strip())
    if not target.is_absolute():
        target = Path(path) / target
    return target


def slice_homes(repo, projects_root):
    """Where this project's slice folders live: beside it, and in its grouping folders.

    Chats keep their copies beside the main checkout (`projects/<repo>-wt-<ticket>`)
    and sometimes in a grouping folder (`projects/<repo>-trees/<chat>-...`). The
    grouping folders carry the project's own name, so two levels is the whole scan:
    one listing per folder, never another project's tree.
    """
    main = Path(repo).resolve()
    parent = main.parent
    root = Path(projects_root).resolve()
    homes = [parent]
    try:
        children = sorted(parent.iterdir())
    except OSError:
        children = []
    for child in children:
        if (child.is_dir() and child.name.startswith(main.name + "-")
                and not is_repo(child)):
            homes.append(child)
    return [home for home in homes if under(home, root)]


def slice_candidates(repo, main_path, projects_root, slug):
    """Folders beside this project that hold its own work, never another repo's.

    Three kinds belong here: a registered worktree (git already lists it), a
    worktree folder whose registration is gone (a stale copy of this repo's own
    admin), and a standalone clone whose origin remote is this project's. A
    registered one is left to the worktree pass; the rest come back here.
    """
    common = Path(main_path) / ".git"
    owned_by_admin = str(common / "worktrees") + os.sep
    registered = {str(Path(entry["path"]).resolve()) for entry in parse_worktrees(main_path)}
    found = []
    seen = set()
    for home in slice_homes(main_path, projects_root):
        try:
            children = sorted(home.iterdir())
        except OSError:
            continue
        for child in children:
            if not child.is_dir() or child.is_symlink():
                continue
            path = child.resolve()
            if str(path) == str(Path(main_path).resolve()) or str(path) in seen:
                continue
            if str(path) in registered:
                continue
            seen.add(str(path))
            target = gitdir_target(path)
            if target is not None:
                if str(target.resolve()).startswith(owned_by_admin):
                    found.append({"path": str(path), "stale": True, "branch": None,
                                  "head": None})
                continue
            if not slug or repo_slug(path) != slug:
                continue
            found.append({"path": str(path), "stale": False,
                          "branch": clone_branch(path), "head": clone_head(path)})
    return found


def clone_head(path):
    code, out, _ = git(["-C", str(path), "rev-parse", "HEAD"])
    return out.strip() if code == 0 else None


def clone_branch(path):
    code, out, _ = git(["-C", str(path), "symbolic-ref", "--short", "HEAD"])
    return out.strip() if code == 0 and out.strip() else None


def session_repo(session_cwd):
    """The main checkout of the repo the session works in, or None."""
    code, out, _ = git(["-C", session_cwd, "rev-parse", "--git-common-dir"])
    if code != 0:
        return None
    common = Path(out.strip())
    if not common.is_absolute():
        common = (Path(session_cwd) / common).resolve()
    if common.name != ".git":
        return None
    return common.parent


def discover_repos(projects_root):
    """Every project under the root, once. A leftover copy beside one is not a project.

    A chat names its copy after the repo it came from, so `<repo>-<ticket>` beside
    `<repo>` with the same origin is a slice of that project. The project's own pass
    removes it, and a sweep that also treated it as a project of its own would race
    that removal and read the same PR list twice.
    """
    repos = []
    if projects_root.is_dir():
        for child in sorted(projects_root.iterdir()):
            if child.is_dir() and is_main_checkout(child):
                repos.append(child.resolve())
    for share in SHARE_REPOS:
        path = Path.home() / share
        if is_main_checkout(path):
            repos.append(path.resolve())
    slugs = {repo: origin_slug_from_config(repo) for repo in repos}
    kept = []
    for repo in repos:
        copy_of = [other.name for other in repos
                   if other != repo and slugs.get(other) and slugs.get(other) == slugs.get(repo)
                   and repo.name.startswith(other.name + "-")]
        if copy_of:
            continue
        if repo not in kept:
            kept.append(repo)
    return kept


# -- git reads -----------------------------------------------------------

def parse_worktrees(repo):
    code, out, _ = git(["-C", str(repo), "worktree", "list", "--porcelain"])
    if code != 0:
        return []
    entries = []
    current = None
    for line in out.splitlines():
        if line.startswith("worktree "):
            current = {"path": line[len("worktree "):], "head": None, "branch": None}
            entries.append(current)
        elif current is None:
            continue
        elif line.startswith("HEAD "):
            current["head"] = line[len("HEAD "):]
        elif line.startswith("branch "):
            current["branch"] = line[len("branch "):].replace("refs/heads/", "", 1)
        elif line == "detached":
            current["branch"] = None
    return entries


def base_ref(repo):
    candidates = []
    code, out, _ = git(["-C", str(repo), "symbolic-ref", "--short",
                        "refs/remotes/origin/HEAD"])
    if code == 0 and out.strip():
        candidates.append(out.strip())
    candidates += ["origin/main", "origin/master", "origin/production"]
    for candidate in candidates:
        if git(["-C", str(repo), "rev-parse", "--verify", "--quiet",
                candidate + "^{commit}"])[0] == 0:
            return candidate
    return None


def commit_set(repo, *args):
    code, out, _ = git(["-C", str(repo), "rev-list", *args], timeout=600)
    return set(out.split()) if code == 0 else set()


def local_branches(repo):
    code, out, _ = git(["-C", str(repo), "for-each-ref",
                        "--format=%(refname:short) %(objectname)",
                        "refs/heads"])
    branches = {}
    if code == 0:
        for line in out.splitlines():
            name, _, sha = line.partition(" ")
            if name:
                branches[name] = sha
    return branches


def remote_branches(repo):
    """origin/<name> -> tip, with committer date, minus origin/HEAD."""
    code, out, _ = git(["-C", str(repo), "for-each-ref",
                        "--format=%(refname:short)%09%(committerdate:unix)%09%(objectname)",
                        "refs/remotes/origin"])
    branches = {}
    if code == 0:
        for line in out.splitlines():
            parts = line.split("\t")
            if len(parts) < 3 or parts[0] == "origin/HEAD":
                continue
            name = parts[0][len("origin/"):]
            if not name or name == "HEAD":
                continue
            try:
                date = int(parts[1])
            except ValueError:
                date = 0
            branches[name] = {"sha": parts[2], "date": date}
    return branches


SLUG = re.compile(r"github\.com[:/]+([^/]+)/(.+?)(?:\.git)?/?$")


def slug_from_url(url):
    match = SLUG.search(url or "")
    return "%s/%s" % (match.group(1), match.group(2)) if match else None


def repo_slug(repo):
    # git config, not `remote get-url`: a url.<base>.insteadOf rewrite would
    # turn the GitHub URL into the local path it fetches from.
    code, out, _ = git(["-C", str(repo), "config", "--get", "remote.origin.url"])
    if code != 0:
        return None
    return slug_from_url(out.strip())


def git_config_file(path):
    """The config that names this folder's remotes, with no child process."""
    dot = Path(path) / ".git"
    if dot.is_dir():
        return dot / "config"
    target = gitdir_target(path)
    if target is None:
        return None
    # A linked worktree's admin dir sits inside the main checkout's `.git`.
    if target.parent.name == "worktrees":
        return target.parent.parent / "config"
    return target / "config"


def origin_slug_from_config(path):
    """This folder's origin slug read straight from the file, never from a child.

    Discovery runs before any repo's own budget, so a git here has no deadline to
    die at: a hung filesystem or a stuck remote would run out GIT_TIMEOUT once per
    repo and hang the whole sweep. Discovery only needs to tell a project from its
    copies, and the config file answers that in one open.
    """
    config = git_config_file(path)
    if config is None:
        return None
    try:
        text = config.read_text(errors="replace")
    except OSError:
        return None
    section = None
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("["):
            section = line
            continue
        if section != '[remote "origin"]':
            continue
        key, sep, value = line.partition("=")
        if sep and key.strip() == "url":
            return slug_from_url(value.strip())
    return None


# -- github --------------------------------------------------------------

class Github:
    """PR and setting reads for one repo, cached for the run."""

    def __init__(self, repo):
        self.repo = repo
        self.slug = repo_slug(repo)
        self.ok = False
        self.merged = {}
        self.open = set()
        self.closed = {}
        self.protected = None
        self.setting = None

    def load(self):
        if not self.slug:
            return False
        code, out, err = gh(["pr", "list", "-R", self.slug, "--state", "all",
                             "--limit", str(PR_LIMIT), "--json", ALL_PR_FIELDS])
        if code != 0:
            self.error = err.strip().splitlines()[-1] if err.strip() else "gh failed"
            return False
        try:
            rows = json.loads(out or "[]")
        except ValueError:
            self.error = "gh returned unreadable JSON"
            return False
        for pr in rows:
            branch = pr.get("headRefName")
            if not branch:
                continue
            state = (pr.get("state") or "").upper()
            if pr.get("mergedAt") or state == "MERGED":
                self.merged.setdefault(branch, []).append(pr)
            elif state == "OPEN" or (not pr.get("closedAt") and not pr.get("mergedAt")):
                self.open.add(branch)
            elif not pr.get("mergedAt"):
                self.closed.setdefault(branch, []).append(pr)
        self.ok = True
        return True

    # -- queries --
    def merged_tip(self, branch, sha):
        return any(pr.get("headRefOid") == sha for pr in self.merged.get(branch, []))

    def closed_pr(self, branch):
        rows = self.closed.get(branch) or []
        return rows[0] if rows else None

    def age_days(self, pr):
        stamp = pr.get("closedAt") or pr.get("updatedAt")
        if not stamp:
            return None
        try:
            closed = time.mktime(time.strptime(stamp[:19], "%Y-%m-%dT%H:%M:%S"))
        except ValueError:
            return None
        return (time.time() - closed) / 86400.0

    def read_protected(self):
        if self.protected is not None:
            return self.protected
        self.protected = set()
        code, out, _ = gh(["api", "repos/%s/branches?protected=true&per_page=100" % self.slug,
                           "--jq", ".[].name"])
        if code == 0:
            self.protected = {name.strip() for name in out.splitlines() if name.strip()}
        return self.protected

    def read_setting(self):
        code, out, _ = gh(["api", "repos/%s" % self.slug, "--jq",
                           ".delete_branch_on_merge"])
        if code != 0:
            return None
        return out.strip() == "true"


# -- live use ------------------------------------------------------------

class Live:
    """One scan of processes, tmux panes and lease files for the whole run."""

    def __init__(self, roots):
        self.roots = [str(Path(root).resolve()) + os.sep for root in roots if root]
        self.cwds = set()
        self.files = []
        self.panes = set()
        self.leases = ""
        self.scan_processes()
        self.scan_tmux()
        self.scan_leases()

    def scan_processes(self):
        try:
            names = os.listdir("/proc")
        except OSError:
            return
        for name in names:
            if not name.isdigit():
                continue
            base = "/proc/" + name
            try:
                self.cwds.add(os.path.realpath(os.readlink(base + "/cwd")))
            except OSError:
                pass
            try:
                fds = os.listdir(base + "/fd")
            except OSError:
                continue
            for fd in fds:
                try:
                    target = os.readlink(base + "/fd/" + fd)
                except OSError:
                    continue
                if target.startswith("/") and any(target.startswith(r) for r in self.roots):
                    self.files.append(target)

    def scan_tmux(self):
        # Only real sockets: the tmux dir collects hundreds of dead files from
        # tests, and asking tmux about each one costs a process and a timeout.
        import stat as stat_module
        sockets = []
        tmp = os.environ.get("TMUX_TMPDIR") or "/tmp/tmux-%d" % os.getuid()
        cutoff = time.time() - RECENT_SECONDS
        try:
            for entry in Path(tmp).iterdir():
                try:
                    info = entry.lstat()
                except OSError:
                    continue
                # Dead test sockets pile up by the hundred; a socket only needs
                # probing when something wrote to its server recently.
                if stat_module.S_ISSOCK(info.st_mode) and info.st_mtime > cutoff:
                    sockets.append(str(entry))
        except OSError:
            pass
        sockets = sockets[:20]
        commands = [["tmux", "list-panes", "-a", "-F", "#{pane_current_path}"]]
        commands += [["tmux", "-S", sock, "list-panes", "-a", "-F",
                      "#{pane_current_path}"] for sock in sockets]
        for command in commands:
            code, out, _ = run_command(command, 5)
            if code == 0:
                self.panes.update(line.strip() for line in out.splitlines()
                                  if line.strip())

    def scan_leases(self):
        state = Path.home() / ".local/state"
        if not state.is_dir():
            return
        chunks = []
        for entry in state.glob("*lease*"):
            try:
                if entry.is_file() and entry.stat().st_size <= 500_000:
                    chunks.append(entry.read_text(errors="replace"))
            except OSError:
                continue
        self.leases = "\n".join(chunks)

    def in_use(self, path):
        target = str(Path(path).resolve())
        prefix = target + os.sep
        for cwd in self.cwds:
            if cwd == target or cwd.startswith(prefix):
                return "process cwd %s" % cwd
        for name in self.panes:
            resolved = os.path.realpath(name)
            if resolved == target or resolved.startswith(prefix):
                return "tmux pane %s" % name
        for filename in self.files:
            if filename.startswith(prefix):
                return "open file %s" % filename
        if target in self.leases:
            return "lease file names it"
        return None


def recently_touched(path, cutoff):
    """The newest file in the top two levels, or None."""
    try:
        for dirpath, dirnames, filenames in os.walk(str(path)):
            rel = os.path.relpath(dirpath, str(path))
            depth = 0 if rel == "." else rel.count(os.sep) + 1
            if depth >= 1:
                dirnames[:] = []
            else:
                dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS]
            for name in filenames:
                if name in SKIP_DIRS:
                    continue
                filename = os.path.join(dirpath, name)
                try:
                    if os.lstat(filename).st_mtime > cutoff:
                        return filename
                except OSError:
                    continue
    except OSError:
        return None
    return None


# -- per-repo work -------------------------------------------------------

def audit_in_progress(git_dir):
    git_dir = Path(git_dir)
    return any((git_dir / marker).exists()
               for marker in ("rebase-merge", "rebase-apply", "MERGE_HEAD"))


def worktree_status(path):
    """(tracked edits, untracked files), or None when git cannot answer."""
    code, out, err = git(["--no-optional-locks", "-C", str(path), "status",
                          "--porcelain", "--untracked-files=all"], timeout=GIT_TIMEOUT)
    if code != 0:
        return None, err
    tracked = []
    untracked = []
    for line in out.splitlines():
        if line.startswith("?? "):
            untracked.append(line[3:].strip())
        elif line.strip():
            tracked.append(line)
    return (tracked, untracked), ""


class RepoRun:
    def __init__(self, repo, opts, live):
        self.repo = Path(repo)
        self.opts = opts
        self.live = live
        self.plan = []
        self._slices = None
        self._main_path = None
        self._slice_cutoff = None
        self.result = {
            "repo": str(self.repo),
            "skipped": None,
            "base": None,
            "slug": None,
            "fetch_ok": False,
            "remote_decisions": False,
            "worktrees": {"removed": [], "held": [], "deferred": 0, "pruned": [],
                          "outside": 0},
            "slices": {"removed": [], "held": [], "deferred": 0, "pruned": []},
            "branches": {"deleted": [], "kept": [], "deferred": 0},
            "remote": {"deleted": [], "kept": [], "stale": [], "deferred": 0},
            "setting": {"before": None, "set": False, "changed": False},
            "freed_bytes": 0,
        }

    # action logging ----------------------------------------------------
    def note(self, verb, kind, target, detail):
        self.plan.append("%s %s %s (%s)" % (verb, kind, target, detail))

    def run(self):
        """The repo's whole budget. Children never outlive it."""
        set_deadline(self.opts.repo_timeout)
        try:
            return self.sweep()
        finally:
            clear_deadline()

    def sweep(self):
        before = free_bytes(self.opts.projects_root)
        result = self.result
        if not is_repo(self.repo):
            result["skipped"] = "not a repo"
            self.note("SKIP", "repo", self.repo, result["skipped"])
            return result
        # Given a linked worktree, work from the main checkout instead.
        entries = parse_worktrees(self.repo)
        if entries:
            self.repo = Path(entries[0]["path"]).resolve()
            result["repo"] = str(self.repo)
        code, out, _ = git(["-C", str(self.repo), "rev-parse", "--absolute-git-dir"])
        if code != 0:
            result["skipped"] = "git cannot read it"
            self.note("SKIP", "repo", self.repo, result["skipped"])
            return result
        if audit_in_progress(out.strip()):
            result["skipped"] = "mid-rebase or mid-merge, left alone"
            self.note("SKIP", "repo", self.repo, result["skipped"])
            return result

        self.budget = self.opts.max_remove
        base = base_ref(self.repo)
        result["base"] = base
        slug = repo_slug(self.repo)
        result["slug"] = slug

        if not slug:
            fetch_ok = False
            self.note("WARN", "repo", self.repo,
                      "no GitHub origin, fetch and remote decisions skipped")
        elif self.opts.apply:
            fetch_ok = git(["-C", str(self.repo), "fetch", "--prune", "--quiet", "origin"],
                           timeout=FETCH_TIMEOUT)[0] == 0
        else:
            code, out, _ = git(["-C", str(self.repo), "for-each-ref", "--format=%(refname)",
                                "refs/remotes/origin"])
            fetch_ok = code == 0 and bool(out.strip())
        result["fetch_ok"] = fetch_ok
        if slug and not fetch_ok:
            self.note("WARN", "repo", self.repo,
                      "fetch failed, remote-dependent decisions skipped")

        cutoff = time.time() - RECENT_SECONDS
        self._slice_cutoff = cutoff
        main_path = self.main_path(entries)
        self._main_path = main_path

        github = Github(self.repo)
        remote_ok = bool(slug) and fetch_ok and github.load()
        result["remote_decisions"] = remote_ok
        if fetch_ok and not remote_ok:
            reason = getattr(github, "error", "no GitHub slug") or "no GitHub slug"
            self.note("WARN", "repo", self.repo,
                      "gh failed (%s), remote decisions skipped" % reason)

        base_set = commit_set(self.repo, base) if base else set()
        remote_set = commit_set(self.repo, "--remotes") if fetch_ok else set()

        self.tidy_worktrees(base, base_set, remote_set, github, remote_ok, cutoff)
        # The cap is one repo's removal budget, and a repo's own worktrees come
        # first: they are the copies a chat made, so they are what --max-remove
        # defers last. Sibling folders spend whatever is left.
        self.tidy_slices(base, base_set, remote_set, github, remote_ok, cutoff,
                         main_path)
        self.tidy_local_branches(base, base_set, github, remote_ok)
        if remote_ok:
            self.tidy_remote_branches(base, base_set, github)
            if not self.opts.mine:
                self.tidy_setting(github)
        removed = (len(result["worktrees"]["removed"]) + len(result["branches"]["deleted"])
                   + len(result["remote"]["deleted"]) + len(result["slices"]["removed"]))
        # statvfs is the whole filesystem, so a dry run frees nothing and a run
        # that removed nothing reports nothing.
        if self.opts.apply and removed:
            result["freed_bytes"] = max(0, free_bytes(self.opts.projects_root) - before)
        return result

    @staticmethod
    def main_path(entries):
        return str(Path(entries[0]["path"]).resolve()) if entries else None

    def slice_rows(self):
        """This project's other folders, found once and read by both passes."""
        if self._slices is None:
            self._slices = slice_candidates(self.repo, self._main_path,
                                            self.opts.projects_root, repo_slug(self.repo))
        return self._slices

    # sibling slices ----------------------------------------------------
    def tidy_slices(self, base, base_set, remote_set, github, remote_ok, cutoff,
                    main_path):
        """Clean this project's other folders: stale registrations and old clones.

        A chat's copy belongs to the project, not to the chat that left it, so these
        are the missed cleanups a chat starting on the project finishes. The same four
        gates judge each one: a clone's own tip is what shipped or did not, and the same
        merged-PR and remote reads answer for it. --mine never reaches them.
        """
        if self.opts.mine or not main_path:
            return
        candidates = self.slice_rows()
        for row in [row for row in candidates if row["stale"]]:
            # A folder whose admin is gone cannot answer git status, so nothing here
            # can promise it holds no uncommitted work. It is named and left alone.
            self.hold_slice(row["path"], "unreadable",
                            "its git registration is gone, so git cannot check its "
                            "files; remove it by hand once you have looked")
        live = [row for row in candidates if not row["stale"]]
        if not live:
            return

        def one(row):
            return row, self.verdict_for(row, base, base_set, remote_set, github,
                                         remote_ok, cutoff)

        workers = min(8, (os.cpu_count() or 2))
        left = (getattr(_STATE, "deadline", None) or 0) - time.monotonic()
        with ThreadPoolExecutor(max_workers=workers, initializer=set_deadline,
                                initargs=(left,)) as pool:
            verdicts = list(pool.map(one, live))
        for row, verdict in verdicts:
            kind, reason = verdict
            if kind != "remove":
                self.hold_slice(row["path"], reason[0], reason[1])
                continue
            self.remove_slice(row["path"], main_path, reason[1])

    def hold_slice(self, path, reason, detail):
        self.result["slices"]["held"].append(
            {"path": path, "reason": reason, "detail": detail})
        self.note("HOLD", "slice", path, "%s: %s" % (reason, detail))

    def remove_slice(self, path, main_path, why):
        if self.budget <= 0:
            self.result["slices"]["deferred"] += 1
            self.note("DEFER", "slice", path, "over --max-remove")
            return
        if self.opts.apply:
            removed, detail = self.remove_clone(path, main_path)
            if not removed:
                self.hold_slice(path, "remove-failed", detail)
                return
        self.budget -= 1
        self.result["slices"]["removed"].append({"path": path, "why": why})
        self.note("REMOVE", "slice", path, why)

    def remove_clone(self, path, main_path):
        """rm -rf a folder this run checked, behind the same last walls."""
        target = Path(path)
        if main_path and str(target.resolve()) == str(Path(main_path).resolve()):
            return False, "refused: main checkout"
        if not under(target, self.opts.projects_root):
            return False, "refused: outside the projects root"
        if str(target.resolve()) == str(Path(self.opts.projects_root).resolve()):
            return False, "refused: that is the projects root itself"
        if str(Path.home() / FORBIDDEN) in str(target.resolve()):
            return False, "refused: vcc evidence"
        status, err = worktree_status(path)
        if status is None or status[0] or status[1]:
            return False, "changed since the scan: " + (
                (err or "").strip() or "%d tracked, %d untracked" % (
                    len(status[0]), len(status[1])))
        use = self.live.in_use(path) or recently_touched(path, self._slice_cutoff)
        if use:
            return False, "started using it since the scan: " + str(use)
        try:
            shutil.rmtree(str(target))
        except OSError as exc:
            return False, "rm -rf failed: %s" % exc
        return True, "removed"

    # worktrees ---------------------------------------------------------
    def tidy_worktrees(self, base, base_set, remote_set, github, remote_ok, cutoff):
        entries = parse_worktrees(self.repo)
        if not entries:
            return
        main_path = str(Path(entries[0]["path"]).resolve())

        candidates = entries[1:]
        if self.opts.mine:
            candidates = [e for e in candidates if e.get("branch") == self.opts.branch]
        missing = [e for e in candidates if not Path(e["path"]).exists()]
        for entry in missing:
            if self.opts.mine:
                if not under(entry["path"], self.opts.projects_root) or self.live.in_use(entry["path"]):
                    self.note("HOLD", "registration", entry["path"], "outside root or in use")
                    continue
                if self.opts.apply:
                    code, _, err = git(["-C", str(self.repo), "worktree", "remove", entry["path"]])
                    if code != 0:
                        self.note("HOLD", "registration", entry["path"], err.strip())
                        continue
            elif self.opts.apply:
                git(["-C", str(self.repo), "worktree", "prune"])
            self.result["worktrees"]["pruned"].append(entry["path"])
            self.note("PRUNE", "worktree", entry["path"], "directory is gone")

        candidates = [e for e in candidates if Path(e["path"]).exists()]
        verdicts = self.inspect_worktrees(
            candidates, base, base_set, remote_set, github, remote_ok, cutoff)

        for entry, verdict in verdicts:
            kind, reason = verdict
            path = entry["path"]
            if reason[0] == "outside":
                self.result["worktrees"]["outside"] += 1
            if kind != "remove":
                self.result["worktrees"]["held"].append(
                    {"path": path, "reason": reason[0], "detail": reason[1]})
                self.note("HOLD", "worktree", path, "%s: %s" % reason)
                continue
            if self.budget <= 0:
                self.result["worktrees"]["deferred"] += 1
                self.note("DEFER", "worktree", path, "over --max-remove")
                continue
            if not self.opts.apply:
                self.budget -= 1
                self.result["worktrees"]["removed"].append({"path": path, "why": reason[1]})
                self.note("REMOVE", "worktree", path, reason[1])
                continue
            # Last look before the destructive call: the scan above took a
            # while, and another session may have started in here since.
            status, err = worktree_status(path)
            if status is None or status[0] or status[1]:
                detail = "changed since the scan: " + (
                    (err or "").strip() or "%d tracked, %d untracked" % (
                        len(status[0]), len(status[1])))
                self.result["worktrees"]["held"].append(
                    {"path": path, "reason": "wip", "detail": detail})
                self.note("HOLD", "worktree", path, "wip: " + detail)
                continue
            use = self.live.in_use(path) or recently_touched(path, cutoff)
            if use:
                detail = "started using it since the scan: " + str(use)
                self.result["worktrees"]["held"].append(
                    {"path": path, "reason": "in use", "detail": detail})
                self.note("HOLD", "worktree", path, "in use: " + detail)
                continue
            removed, detail = self.remove_worktree(path, main_path)
            if removed:
                self.budget -= 1
                self.result["worktrees"]["removed"].append({"path": path, "why": reason[1]})
                self.note("REMOVE", "worktree", path, reason[1])
            else:
                self.result["worktrees"]["held"].append(
                    {"path": path, "reason": "remove-failed", "detail": detail})
                self.note("HOLD", "worktree", path, "remove failed: " + detail)

    def inspect_worktrees(self, entries, base, base_set, remote_set, github,
                          remote_ok, cutoff):
        def one(entry):
            return entry, self.verdict_for(entry, base, base_set, remote_set,
                                           github, remote_ok, cutoff)

        workers = min(8, (os.cpu_count() or 2))
        left = (getattr(_STATE, "deadline", None) or 0) - time.monotonic()
        with ThreadPoolExecutor(max_workers=workers, initializer=set_deadline,
                                initargs=(left,)) as pool:
            return list(pool.map(one, entries))

    def verdict_for(self, entry, base, base_set, remote_set, github, remote_ok, cutoff):
        path = Path(entry["path"])
        head = entry.get("head")
        branch = entry.get("branch")
        if not under(path, self.opts.projects_root):
            return "hold", ("outside", "outside the projects root, reported only")

        status, err = worktree_status(path)
        if status is None:
            return "hold", ("unreadable", "git status failed: " + (err or "").strip())
        tracked, untracked = status
        if tracked:
            return "hold", ("wip", "%d tracked file(s) edited" % len(tracked))
        if untracked:
            shown = ", ".join(untracked[:5])
            more = "" if len(untracked) <= 5 else " (+%d more)" % (len(untracked) - 5)
            return "hold", ("scratch", "untracked: %s%s" % (shown, more))

        shipped = None
        if head and head in base_set:
            shipped = "tip is in %s" % base
        elif branch and remote_ok and github.merged_tip(branch, head):
            shipped = "merged PR carries this tip"
        elif branch and remote_ok:
            pr = github.closed_pr(branch)
            age = github.age_days(pr) if pr else None
            if (pr and age is not None and age > STALE_CLOSED_DAYS
                    and (head in remote_set or pr.get("headRefOid") == head)):
                shipped = "PR closed %d days ago, commit is on the remote" % age
        if not shipped:
            if branch is None:
                return "hold", ("unshipped",
                                "detached HEAD, commit is on no remote ref")
            return "hold", ("unshipped", "no merged PR and not in %s" % (base or "base"))

        use = self.live.in_use(path)
        if use:
            return "hold", ("in use", use)
        touched = recently_touched(path, cutoff)
        if touched:
            return "hold", ("in use", "touched in the last 2 hours: %s" % touched)
        return "remove", ("shipped", shipped)

    def remove_worktree(self, path, main_path):
        target = Path(path)
        if str(target.resolve()) == main_path:
            return False, "refused: main worktree"
        if not self.is_registered(str(target)):
            return False, "refused: not a registered worktree"
        if not under(target, self.opts.projects_root):
            return False, "refused: outside the projects root"
        if str(target.resolve()) == str(Path(self.opts.projects_root).resolve()):
            return False, "refused: that is the projects root itself"
        if str(Path.home() / FORBIDDEN) in str(target.resolve()):
            return False, "refused: vcc evidence"
        git(["-C", str(self.repo), "worktree", "remove", "--force", str(target)])
        if target.exists():
            if self.is_registered(str(target)):
                return False, "git kept it registered"
            if not under(target, self.opts.projects_root):
                return False, "refused: outside the projects root"
            try:
                shutil.rmtree(str(target))
            except OSError as exc:
                return False, "rm -rf failed: %s" % exc
        if not self.opts.mine:
            git(["-C", str(self.repo), "worktree", "prune"])
        return True, "removed"

    def is_registered(self, path):
        target = str(Path(path).resolve())
        return any(str(Path(entry["path"]).resolve()) == target
                   for entry in parse_worktrees(self.repo))

    # local branches ----------------------------------------------------
    def tidy_local_branches(self, base, base_set, github, remote_ok):
        branches = local_branches(self.repo)
        if not branches:
            return
        expected = self.expected_base(base)
        removed = {str(Path(row["path"]).resolve())
                   for row in self.result["worktrees"]["removed"]}
        worktree_branches = set()
        for entry in parse_worktrees(self.repo):
            path = Path(entry["path"])
            if not path.exists():
                continue
            # A dry run has not removed anything yet, so count a worktree this
            # run plans to remove as already gone, and its branch as free.
            if str(path.resolve()) in removed:
                continue
            if entry.get("branch"):
                worktree_branches.add(entry["branch"])
        code, out, _ = git(["-C", str(self.repo), "symbolic-ref", "--short", "HEAD"])
        current = out.strip() if code == 0 else None
        remote = remote_branches(self.repo)

        for name, sha in sorted(branches.items()):
            if self.opts.mine and name != self.opts.branch:
                continue
            if name == expected:
                continue
            if name in worktree_branches or name == current:
                self.result["branches"]["kept"].append(
                    {"name": name, "reason": "in use", "detail": "checked out"})
                continue
            why = None
            if sha in base_set:
                why = "tip is in %s" % base
            elif remote_ok and github.merged_tip(name, sha):
                why = "merged PR carries this tip"
            elif remote_ok and name in github.open:
                self.result["branches"]["kept"].append(
                    {"name": name, "reason": "open PR", "detail": "PR still open"})
                self.note("KEEP", "branch", name, "open PR")
                continue
            elif remote_ok:
                pr = github.closed_pr(name)
                age = github.age_days(pr) if pr else None
                local_tip = remote.get(name, {}).get("sha")
                if pr and age is not None and age > STALE_UNMERGED_PR_DAYS and local_tip == sha:
                    why = "PR closed unmerged %d days ago, tip is on the remote" % age
                elif pr and age is not None:
                    detail = "closed-unmerged PR %d days old, under %d" % (
                        age, STALE_UNMERGED_PR_DAYS)
                    self.result["branches"]["kept"].append(
                        {"name": name, "reason": "unshipped", "detail": detail})
                    self.note("KEEP", "branch", name, detail)
                    continue
            if not why:
                ahead = git(["-C", str(self.repo), "rev-list", "--count", sha,
                             "--not", "--remotes"])
                count = ahead[1].strip() if ahead[0] == 0 else "?"
                detail = "unpushed: %s commits" % count
                self.result["branches"]["kept"].append(
                    {"name": name, "reason": "unpushed", "detail": detail})
                self.note("KEEP", "branch", name, detail)
                continue
            if self.budget <= 0:
                self.result["branches"]["deferred"] += 1
                self.note("DEFER", "branch", name, "over --max-remove")
                continue
            if self.opts.apply:
                code, _, err = git(["-C", str(self.repo), "branch", "-D", name])
                if code != 0:
                    self.result["branches"]["kept"].append(
                        {"name": name, "reason": "delete-failed", "detail": err.strip()})
                    self.note("HOLD", "branch", name, "delete failed: " + err.strip())
                    continue
            self.budget -= 1
            self.result["branches"]["deleted"].append({"name": name, "why": why})
            self.note("DELETE", "branch", name, why)

    def expected_base(self, base):
        if not base:
            return None
        return base[len("origin/"):] if base.startswith("origin/") else base

    # remote branches ---------------------------------------------------
    def tidy_remote_branches(self, base, base_set, github):
        remote = remote_branches(self.repo)
        if not remote:
            return
        default = self.expected_base(base)
        protected = github.read_protected()
        candidates = []
        for name, info in sorted(remote.items()):
            if self.opts.mine and name != self.opts.branch:
                continue
            if name == default:
                continue
            if name in github.open:
                self.result["remote"]["kept"].append(
                    {"name": name, "reason": "open PR"})
                self.note("KEEP", "remote", "origin/" + name, "open PR")
                continue
            if name in protected:
                self.result["remote"]["kept"].append(
                    {"name": name, "reason": "protected"})
                self.note("KEEP", "remote", "origin/" + name, "protected branch")
                continue
            sha = info["sha"]
            if sha in base_set:
                candidates.append((name, "tip is in %s" % base))
            elif github.merged_tip(name, sha):
                candidates.append((name, "merged PR carries this tip"))
            elif github.merged.get(name):
                self.result["remote"]["kept"].append(
                    {"name": name, "reason": "merged PR, different tip"})
                self.note("KEEP", "remote", "origin/" + name,
                          "merged PR does not carry this tip, commits after the merge")
            else:
                pr = github.closed_pr(name)
                if pr:
                    age = github.age_days(pr)
                    detail = "PR closed unmerged %s days ago" % (
                        "?" if age is None else int(age))
                    self.result["remote"]["kept"].append(
                        {"name": name, "reason": "closed PR", "detail": detail})
                    self.note("KEEP", "remote", "origin/" + name, detail)
                    continue
                age = int((time.time() - info["date"]) / 86400)
                self.result["remote"]["stale"].append({"name": name, "age_days": age})
        self.result["remote"]["stale"].sort(key=lambda row: -row["age_days"])
        for row in self.result["remote"]["stale"][:10]:
            self.note("STALE", "remote", "origin/" + row["name"],
                      "%d days old, no merged PR, left alone" % row["age_days"])
        for name, why in candidates:
            if self.budget <= 0:
                self.result["remote"]["deferred"] += 1
                self.note("DEFER", "remote", "origin/" + name, "over --max-remove")
                continue
            if self.opts.apply:
                code, _, err = git(["-C", str(self.repo), "push", "origin", "--delete", name])
                if code != 0:
                    self.result["remote"]["kept"].append(
                        {"name": name, "reason": "delete-failed", "detail": err.strip()})
                    self.note("HOLD", "remote", "origin/" + name,
                              "delete failed: " + err.strip())
                    continue
            self.budget -= 1
            self.result["remote"]["deleted"].append({"name": name, "why": why})
            self.note("DELETE", "remote", "origin/" + name, why)

    # github setting ----------------------------------------------------
    def tidy_setting(self, github):
        if not github.slug:
            return
        owner = github.slug.split("/")[0]
        if owner not in OWNERS_THAT_ALLOW_THE_SETTING:
            return
        before = github.read_setting()
        self.result["setting"]["before"] = before
        if before is None or before:
            return
        self.result["setting"]["changed"] = True
        if not self.opts.apply:
            self.note("SET", "setting", github.slug, "delete_branch_on_merge=true")
            return
        code, _, err = gh(["api", "-X", "PATCH", "repos/%s" % github.slug,
                           "-F", "delete_branch_on_merge=true"])
        if code == 0:
            self.result["setting"]["set"] = True
            self.note("SET", "setting", github.slug, "delete_branch_on_merge=true")
        else:
            self.note("HOLD", "setting", github.slug, "PATCH failed: " + err.strip())


# -- reporting -----------------------------------------------------------

def hold_counts(rows):
    counts = {"wip": 0, "in use": 0, "unshipped": 0}
    for row in rows:
        reason = row["reason"]
        if reason in ("wip", "scratch"):
            counts["wip"] += 1
        elif reason in ("in use", "unreadable", "remove-failed"):
            counts["in use"] += 1
        elif reason != "outside":
            counts["unshipped"] += 1
    return counts


def summarise(result, apply):
    work = result["worktrees"]
    branches = result["branches"]
    remote = result["remote"]
    counts = hold_counts(work["held"])
    verb = "removed" if apply else "would-remove"
    freed = result["freed_bytes"] / 1e9
    stale = len(remote["stale"])
    slices = result.get("slices") or {"removed": [], "held": [], "deferred": 0}
    line = ("%s: worktrees %s %d held %d (wip %d, in-use %d, unshipped %d) | "
            "local branches deleted %d kept %d | remote deleted %d stale-unPR'd %d "
            "| freed ~%.1f GB" % (
                Path(result["repo"]).name, verb, len(work["removed"]),
                len(work["held"]) + work["deferred"], counts["wip"], counts["in use"],
                counts["unshipped"], len(branches["deleted"]), len(branches["kept"]),
                len(remote["deleted"]), stale, freed))
    # A repo with no sibling folders keeps the line every reader already parses.
    if slices["removed"] or slices["held"] or slices["deferred"]:
        line += (" | sibling folders %s %d held %d" % (
            verb, len(slices["removed"]), len(slices["held"]) + slices["deferred"]))
    return line


def deferred_line(result):
    work = result["worktrees"]["deferred"]
    branches = result["branches"]["deferred"]
    remote = result["remote"]["deferred"]
    slices = (result.get("slices") or {}).get("deferred", 0)
    if not (work or branches or remote or slices):
        return None
    return ("DEFERRED %d worktree removals, %d sibling folder removals, "
            "%d branch deletions, %d remote deletions (--max-remove %d)" % (
                work, slices, branches, remote, result["max_remove"]))


def write_run_log(payload, stamp):
    directory = Path.home() / ".local/state/repo-tidy"
    try:
        directory.mkdir(parents=True, exist_ok=True)
        path = directory / ("%s.json" % stamp.replace(":", ""))
        path.write_text(json.dumps(payload, indent=2) + "\n")
        return path
    except OSError as exc:
        sys.stderr.write("repo-tidy: cannot write run log: %s\n" % exc)
        return None


def lower_priority():
    """Take less of the host than everyone else on it."""
    try:
        os.nice(NICE_INCREMENT)
    except OSError as exc:
        sys.stderr.write("repo-tidy: cannot lower its priority: %s\n" % exc)


def load_probe():
    """ADD, CAREFUL, HOLD, or None when the probe cannot answer."""
    path = Path.home() / ".local/bin/vps-state"
    if not (path.is_file() and os.access(str(path), os.X_OK)):
        return None
    code, _, err = run_command([str(path), "--can-launch", "worker", "--no-write"],
                               PROBE_TIMEOUT)
    if err.startswith("timeout after") or err.startswith("[Errno"):
        return None
    return {0: "ADD", 1: "CAREFUL", 2: "HOLD"}.get(code)


def sweep_jobs(requested):
    """Repos in flight, and the reason for that number."""
    if requested is not None:
        return requested, "given"
    verdict = load_probe()
    if verdict is None:
        return 1, "no probe"
    return JOBS_AT_VERDICT[verdict], verdict.lower()


# -- the chat's own quick check ------------------------------------------

def local_owed(repo, opts, live, seen, cutoff):
    """The cleanups this repo still owes, judged from local git alone.

    An item counts only when it is past the gates that need no network: clean, and
    neither in use nor touched in the last two hours. Whether its work shipped is
    then a local question, because a merged branch's tip is in the base or on a
    remote ref, and every commit a left behind folder keeps is in one of the two.
    What local git cannot see, such as a squash merge, is not guessed at: those
    wait for --apply, which asks GitHub.
    """
    owed = []
    entries = parse_worktrees(repo)
    for entry in entries[1:]:
        path = Path(entry["path"])
        if not under(path, opts.projects_root):
            continue
        if not path.exists():
            owed.append(entry["path"])
            continue
        if entry.get("head") not in seen:
            continue
        status, _ = worktree_status(path)
        if status is None or status[0] or status[1]:
            continue
        if live.in_use(path) or recently_touched(path, cutoff):
            continue
        owed.append(entry["path"])
    return owed


def slice_owed(repo, opts, live, seen, cutoff):
    """The sibling folders of this project this repo could clean without the network."""
    owed = []
    main_path = RepoRun.main_path(parse_worktrees(repo))
    if not main_path:
        return owed
    for row in slice_candidates(repo, main_path, opts.projects_root, repo_slug(repo)):
        path = Path(row["path"])
        if row["stale"]:
            owed.append(row["path"])
            continue
        if not under(path, opts.projects_root) or not path.exists():
            continue
        if row.get("head") not in seen:
            continue
        status, _ = worktree_status(path)
        if status is None or status[0] or status[1]:
            continue
        if live.in_use(path) or recently_touched(path, cutoff):
            continue
        owed.append(row["path"])
    return owed


def quick_sweep(repos, opts):
    """One TIDY line per cleanup owed, and one PASS line when nothing is owed."""
    live = Live([opts.projects_root] + repos)
    cutoff = time.time() - RECENT_SECONDS
    owed = []
    for repo in repos:
        entries = parse_worktrees(repo)
        repo = Path(entries[0]["path"]).resolve() if entries else repo
        seen = commit_set(repo, "--remotes")
        base = base_ref(repo)
        if base:
            seen |= commit_set(repo, base)
        owed += local_owed(repo, opts, live, seen, cutoff)
        if not opts.mine:
            owed += slice_owed(repo, opts, live, seen, cutoff)
    for path in sorted(set(owed)):
        print("TIDY %s" % path)
    if not owed:
        print("tidy: PASS")
    return 0


# -- hygiene: idle build caches and this project's own /tmp ---------------

class TimeBudget:
    """A wall-clock cap for one hygiene run, so a chat's call answers in seconds."""

    def __init__(self, seconds):
        self.deadline = time.monotonic() + max(0.5, float(seconds))

    def left(self):
        return self.deadline - time.monotonic()

    def spent(self):
        return self.left() <= 0


def newest_shallow(path, depth=1, budget=None, cap=4000, skip=()):
    """The newest mtime in the top `depth` levels of a folder, and its name.

    Shallow on purpose: a chat working in a folder touches files at its top, and a
    build adds entries at the top of its output. Walking a whole node_modules to
    answer costs more than the disk it saves. Git admin is skipped, because a
    fetch is not somebody using this folder.
    """
    newest, where, seen = None, None, 0
    stack = [(str(path), 0)]
    while stack:
        if budget is not None and budget.spent():
            break
        current, level = stack.pop()
        try:
            entries = list(os.scandir(current))
        except OSError:
            continue
        for entry in entries:
            seen += 1
            if seen > cap:
                return newest, where, True
            if entry.name == ".git" or entry.name in skip:
                continue
            try:
                info = entry.stat(follow_symlinks=False)
            except OSError:
                continue
            if newest is None or info.st_mtime > newest:
                newest, where = info.st_mtime, entry.path
            if entry.is_dir(follow_symlinks=False) and level + 1 < depth + 1:
                stack.append((entry.path, level + 1))
    return newest, where, seen > cap


def tree_bytes(path, budget=None, cap=20000):
    """Bytes under a folder, never following a link, bounded so it answers fast.

    Returns (bytes, truncated). A truncated count is a floor, and the caller says so,
    because an underreported size reads as a small win when it is a large one.
    """
    total, seen = 0, 0
    stack = [str(path)]
    while stack:
        if budget is not None and budget.spent():
            return total, True
        current = stack.pop()
        try:
            entries = list(os.scandir(current))
        except OSError:
            continue
        for entry in entries:
            seen += 1
            if seen > cap:
                return total, True
            try:
                info = entry.stat(follow_symlinks=False)
            except OSError:
                continue
            if entry.is_dir(follow_symlinks=False):
                stack.append(entry.path)
            elif entry.is_file(follow_symlinks=False):
                total += info.st_size
    return total, False


def size_text(bytes_count, truncated):
    """A size a person reads, marked as a floor when the walk was cut short."""
    text = human_bytes(bytes_count)
    return ("at least " + text) if truncated else text


def tracked_inside(folder, name):
    """True when git tracks any file under this build output folder.

    A tracked file in a build output folder means the folder is not pure output, so
    removing it would delete work. One git call, scoped to that path.
    """
    code, out, _ = git(["--no-optional-locks", "-C", str(folder), "ls-files", "--",
                        name], timeout=GIT_TIMEOUT)
    return code != 0 or bool(out.strip())


def project_name(repo):
    """The name a chat gives its copies and its /tmp entries: the checkout's folder."""
    return Path(repo).resolve().name


def tmp_prefixes(name):
    return (name + "-", name + ".")


class Hygiene:
    """Reclaim disk in this project's own idle folders, in seconds, gated.

    Two jobs, both scoped to the project named on the command line so a chat never
    reaches another project's disk:

    caches   rebuildable build output inside this project's idle folders. The
             folder must be idle 48 hours, nobody's process or tmux pane may sit in
             it, and no lease may name it. Inside, only known output directories go,
             and only when they hold no git-tracked file.
    tmp      this project's own /tmp entries, older than 48 hours and held open by
             nobody.

    Dry run unless --apply. Every removal spends one of --max-remove.
    """

    def __init__(self, repo, opts, live):
        self.repo = Path(repo).resolve()
        self.opts = opts
        self.live = live
        self.budget = TimeBudget(opts.time_budget)
        self.cap = opts.max_remove
        self.rows = []
        self.cutoff = time.time() - IDLE_SECONDS

    # -- rows --
    def row(self, kind, path, action, reason, detail, size=None):
        row = {"kind": kind, "path": str(path), "action": action,
               "reason": reason, "detail": detail, "bytes": size,
               "exact": True}
        self.rows.append(row)
        return row

    # -- the project's own folders, never the main checkout --
    def folders(self):
        entries = parse_worktrees(self.repo)
        main = Path(entries[0]["path"]).resolve() if entries else self.repo
        found = []
        for entry in entries[1:]:
            path = Path(entry["path"])
            if path.exists() and under(path, self.opts.projects_root):
                found.append(path.resolve())
        if entries:
            for row in slice_candidates(self.repo, main, self.opts.projects_root,
                                        repo_slug(self.repo)):
                path = Path(row["path"])
                if path.exists() and path.resolve() != main:
                    found.append(path.resolve())
        unique = []
        for path in found:
            if path not in unique and path != main:
                unique.append(path)
        return unique

    # -- idleness --
    def idle_detail(self, folder, budget):
        """(reason, detail) when this folder is not idle, else (None, idle sentence)."""
        use = self.live.in_use(folder)
        if use:
            return "in use", use
        newest, where, capped = newest_shallow(folder, depth=1, budget=budget,
                                               skip=BUILD_OUTPUT_DIRS)
        if newest is not None and newest > self.cutoff:
            hours = (time.time() - newest) / 3600.0
            return "in use", "touched {:.1f} hours ago: {}".format(hours, where)
        if capped and newest is not None:
            return "in use", ("more entries than one read takes, so its idleness is "
                              "not proven")
        if newest is None:
            return None, "no files to time"
        days = (time.time() - newest) / 86400.0
        return None, "idle {:.0f} days".format(days)

    # -- job one: rebuildable build output --
    def prune_caches(self):
        for folder in self.folders():
            if self.budget.spent():
                self.row("cache", folder, "keep", "time budget",
                         "stopped at --time-budget before this folder")
                return
            reason, detail = self.idle_detail(folder, self.budget)
            if reason:
                self.row("cache", folder, "hold", reason,
                         "folder held, its build output stays: " + detail)
                continue
            for name in BUILD_OUTPUT_DIRS:
                if self.budget.spent():
                    self.row("cache", folder, "keep", "time budget",
                             "stopped at --time-budget inside this folder")
                    return
                self.prune_one(folder, name, detail)

    def prune_one(self, folder, name, idle):
        target = folder / name
        try:
            info = os.lstat(str(target))
        except OSError:
            return
        if not os.path.isdir(str(target)) or os.path.islink(str(target)):
            return
        # An output folder that is itself a repo or holds one is not pure output.
        if (target / ".git").exists():
            self.row("cache", target, "hold", "not-rebuildable",
                     "it holds its own git repo")
            return
        # The output directory's own mtime moves whenever a build adds or removes an
        # entry, which is the cheap signal that something is happening here. A build
        # that only rewrites files inside is caught by the live-process gate instead.
        newest = info.st_mtime
        if newest > self.cutoff:
            self.row("cache", target, "hold", "in use",
                     "its own entry list changed {:.1f} hours ago".format(
                         (time.time() - newest) / 3600.0))
            return
        if tracked_inside(folder, name):
            self.row("cache", target, "hold", "tracked",
                     "git tracks a file inside it, so it is not build output")
            return
        if self.cap <= 0:
            self.row("cache", target, "keep", "over --max-remove",
                     "deferred to the next run")
            return
        size, truncated = tree_bytes(target, self.budget)
        size_detail = size_text(size, truncated)
        if not self.opts.apply:
            self.cap -= 1
            row = self.row("cache", target, "remove", "rebuildable", "%s, %s" % (
                idle, size_detail), size)
            row["exact"] = not truncated
            return
        use = self.live.in_use(target)
        if use:
            self.row("cache", target, "hold", "in use", use)
            return
        try:
            shutil.rmtree(str(target))
        except OSError as exc:
            self.row("cache", target, "hold", "remove-failed", str(exc))
            return
        self.cap -= 1
        row = self.row("cache", target, "remove", "rebuildable", "%s, %s" % (
            idle, size_detail), size)
        row["exact"] = not truncated

    # -- job two: this project's own /tmp entries --
    def clean_tmp(self):
        root = Path(self.opts.tmp_root).resolve()
        name = project_name(self.repo)
        prefixes = tmp_prefixes(name)
        uid = os.getuid()
        try:
            names = sorted(os.listdir(str(root)))
        except OSError as exc:
            self.row("tmp", root, "keep", "unreadable", str(exc))
            return
        for entry in names:
            if self.budget.spent():
                self.row("tmp", root, "keep", "time budget",
                         "stopped at --time-budget while reading %s" % root)
                return
            if not (entry == name or entry.startswith(prefixes)):
                continue
            path = root / entry
            try:
                info = os.lstat(str(path))
            except OSError:
                continue
            if entry == name:
                # The bare project name in /tmp is a lock or a socket far more
                # often than a scratch folder, so it is named and left alone.
                self.row("tmp", path, "hold", "bare-name",
                         "named exactly %s, not %s-*: remove it by hand if it is yours"
                         % (name, name))
                continue
            if os.path.islink(str(path)):
                self.row("tmp", path, "hold", "symlink", "never followed")
                continue
            if info.st_uid != uid:
                self.row("tmp", path, "hold", "own-uid",
                         "owned by uid %d, not ours" % info.st_uid)
                continue
            if not (os.path.isfile(str(path)) or os.path.isdir(str(path))):
                self.row("tmp", path, "hold", "special-file",
                         "not a file or a directory")
                continue
            if entry.endswith((".lock", ".sock", ".pid")):
                # A lock or socket costs no space and another run may recreate it;
                # deleting one buys nothing and can break a service's coordination.
                self.row("tmp", path, "hold", "coordination-file",
                         "a lock, socket or pid file, which costs no disk")
                continue
            if info.st_mtime > time.time() - TMP_AGE_SECONDS:
                continue
            use = self.live.in_use(path)
            if use:
                self.row("tmp", path, "hold", "in use", use)
                continue
            if self.cap <= 0:
                self.row("tmp", path, "keep", "over --max-remove",
                         "deferred to the next run")
                continue
            age = (time.time() - info.st_mtime) / 86400.0
            if os.path.isdir(str(path)):
                size, truncated = tree_bytes(path, self.budget)
            else:
                size, truncated = info.st_size, False
            detail = "idle {:.0f} days, {}".format(age, size_text(size, truncated))
            if not self.opts.apply:
                self.cap -= 1
                row = self.row("tmp", path, "remove", "own-prefix", detail, size)
                row["exact"] = not truncated
                continue
            try:
                if os.path.isdir(str(path)):
                    shutil.rmtree(str(path))
                else:
                    os.unlink(str(path))
            except OSError as exc:
                self.row("tmp", path, "hold", "remove-failed", str(exc))
                continue
            self.cap -= 1
            row = self.row("tmp", path, "remove", "own-prefix", detail, size)
            row["exact"] = not truncated

    def run(self):
        if self.opts.prune_caches:
            self.prune_caches()
        if self.opts.clean_tmp:
            self.clean_tmp()
        return {"repo": str(self.repo), "rows": self.rows}


def human_bytes(count):
    if count is None:
        return "size unknown"
    if count >= 1024 ** 3:
        return "{:.1f} GB".format(count / 1024 ** 3)
    if count >= 1024 ** 2:
        return "{:.0f} MB".format(count / 1024 ** 2)
    if count >= 1024:
        return "{:.0f} KB".format(count / 1024)
    return "{} B".format(int(count))


HYGIENE_VERB = {"remove": ("PRUNE", "CLEAN"), "hold": ("HOLD", "HOLD"),
                "keep": ("KEEP", "KEEP")}


def hygiene_line(row, apply):
    """One readable line per item, in the shape the git passes already print."""
    pair = HYGIENE_VERB[row["action"]]
    verb = pair[0] if row["kind"] == "cache" else pair[1]
    if row["action"] == "remove" and not apply:
        verb = "WOULD-" + verb
    return "%s %s %s (%s: %s)" % (verb, row["kind"], row["path"], row["reason"],
                                   row["detail"])


def hygiene_summary(results, apply):
    """One summary line per repo: what went, what stayed, and what it freed."""
    lines = []
    for result in results:
        rows = result["rows"]
        cache = [row for row in rows if row["kind"] == "cache"]
        tmp = [row for row in rows if row["kind"] == "tmp"]
        freed = sum(row["bytes"] or 0 for row in rows if row["action"] == "remove")
        floor = any(not row.get("exact", True) for row in rows
                    if row["action"] == "remove")
        lines.append(
            "%s: build caches %s %d held %d | tmp entries %s %d held %d "
            "| freed %s%s" % (
                Path(result["repo"]).name,
                "pruned" if apply else "would-prune",
                len([row for row in cache if row["action"] == "remove"]),
                len([row for row in cache if row["action"] != "remove"]),
                "cleaned" if apply else "would-clean",
                len([row for row in tmp if row["action"] == "remove"]),
                len([row for row in tmp if row["action"] != "remove"]),
                "at least " if floor else "~",
                human_bytes(freed)))
    return lines


def run_hygiene(repos, opts):
    """The fast pass: build caches and /tmp, for the repos the selection named."""
    tmp_root = Path(opts.tmp_root).resolve()
    live = Live([opts.projects_root, tmp_root] + repos)
    results = []
    printed = 0
    if not opts.json:
        if not opts.apply:
            print("DRY RUN: nothing is removed; pass --apply to do it", flush=True)
    for repo in repos:
        runner = Hygiene(repo, opts, live)
        results.append(runner.run())
        if not opts.json:
            for row in runner.rows:
                print(hygiene_line(row, opts.apply), flush=True)
        printed += 1
    if not opts.json:
        for line in hygiene_summary(results, opts.apply):
            print(line, flush=True)
    payload = {
        "run_id": utc_stamp(),
        "apply": opts.apply,
        "prune_caches": opts.prune_caches,
        "clean_tmp": opts.clean_tmp,
        "tmp_root": str(tmp_root),
        "projects_root": str(opts.projects_root),
        "max_remove": opts.max_remove,
        "time_budget": opts.time_budget,
        "repos": results,
        "totals": {
            "repos": len(results),
            "caches_removed": sum(len([row for row in r["rows"] if row["kind"] == "cache"
                                        and row["action"] == "remove"]) for r in results),
            "tmp_removed": sum(len([row for row in r["rows"] if row["kind"] == "tmp"
                                    and row["action"] == "remove"]) for r in results),
            "held": sum(len([row for row in r["rows"] if row["action"] != "remove"])
                        for r in results),
            "freed_bytes": sum(row["bytes"] or 0 for r in results for row in r["rows"]
                               if row["action"] == "remove"),
        },
    }
    if opts.json:
        print(json.dumps(payload, indent=2))
    return 0


def main(argv):
    parser = argparse.ArgumentParser(prog="repo-tidy", add_help=True,
                                     description="Remove shipped worktrees and "
                                                 "branches, gated. Dry run by default.")
    parser.add_argument("--apply", action="store_true",
                        help="actually remove; without it this is a dry run")
    parser.add_argument("--all", action="store_true",
                        help="every repo under the projects root plus the two shares")
    parser.add_argument("--project", metavar="DIR", default=None,
                        help="this project only: its own folders beside DIR, never "
                             "another project's")
    parser.add_argument("--json", action="store_true", help="print full detail")
    parser.add_argument("--quick", action="store_true",
                        help="local git only, no gh, no fetch, no log: one TIDY line "
                             "per cleanup still owed, for a chat's own check")
    parser.add_argument("--prune-caches", action="store_true",
                        help="fast hygiene: remove rebuildable build output from this "
                             "project's folders idle over 48 hours")
    parser.add_argument("--clean-tmp", action="store_true",
                        help="fast hygiene: remove this project's own /tmp entries "
                             "older than 48 hours")
    parser.add_argument("--tmp-root", default="/tmp", metavar="DIR",
                        help="where --clean-tmp looks (default /tmp)")
    parser.add_argument("--time-budget", type=float, default=DEFAULT_TIME_BUDGET,
                        metavar="SECONDS",
                        help="wall-clock cap for a hygiene run (default %d)"
                             % DEFAULT_TIME_BUDGET)
    parser.add_argument("--mine", metavar="SESSION_CWD",
                        help="only this session's named branch in this repo")
    parser.add_argument("--branch", help="branch owned by this chat; required with --mine")
    parser.add_argument("--max-remove", type=int, default=DEFAULT_MAX_REMOVE,
                        help="cap deletions per repo per run (default %d)" % DEFAULT_MAX_REMOVE)
    parser.add_argument("--projects-root", default=None,
                        help="where worktrees may be deleted (default ~/projects)")
    parser.add_argument("--repo-timeout", type=int, default=DEFAULT_REPO_TIMEOUT,
                        help="seconds per repo before SKIPPED (default %d)" % DEFAULT_REPO_TIMEOUT)
    parser.add_argument("--jobs", type=int, default=None, metavar="N",
                        help="repos in flight, 1..%d (default: the load probe, else %d)"
                             % (MAX_JOBS, DEFAULT_JOBS))
    parser.add_argument("paths", nargs="*", help="repo paths")
    opts = parser.parse_args(argv)

    if bool(opts.mine) != bool(opts.branch):
        parser.error("--mine and --branch must be used together")
    if opts.mine and (opts.all or opts.paths or opts.project):
        parser.error("--mine cannot be combined with --all, --project or repo paths")
    if opts.project and (opts.all or opts.paths):
        parser.error("--project cannot be combined with --all or repo paths")
    if opts.quick and opts.apply:
        parser.error("--quick reads only; it never removes anything")
    hygiene = opts.prune_caches or opts.clean_tmp
    if hygiene and (opts.quick or opts.mine):
        parser.error("--prune-caches and --clean-tmp cannot be combined with --quick or --mine")
    if hygiene and opts.all:
        parser.error("--prune-caches and --clean-tmp are project-scoped: name one project "
                     "or one repo path, never --all")
    if opts.time_budget < 1:
        parser.error("--time-budget must be at least 1 second")
    if opts.max_remove < 0:
        parser.error("--max-remove must be 0 or more")
    if opts.repo_timeout < 1:
        parser.error("--repo-timeout must be at least 1")
    if opts.jobs is not None and not 1 <= opts.jobs <= MAX_JOBS:
        parser.error("--jobs must be between 1 and %d" % MAX_JOBS)
    opts.projects_root = Path(opts.projects_root or (Path.home() / "projects")).resolve()
    lower_priority()

    repos = []
    if opts.mine:
        repo = session_repo(opts.mine)
        if repo is None:
            return 0
        repos = [repo]
    elif opts.all:
        repos = discover_repos(opts.projects_root)
    elif opts.project:
        repo = session_repo(opts.project)
        if repo is None:
            sys.stderr.write("repo-tidy: %s is not in a git repo; nothing to clean\n"
                             % opts.project)
            return 2
        repos = [repo]
    elif opts.paths:
        repos = [Path(p).resolve() for p in opts.paths]
    else:
        repo = session_repo(Path.cwd())
        if repo is None:
            sys.stderr.write("repo-tidy: not in a git repo; pass --all or a path\n")
            return 2
        repos = [repo]

    if opts.quick:
        return quick_sweep(repos, opts)
    if hygiene:
        return run_hygiene(repos, opts)
    live = Live([opts.projects_root] + repos)
    sweep_workers, probe = sweep_jobs(opts.jobs)
    if len(repos) == 1:
        sweep_workers = 1
    stamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    started = time.time()
    results = []
    if not opts.json:
        if not opts.apply:
            print("DRY RUN: nothing is removed; pass --apply to do it", flush=True)
        print("jobs: %d (load probe: %s)" % (sweep_workers, probe), flush=True)

    def process_one(repo):
        runner = RepoRun(repo, opts, live)
        try:
            with ThreadPoolExecutor(max_workers=1) as pool:
                future = pool.submit(runner.run)
                try:
                    result = future.result(timeout=opts.repo_timeout + KILL_WAIT)
                except (FutureTimeout, Budget):
                    result = runner.result
                    reason = "exceeded %ds per-repo cap" % opts.repo_timeout
                    result["skipped"] = reason
                    runner.plan = ["SKIP repo %s (%s)" % (repo, reason)]
        except Exception as exc:  # one bad repo must not stop the sweep
            result = runner.result
            result["error"] = "%s: %s" % (type(exc).__name__, exc)
            runner.note("ERROR", "repo", repo, result["error"])
        result["max_remove"] = opts.max_remove
        return runner, result

    with ThreadPoolExecutor(max_workers=sweep_workers) as sweep:
        futures = [sweep.submit(process_one, repo) for repo in repos]
        for future in as_completed(futures):
            runner, result = future.result()
            results.append(result)
            if opts.json:
                continue
            for line in runner.plan:
                print(line, flush=True)
            print(summarise(result, opts.apply), flush=True)
            outside = result["worktrees"]["outside"]
            if outside:
                print("OUTSIDE %d worktrees outside %s, reported only (widen with "
                      "--projects-root)" % (outside, opts.projects_root), flush=True)
            deferred = deferred_line(result)
            if deferred:
                print(deferred, flush=True)

    payload = {
        "run_id": stamp,
        "apply": opts.apply,
        "mine": opts.mine,
        "all": opts.all,
        "projects_root": str(opts.projects_root),
        "max_remove": opts.max_remove,
        "jobs": sweep_workers,
        "probe": probe,
        "nice": os.nice(0),
        "duration_seconds": round(time.time() - started, 2),
        "repos": results,
        "totals": {
            "repos": len(results),
            "worktrees_removed": sum(len(r["worktrees"]["removed"]) for r in results),
            "worktrees_held": sum(len(r["worktrees"]["held"]) for r in results),
            "worktrees_outside": sum(r["worktrees"]["outside"] for r in results),
            "branches_deleted": sum(len(r["branches"]["deleted"]) for r in results),
            "remote_deleted": sum(len(r["remote"]["deleted"]) for r in results),
            "slices_removed": sum(len((r.get("slices") or {}).get("removed") or [])
                                  for r in results),
            "slices_held": sum(len((r.get("slices") or {}).get("held") or [])
                               for r in results),
            "freed_bytes": sum(r["freed_bytes"] for r in results),
        },
    }
    log = write_run_log(payload, stamp)
    if opts.json:
        print(json.dumps(payload, indent=2))
    elif log and not opts.mine:
        print("log: %s" % log, flush=True)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
