        item = ctx.candidate("caches", path, "remove", "ceo-runs-5m-2d",
                             "{} file untouched {} (rule over 5M and 2 days)".format(
                                 fmt_bytes(st.st_size), fmt_age(age)), age, st.st_size)
        act_on(item, ctx)


def tool_busy(ps, names):
    for row in ps or []:
        argv = row["args"].split()
        base = os.path.basename(argv[0]) if argv else ""
        if base in names:
            return row
    return None


def ps_table(ctx):
    if ctx.ps is None:
        ctx.ps = read_ps(ctx)
    return ctx.ps


def run_tool(command, ctx, label="run", part="caches", rule=None):
    rule = rule or label
    busy_with = tool_busy(ps_table(ctx), {os.path.basename(command[0])})
    if busy_with is not None:
        ctx.candidate(part, None, "keep", rule,
                      "{} is running (pid {}), so the cache is left alone".format(
                          os.path.basename(command[0]), busy_with["pid"]))
        return
    if shutil.which(command[0]) is None:
        ctx.candidate(part, None, "keep", rule,
                      "{} is not installed here".format(command[0]))
        return
    item = ctx.candidate(part, None, "prune", rule,
                         "run {}".format(" ".join(command)))
    if not ctx.applied:
        item["result"] = "would-run"
        return
    try:
        done = subprocess.run(command, capture_output=True, text=True,
                              timeout=max(10, min(120, ctx.budget.left() or 10)))
    except (OSError, subprocess.SubprocessError) as error:
        item["result"] = "failed"
        item["reason"] = "{} failed: {}".format(" ".join(command), error)
        return
    item["result"] = "ran" if done.returncode == 0 else "failed"
    item["reason"] = "{}: {}".format(" ".join(command),
                                     (done.stdout or done.stderr or "").strip()[:200] or "ok")
    item["bytes"] = 0


def tool_cache_commands(ctx):
    for command, rule in ((("npm", "cache", "clean", "--force"), "npm-clean"),
                          (("uv", "cache", "clean"), "uv-clean"),
                          (("pnpm", "store", "prune"), "pnpm-prune")):
        if ctx.budget.spent():
            return
        run_tool(list(command), ctx, rule=rule)


# ---------------------------------------------------------------- docker

def docker(ctx, args, timeout=60):
    if shutil.which("docker") is None:
        return None
    try:
        done = subprocess.run(["docker"] + args, capture_output=True, text=True,
                              timeout=max(5, min(timeout, ctx.budget.left() or 5)))
    except (OSError, subprocess.SubprocessError):
        return None
    return done.stdout if done.returncode == 0 else None


def scan_docker(ctx):
    if shutil.which("docker") is None:
        ctx.candidate("docker", None, "keep", "docker-missing", "docker is not on PATH")
        return
    used_percent = ctx.opts["used_percent"]
    dangling = docker(ctx, ["image", "ls", "--filter", "dangling=true",
                            "--format", "{{.ID}} {{.Size}}"], timeout=30)
    dangling = [line for line in (dangling or "").splitlines() if line.strip()]
    if used_percent is None or used_percent < DISK_PRUNE_PERCENT:
        ctx.candidate("docker", None, "keep", "docker-images-80",
                      "disk {:.1f}% used, below the {:.0f}% gate; {} dangling images kept".format(
                          used_percent or 0.0, DISK_PRUNE_PERCENT, len(dangling)))
    else:
        item = ctx.candidate("docker", None, "prune", "docker-images-80",
                             "disk {:.1f}% used, {} dangling images".format(
                                 used_percent, len(dangling)))
        if not ctx.applied:
            item["result"] = "would-run"
        else:
            out = docker(ctx, ["image", "prune", "-f"], timeout=300)
            item["result"] = "ran" if out is not None else "failed"
            item["reason"] = "docker image prune -f (dangling only)"
    builder = ctx.candidate("docker", None, "prune", "docker-builder-72h",
                            "docker builder prune --filter until=72h")
    if not ctx.applied:
        builder["result"] = "would-run"
    else:
        out = docker(ctx, ["builder", "prune", "-f", "--filter", "until=72h"], timeout=300)
        builder["result"] = "ran" if out is not None else "failed"
    names = docker(ctx, ["volume", "ls", "--filter", "name=ht-smoke-",
                         "--format", "{{.Name}}"], timeout=30)
    for name in sorted(line.strip() for line in (names or "").splitlines() if line.strip()):
        if not re.match(r"^ht-smoke-(build|state|dependencies)-", name):
            continue
        attached = docker(ctx, ["ps", "-a", "--filter", "volume={}".format(name),
                                "--format", "{{.ID}}"], timeout=30)
        if attached is None:
            ctx.candidate("docker", name, "keep", "docker-volumes-smoke",
                          "could not prove the volume is leaked, so it stays")
            continue
        if attached.strip():
            ctx.candidate("docker", name, "keep", "docker-volumes-smoke",
                          "volume is attached to a container")
            continue
        item = ctx.candidate("docker", name, "remove", "docker-volumes-smoke",
                             "leaked smoke volume, attached to nothing")
        if not ctx.applied:
            item["result"] = "would-remove"
            continue
        out = docker(ctx, ["volume", "rm", name], timeout=60)
        item["result"] = "removed" if out is not None else "failed"


# ---------------------------------------------------------------- processes

def read_ps(ctx):
    path = ctx.opts["ps_file"]
    if path:
        text = read_text(path, limit=None)
    else:
        try:
            done = subprocess.run(["ps", "-eo", "pid,ppid,uid,rss,pcpu,etimes,stat,args"],
                                  capture_output=True, text=True, timeout=10)
        except (OSError, subprocess.SubprocessError):
            return []
        text = done.stdout
    rows = []
    for line in (text or "").splitlines()[1:]:
        parts = line.split(None, 7)
        if len(parts) < 8:
            continue
        try:
            rows.append({"pid": int(parts[0]), "ppid": int(parts[1]), "uid": int(parts[2]),
                         "rss_kb": int(parts[3]), "cpu": float(parts[4]),
                         "etimes": int(parts[5]), "stat": parts[6], "args": parts[7].strip()})
        except ValueError:
            continue
    return rows


def read_link(path):
    try:
        return os.readlink(path)
    except OSError:
        return None


def process_facts(ctx, row, cache):
    pid = row["pid"]
    if pid in cache:
        return cache[pid]
    facts = {"cwd": read_link(os.path.join(ctx.proc, str(pid), "cwd")),
             "root": read_link(os.path.join(ctx.proc, str(pid), "root")),
             "home": None}
    environ = read_text(os.path.join(ctx.proc, str(pid), "environ"), limit=65536)
    for entry in (environ or "").split("\0"):
        if entry.startswith("HOME="):
            facts["home"] = entry.split("=", 1)[1]
            break
    cache[pid] = facts
    return facts


def basename_of(args):
    tokens = args.split()
    if not tokens:
        return ""
    return os.path.basename(tokens[0])


def process_kind(row):
    args = row["args"]
    base = basename_of(args)
    tokens = args.split()
    if base in ("headless_shell", "chrome-headless-shell", "agent-browser-chrome"):
        return "headless-browser"
    if "chroma-mcp" in args or "chroma_mcp" in args:
        return "chroma-mcp"
    if "agent-browser" in base or "agent-browser" in args:
        return "headless-browser"
    if base in ("chrome", "chromium", "google-chrome") and any(
            "--headless" in token or "headless" in token for token in tokens):
        return "headless-browser"
    if base in ("next", "vite") or "next dev" in args or base == "esbuild" and \
            ("--service" in tokens or "service" in tokens):
        return "dev-server"
    if base == "node" and ("next" in tokens and "dev" in tokens):
        return "dev-server"
    if base in PROVIDER_NAMES:
        return "provider"
    return "other"


def descendants(pid, children):
    found = []
    stack = list(children.get(pid, []))
    seen = set()
    while stack:
        current = stack.pop()
        if current in seen:
            continue
        seen.add(current)
        found.append(current)
        stack.extend(children.get(current, []))
    return found


def top_ancestor(row, by_pid):
    pid = row["ppid"]
    seen = set()
    while pid not in (0, 1) and pid not in seen:
        seen.add(pid)
        parent = by_pid.get(pid)
        if parent is None:
            return pid
        pid = parent["ppid"]
    return pid if pid in (0, 1) else pid


def proc_alive(pid, ctx):
    base = os.path.join(ctx.proc, str(pid))
    if not os.path.isdir(base):
        return False
    text = read_text(os.path.join(base, "stat"), limit=4096)
    if text and ")" in text:
        state = text.rsplit(")", 1)[1].split()[:1]
        if state and state[0] in ("Z", "X"):
            return False
    return True


def signal_pid(pid, ctx, number):
    try:
        os.kill(pid, number)
        return True
    except OSError:
        return False


def stop_tree(item, pids, ctx):
    """SIGTERM the whole tree, wait the grace, SIGKILL what is left."""
    if not ctx.applied:
        item["result"] = "would-kill"
        item["signals"] = ["SIGTERM", "SIGKILL"]
        return
    signalled = {}
    for pid in pids:
        if not proc_alive(pid, ctx):
            continue
        if signal_pid(pid, ctx, signal.SIGTERM):
            signalled[pid] = ["SIGTERM"]
    deadline = time.monotonic() + max(0.0, ctx.opts["grace"])
    while time.monotonic() < deadline:
        if not any(proc_alive(pid, ctx) for pid in signalled):
            break
        time.sleep(0.05)
    for pid in list(signalled):
        if not proc_alive(pid, ctx):
            continue
        if signal_pid(pid, ctx, signal.SIGKILL):
            signalled[pid].append("SIGKILL")
    item["signals"] = sum(signalled.values(), [])
    item["result"] = "killed" if signalled else "kept"
    log_kills(ctx, item, signalled, pids)


def log_kills(ctx, item, signalled, pids):
    facts = process_facts(ctx, {"pid": item["pid"]}, {})
    append_line(os.path.join(ctx.state, "kills.log"),
                "{} kill pid={} kind={} reason={}".format(
                    time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                    item["pid"], item.get("kind"), item.get("reason")))
    for pid, signals in signalled.items():
        for sig in signals:
            ctx.kills.append({"event": "kill", "pid": pid, "kind": item.get("kind"),
                              "reason": item.get("reason"), "cwd": facts.get("cwd"),
                              "signal": sig, "tree": pids})


def worker_in_worktree(worktree, rows, facts, ctx):
    for row in rows:
        if row["pid"] == os.getpid() or row["uid"] != ctx.uid:
            continue
        if basename_of(row["args"]) not in ("claude", "codex"):
            continue
        cwd = process_facts(ctx, row, facts).get("cwd") or ""
        if cwd == worktree or cwd.startswith(worktree.rstrip("/") + "/"):
            return row
    return None


def worktree_component(path):
    parts = [part for part in (path or "").split(os.sep) if part]
    for index in range(len(parts) - 1, -1, -1):
        if parts[index].startswith("wt-"):
            return os.sep + os.sep.join(parts[:index + 1])
    return None


def scan_processes(ctx):
    rows = read_ps(ctx)
    ctx.ps = rows
    if not rows:
        ctx.candidate("processes", None, "keep", "ps", "process table unreadable")
        return
    by_pid = {row["pid"]: row for row in rows}
    children = {}
    for row in rows:
        children.setdefault(row["ppid"], []).append(row["pid"])
    facts = {}
    me = os.getpid()

    def candidate_row(part, action, rule, reason, row, extra=None):
        payload = {"pid": row["pid"], "kind": row.get("kind"), "args": row["args"][:120],
                   "age_seconds": row["etimes"]}
        payload.update(extra or {})
        item = ctx.candidate(part, None, action, rule, reason, row["etimes"], None, payload)
        return item

    for row in rows:
        if ctx.budget.spent():
            return
        kind = process_kind(row)
        row["kind"] = kind
        if row["pid"] in (0, 1, me):
            continue
        tree = [row["pid"]] + descendants(row["pid"], children)
        tree_rows = [by_pid[pid] for pid in tree if pid in by_pid]
        if row["stat"].startswith("Z"):
            candidate_row("processes", "report", "zombies-report",
                          "zombie, reported only, never killed", row,
                          {"kind": "zombie", "signals": []})
            continue
        if row["uid"] != ctx.uid:
            candidate_row("processes", "keep", "own-uid",
                          "uid {} is not ours".format(row["uid"]), row)
            continue
        protected = None
        if basename_of(row["args"]) in PROTECTED_NAMES:
            protected = basename_of(row["args"])
        else:
            for member in tree_rows:
                if basename_of(member["args"]) in TREE_PROTECTED_NAMES:
                    protected = basename_of(member["args"])
                    break
        if protected:
            candidate_row("processes", "keep", "protected",
                          "protected: tree holds {}, never kill a chat program, tmux "
                          "or an interactive shell".format(protected), row)
            continue
        if kind == "headless-browser":
            if row["etimes"] > BROWSER_AGE:
                item = candidate_row("processes", "kill", "headless-browser-2h",
                                     "headless browser idle {} (rule {})".format(
                                         fmt_age(row["etimes"]), fmt_age(BROWSER_AGE)), row)
                stop_tree(item, tree, ctx)
            else:
                candidate_row("processes", "keep", "headless-browser-2h",
                              "idle {}, below the {} rule".format(
                                  fmt_age(row["etimes"]), fmt_age(BROWSER_AGE)), row)
            continue
        if kind == "chroma-mcp":
            orphan = row["ppid"] == 1
            if orphan and row["etimes"] > CHROMA_AGE:
                item = candidate_row("processes", "kill", "chroma-mcp-7200",
                                     "orphan chroma-mcp at ppid 1, idle {}".format(
                                         fmt_age(row["etimes"])), row)
                stop_tree(item, tree, ctx)
            else:
                candidate_row("processes", "keep", "chroma-mcp-7200",
                              "not an orphan at ppid 1 over 2h", row)
            continue
        if kind == "dev-server":
            worktree = worktree_component(process_facts(ctx, row, facts).get("cwd"))
            young = row["etimes"] <= DEV_SERVER_AGE
            top = top_ancestor(row, by_pid)
            if young:
                candidate_row("processes", "keep", "dev-server-2h",
                              "idle {}, below the 2h rule".format(fmt_age(row["etimes"])), row)
                continue
            if not worktree:
                candidate_row("processes", "keep", "dev-server-2h",
                              "cwd is not inside a wt-* worktree", row)
                continue
            if top != 1:
                candidate_row("processes", "keep", "dev-server-2h",
                              "top ancestor is pid {}, not init".format(top), row)
                continue
            live = worker_in_worktree(worktree, rows, facts, ctx)
            if live is not None:
                candidate_row("processes", "keep", "dev-server-2h",
                              "a live {} session is in the same worktree (pid {})".format(
                                  basename_of(live["args"]), live["pid"]), row)
                continue
            item = candidate_row("processes", "kill", "dev-server-2h",
                                 "orphan dev server, idle {}, no claude or codex in {}".format(
                                     fmt_age(row["etimes"]), worktree), row,
                                 {"worktree": worktree})
            stop_tree(item, tree, ctx)
            continue
        if kind == "provider":
            base = basename_of(row["args"])
            if base in PROTECTED_NAMES:
                candidate_row("processes", "keep", "protected",
                              "protected: {} is never killed".format(base), row)
                continue
            if row["ppid"] != 1 or row["etimes"] <= PROVIDER_AGE:
                candidate_row("processes", "keep", "provider-1800",
                              "not an orphan at ppid 1 over 30 minutes", row)
                continue
            where = process_facts(ctx, row, facts)
            proof = [path for path in (where.get("home"), where.get("cwd"))
                     if path and "/.local/state/hypertask-" in path]
            if not proof:
                candidate_row("processes", "keep", "provider-1800",
                              "no hypertask state dir proof in HOME or cwd", row)
                continue
            item = candidate_row("processes", "kill", "provider-1800",
                                 "orphan provider in {}, idle {}".format(
                                     proof[0], fmt_age(row["etimes"])), row)
            stop_tree(item, tree, ctx)
            continue


# ---------------------------------------------------------------- log and output

def append_line(path, line):
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "a") as handle:
            handle.write(line.rstrip("\n") + "\n")
    except OSError:
        pass


def disk_facts(path, override=None):
    total = free = None
    try:
        st = os.statvfs(path)
        total = st.f_blocks * st.f_frsize
        free = st.f_bavail * st.f_frsize
    except OSError:
        pass
    if override:
        text = read_text(override, limit=4096)
        try:
            data = json.loads(text or "")
        except ValueError:
            data = None
        if isinstance(data, dict) and isinstance(data.get("total"), int) \
                and isinstance(data.get("free"), int) and data["total"] > 0:
            total, free = data["total"], data["free"]
    used_percent = round((total - free) / total * 100, 1) if total else None
    return {"total_bytes": total, "free_bytes": free, "used_percent": used_percent,
            "free_gb": round(free / 1024 ** 3, 2) if free else None}


def caller_name(ctx):
    named = os.environ.get("VPS_TIDY_CALLER") or ctx.opts.get("caller")
    if named:
        return named
    text = read_text(os.path.join("/proc", str(os.getppid()), "cmdline"), limit=4096)
    if text:
        joined = " ".join(part for part in text.split("\0") if part).strip()
        if joined:
            return joined[:200]
    return "unknown"


def write_log(ctx, payload):
    try:
        os.makedirs(ctx.state, exist_ok=True)
        with open(ctx.log_path, "w") as handle:
            for item in payload["items"]:
                record = dict(item)
                record["event"] = "action"
                handle.write(json.dumps(record, sort_keys=True) + "\n")
            for record in ctx.kills:
                handle.write(json.dumps(record, sort_keys=True) + "\n")
            summary = dict(payload["summary"])
            summary["event"] = "summary"
            summary["used_percent"] = payload["disk"]["used_percent"]
            summary["would_free_bytes"] = payload["summary"]["would_free_bytes"]
            summary["mode"] = payload["mode"]
            summary["finished_at"] = payload["finished_at"]
            handle.write(json.dumps(summary, sort_keys=True) + "\n")
    except OSError:
        return None
    return ctx.log_path


def write_status(ctx, payload):
    path = os.path.join(ctx.state, "status.json")
    status = {"finished_at": payload["finished_at"], "mode": payload["mode"],
              "removed": payload["summary"]["removed"],
              "kills": payload["summary"]["kills"],
              "freed_bytes": payload["summary"]["freed_bytes"],
              "used_percent": payload["disk"]["used_percent"],
              "log": payload["log"]}
    try:
        os.makedirs(ctx.state, exist_ok=True)
        tmp = path + ".tmp.{}".format(os.getpid())
        with open(tmp, "w") as handle:
            json.dump(status, handle, indent=2, sort_keys=True)
            handle.write("\n")
        os.replace(tmp, path)
    except OSError:
        return None
    return path


def human_lines(payload):
    lines = []
    titles = {"tmp": "Temp files", "evidence": "Evidence", "caches": "Caches",
              "docker": "Docker", "processes": "Processes"}
    for part in PARTS:
        if part not in payload["parts"]:
            continue
        mine = [item for item in payload["items"] if item["part"] == part]
        lines.append("")
        lines.append("{} ({} {})".format(titles[part], len(mine),
                                         "item" if len(mine) == 1 else "items"))
        for item in mine:
            lines.append(format_item(item))
        if not mine:
            lines.append("  nothing to report")
    summary = payload["summary"]
    disk = payload["disk"]
    lines.append("")
    lines.append("Summary")
    if disk["used_percent"] is not None:
        lines.append("  disk    / {:.0f}% used, {:.1f}G free".format(
            disk["used_percent"], disk["free_gb"] or 0))
    lines.append("  {}      {} removed, {} kept, {} would free, {} freed".format(
        payload["mode"], summary["removed"], summary["kept"],
        fmt_bytes(summary["would_free_bytes"]), fmt_bytes(summary["freed_bytes"])))
    if summary["kills"]:
        lines.append("  killed  {} ({} RAM before)".format(
            summary["kills"], fmt_bytes(summary["killed_rss_mb"] * 1024 ** 2)))
    if summary["zombies"]:
        lines.append("  zombies {} reported, never killed".format(summary["zombies"]))
    if summary["time_budget_reached"]:
        lines.append("  budget  reached, the next run resumes where this one stopped")
    if payload["alarm"]["needed"]:
        lines.append("  alarm   {}".format(payload["alarm"]["text"]))
    lines.append("  caller  {}".format(payload["caller"]))
    lines.append("  log     {}".format(payload["log"]))
    if not payload["apply"]:
        lines.append("  dry run: nothing was deleted or killed. Add --apply to act.")
    return lines


def format_item(item):
    if item["part"] == "processes":
        if item.get("pid") is None:
            return "{:<7} {}".format(item["action"], item["reason"])
        return "{:<7} {:<15} {}{} ({}) {}".format(
            item["action"], item.get("kind") or "",
            "pid {} ".format(item["pid"]) if item.get("pid") else "",
            fmt_age(item.get("age_seconds")), item["rule"], item["reason"])
    if item.get("path") is None:
        return "{:<7} {} ({})".format(item["action"], item["reason"], item["rule"])
    return "{:<7} {:>7} {} ({}) {}".format(
        item["action"], fmt_bytes(item.get("bytes")),
        item["path"], item["rule"], item["reason"])


# ---------------------------------------------------------------- main

def parse_args(argv):
    opts = {"apply": False, "json": False, "parts": list(PARTS), "budget": DEFAULT_BUDGET,
            "ps_file": None, "proc_root": None, "root": None, "grace": KILL_GRACE,
            "statvfs_json": None, "caller": None, "error": None, "help": False}
    opts["root"] = os.environ.get("VPS_TIDY_ROOT") or None
    picked = []
    index = 0
    while index < len(argv):
        arg = argv[index]
        if arg == "--apply":
            opts["apply"] = True
        elif arg == "--dry-run":
            opts["apply"] = False
        elif arg == "--json":
            opts["json"] = True
        elif arg in ("-h", "--help"):
            opts["help"] = True
        elif arg in ("--only", "--budget", "--ps-file", "--proc-root", "--root", "--grace",
                     "--statvfs-json", "--caller"):
            if index + 1 >= len(argv):
                opts["error"] = "{} needs a value".format(arg)
                return opts
            value = argv[index + 1]
            index += 1
            if arg == "--only":
                picked.extend(part.strip() for part in value.split(",") if part.strip())
            elif arg in ("--budget", "--grace"):
                try:
                    opts["budget" if arg == "--budget" else "grace"] = float(value)
                except ValueError:
                    opts["error"] = "{} takes a number, not {!r}".format(arg, value)
                    return opts
            elif arg == "--caller":
                opts["caller"] = value
            else:
                opts[{"--ps-file": "ps_file", "--proc-root": "proc_root",
                      "--root": "root", "--statvfs-json": "statvfs_json"}[arg]] = value
        else:
            opts["error"] = "unknown argument {!r}".format(arg)
            return opts
        index += 1
    if picked:
        parts = []
        for name in picked:
            if name in PART_ALIASES:
                parts.extend(PART_ALIASES[name])
            elif name in PARTS:
                parts.append(name)
            else:
                opts["error"] = "--only takes {}, not {!r}".format(
                    ", ".join(PARTS + tuple(PART_ALIASES)), name)
                return opts
        opts["parts"] = [part for part in PARTS if part in set(parts)]
    return opts


def acquire_lock(ctx):
    path = os.path.join(ctx.state, "lock")
    try:
        os.makedirs(ctx.state, exist_ok=True)
        handle = open(path, "w")
    except OSError as error:
        return None, str(error)
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        handle.close()
        return None, "another run holds {}".format(path)
    return handle, None


def collect(ctx):
    disk_before = disk_facts(ctx.tmp if os.path.isdir(ctx.tmp) else ctx.home,
                            ctx.opts["statvfs_json"])
    ctx.opts["used_percent"] = disk_before["used_percent"]
    if ctx.opts["used_percent"] is None:
        ctx.opts["used_percent"] = 0.0
    if "tmp" in ctx.opts["parts"]:
        scan_tmp(ctx)
    if "evidence" in ctx.opts["parts"]:
        scan_evidence(ctx)
        scan_state_tmp(ctx)
    if "caches" in ctx.opts["parts"]:
        scan_caches(ctx)
    if "docker" in ctx.opts["parts"]:
        scan_docker(ctx)
    if "processes" in ctx.opts["parts"]:
        scan_processes(ctx)
    return disk_before


def payload_of(ctx, disk_before, caller):
    disk_after = disk_facts(ctx.tmp if os.path.isdir(ctx.tmp) else ctx.home,
                            ctx.opts["statvfs_json"])
    freed = 0
    if disk_before["free_bytes"] is not None and disk_after["free_bytes"] is not None:
        freed = max(0, disk_after["free_bytes"] - disk_before["free_bytes"])
    removed = sum(1 for item in ctx.items if item.get("result") == "removed")
    kept = sum(1 for item in ctx.items if item["action"] == "keep")
    failed = sum(1 for item in ctx.items if item.get("result") == "failed")
    would_free = sum(item.get("bytes") or 0 for item in ctx.items
                     if item["action"] in ("remove", "prune"))
    zombies = sum(1 for item in ctx.items if item.get("kind") == "zombie")
    kills = len({record.get("pid") for record in ctx.kills if record.get("pid")})
    killed_rss = sum(row.get("rss_kb", 0) for row in (ctx.ps or [])
                     if row.get("pid") in {record.get("pid") for record in ctx.kills})
    used = disk_before["used_percent"] or 0.0
    alarm = {"needed": used >= DISK_ALARM_PERCENT,
             "text": "disk {:.0f}% used, over the {:.0f}% alarm. File one urgent ticket on "
                     "board 4060, or update the open one. vps-tidy never writes to a board."
                     .format(used, DISK_ALARM_PERCENT)}
    return {
        "generated_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "mode": "apply" if ctx.applied else "dry-run",
        "apply": ctx.applied,
        "parts": list(ctx.opts["parts"]),
        "root": ctx.root,
        "home": ctx.home,
        "caller": caller,
        "disk": {"before": disk_before, "after": disk_after,
                 "used_percent": disk_before["used_percent"],
                 "free_gb": disk_before["free_gb"],
                 "freed_bytes": freed},
        "summary": {"removed": removed, "kept": kept, "failed": failed,
                    "would_free_bytes": would_free, "freed_bytes": freed,
                    "kills": kills, "killed_rss_mb": round(killed_rss / 1024, 1),
                    "zombies": zombies,
                    "time_budget_reached": ctx.budget.reached,
                    "actions": len(ctx.items)},
        "items": ctx.items,
        "alarm": alarm,
        "log": ctx.log_path,
        "status": os.path.join(ctx.state, "status.json"),
        "finished_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    }


def main(argv=None):
    opts = parse_args(list(sys.argv[1:] if argv is None else argv))
    if opts["help"]:
        print(USAGE)
        return 0
    if opts["error"]:
        sys.stderr.write("vps-tidy: {}\n{}\n".format(opts["error"], USAGE))
        return 2
    ctx = Context(opts)
    handle, error = acquire_lock(ctx)
    if error:
        sys.stderr.write("vps-tidy: {}\n".format(error))
        return 3
    try:
        caller = caller_name(ctx)
        disk_before = collect(ctx)
        payload = payload_of(ctx, disk_before, caller)
        payload["log"] = write_log(ctx, payload) or payload["log"]
        write_status(ctx, payload)
        if opts["json"]:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print("\n".join(human_lines(payload)))
        return 0
    finally:
        try:
            handle.close()
        except OSError:
            pass


if __name__ == "__main__":
    sys.exit(main())
