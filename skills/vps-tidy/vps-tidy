# ---------------------------------------------------------------- small parts

def read_text(path, limit=65536):
    try:
        with open(path, "r", errors="replace") as handle:
            return handle.read() if limit is None else handle.read(limit)
    except OSError:
        return None


def fmt_bytes(count):
    if count is None:
        return "?"
    if count >= 1024 ** 3:
        return "{:.1f}G".format(count / 1024 ** 3)
    if count >= 1024 ** 2:
        return "{:.1f}M".format(count / 1024 ** 2)
    if count >= 1024:
        return "{:.1f}K".format(count / 1024)
    return "{}B".format(int(count))


def fmt_age(seconds):
    if seconds is None:
        return "?"
    if seconds >= DAY:
        return "{:.1f}d".format(seconds / DAY)
    if seconds >= HOUR:
        return "{:.1f}h".format(seconds / HOUR)
    return "{:.0f}m".format(seconds / 60)


def owned_by_us(st, uid):
    return st.st_uid == uid


def same_filesystem(st, device):
    return st.st_dev == device


def never_touch(path):
    """Paths no part of this tool may delete, whatever the rule says."""
    parts = [part for part in path.split(os.sep) if part]
    if any(part in NEVER_TOUCH_COMPONENTS for part in parts):
        return True
    if any(part in NEVER_TOUCH_DIRS for part in parts):
        return True
    return any(part.startswith("gh-shared-cache") for part in parts)


def is_special(st):
    return not (statmod.S_ISDIR(st.st_mode) or statmod.S_ISREG(st.st_mode))


class Budget:
    """One time budget per run, shared by every walk and every call."""

    def __init__(self, seconds):
        self.seconds = max(0.0, float(seconds))
        self.started = time.monotonic()
        self.reached = False

    def spent(self):
        if self.reached:
            return True
        if time.monotonic() - self.started > self.seconds:
            self.reached = True
        return self.reached

    def left(self, cap=None):
        remaining = max(0.0, self.seconds - (time.monotonic() - self.started))
        return min(remaining, cap) if cap is not None else remaining


class Context:
    def __init__(self, opts):
        self.opts = opts
        self.uid = os.getuid()
        self.root = opts["root"]
        if self.root:
            self.tmp = os.path.join(self.root, "tmp")
            self.home = os.path.join(self.root, "home")
        else:
            self.tmp = "/tmp"
            self.home = os.path.expanduser("~")
        self.state_root = os.path.join(self.home, ".local", "state")
        self.state = os.path.join(self.state_root, "vps-tidy")
        self.proc = opts["proc_root"] or os.environ.get("VPS_TIDY_PROC") or "/proc"
        self.budget = Budget(opts["budget"])
        self.run_id = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
        self.log_path = os.path.join(self.state, self.run_id + ".jsonl")
        self.device = self._device()
        self.open_paths = None
        self.ps = None
        self.items = []
        self.kills = []
        self.applied = opts["apply"]

    def _device(self):
        try:
            return os.stat(self.tmp if os.path.isdir(self.tmp) else self.home).st_dev
        except OSError:
            return None

    def candidate(self, part, path, action, rule, reason, age_seconds=None,
                  bytes_freed=None, extra=None):
        item = {"part": part, "path": path, "action": action, "rule": rule,
                "reason": reason, "age_seconds": age_seconds,
                "bytes": bytes_freed, "result": None}
        if extra:
            item.update(extra)
        self.items.append(item)
        return item


# ---------------------------------------------------------------- walking

def newest_inside(path, ctx, cap_depth=12):
    """Newest mtime inside a tree and its file bytes. Never follows a symlink."""
    newest = None
    total = 0
    stack = [(path, 0)]
    while stack:
        if ctx.budget.spent():
            return newest, total, True
        current, depth = stack.pop()
        try:
            entries = list(os.scandir(current))
        except OSError:
            continue
        for entry in entries:
            try:
                st = entry.stat(follow_symlinks=False)
            except OSError:
                continue
            if newest is None or st.st_mtime > newest:
                newest = st.st_mtime
            if statmod.S_ISREG(st.st_mode):
                total += st.st_size
                continue
            if statmod.S_ISDIR(st.st_mode):
                if ctx.device is not None and st.st_dev != ctx.device:
                    continue
                if depth + 1 < cap_depth:
                    stack.append((entry.path, depth + 1))
    return newest, total, False


def protected_inside(path, ctx, cap_depth=12):
    """The first protected component name inside a tree, or None."""
    stack = [(path, 0)]
    while stack:
        if ctx.budget.spent():
            return None
        current, depth = stack.pop()
        try:
            entries = list(os.scandir(current))
        except OSError:
            continue
        for entry in entries:
            if entry.name in NEVER_TOUCH_COMPONENTS:
                return entry.name
            try:
                st = entry.stat(follow_symlinks=False)
            except OSError:
                continue
            if statmod.S_ISDIR(st.st_mode) and depth + 1 < cap_depth:
                if ctx.device is not None and st.st_dev != ctx.device:
                    continue
                stack.append((entry.path, depth + 1))
    return None


def walk_dirs(path, ctx, cap_depth=6):
    """Every directory under path, symlinks and other mounts skipped."""
    stack = [(path, 0)]
    while stack:
        if ctx.budget.spent():
            return
        current, depth = stack.pop()
        try:
            entries = list(os.scandir(current))
        except OSError:
            continue
        for entry in entries:
            try:
                st = entry.stat(follow_symlinks=False)
            except OSError:
                continue
            if not statmod.S_ISDIR(st.st_mode) or entry.is_symlink():
                continue
            if ctx.device is not None and st.st_dev != ctx.device:
                continue
            yield entry.path, depth + 1
            if depth + 1 < cap_depth:
                stack.append((entry.path, depth + 1))


def open_path_set(ctx):
    """Every path a live process of ours holds open, from /proc, one scan."""
    if ctx.open_paths is not None:
        return ctx.open_paths
    found = set()
    try:
        pids = [name for name in os.listdir(ctx.proc) if name.isdigit()]
    except OSError:
        pids = []
    for name in pids:
        if ctx.budget.spent():
            break
        base = os.path.join(ctx.proc, name)
        try:
            if os.stat(base).st_uid != ctx.uid:
                continue
        except OSError:
            continue
        for link in ("cwd", "root"):
            target = os.path.join(base, link)
            try:
                found.add(os.readlink(target))
            except OSError:
                pass
        fds = os.path.join(base, "fd")
        try:
            handles = os.listdir(fds)
        except OSError:
            handles = []
        for handle in handles[:512]:
            try:
                found.add(os.readlink(os.path.join(fds, handle)))
            except OSError:
                pass
    found.discard("/")
    ctx.open_paths = found
    return found


def in_use(path, ctx):
    """True when a live process holds this path, or anything inside it, open.

    An open parent directory (/tmp itself) says nothing about a child, so the
    check only looks down, never up.
    """
    opens = open_path_set(ctx)
    prefix = path.rstrip("/") + "/"
    for open_path in opens:
        if open_path == path or open_path.startswith(prefix):
            return True
    return False


# ---------------------------------------------------------------- removal

def trash_dir(ctx):
    return os.path.join(ctx.state, "trash", ctx.run_id)


def remove_path(path, ctx):
    """Recheck, move through the trash, then delete. Returns (ok, bytes, error)."""
    try:
        before = os.lstat(path)
    except OSError as error:
        return False, 0, str(error)
    if statmod.S_ISLNK(before.st_mode):
        return False, 0, "symlink, never followed"
    if never_touch(path):
        return False, 0, "on the never-touch list"
    if not owned_by_us(before, ctx.uid):
        return False, 0, "owned by uid {}".format(before.st_uid)
    if ctx.device is not None and not same_filesystem(before, ctx.device):
        return False, 0, "other filesystem"
    if in_use(path, ctx):
        return False, 0, "a process holds it open"
    size = 0
    if statmod.S_ISREG(before.st_mode):
        size = before.st_size
    else:
        _, size, _ = newest_inside(path, ctx)
    # The inode, device and mtime recheck immediately before removal. Any
    # change since the scan means someone is using it: keep it.
    trash = trash_dir(ctx)
    moved = None
    try:
        os.makedirs(trash, exist_ok=True)
        moved = os.path.join(trash, "{}.{}".format(os.path.basename(path.rstrip("/")),
                                                   uuid.uuid4().hex[:8]))
        os.rename(path, moved)
    except OSError as error:
        if error.errno != errno.EXDEV:
            return False, size, str(error)
        moved = None
    target = moved or path
    try:
        after = os.lstat(target)
        if (after.st_ino != before.st_ino or after.st_dev != before.st_dev
                or int(after.st_mtime) != int(before.st_mtime)):
            if moved:
                os.rename(moved, path)
            return False, 0, "changed during the run"
        if statmod.S_ISDIR(after.st_mode):
            shutil.rmtree(target)
        else:
            os.unlink(target)
    except OSError as error:
        if moved and os.path.exists(moved) and not os.path.exists(path):
            try:
                os.rename(moved, path)
            except OSError:
                pass
        return False, size, str(error)
    return True, size, None


def act_on(item, ctx):
    """Run one file item through the removal gate, or record a dry-run."""
    if item["action"] != "remove":
        item["result"] = "kept"
        return
    if not ctx.applied:
        item["result"] = "would-remove"
        return
    ok, freed, error = remove_path(item["path"], ctx)
    if ok:
        item["result"] = "removed"
        item["bytes"] = freed
    else:
        item["action"] = "keep"
        item["result"] = "kept"
        item["reason"] = "{} (blocked: {})".format(item["reason"], error)


# ---------------------------------------------------------------- file rules

def age_of(path, ctx, own_fallback=True):
    newest, size, truncated = newest_inside(path, ctx)
    if newest is None:
        try:
            newest = os.lstat(path).st_mtime if own_fallback else None
        except OSError:
            return None, size, truncated
    return (time.time() - newest) if newest else None, size, truncated


def keep(item, reason):
    item["action"] = "keep"
    item["reason"] = reason
    item["result"] = "kept"


def scan_tmp(ctx):
    root = ctx.tmp
    try:
        names = sorted(os.listdir(root))
    except OSError:
        return
    for name in names:
        if ctx.budget.spent():
            return
        path = os.path.join(root, name)
        try:
            st = os.lstat(path)
        except OSError:
            continue
        if statmod.S_ISLNK(st.st_mode):
            ctx.candidate("tmp", path, "keep", "no-follow", "symlink, never followed")
            continue
        if not owned_by_us(st, ctx.uid):
            ctx.candidate("tmp", path, "keep", "own-uid",
                          "owned by uid {}, not ours".format(st.st_uid))
            continue
        if is_special(st):
            ctx.candidate("tmp", path, "keep", "special-file", "not a file or directory")
            continue
        if name.startswith("claude-"):
            if name == "claude-{}".format(ctx.uid):
                scan_claude_scratch(ctx, path)
            else:
                ctx.candidate("tmp", path, "keep", "excluded",
                              "excluded by name (claude-*), not this uid's scratch")
            continue
        if any(name.startswith(prefix) for prefix in TMP_EXCLUDED):
            ctx.candidate("tmp", path, "keep", "excluded",
                          "excluded by name: claude-*, tmux-*, .X*, systemd-*")
            continue
        if name.startswith("agent-template-stage."):
            rule, limit, part = "tmp-agent-template-1d", AGENT_STAGE_AGE, "tmp"
        elif name.startswith(SCRATCH_PREFIXES):
            rule, limit, part = "tmp-scratch-24h", SCRATCH_AGE, "tmp"
        else:
            rule, limit, part = "tmp-3d", TMP_AGE, "tmp"
        age, size, _ = age_of(path, ctx)
        action = "keep" if age is None or age < limit else "remove"
        item = ctx.candidate(part, path, action, rule,
                             "untouched {} (rule {})".format(fmt_age(age), fmt_age(limit)),
                             age, size)
        protected = protected_inside(path, ctx) if action == "remove" else None
        if protected:
            keep(item, "protected: the tree holds {}, never removed".format(protected))
        elif in_use(path, ctx):
            keep(item, "a process holds it open")
        act_on(item, ctx)


def scan_claude_scratch(ctx, root):
    ctx.candidate("tmp", root, "keep", "excluded",
                  "excluded by name (claude-*); its sessions follow the 24h rule")
    try:
        projects = sorted(os.listdir(root))
    except OSError:
        return
    for project in projects:
        if ctx.budget.spent():
            return
        project_path = os.path.join(root, project)
        if project.endswith("-hypertask") or "ht-marketing" in project:
            ctx.candidate("tmp", project_path, "keep", "claude-scratch-skip",
                          "project is skipped by name (*-hypertask*, *ht-marketing*)")
            continue
        try:
            sessions = sorted(os.listdir(project_path))
        except OSError:
            continue
        for session in sessions:
            if ctx.budget.spent():
                return
            path = os.path.join(project_path, session)
            if not UUID_RE.match(session):
                ctx.candidate("tmp", path, "keep", "claude-scratch-uuid",
                              "leaf is not a session UUID")
                continue
            try:
                st = os.lstat(path)
            except OSError:
                continue
            if statmod.S_ISLNK(st.st_mode) or not statmod.S_ISDIR(st.st_mode):
                ctx.candidate("tmp", path, "keep", "no-follow", "not a plain directory")
                continue
            if not owned_by_us(st, ctx.uid):
                ctx.candidate("tmp", path, "keep", "own-uid", "not ours")
                continue
            age, size, _ = age_of(path, ctx)
            action = "remove" if age is not None and age >= CLAUDE_SCRATCH_AGE else "keep"
            item = ctx.candidate("tmp", path, action, "tmp-claude-24h",
                                 "untouched {} (rule {})".format(fmt_age(age),
                                                                 fmt_age(CLAUDE_SCRATCH_AGE)),
                                 age, size)
            if in_use(path, ctx):
                keep(item, "a process holds it open")
            act_on(item, ctx)


def scan_evidence(ctx):
    root = os.path.join(ctx.state_root, "vcc-evidence")
    if not os.path.isdir(root):
        return
    try:
        children = sorted(os.listdir(root))
    except OSError:
        return
    kept_children = []
    for name in children:
        if ctx.budget.spent():
            break
        path = os.path.join(root, name)
        try:
            st = os.lstat(path)
        except OSError:
            continue
        if statmod.S_ISLNK(st.st_mode) or not statmod.S_ISDIR(st.st_mode):
            ctx.candidate("evidence", path, "keep", "no-follow", "not a plain directory")
            continue
        age, size, _ = age_of(path, ctx)
        action = "remove" if age is not None and age >= EVIDENCE_AGE else "keep"
        item = ctx.candidate("evidence", path, action, "evidence-30d",
                             "untouched {} (rule {})".format(fmt_age(age), fmt_age(EVIDENCE_AGE)),
                             age, size)
        if in_use(path, ctx):
            keep(item, "a process holds it open")
        act_on(item, ctx)
        if item["result"] != "removed":
            kept_children.append(path)
    for base in kept_children:
        if ctx.budget.spent():
            return
        scan_evidence_builds(ctx, base)
        scan_evidence_videos(ctx, base)


def scan_evidence_builds(ctx, base):
    for path, _depth in walk_dirs(base, ctx, cap_depth=8):
        if ctx.budget.spent():
            return
        name = os.path.basename(path)
        if not (name in EVIDENCE_BUILD_NAMES or
                (name.startswith(BUILD_PREFIXES) and name not in ("build",))):
            continue
        age, size, _ = age_of(path, ctx)
        action = "remove" if age is not None and age >= EVIDENCE_BUILD_AGE else "keep"
        item = ctx.candidate("evidence", path, action, "evidence-build-2d",
                             "build dir untouched {} (rule {})".format(
                                 fmt_age(age), fmt_age(EVIDENCE_BUILD_AGE)),
                             age, size)
        if in_use(path, ctx):
            keep(item, "a process holds it open")
        act_on(item, ctx)


def scan_evidence_videos(ctx, base):
    for path, _depth in walk_dirs(base, ctx, cap_depth=8):
        if ctx.budget.spent():
            return
        try:
            names = os.listdir(path)
        except OSError:
            continue
        for name in names:
            if not name.lower().endswith(VIDEO_SUFFIXES):
                continue
            file_path = os.path.join(path, name)
            try:
                st = os.lstat(file_path)
            except OSError:
                continue
            if not statmod.S_ISREG(st.st_mode):
                continue
            age = time.time() - st.st_mtime
            if age < EVIDENCE_VIDEO_AGE:
                ctx.candidate("evidence", file_path, "keep", "evidence-video-14d",
                              "video untouched {} (rule {})".format(
                                  fmt_age(age), fmt_age(EVIDENCE_VIDEO_AGE)),
                              age, st.st_size)
                continue
            relative = os.path.relpath(file_path, os.path.join(ctx.state_root, "vcc-evidence"))
            ticket = next((part for part in relative.split(os.sep) if TICKET_RE.match(part)), None)
            item = ctx.candidate("evidence", file_path, "keep", "evidence-video-14d",
                                 "video untouched {} (rule {})".format(
                                     fmt_age(age), fmt_age(EVIDENCE_VIDEO_AGE)),
                                 age, st.st_size)
            if ticket is None:
                keep(item, "no ticket id in the path, so the board cannot be asked")
                continue
            state = board_state(ticket, ctx)
            if state is None:
                keep(item, "board read failed, so the video stays")
                continue
            if state != "closed":
                keep(item, "ticket {} is {}, so the video stays".format(ticket, state))
                continue
            item["action"] = "remove"
            item["reason"] = "video untouched {}, ticket {} closed".format(
                fmt_age(age), ticket)
            act_on(item, ctx)


def board_state(ticket, ctx):
    command = os.environ.get("VPS_TIDY_BOARD_CMD")
    if not command:
        return None
    try:
        done = subprocess.run(shlex.split(command) + [ticket], capture_output=True,
                              text=True, timeout=max(5, min(30, ctx.budget.left() or 5)))
    except (OSError, subprocess.SubprocessError):
        return None
    if done.returncode != 0:
        return None
    answer = done.stdout.strip().splitlines()
    return answer[0].strip().lower() if answer else None


def scan_state_tmp(ctx):
    try:
        parents = sorted(os.listdir(ctx.state_root))
    except OSError:
        return
    for parent in parents:
        if ctx.budget.spent():
            return
        if parent not in STATE_TMP_PARENTS:
            continue
        path = os.path.join(ctx.state_root, parent, "tmp")
        try:
            st = os.lstat(path)
        except OSError:
            continue
        if statmod.S_ISLNK(st.st_mode) or not statmod.S_ISDIR(st.st_mode):
            continue
        if not owned_by_us(st, ctx.uid):
            continue
        age, size, _ = age_of(path, ctx)
        action = "remove" if age is not None and age >= STATE_TMP_AGE else "keep"
        item = ctx.candidate("evidence", path, action, "state-tmp-2d",
                             "state tmp untouched {} (rule {})".format(
                                 fmt_age(age), fmt_age(STATE_TMP_AGE)),
                             age, size)
        if in_use(path, ctx):
            keep(item, "a process holds it open")
        act_on(item, ctx)


def cache_root(ctx, name):
