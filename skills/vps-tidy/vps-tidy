def playwright_referenced(ctx, browsers_root):
    """Revision strings a live install asks for, read from .links."""
    wanted = set()
    links = os.path.join(browsers_root, ".links")
    try:
        names = os.listdir(links)
    except OSError:
        return wanted
    for name in names:
        target = read_text(os.path.join(links, name), limit=4096)
        if not target:
            continue
        for candidate in (os.path.join(target.strip(), "browsers.json"),
                          os.path.join(target.strip(), "playwright-core", "browsers.json")):
            text = read_text(candidate, limit=1 << 20)
            if not text:
                continue
            try:
                data = json.loads(text)
            except ValueError:
                continue
            for browser in data.get("browsers", []):
                if isinstance(browser, dict) and browser.get("revision") is not None:
                    wanted.add(str(browser["revision"]))
    return wanted


def scan_playwright(ctx):
    root = cache_root(ctx, "ms-playwright")
    try:
        names = sorted(os.listdir(root))
    except OSError:
        return
    wanted = playwright_referenced(ctx, root)
    newest = {}
    for name in names:
        match = PLAYWRIGHT_RE.match(name)
        if not match:
            continue
        family, revision = match.group(1), int(match.group(2))
        if family not in newest or revision > newest[family]:
            newest[family] = revision
    for name in names:
        if ctx.budget.spent():
            return
        match = PLAYWRIGHT_RE.match(name)
        if not match:
            continue
        family, revision = match.group(1), int(match.group(2))
        path = os.path.join(root, name)
        try:
            st = os.lstat(path)
        except OSError:
            continue
        if not statmod.S_ISDIR(st.st_mode) or statmod.S_ISLNK(st.st_mode):
            continue
        age, size, _ = age_of(path, ctx)
        if revision == newest.get(family):
            ctx.candidate("caches", path, "keep", "playwright-superseded",
                          "current {} build, never removed".format(family), age, size)
            continue
        if str(revision) in wanted:
            ctx.candidate("caches", path, "keep", "playwright-superseded",
                          "revision {} is still referenced by an installed playwright".format(
                              revision), age, size)
            continue
        item = ctx.candidate("caches", path, "remove", "playwright-superseded",
                             "superseded: {} is newer".format(newest.get(family)), age, size)
        if in_use(path, ctx):
            keep(item, "a process holds it open")
        act_on(item, ctx)


def project_roots(ctx):
    projects = os.path.join(ctx.home, "projects")
    try:
        names = sorted(os.listdir(projects))
    except OSError:
        return []
    roots = []
    for name in names:
        path = os.path.join(projects, name)
        if never_touch(path):
            continue
        if not os.path.isdir(path) or os.path.islink(path):
            continue
        roots.append(path)
        try:
            children = sorted(os.listdir(path))
        except OSError:
            continue
        for child in children:
            child_path = os.path.join(path, child)
            if never_touch(child_path) or not child.startswith("wt-"):
                continue
            if os.path.isdir(child_path) and not os.path.islink(child_path):
                roots.append(child_path)
    return roots


def scan_repo_caches(ctx):
    for root in project_roots(ctx):
        if ctx.budget.spent():
            return
        for name, needs_tag in (("target", True), (".zig-cache", False), (".next/cache", False)):
            if ctx.budget.spent():
                return
            path = os.path.join(root, name)
            try:
                st = os.lstat(path)
            except OSError:
                continue
            if not statmod.S_ISDIR(st.st_mode) or statmod.S_ISLNK(st.st_mode):
                continue
            item = None
            if needs_tag and not os.path.isfile(os.path.join(path, "CACHEDIR.TAG")):
                ctx.candidate("caches", path, "keep", "repo-cache-1d",
                              "no CACHEDIR.TAG, so it is not provably rebuildable")
                continue
            age, size, _ = age_of(path, ctx)
            action = "remove" if age is not None and age >= REPO_CACHE_AGE else "keep"
            item = ctx.candidate("caches", path, action, "repo-cache-1d",
                                 "build cache untouched {} (rule {})".format(
                                     fmt_age(age), fmt_age(REPO_CACHE_AGE)),
                                 age, size)
            if in_use(path, ctx):
                keep(item, "a process holds it open")
            act_on(item, ctx)


def scan_ceo_runs(ctx):
    root = os.path.join(ctx.home, "projects", "ceo", "runs")
    try:
        names = sorted(os.listdir(root))
    except OSError:
