#!/usr/bin/env python3
"""pr-queue: list this chat's own open PRs and one next step each.

  pr-queue --mine NAME [--repo OWNER/REPO] [--stale-hours N]
  pr-queue --self-test

Ownership comes only from `Owner chat: <name>` in the PR body. pstack Babysit drives
conflicts, threads and CI; this script only lists yours and flags staleness.

Exit 0 when none are stale; 1 when one is stale past --stale-hours (default 72);
2 on gh error or when --mine is missing.
"""
import argparse
import datetime
import json
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
DEFAULT_USER = 'valentinyeo'
GH_TIMEOUT = 90
OWNER_CHAT = re.compile(r'^Owner chat:\s*(.+?)\s*$', re.M | re.I)
RED = frozenset({'FAILURE', 'ERROR', 'TIMED_OUT', 'ACTION_REQUIRED'})
PENDING = frozenset({'PENDING', 'EXPECTED', 'REQUESTED', 'IN_PROGRESS'})

SEARCH_QUERY = '''query($q: String!, $after: String) {
  search(query: $q, type: ISSUE, first: 100, after: $after) {
    pageInfo { hasNextPage endCursor }
    nodes {
      ... on PullRequest {
        number url title body updatedAt
        repository { nameWithOwner }
        commits(last: 1) { nodes { commit { committedDate } } }
        statusCheckRollup { state }
      }
    }
  }
}'''


class GhError(Exception):
    pass


def owner_chat(body):
    """The Owner chat line, stripped, or None."""
    match = OWNER_CHAT.search(body or '')
    return match.group(1).strip() if match else None


def parse_time(value):
    text = (value or '').strip()
    if not text:
        return None
    if text.endswith('Z'):
        text = text[:-1] + '+00:00'
    try:
        stamp = datetime.datetime.fromisoformat(text)
    except ValueError:
        return None
    return stamp if stamp.tzinfo else stamp.replace(tzinfo=datetime.timezone.utc)


def hours_since(value, now):
    stamp = parse_time(value)
    if not stamp:
        return 0.0
    return (now - stamp).total_seconds() / 3600


def newest_push_hours(view, now):
    commits = view.get('commits') or ()
    stamps = [c.get('committedDate') for c in commits if c.get('committedDate')]
    if stamps:
        return hours_since(max(stamps), now)
    return hours_since(view.get('updatedAt'), now)


def ci_state(aggregate):
    state = (aggregate or '').upper()
    if state in RED:
        return 'red'
    if state in PENDING:
        return 'pending'
    if state == 'SUCCESS':
        return 'green'
    return 'none'


def next_action(ci, hours, stale_hours):
    if hours >= stale_hours:
        return 'stale: close with a reason or finish and push'
    if ci == 'green':
        return 'merge-ready: Babysit drive mode or merge per Shipping'
    if ci == 'red':
        return 'fix CI on your branch, then push'
    if ci == 'pending':
        return 'wait for CI, or fix CI on your branch'
    return 'fix CI on your branch, then push'


def row_from_node(node, now, stale_hours):
    body = node.get('body') or ''
    hours = newest_push_hours(
        {'commits': [n.get('commit') or {} for n in (node.get('commits') or {}).get('nodes') or ()],
         'updatedAt': node.get('updatedAt')},
        now,
    )
    ci = ci_state((node.get('statusCheckRollup') or {}).get('state'))
    action = next_action(ci, hours, stale_hours)
    repo = (node.get('repository') or {}).get('nameWithOwner') or ''
    return {
        'repo': repo,
        'number': node['number'],
        'url': node.get('url') or '',
        'title': node.get('title') or '',
        'owner_chat': owner_chat(body),
        'hours_since_push': round(hours, 2),
        'ci': ci,
        'stale': hours >= stale_hours,
        'next_action': action,
    }


def build_rows(nodes, mine, now, stale_hours):
    want = mine.lower()
    rows = []
    for node in nodes:
        row = row_from_node(node, now, stale_hours)
        owner = (row['owner_chat'] or '').lower()
        if owner != want:
            continue
        rows.append(row)
    rows.sort(key=lambda r: (r['repo'], r['number']))
    return rows


def search_scope(repo):
    if repo:
        return f'repo:{repo} is:pr is:open'
    return f'user:{DEFAULT_USER} is:pr is:open'


def gh_graphql(query, fields):
    argv = ['gh', 'api', 'graphql', '-f', f'query={query}']
    for key, value in fields.items():
        argv.extend(['-f', f'{key}={value}'])
    try:
        proc = subprocess.run(argv, capture_output=True, text=True, timeout=GH_TIMEOUT)
    except (subprocess.TimeoutExpired, FileNotFoundError) as err:
        raise GhError(str(err)) from err
    if proc.returncode != 0:
        raise GhError(proc.stderr.strip() or proc.stdout.strip() or 'gh failed')
    try:
        return json.loads(proc.stdout)
    except json.JSONDecodeError as err:
        raise GhError('gh returned invalid JSON') from err


def bulk_prs(scope):
    nodes = []
    after = None
    for _ in range(20):
        fields = {'q': scope}
        if after:
            fields['after'] = after
        payload = gh_graphql(SEARCH_QUERY, fields)
        if payload.get('errors'):
            raise GhError('; '.join(e.get('message', '') for e in payload['errors']))
        data = (payload.get('data') or {}).get('search') or {}
        batch = data.get('nodes') or []
        nodes.extend(batch)
        page = data.get('pageInfo') or {}
        if not page.get('hasNextPage'):
            break
        after = page.get('endCursor')
        if not after:
            break
    return nodes


def render(rows, mine, stale_hours):
    lines = []
    for row in rows:
        tag = f"{row['repo']}#{row['number']}"
        lines.append(f"{tag}  {row['title']}")
        lines.append(f"  {row['url']}")
        lines.append(f"  {row['next_action']}")
    lines.append('')
    stale_n = sum(1 for r in rows if r['stale'])
    lines.append(
        f"pr-queue: {len(rows)} open PR{'s' if len(rows) != 1 else ''} for Owner chat {mine!r}, "
        f"stale after {stale_hours}h ({stale_n} stale)"
    )
    return lines


def self_test():
    return subprocess.call([sys.executable, '-m', 'unittest', 'tests.test_pr_queue'], cwd=str(ROOT))


def main(argv):
    parser = argparse.ArgumentParser(description="list this chat's own open PRs")
    parser.add_argument('--mine', help='only PRs whose body names this Owner chat (required)')
    parser.add_argument('--repo', help='only this owner/name')
    parser.add_argument('--stale-hours', type=int, default=72)
    parser.add_argument('--self-test', action='store_true')
    args = parser.parse_args(argv)
    if args.self_test:
        return self_test()
    if not args.mine:
        print('pr-queue: pass --mine NAME; each chat checks only its own pull requests', file=sys.stderr)
        return 2
    try:
        nodes = bulk_prs(search_scope(args.repo))
    except GhError as error:
        print(f'pr-queue: {error}', file=sys.stderr)
        print('pr-queue: gh failed, so this tick read nothing; check `gh auth status` and rerun',
              file=sys.stderr)
        return 2
    now = datetime.datetime.now(datetime.timezone.utc)
    rows = build_rows(nodes, args.mine, now, args.stale_hours)
    print('\n'.join(render(rows, args.mine, args.stale_hours)))
    return 1 if any(row['stale'] for row in rows) else 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))