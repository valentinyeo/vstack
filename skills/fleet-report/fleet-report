#!/usr/bin/env python3
"""Read-only fleet report: valentin-mode version, board loop, pstack-diff per live chat.

    fleet-report              table on stdout
    fleet-report --json
    fleet-report --html FILE

Always exits 0 (report, not gate). Each failing chat should fix itself; do not centralize enforcement.
"""
from __future__ import annotations

import argparse
import html
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

VERSION_LATEST = re.compile(r"valentin-mode v(\d+) \(latest\)")
VERSION_BEHIND = re.compile(r"valentin-mode v(\d+), latest is v(\d+)")
ROSTER_LINE = re.compile(r"^(.+?) \(([^,]+), ([^,)]+)(?:, (.+))?\)$")
PSTACK_EXTRA = re.compile(r"^EXTRA ")
PSTACK_GAP = re.compile(r"^GAP ")
PSTACK_WARN_BEHIND = re.compile(r"^WARN checkout is (\d+) commits behind")
HYPERTASK_BOARD = re.compile(r"Hypertask board:", re.I)


def home() -> Path:
    return Path(os.environ.get("FLEET_REPORT_HOME") or Path.home())


def vstack_root() -> Path:
    return Path(os.environ.get("FLEET_REPORT_VSTACK") or (home() / ".local/share/vstack"))


def tool_path(env_name: str, default: Path) -> Path:
    override = os.environ.get(env_name)
    return Path(override) if override else default


def encode_cwd(cwd: str) -> str:
    return re.sub(r"[^a-zA-Z0-9]+", "-", os.path.expanduser(cwd))


def expand_cwd(cwd: str) -> str:
    if not cwd:
        return ""
    return os.path.expanduser(cwd.replace("~/", str(home()) + "/") if cwd.startswith("~/") else cwd)


def parse_roster_lines(text: str) -> list[dict]:
    rows = []
    for line in text.splitlines():
        line = line.strip()
        if not line or re.fullmatch(r"\d+ live sessions", line):
            continue
        match = ROSTER_LINE.match(line)
        if not match:
            continue
        name, tmux, harness, cwd = match.group(1), match.group(2), match.group(3), match.group(4) or ""
        rows.append(
            dict(name=name.strip(), tmux=tmux.strip(), harness=harness.strip(), cwd=cwd.strip(), sid="")
        )
    return rows


def load_announce_index() -> tuple[dict[str, dict], dict[str, dict]]:
    root = home() / ".local/state/roster/announce"
    by_tmux: dict[str, dict] = {}
    by_name: dict[str, dict] = {}
    if not root.is_dir():
        return by_tmux, by_name
    for path in root.glob("*.json"):
        try:
            data = json.loads(path.read_text(errors="replace"))
        except (OSError, ValueError, TypeError):
            continue
        if not isinstance(data, dict):
            continue
        tmux = data.get("tmux")
        name = data.get("name")
        if isinstance(tmux, str) and tmux:
            by_tmux[tmux] = data
        if isinstance(name, str) and name:
            by_name[name.casefold()] = data
    return by_tmux, by_name


def pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


def load_claude_sessions() -> list[dict]:
    root = home() / ".claude/sessions"
    rows = []
    if not root.is_dir():
        return rows
    for path in root.glob("*.json"):
        try:
            data = json.loads(path.read_text(errors="replace"))
        except (OSError, ValueError, TypeError):
            continue
        if not isinstance(data, dict) or data.get("kind") != "interactive":
            continue
        pid = data.get("pid")
        if pid is not None and not pid_alive(pid):
            continue
        sid = data.get("sessionId")
        if isinstance(sid, str) and sid:
            rows.append(data)
    return rows


def resolve_sid(row: dict, by_tmux: dict[str, dict], by_name: dict[str, dict], claude: list[dict]) -> str:
    if row.get("sid"):
        return row["sid"]
    tmux = row.get("tmux") or ""
    if tmux in by_tmux and isinstance(by_tmux[tmux].get("sid"), str):
        return by_tmux[tmux]["sid"]
    name = (row.get("name") or "").casefold()
    if name in by_name and isinstance(by_name[name].get("sid"), str):
        return by_name[name]["sid"]
    if tmux.startswith("pid "):
        try:
            pid = int(tmux.split()[1])
        except (IndexError, ValueError):
            pid = None
        if pid is not None:
            for session in claude:
                if session.get("pid") == pid and isinstance(session.get("sessionId"), str):
                    return session["sessionId"]
    cwd = expand_cwd(row.get("cwd") or "")
    if cwd:
        matches = [s for s in claude if (s.get("cwd") or "") == cwd and isinstance(s.get("sessionId"), str)]
        if len(matches) == 1:
            return matches[0]["sessionId"]
        if len(matches) > 1:
            peer = (row.get("name") or "").casefold()
            for session in matches:
                title = (session.get("name") or "").casefold()
                if peer and title and (peer in title or title in peer):
                    return session["sessionId"]
    return ""


def load_sessions() -> list[dict]:
    override = os.environ.get("FLEET_REPORT_SESSIONS_JSON")
    if override:
        try:
            data = json.loads(Path(override).read_text(encoding="utf-8"))
            if isinstance(data, list):
                return [normalize_session(row) for row in data if isinstance(row, dict)]
        except (OSError, ValueError, TypeError):
            pass

    rows: dict[str, dict] = {}
    mp_bin = home() / ".local/bin/mp-sessions"
    if mp_bin.is_file():
        try:
            done = subprocess.run(
                [str(mp_bin), "--json"],
                capture_output=True,
                text=True,
                timeout=30,
                check=False,
            )
            if done.returncode == 0 and done.stdout.strip():
                for item in json.loads(done.stdout):
                    if not isinstance(item, dict):
                        continue
                    row = normalize_session(
                        dict(
                            name=item.get("name") or item.get("tmux"),
                            harness=item.get("provider") or item.get("harness") or "",
                            cwd=item.get("cwd") or "",
                            sid=item.get("sid") or "",
                            tmux=item.get("tmux") or "",
                        )
                    )
                    rows[row_key(row)] = row
        except (OSError, ValueError, TypeError, subprocess.TimeoutExpired, json.JSONDecodeError):
            pass

    roster = tool_path("FLEET_REPORT_ROSTER_LIVE", home() / ".local/share/house-rules/fleet/roster-live")
    if roster.is_file():
        try:
            if os.environ.get("FLEET_REPORT_ROSTER_TEXT"):
                text = Path(os.environ["FLEET_REPORT_ROSTER_TEXT"]).read_text(errors="replace")
            elif roster.suffix == ".txt" or roster.name.endswith("-fixture"):
                text = roster.read_text(errors="replace")
            else:
                done = subprocess.run([str(roster)], capture_output=True, text=True, timeout=60, check=False)
                text = done.stdout if done.returncode == 0 else ""
            for row in parse_roster_lines(text):
                key = row_key(row)
                if key not in rows:
                    rows[key] = normalize_session(row)
        except (OSError, subprocess.TimeoutExpired):
            pass

    by_tmux, by_name = load_announce_index()
    claude = load_claude_sessions()
    out = []
    for row in sorted(rows.values(), key=lambda r: (r.get("name") or "").casefold()):
        if not row.get("sid"):
            row["sid"] = resolve_sid(row, by_tmux, by_name, claude)
        out.append(row)
    return out


def normalize_session(row: dict) -> dict:
    name = (row.get("name") or row.get("tmux") or "unknown").strip()
    harness = (row.get("harness") or row.get("provider") or "").strip() or "unknown"
    cwd = (row.get("cwd") or "").strip()
    return dict(
        name=name,
        harness=harness,
        cwd=cwd,
        sid=(row.get("sid") or "").strip(),
        tmux=(row.get("tmux") or "").strip(),
    )


def row_key(row: dict) -> str:
    return (row.get("sid") or row.get("tmux") or row.get("name") or "").casefold()


def transcript_path(cwd: str, sid: str) -> Path | None:
    if not sid or not cwd:
        return None
    project = home() / ".claude/projects" / encode_cwd(expand_cwd(cwd)) / f"{sid}.jsonl"
    return project


def last_valentin_version(transcript: Path | None, harness: str) -> tuple[str, int | None, int | None]:
    if harness != "claude":
        return "unknown (no transcript)", None, None
    if transcript is None or not transcript.is_file():
        return "unknown (no transcript)", None, None
    loaded_text = "never loaded"
    loaded_num = None
    latest_num = None
    try:
        with transcript.open("r", errors="replace") as handle:
            for line in handle:
                for match in VERSION_LATEST.finditer(line):
                    loaded_text = match.group(0)
                    loaded_num = int(match.group(1))
                    latest_num = loaded_num
                for match in VERSION_BEHIND.finditer(line):
                    loaded_text = match.group(0)
                    loaded_num = int(match.group(1))
                    latest_num = int(match.group(2))
    except OSError:
        return "unknown (no transcript)", None, None
    return loaded_text, loaded_num, latest_num


def fetch_latest_version() -> tuple[str, int | None]:
    script = tool_path(
        "FLEET_REPORT_VERSION_SH",
        vstack_root() / "skills/valentin-mode/version.sh",
    )
    if not script.is_file():
        return "unknown", None
    try:
        done = subprocess.run(["sh", str(script)], capture_output=True, text=True, timeout=60, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return "unknown", None
    line = (done.stdout or "").strip().splitlines()[-1] if done.stdout else ""
    if not line:
        return "unknown", None
    match = VERSION_LATEST.match(line)
    if match:
        num = int(match.group(1))
        return f"v{num}", num
    match = VERSION_BEHIND.match(line)
    if match:
        return f"v{match.group(2)}", int(match.group(2))
    if line == "valentin-mode version unknown":
        return "unknown", None
    return line, None


def board_loop_status(name: str) -> tuple[int | None, str]:
    loop_state = tool_path(
        "FLEET_REPORT_LOOP_STATE",
        vstack_root() / "skills/board-drain/loop-state",
    )
    if not loop_state.is_file():
        return None, "missing loop-state"
    try:
        done = subprocess.run(
            [sys.executable, str(loop_state), "status", "--name", name],
            capture_output=True,
            text=True,
            timeout=60,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None, "timeout"
    text = (done.stdout or done.stderr or "").strip().splitlines()
    summary = text[-1] if text else ""
    return done.returncode, summary


def is_git_repo(cwd: str) -> bool:
    if not cwd:
        return False
    expanded = expand_cwd(cwd)
    return (Path(expanded) / ".git").exists()


def repo_has_hypertask_board(cwd: str) -> bool:
    expanded = Path(expand_cwd(cwd))
    if not expanded.is_dir():
        return False
    for name in ("CLAUDE.md", "AGENTS.md"):
        path = expanded / name
        if path.is_file() and HYPERTASK_BOARD.search(path.read_text(errors="replace")):
            return True
    return False


def parse_pstack_stdout(stdout: str) -> tuple[int, int, int | None]:
    extras = gaps = 0
    behind: int | None = None
    for line in stdout.splitlines():
        if PSTACK_EXTRA.match(line):
            extras += 1
        elif PSTACK_GAP.match(line):
            gaps += 1
        elif match := PSTACK_WARN_BEHIND.match(line):
            behind = int(match.group(1))
    if behind is None and stdout.strip():
        try:
            payload = json.loads(stdout)
            if isinstance(payload, dict):
                if isinstance(payload.get("extras"), list):
                    extras = len(payload["extras"])
                if isinstance(payload.get("gaps"), list):
                    gaps = len(payload["gaps"])
                for line in payload.get("lines") or []:
                    if isinstance(line, str) and (match := PSTACK_WARN_BEHIND.match(line)):
                        behind = int(match.group(1))
        except ValueError:
            pass
    return extras, gaps, behind


def format_self_check(
    extras: int,
    gaps: int,
    behind: int | None,
    *,
    upstream: bool = False,
    stale: bool = False,
    fetch_failed: bool = False,
) -> str:
    if stale and behind is not None:
        if fetch_failed:
            return f"EXTRA {extras} GAP {gaps} stale, {behind} behind (fetch failed)"
        return f"stale, {behind} behind"
    parts = [f"EXTRA {extras}", f"GAP {gaps}"]
    if behind is not None and behind > 0:
        parts.append(f"behind {behind}")
    label = " ".join(parts)
    if upstream:
        label += " (upstream)"
    return label


def git_upstream_ref(repo: Path) -> str | None:
    for args in (
        ["symbolic-ref", "--short", "refs/remotes/origin/HEAD"],
        ["rev-parse", "--abbrev-ref", "origin/HEAD"],
    ):
        try:
            ref = subprocess.check_output(
                ["git", "-C", str(repo), *args],
                text=True,
                stderr=subprocess.DEVNULL,
                timeout=30,
            ).strip()
            if ref:
                return ref
        except (subprocess.CalledProcessError, FileNotFoundError, OSError, subprocess.TimeoutExpired):
            continue
    for branch in ("origin/main", "origin/master"):
        try:
            subprocess.check_output(
                ["git", "-C", str(repo), "rev-parse", "--verify", branch],
                stderr=subprocess.DEVNULL,
                timeout=30,
            )
            return branch
        except (subprocess.CalledProcessError, FileNotFoundError, OSError, subprocess.TimeoutExpired):
            continue
    return None


def run_pstack_diff_at(root: Path) -> tuple[str, int | None, int, int, int | None]:
    tool = tool_path("FLEET_REPORT_PSTACK_DIFF", vstack_root() / "skills/pstack-diff/pstack-diff")
    if not tool.is_file():
        return "missing", None, 0, 0, None
    try:
        done = subprocess.run(
            [sys.executable, str(tool), str(root)],
            capture_output=True,
            text=True,
            timeout=60,
            check=False,
        )
    except subprocess.TimeoutExpired:
        return "timeout", None, 0, 0, None
    except OSError:
        return "error", None, 0, 0, None
    extras, gaps, behind = parse_pstack_stdout(done.stdout or "")
    label = format_self_check(extras, gaps, behind)
    return label, done.returncode, extras, gaps, behind


FETCH_FAILED = "fetch_failed"


def run_pstack_diff_upstream(cwd: str, behind: int) -> tuple[int, int, bool] | str | None:
    """Re-run pstack-diff on a fresh detached worktree at origin default.

    Returns FETCH_FAILED when git fetch fails; None for other upstream skip reasons.
    """
    expanded = Path(expand_cwd(cwd))
    if not (expanded / ".git").exists():
        return None
    try:
        fetch = subprocess.run(
            ["git", "-C", str(expanded), "fetch", "origin"],
            capture_output=True,
            timeout=60,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return FETCH_FAILED
    if fetch.returncode != 0:
        return FETCH_FAILED
    ref = git_upstream_ref(expanded)
    if not ref:
        return None
    tmp = tempfile.mkdtemp(prefix="fleet-report-pstack-")
    try:
        add = subprocess.run(
            ["git", "-C", str(expanded), "worktree", "add", "--detach", tmp, ref],
            capture_output=True,
            text=True,
            timeout=60,
            check=False,
        )
        if add.returncode != 0:
            return None
        _label, _code, extras, gaps, _behind = run_pstack_diff_at(Path(tmp))
        return extras, gaps, True
    except (OSError, subprocess.TimeoutExpired):
        return None
    finally:
        subprocess.run(
            ["git", "-C", str(expanded), "worktree", "remove", "--force", tmp],
            capture_output=True,
            timeout=60,
            check=False,
        )
        shutil.rmtree(tmp, ignore_errors=True)


def run_pstack_diff(cwd: str) -> dict:
    if not is_git_repo(cwd):
        return dict(
            self_check="skip",
            pstack_exit=None,
            extra_count=0,
            gap_count=0,
            local_extra_count=0,
            local_gap_count=0,
            behind=None,
            upstream=False,
            upstream_extras=None,
            upstream_gaps=None,
            upstream_ok=False,
            stale=False,
            fetch_failed=False,
        )
    expanded = expand_cwd(cwd)
    label, code, extras, gaps, behind = run_pstack_diff_at(Path(expanded))
    upstream_extras = upstream_gaps = None
    upstream_ok = False
    stale = False
    fetch_failed = False
    self_check = label
    if behind is not None and behind > 0:
        upstream = run_pstack_diff_upstream(cwd, behind)
        if upstream == FETCH_FAILED:
            fetch_failed = True
            stale = True
            self_check = format_self_check(
                extras, gaps, behind, stale=True, fetch_failed=True
            )
        elif upstream is None:
            stale = True
            self_check = format_self_check(extras, gaps, behind, stale=True)
        else:
            upstream_extras, upstream_gaps, upstream_ok = upstream
            self_check = format_self_check(
                upstream_extras, upstream_gaps, behind, upstream=True
            )
    display_extras = upstream_extras if upstream_ok else extras
    display_gaps = upstream_gaps if upstream_ok else gaps
    return dict(
        self_check=self_check,
        pstack_exit=code,
        extra_count=display_extras,
        gap_count=display_gaps,
        local_extra_count=extras,
        local_gap_count=gaps,
        behind=behind,
        upstream=upstream_ok,
        upstream_extras=upstream_extras,
        upstream_gaps=upstream_gaps,
        upstream_ok=upstream_ok,
        stale=stale,
        fetch_failed=fetch_failed,
    )


def verdict(
    harness: str,
    loaded_label: str,
    loaded_num: int | None,
    latest_num: int | None,
    board_exit: int | None,
    has_board: bool,
    extra_count: int,
    gap_count: int,
    upstream_extras: int | None,
    upstream_gaps: int | None,
    upstream_ok: bool,
    stale: bool,
    fetch_failed: bool,
    behind: int | None,
) -> tuple[str, str, str]:
    tags: list[str] = []
    notes: list[str] = []
    actions: list[str] = []

    if harness == "claude" and loaded_label == "never loaded":
        tags.append("NO VALENTIN-MODE")
        actions.append("re-run /valentin-mode")

    if (
        loaded_num is not None
        and latest_num is not None
        and loaded_num < latest_num
        and loaded_label not in ("never loaded", "unknown (no transcript)")
    ):
        tags.append("BEHIND")
        notes.append("updates on its next message")

    if has_board and board_exit not in (0, None):
        tags.append("LOOP OFF")
        actions.append("re-arm /board-drain")

    if upstream_ok and behind is not None and behind > 0 and not stale:
        effective_extras = extra_count
        effective_gaps = gap_count
    elif stale and behind is not None and behind > 0 and not fetch_failed:
        effective_extras = 0
        effective_gaps = gap_count
    else:
        effective_extras = extra_count
        effective_gaps = gap_count

    if effective_extras > 0:
        tags.append("FIX")
        actions.append("remove the EXTRA in one PR")
    if effective_gaps > 0:
        tags.append("GAPS")

    if fetch_failed:
        if "STALE" not in tags:
            tags.append("STALE")
        notes.append("upstream fetch failed; counts are local")

    if not tags:
        tags.append("OK")

    reason = "; ".join(notes) if notes else ""
    action = "; ".join(dict.fromkeys(actions))
    return "; ".join(tags), reason, action


def build_rows() -> list[dict]:
    latest_label, latest_num = fetch_latest_version()
    sessions = load_sessions()
    rows = []
    for session in sessions:
        path = transcript_path(session.get("cwd", ""), session.get("sid", ""))
        loaded_label, loaded_num, transcript_latest = last_valentin_version(path, session.get("harness", ""))
        effective_latest = latest_num if latest_num is not None else transcript_latest
        board_exit, board_text = board_loop_status(session["name"])
        pstack = run_pstack_diff(session.get("cwd", ""))
        has_board = repo_has_hypertask_board(session.get("cwd", ""))
        status, reason, action = verdict(
            session.get("harness", ""),
            loaded_label,
            loaded_num,
            effective_latest,
            board_exit,
            has_board,
            pstack["extra_count"],
            pstack["gap_count"],
            pstack["upstream_extras"],
            pstack["upstream_gaps"],
            pstack["upstream_ok"],
            pstack["stale"],
            pstack["fetch_failed"],
            pstack["behind"],
        )
        rows.append(
            dict(
                name=session["name"],
                harness=session.get("harness") or "",
                cwd=session.get("cwd") or "",
                loaded=loaded_label,
                latest=latest_label,
                latest_num=effective_latest,
                board=f"{board_exit if board_exit is not None else '?'} {board_text}".strip(),
                board_exit=board_exit,
                self_check=pstack["self_check"],
                pstack_exit=pstack["pstack_exit"],
                extra_count=pstack["extra_count"],
                gap_count=pstack["gap_count"],
                local_extra_count=pstack["local_extra_count"],
                local_gap_count=pstack["local_gap_count"],
                upstream=pstack["upstream"],
                behind=pstack["behind"],
                verdict=status,
                reason=reason,
                action=action,
            )
        )
    return rows


def column_widths(rows: list[dict], columns: list[tuple[str, str]]) -> list[int]:
    widths = [len(title) for title, _ in columns]
    for row in rows:
        for index, (_, key) in enumerate(columns):
            widths[index] = max(widths[index], len(str(row.get(key, ""))))
    return widths


def format_table(rows: list[dict]) -> str:
    columns = [
        ("CHAT", "name"),
        ("HARNESS", "harness"),
        ("LOADED", "loaded"),
        ("LATEST", "latest"),
        ("BOARD", "board"),
        ("SELF-CHECK", "self_check"),
        ("VERDICT", "verdict"),
        ("ACTION", "action"),
    ]
    widths = column_widths(rows, columns)
    lines = []
    header = "  ".join(title.ljust(widths[i]) for i, (title, _) in enumerate(columns))
    lines.append(header)
    lines.append("  ".join("-" * widths[i] for i in range(len(columns))))
    for row in rows:
        cells = []
        for index, (_, key) in enumerate(columns):
            text = str(row.get(key, ""))
            if key == "verdict" and row.get("reason"):
                text = f"{text} ({row['reason']})"
            cells.append(text.ljust(widths[index]))
        lines.append("  ".join(cells))
    return "\n".join(lines)


def write_html(path: Path, rows: list[dict]) -> None:
    headers = [
        "Chat",
        "Harness",
        "Loaded",
        "Latest",
        "Board loop",
        "Self-check",
        "Verdict",
        "Action",
    ]
    body_rows = []
    for row in rows:
        verdict = row["verdict"]
        if row.get("reason"):
            verdict = f"{verdict} ({row['reason']})"
        body_rows.append(
            [
                row["name"],
                row["harness"],
                row["loaded"],
                row["latest"],
                row["board"],
                row["self_check"],
                verdict,
                row.get("action") or "",
            ]
        )
    table_rows = []
    for cells in body_rows:
        tds = "".join(f"<td>{html.escape(str(cell))}</td>" for cell in cells)
        cls = ""
        verdict_cell = cells[6]
        if verdict_cell != "OK" and not verdict_cell.startswith("BEHIND"):
            cls = ' class="fail"'
        elif verdict_cell.startswith("BEHIND") or verdict_cell.endswith("BEHIND"):
            cls = ' class="behind"'
        table_rows.append(f"<tr{cls}>{tds}</tr>")
    doc = f"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Fleet report</title>
<style>
body {{ font-family: ui-monospace, monospace; margin: 1.5rem; }}
table {{ border-collapse: collapse; width: 100%; }}
th, td {{ border: 1px solid #ccc; padding: 0.35rem 0.5rem; text-align: left; vertical-align: top; }}
th {{ background: #f4f4f4; }}
tr.fail td {{ background: #ffe8e8; }}
tr.behind td {{ background: #fff6dd; }}
</style>
</head>
<body>
<h1>Fleet report</h1>
<p>Read-only snapshot. Message each failing chat; it fixes itself.</p>
<table>
<thead><tr>{"".join(f"<th>{html.escape(h)}</th>" for h in headers)}</tr></thead>
<tbody>
{"".join(table_rows)}
</tbody>
</table>
</body>
</html>
"""
    path.write_text(doc, encoding="utf-8")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--json", action="store_true", help="print JSON rows")
    parser.add_argument("--html", metavar="FILE", help="write a static HTML table")
    args = parser.parse_args(argv)
    rows = build_rows()
    if args.json:
        print(json.dumps(rows, indent=2))
    else:
        print(format_table(rows))
    if args.html:
        write_html(Path(args.html), rows)
    return 0


if __name__ == "__main__":
    sys.exit(main())