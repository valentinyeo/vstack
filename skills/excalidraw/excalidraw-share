#!/usr/bin/env python3
"""excalidraw-share: draw a shared Excalidraw scene, or read one back.

    excalidraw-share drawing.excalidraw --name "How a ticket ships"
    excalidraw-share drawing.json --scene 2YaSpW57ZCO
    excalidraw-share --read https://app.excalidraw.com/s/1GorMHPWnnO/2YaSpW57ZCO

Writing creates the scene (or replaces it with --scene), fills every missing standard
element field and `index` with Excalidraw's own defaults, turns on view sharing, and
prints only the https link. --read prints a plain outline of a shared scene, or its
raw JSON with --json.
The API key comes from 1Password through yeo-key, once per run, and is never printed.
"""
from __future__ import annotations

import argparse
import json
import os
import random
import subprocess
import sys
import time
from pathlib import Path
from urllib.error import HTTPError, URLError
from urllib.parse import urlsplit
from urllib.request import Request, urlopen

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / 'scripts'))
from bin_path import find

BASE = 'https://api.excalidraw.com/api/v1'
COLLECTION = '8nmjwOyvh62'
WORKSPACE = '1GorMHPWnnO'
LINK = 'https://app.excalidraw.com/s/' + WORKSPACE + '/'
TIMEOUT = 60
ALPHABET = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz'
RANDOM_MAX = 2 ** 31 - 1
LINE_TYPES = ('arrow', 'line')
ID_CHARS = set('0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ-_')


class ShareError(Exception):
    pass


def one_line(text: str, limit: int = 200) -> str:
    flat = ' '.join(str(text).split())
    return flat if len(flat) <= limit else flat[:limit] + '...'


def fractional_index(position: int) -> str:
    """Excalidraw index strings in order: a0..az, then b00..bzz, then c000.."""
    offset = 0
    while True:
        width = offset + 1
        capacity = len(ALPHABET) ** width
        if position < capacity:
            digits, rest = '', position
            for _ in range(width):
                digits = ALPHABET[rest % len(ALPHABET)] + digits
                rest //= len(ALPHABET)
            return chr(ord('a') + offset) + digits
        position -= capacity
        offset += 1


def standard_fields(kind: str) -> dict:
    """Every persisted element field Excalidraw fills at its default value."""
    fields = {
        'angle': 0,
        'strokeColor': '#1e1e1e',
        'backgroundColor': 'transparent',
        'fillStyle': 'hachure',
        'strokeWidth': 2,
        'strokeStyle': 'solid',
        'roughness': 1,
        'opacity': 100,
        'seed': random.randint(1, RANDOM_MAX),
        'version': 1,
        'versionNonce': random.randint(1, RANDOM_MAX),
        'isDeleted': False,
        'groupIds': [],
        'frameId': None,
        'roundness': None,
        'boundElements': None,
        'updated': int(time.time() * 1000),
        'link': None,
        'locked': False,
    }
    if kind == 'text':
        fields.update({
            'text': '',
            'fontSize': 20,
            'fontFamily': 6,
            'textAlign': 'left',
            'verticalAlign': 'top',
            'containerId': None,
            'autoResize': True,
            'lineHeight': 1.25,
            'baseline': None,
        })
    elif kind in LINE_TYPES:
        fields.update({
            'points': [[0, 0]],
            'lastCommittedPoint': None,
            'startBinding': None,
            'endBinding': None,
            'startArrowhead': None,
            'endArrowhead': 'arrow' if kind == 'arrow' else None,
        })
        fields.update({'elbowed': False} if kind == 'arrow' else {'polygon': False})
    return fields


def fill_standard_fields(element: dict) -> dict:
    """Add every absent standard field; a field the author wrote stays as written."""
    for key, value in standard_fields(element.get('type')).items():
        element.setdefault(key, value)
    if element.get('type') == 'text':
        element.setdefault('originalText', element.get('text', ''))
    return element


def document(data) -> dict:
    elements = data if isinstance(data, list) else None
    if elements is None:
        if not isinstance(data, dict):
            raise ShareError('the file holds no Excalidraw elements')
        elements = data.get('elements')
    if not isinstance(elements, list) or not elements:
        raise ShareError('the file holds no Excalidraw elements')
    if not all(isinstance(element, dict) for element in elements):
        raise ShareError('an element in the file is not an object')

    scene = dict(data) if isinstance(data, dict) else {}
    scene['elements'] = elements
    scene['type'] = 'excalidraw'
    scene['version'] = 2
    scene.setdefault('source', 'https://excalidraw.com')
    scene.setdefault('files', {})
    app_state = scene.get('appState')
    app_state = dict(app_state) if isinstance(app_state, dict) else {}
    app_state.setdefault('viewBackgroundColor', '#ffffff')
    scene['appState'] = app_state

    for element in elements:
        fill_standard_fields(element)

    if any(not isinstance(element.get('index'), str) or not element['index']
           for element in elements):
        for position, element in enumerate(elements):
            element['index'] = fractional_index(position)
    return scene


def yeo_key_env() -> dict:
    return dict(os.environ, XDG_RUNTIME_DIR=os.environ.get('XDG_RUNTIME_DIR')
                or '/run/user/%d' % os.getuid())


def read_key() -> str:
    try:
        done = subprocess.run([find('yeo-key') or 'yeo-key', 'Excalidraw', 'credential'],
                              capture_output=True, text=True, timeout=120,
                              env=yeo_key_env())
    except FileNotFoundError:
        raise ShareError('yeo-key is not on PATH; run ~/.local/share/vstack/install')
    except (OSError, subprocess.TimeoutExpired):
        raise ShareError('yeo-key could not reach 1Password')
    key = done.stdout.strip()
    if done.returncode != 0 or not key:
        raise ShareError('yeo-key has no Excalidraw credential: '
                         + one_line(done.stderr or done.stdout or 'no output'))
    return key


def api(method: str, path: str, key: str, body=None) -> dict:
    payload = None if body is None else json.dumps(body).encode('utf-8')
    request = Request(BASE + path, data=payload, method=method)
    request.add_header('Authorization', 'Bearer ' + key)
    request.add_header('Content-Type', 'application/json')
    try:
        with urlopen(request, timeout=TIMEOUT) as response:
            raw = response.read()
    except HTTPError as error:
        try:
            detail = error.read().decode('utf-8', 'replace')
        finally:
            error.close()
        raise ShareError('%s %s failed with HTTP %d: %s'
                         % (method, path, error.code, one_line(detail)))
    except URLError as error:
        raise ShareError('%s %s failed: %s' % (method, path, one_line(error.reason)))
    except OSError as error:
        raise ShareError('%s %s failed: %s' % (method, path, one_line(error)))
    if not raw.strip():
        return {}
    try:
        return json.loads(raw)
    except ValueError:
        raise ShareError('%s %s returned a body that is not JSON' % (method, path))


def scene_id_from(value: str) -> str:
    text = value.strip()
    if '/' in text or ':' in text:
        parts = [part for part in urlsplit(text).path.split('/') if part]
        text = parts[-1] if parts else ''
    if not text or any(char not in ID_CHARS for char in text):
        raise ShareError('not a scene link or id: ' + one_line(value))
    return text


def scene_of(data) -> dict:
    if isinstance(data, list):
        return {'type': 'excalidraw', 'elements': data}
    if not isinstance(data, dict) or not isinstance(data.get('elements'), list):
        raise ShareError('the scene holds no elements')
    return data


def visible(scene: dict) -> list:
    return [element for element in scene.get('elements') or []
            if isinstance(element, dict) and not element.get('isDeleted')]


def placed(elements: list) -> list:
    return sorted(elements, key=lambda element: (element.get('y') or 0,
                                                element.get('x') or 0))


def label(element: dict) -> str:
    return one_line((element.get('text') or '').replace('\n', ' ').strip())


def outline(scene: dict) -> list:
    elements = visible(scene)
    bound = {}
    for element in elements:
        if element.get('type') == 'text' and element.get('containerId'):
            bound.setdefault(str(element['containerId']), []).append(label(element))
    by_id = {str(element.get('id')): element for element in elements}

    def label_of(element_id: str) -> str:
        element = by_id.get(element_id)
        if element is None:
            return element_id
        if element.get('type') == 'text':
            return label(element) or element_id
        return ' '.join(text for text in bound.get(element_id, []) if text) or element_id

    lines = []
    for element in placed(elements):
        if element.get('type') in LINE_TYPES:
            continue
        if element.get('type') == 'text' and element.get('containerId'):
            continue
        text = ' '.join(bound.get(str(element.get('id')), []))
        if not text and element.get('type') == 'text':
            text = label(element)
        lines.append('%s: %s' % (element.get('type') or 'element', text)
                     if text else str(element.get('type') or 'element'))
    for element in placed(elements):
        if element.get('type') != 'arrow':
            continue
        start = (element.get('startBinding') or {}).get('elementId')
        end = (element.get('endBinding') or {}).get('elementId')
        lines.append('arrow: %s -> %s' % (label_of(str(start)) if start else '?',
                                          label_of(str(end)) if end else '?'))
    return lines


def read_scene(value: str, key: str, as_json: bool) -> str:
    scene = scene_of(api('GET', '/scenes/%s/content' % scene_id_from(value), key))
    if as_json:
        return json.dumps(scene, indent=2)
    lines = outline(scene)
    return '\n'.join(lines) if lines else 'the scene holds no elements'


def share(path: Path, name: str, scene_id: str | None, key: str) -> str:
    try:
        data = json.loads(path.read_text(encoding='utf-8'))
    except FileNotFoundError:
        raise ShareError('no file at ' + str(path))
    except OSError as error:
        raise ShareError('cannot read %s: %s' % (path, one_line(error)))
    except ValueError:
        raise ShareError(str(path) + ' is not JSON')
    scene = document(data)

    if scene_id is None:
        created = api('POST', '/collections/%s/scenes' % COLLECTION, key,
                      {'name': name})
        metadata = created.get('metadata') if isinstance(created, dict) else None
        scene_id = str(metadata.get('id') or '') if isinstance(metadata, dict) else ''
        if not scene_id:
            raise ShareError('creating the scene returned no scene id')
    api('PUT', '/scenes/%s/content' % scene_id, key, scene)
    api('PUT', '/scenes/%s/link-sharing' % scene_id, key, {'access': 'view'})
    return LINK + scene_id


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(
        prog='excalidraw-share',
        description='Put an Excalidraw file in the workspace and print its share link.')
    parser.add_argument('file', nargs='?', help='.excalidraw or .json drawing')
    parser.add_argument('--name', help='scene name; defaults to the file name')
    parser.add_argument('--scene', help='replace this scene instead of creating one')
    parser.add_argument('--read', metavar='LINK-OR-ID',
                        help='print a plain outline of a shared scene')
    parser.add_argument('--json', action='store_true',
                        help='with --read, print the raw scene JSON')
    args = parser.parse_args(argv)
    if args.read is None and args.file is None:
        parser.error('give a drawing file, or --read LINK-OR-ID')
    if args.read is not None and args.file is not None:
        parser.error('--read takes no drawing file')
    try:
        if args.read is not None:
            print(read_scene(args.read, read_key(), args.json))
            return 0
        path = Path(args.file).expanduser()
        name = args.name or path.stem
        print(share(path, name, args.scene, read_key()))
    except ShareError as error:
        print('excalidraw-share: ' + one_line(str(error)), file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
