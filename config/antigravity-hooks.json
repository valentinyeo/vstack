{
  "vstack-valentin-mode": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "\"$HOME/.local/share/vstack/hooks/run-hook\" \"$HOME/.claude/hooks/harness-start.py\" --harness agy --event start",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/share/vstack/hooks/run-hook\" \"$HOME/.local/share/vstack/skills/valentin-mode/context.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/share/vstack/hooks/run-hook\" \"$HOME/.claude/hooks/pacer-guard.py\" --harness agy",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/share/vstack/hooks/run-hook\" \"$HOME/.claude/hooks/agent-lane-guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/share/vstack/hooks/run-hook\" \"$HOME/.local/share/vstack/skills/responsive-mode/said-started.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "\"$HOME/.local/share/vstack/hooks/run-hook\" \"$HOME/.local/share/vstack/skills/responsive-mode/reply-check.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "\"$HOME/.local/share/vstack/hooks/run-hook\" \"$HOME/.local/share/vstack/skills/valentin-mode/no-bare-ids.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "\"$HOME/.local/share/vstack/hooks/run-hook\" \"$HOME/.local/share/vstack/skills/responsive-mode/idle-stop.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
