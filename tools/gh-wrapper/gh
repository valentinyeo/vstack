def _classify_caller_proc() -> tuple:
    """Walk /proc ancestors; return (caller label, pid where that label matched)."""
    pid = os.getppid()
    seen = set()
    agent = ""
    agent_pid = 0
    for _ in range(14):
        if pid <= 1 or pid in seen:
            break
        seen.add(pid)
        parts = _proc_cmdline(pid)
        if not agent:
            for head in parts[:2]:
                base = head.rsplit("/", 1)[-1]
                if base in ("claude", "codex"):
                    agent = base
                    agent_pid = pid
                    break
        for index, part in enumerate(parts):
            base = part.rsplit("/", 1)[-1]
            if base not in _CALLER_NAMES:
                continue
            label = _CALLER_NAMES[base]
            if label in ("agent-board-poll", "drain-worker"):
                for nxt in parts[index + 1:]:
                    if not nxt.startswith("-") and len(nxt) < 40:
                        return label + ":" + nxt, pid
            return label, pid
        pid = _proc_ppid(pid)
        if not pid:
            break
    if agent:
        return agent, agent_pid
    return "other", 0


def classify_caller() -> str:
    env_caller = (os.environ.get("GH_CALLER") or "").strip()
    if env_caller:
        return env_caller
    return _classify_caller_proc()[0]


_SCRIPT_SKIP = frozenset({
    "bash", "sh", "dash", "zsh", "fish", "run", "nice", "timeout", "env", "sudo", "nohup",
    "setsid", "script", "tee", "xargs", "exec", "systemd", "python", "python3", "node", "nodejs",
    "ruby", "perl", "lua", "deno", "bun", "gh", "git", "jq", "curl", "wget", "make", "doas",
})


def _proc_cmdline(pid: int) -> list:
    try:
        raw = open("/proc/%s/cmdline" % pid, "rb").read().split(b"\0")
    except OSError:
        return []
    return [part.decode("utf-8", "replace") for part in raw if part and len(part) <= 200]


def _proc_ppid(pid: int) -> int:
    try:
        return int(open("/proc/%s/stat" % pid).read().split()[3])
    except (OSError, IndexError, ValueError):
        return 0


def script_ancestor_name(pid=None) -> str:
    """Basename of the nearest non-shell, non-interpreter script in /proc ancestry."""
    pid = os.getppid() if pid is None else pid
    seen = set()
    cron = False
    hit = ""
    for _ in range(20):
        if pid <= 1 or pid in seen:
            break
        seen.add(pid)
        parts = _proc_cmdline(pid)
        joined = " ".join(parts).lower()
        if "cron" in joined or any(part.endswith("/cron") for part in parts[:1]):
            cron = True
        if not hit:
            for part in parts:
                if not part or part.startswith("-"):
                    continue
                base = part.rsplit("/", 1)[-1]
                if base in _SCRIPT_SKIP:
                    continue
                name = base
                for suffix in (".py", ".mjs", ".cjs", ".sh", ".bash", ".pl", ".rb", ".js"):
                    if name.endswith(suffix):
                        name = name[: -len(suffix)]
                        break
                if not name or name in _SCRIPT_SKIP:
                    continue
                hit = name
                break
        if hit and cron:
            break
        pid = _proc_ppid(pid)
    if not hit:
        return ""
    return ("cron:" + hit) if cron else hit


def known_script_caller(caller: str) -> bool:
    return bool(caller) and caller not in ("other",)


# Purely local subcommands never reach GitHub, so they are not logged.
# `auth status` does reach GitHub and is logged; `auth token` is local and is not.
LOCAL_COMMANDS = {"", "--version", "version", "help", "-h", "--help", "completion", "config", "alias",
                  "extension"}
_SECRET = re.compile(r"(gh[pousr]_\w+|github_pat_\w+|Bearer\s+\S+|(?i:token)\S*)")


def _fallback_script_session() -> str:
    env_caller = (os.environ.get("GH_CALLER") or "").strip()
    if env_caller:
        caller, match_pid = env_caller, 0
    else:
        caller, match_pid = _classify_caller_proc()
    base = caller.split(":", 1)[0]
    if base in AGENT_KIND_CALLERS:
        if match_pid <= 0:
            return ""
        stable = "agent:%s:%s" % (caller, match_pid)
        return re.sub(r"[^A-Za-z0-9_.:-]", "_", stable)[:32]
    if known_script_caller(caller):
        stable = caller
    else:
        stable = script_ancestor_name()
    if not stable:
        return ""
    return "script:" + re.sub(r"[^A-Za-z0-9_.:-]", "_", stable)[:24]


def log_session() -> str:
    name = os.environ.get("HT_SESSION_NAME")
    if not name:
        name = (os.environ.get("CLAUDE_CODE_SESSION_ID") or "")[:8]
    if not name:
        name = os.environ.get("CODEX_COMPANION_SESSION_ID") or ""
    if name:
        return re.sub(r"\s+", "_", name)[:32]
    script = _fallback_script_session()
    return script[:32] if script else "-"


def _subcommand(argv):
    for arg in argv[1:]:
        if not arg.startswith("-"):
            return arg
    return ""


def _log_roll_limit() -> int:
    raw = os.environ.get(LOG_ROLL_BYTES_ENV)
    if raw:
        try:
            return max(1, int(raw))
        except ValueError:
            pass
    return LOG_ROLL_BYTES


def _roll_lock(parent: Path):
    import fcntl

    parent.mkdir(parents=True, mode=0o700, exist_ok=True)
    handle = open(parent / "roll.lock", "a+")
    return handle, fcntl


def _maybe_roll_log(log_path: str) -> None:
    """When calls.tsv is huge, gzip it and keep LOG_ROLL_KEEP older copies. Non-blocking."""
    import gzip

    try:
        size = os.stat(log_path).st_size
    except OSError:
        return
    if size < _log_roll_limit():
        return
    parent = Path(log_path).parent
    log = Path(log_path)
    one = log.with_name(log.name + ".1.gz")
    two = log.with_name(log.name + ".2.gz")
    tmp = parent / ("%s.%s.roll.tmp" % (log.name, os.getpid()))
    try:
        lock_handle, fcntl = _roll_lock(parent)
    except OSError:
        return
    try:
        try:
            fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except (OSError, BlockingIOError):
            return
        try:
            try:
                size = os.stat(log_path).st_size
            except OSError:
                return
            if size < _log_roll_limit():
                return
            if one.exists():
                os.replace(str(one), str(two))
            os.replace(str(log), str(tmp))
        finally:
            fcntl.flock(lock_handle.fileno(), fcntl.LOCK_UN)
    except OSError:
        return
    finally:
        lock_handle.close()
    try:
        with open(tmp, "rb") as src, gzip.open(str(one), "wb") as dst:
            while True:
                chunk = src.read(1024 * 1024)
                if not chunk:
                    break
                dst.write(chunk)
        try:
            tmp.unlink()
        except OSError:
            pass
        for extra in parent.glob(log.name + ".*.gz"):
            if extra.name not in (one.name, two.name):
                _unlink(str(extra))
    except OSError:
        pass


def _log_call(argv, method=None, bucket=None, marker="-") -> None:
    if any(arg in ("api", "graphql") for arg in argv[1:]):
        parsed_method, path, _jq, _flags, _fields = _api_path(argv)
        method = method or parsed_method
        if any(mark in path for mark in ("token", "gho_", "github_pat_", "Bearer")):
            path = "[redacted]"
        path = path.split("?", 1)[0] or "-"
    else:
        sub = _subcommand(argv)
        if sub in LOCAL_COMMANDS or (sub == "auth" and "token" in argv[1:]):
            return
        method = method or sub
        path = _SECRET.sub("[redacted]", " ".join(argv[1:]))
        path = re.sub(r"\s+", " ", path)[:160] or "-"
    if bucket is None:
        bucket = _LAST_BUCKET[0] or ("app" if os.environ.get("GH_TOKEN") else "user")
    caller = classify_caller()
    log = os.environ.get("GH_CALL_LOG", str(Path.home() / ".local/state/gh-call-log/calls.tsv"))
    row = "%s\t%s\t%s\t%s\t%s\t%s\t%s\n" % (
        int(time.time()), caller, method, path, bucket, log_session(), marker)
    try:
        parent = Path(log).parent
        lock_handle, fcntl = _roll_lock(parent)
        try:
            _maybe_roll_log(log)
            fcntl.flock(lock_handle.fileno(), fcntl.LOCK_SH)
            with open(log, "a", encoding="utf-8") as handle:
                handle.write(row)
        finally:
            fcntl.flock(lock_handle.fileno(), fcntl.LOCK_UN)
            lock_handle.close()
    except OSError:
        pass


def budget_dir() -> Path:
    """The counter folder, beside the call log unless GH_BUDGET_DIR says otherwise."""
    log = os.environ.get("GH_CALL_LOG", str(Path.home() / ".local/state/gh-call-log/calls.tsv"))
    return Path(os.environ.get("GH_BUDGET_DIR", str(Path(log).parent / "budget")))


def budget_minute(now=None) -> int:
    """The minute bucket a count belongs to. A rolling hour is the last BUDGET_MINUTES of them."""
    return int(time.time() if now is None else now) // 60


def budget_session() -> str:
    """The name the log and the budget share; `-` means this call carries no session id."""
    return re.sub(r"[^A-Za-z0-9_.:-]", "_", log_session())[:32] or "-"


def budget_path(session: str) -> Path:
    return budget_dir() / ("s." + session)


def budget_lines(text: str, first: int) -> dict:
    """{minute: count} from a counter file, keeping only the minutes inside the rolling hour."""
    rows = {}
    for line in (text or "").splitlines():
        head, _sep, tail = line.partition(" ")
        if head.isdigit() and tail.isdigit() and int(head) >= first:
            rows[int(head)] = rows.get(int(head), 0) + int(tail)
    return rows


def budget_rows(session: str, now=None) -> list:
    """[(minute, count)] inside the rolling hour, oldest first."""
    try:
        text = budget_path(session).read_text(encoding="utf-8")
    except OSError:
        return []
    rows = budget_lines(text, budget_minute(now) - BUDGET_MINUTES + 1)
    return sorted(rows.items())


def budget_count(session: str, now=None) -> int:
    return sum(count for _minute, count in budget_rows(session, now))


def budget_lock():
    import fcntl
    directory = budget_dir()
    directory.mkdir(parents=True, mode=0o700, exist_ok=True)
    handle = open(directory / ".lock", "a+")
    fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
    return handle


def budget_prune(now=None) -> None:
    """Drop counters nobody has touched for a few hours. Runs when a session's file is first made."""
    cutoff = (budget_minute(now) - 60 * BUDGET_KEEP_HOURS) * 60
    try:
        items = list(budget_dir().iterdir())
    except OSError:
        return
    for item in items:
        if not item.name.startswith("s."):
            continue
        try:
            if item.stat().st_mtime < cutoff:
                _unlink(str(item))
        except OSError:
            continue


def budget_charge(session=None, now=None) -> int:
    """Count one call that reached GitHub, for this session and rolling hour. Returns the new count."""
    session = session or budget_session()
    minute = budget_minute(now)
    first = minute - BUDGET_MINUTES + 1
    try:
        lock = budget_lock()
    except OSError:
        return budget_count(session, now)
    try:
        try:
            text = budget_path(session).read_text(encoding="utf-8")
        except OSError:
            text = ""
            budget_prune(now)
        rows = budget_lines(text, first)
        rows[minute] = rows.get(minute, 0) + 1
        target = budget_path(session)
        tmp = target.with_name(target.name + ".%s.tmp" % os.getpid())
        tmp.write_text("".join("%d %d\n" % (minute, rows[minute]) for minute in sorted(rows)),
                       encoding="utf-8")
        os.chmod(tmp, 0o600)
        os.replace(tmp, target)
        return sum(rows.values())
    except OSError:
        return budget_count(session, now)
    finally:
        lock.close()


def budget_ledger(now=None) -> list:
    """[(session, count)] for the rolling hour, busiest first, read from the counter files alone."""
    rows = []
    try:
        items = list(budget_dir().iterdir())
    except OSError:
        return rows
    for item in items:
        if not item.name.startswith("s."):
            continue
        name = item.name[2:]
        count = budget_count(name, now)
        if count:
            rows.append((name, count))
    return sorted(rows, key=lambda row: -row[1])


def budget_until(session: str, now=None) -> int:
    """The epoch when this session's rolling hour falls under the refuse line."""
    rows = budget_rows(session, now)
    until = (budget_minute(now) + BUDGET_MINUTES) * 60
    total = sum(count for _minute, count in rows)
    for minute, count in rows:
        if total < BUDGET_REFUSE:
            break
        total -= count
        until = (minute + BUDGET_MINUTES) * 60
    return until


def budget_verdict(argv, now=None):
    """("", n), ("warn", n) or ("refuse", n) for the next upstream read this call would make."""
    session = budget_session()
    count = budget_count(session, now)
    if session == "-":
        return "", count
    if count >= BUDGET_REFUSE:
        return "refuse", count
    if count >= BUDGET_WARN:
        return "warn", count
    return "", count


def budget_next(argv) -> str:
    """The one better command for this kind of call."""
    return BUDGET_REPLACEMENT if pr_command(argv) in PR_READ_SUBS else "gh budget"


def budget_message(verdict: str, session: str, count: int, argv) -> str:
    """The one line a slowed call writes: what happened, then the command and the rules to run."""
    tail = "Next: %s. Rules: %s" % (budget_next(argv), BUDGET_RULES)
    if verdict == "refuse":
        until = time.strftime("%H:%M UTC", time.gmtime(budget_until(session)))
        return "gh budget: %s is over %d GitHub calls this hour; wait until %s. %s" % (
            session, BUDGET_REFUSE, until, tail)
    return "gh budget: %s used %d of %d GitHub calls this hour; slow down or use the cache. %s" % (
        session, count, BUDGET_REFUSE, tail)


def graphql_read(argv) -> bool:
    """`gh api graphql` carrying a query and no mutation: a read that spends the shared pool."""
    return "graphql" in argv[1:] and not any("mutation" in arg for arg in argv)


def budgeted_read(argv) -> bool:
    """A GitHub read the per-session budget may refuse or warn on before upstream runs."""
    return graphql_read(argv) or pr_command(argv) in PR_READ_SUBS


def reaches_github(argv) -> bool:
    """This call spends a GitHub request: it is not a local subcommand."""
    sub = _subcommand(argv)
    if sub in LOCAL_COMMANDS:
        return False
    return not (sub == "auth" and "token" in argv[1:])


def rate_limit_line(real: str) -> str:
    """One line of live headroom from one cached rate_limit call."""
    try:
        doc = gh_get("rate_limit", gh_bin=real)
    except (GhError, OSError, ValueError, subprocess.SubprocessError) as error:
        return "rate limit unknown: %s\n" % " ".join(str(error).split())[:120]
    resources = doc.get("resources") if isinstance(doc, dict) else None
    if not isinstance(resources, dict):
        return "rate limit unknown: rate_limit answered without resources\n"
    core = resources.get("core") or {}
    graphql = resources.get("graphql") or {}
    reset = core.get("reset")
    when = time.strftime("%H:%M UTC", time.gmtime(reset)) if isinstance(reset, int) and reset else "unknown"
    return "REST core %s of %s left; GraphQL %s of %s left; resets %s\n" % (
        core.get("remaining", "?"), core.get("limit", "?"),
        graphql.get("remaining", "?"), graphql.get("limit", "?"), when)


def budget_mode(real: str) -> int:
    """`gh budget`: this session's count, the five busiest this hour, and live rate-limit headroom."""
    session = budget_session()
    count = budget_count(session)
    out = sys.stdout
    if session == "-":
        out.write("gh budget: no session id, so this caller is never refused; %d GitHub calls this hour\n" % count)
    elif session.startswith("script:"):
        out.write("gh budget %s: %d of %d GitHub calls this hour, warn at %d (script)\n" % (
            session, count, BUDGET_REFUSE, BUDGET_WARN))
    else:
        out.write("gh budget %s: %d of %d GitHub calls this hour, warn at %d\n" % (
            session, count, BUDGET_REFUSE, BUDGET_WARN))
    ledger = budget_ledger()
    if ledger:
        out.write("top sessions this hour:\n")
        for name, used in ledger[:5]:
            out.write("  %-24s %d\n" % (name, used))
    out.write(rate_limit_line(real))
    out.flush()
    return 0


# --- gh pr reads: one saved answer serves every chat for a minute -----------------
#
# `gh pr checks`, `view`, `list` and `status` are GraphQL, so the api snapshot above never
# covered them. They were the bulk of the user token's calls. Each answer is stored whole
# (stdout, stderr, exit code) under a key of full argv, repo and token identity, and replayed
# byte for byte. A hash of the token file path or the env var name stands in for the token, so
# different tokens never share a body and no token reaches the disk.


class Outcome:
    """What one gh.real run produced. Replayed exactly, including the exit code."""

    __slots__ = ("code", "out", "err")

    def __init__(self, code, out="", err=""):
        self.code = int(code)
        self.out = out or ""
        self.err = err or ""


def pr_command(argv):
    """The pr subcommand word, or "" when this is not a `gh pr <sub>` call."""
    for index, arg in enumerate(argv[1:], 1):
        if arg.startswith("-"):
            continue
        if arg != "pr":
            return ""
        rest = argv[index + 1:]
        return rest[0] if rest and not rest[0].startswith("-") else ""
    return ""


def token_identity() -> str:
    """A short hash naming which credential will answer, so two tokens never share a body.

    Only the digest is kept, never the token: it is one sha256 of the env value or the token
    file, truncated to 16 hex characters, and it cannot be read back.
    """
    pieces = []
    for name in ("GH_TOKEN", "GITHUB_TOKEN"):
        value = os.environ.get(name)
        if value:
            pieces.append("env:%s:%s" % (name, value))
    if not pieces:
        path = token_file()
        try:
            value = path.read_text(encoding="utf-8").strip()
        except OSError:
            value = ""
        pieces.append("file:%s:%s" % (path, value))
    return hashlib.sha256("|".join(pieces).encode("utf-8")).hexdigest()[:16]


def normalize_repo(text: str) -> str:
    value = (text or "").strip().rstrip("/")
    if value.endswith(".git"):
        value = value[:-4]
    if value.startswith("git@") and ":" in value:
        value = value.split(":", 1)[1]
    elif "://" in value:
        value = value.split("://", 1)[1]
        value = value.split("/", 1)[1] if "/" in value else ""
    return value.strip("/")


def repo_flag(argv) -> str:
    for index, arg in enumerate(argv):
        if arg in ("-R", "--repo") and index + 1 < len(argv):
            return normalize_repo(argv[index + 1])
        if arg.startswith("--repo="):
            return normalize_repo(arg.split("=", 1)[1])
    return ""


def origin_repo(cwd=None) -> str:
    try:
        result = subprocess.run(["git", "config", "--get", "remote.origin.url"], cwd=cwd,
                                capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return ""
    if result.returncode != 0:
        return ""
    return normalize_repo(result.stdout)


def effective_repo(argv) -> str:
    """The repo this call answers for: the flag when given, else this folder's origin."""
    return repo_flag(argv) or origin_repo()


def pr_key(argv, repo="", token="") -> str:
    payload = json.dumps({"argv": [str(arg) for arg in argv[1:]], "repo": repo, "token": token}, sort_keys=True)
    return hashlib.sha256(payload.encode("utf-8")).hexdigest()


def split_watch(argv):
    """(argv without the watch flags, requested interval, fail_fast)."""
    interval = 10
    fail_fast = False
    keep = []
    index = 0
    while index < len(argv):
        arg = argv[index]
        if arg == "--watch":
            index += 1
            continue
        if arg == "--fail-fast":
            fail_fast = True
            index += 1
            continue
        if arg in ("--interval", "-i") and index + 1 < len(argv):
            try:
                interval = int(argv[index + 1])
            except ValueError:
                pass
            index += 2
            continue
        if arg.startswith("--interval="):
            try:
                interval = int(arg.split("=", 1)[1])
            except ValueError:
                pass
            index += 1
            continue
        keep.append(arg)
        index += 1
    return keep, interval, fail_fast


def pr_ttl() -> int:
    raw = os.environ.get(PR_TTL_ENV)
    if not raw:
        return PR_TTL
    try:
        return max(0, int(float(raw)))
    except ValueError:
        return PR_TTL


def pr_cache_dir() -> Path:
    return cache_dir() / "pr"


def pr_entry_path(key: str) -> Path:
    return pr_cache_dir() / (key + ".json")


def pr_lock(key: str):
    import fcntl
    directory = pr_cache_dir()
    directory.mkdir(parents=True, mode=0o700, exist_ok=True)
    handle = open(directory / (key + ".lock"), "a+")
    fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
    return handle


def read_pr_entry(key: str):
    try:
        doc = json.loads(pr_entry_path(key).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    if doc.get("key") != key or not isinstance(doc.get("stdout"), str):
        return None
    return doc


def write_pr_entry(key: str, entry: dict) -> None:
    """Write a temp file, then rename, so a reader never sees half an answer."""
    target = pr_entry_path(key)
    target.parent.mkdir(parents=True, mode=0o700, exist_ok=True)
    tmp = target.with_name("%s.%s.tmp" % (key, os.getpid()))
    tmp.write_text(json.dumps(entry), encoding="utf-8")
    os.chmod(tmp, 0o600)
    os.replace(tmp, target)


def _fresh(entry, now: int, ttl: int) -> bool:
    if not entry:
        return False
    return 0 <= now - int(entry.get("fetchedAt") or 0) < ttl


def upstream(real: str, args, runner=None, env=None, timeout=None) -> Outcome:
    if runner is not None:
        return runner([real, *args], os.environ.copy() if env is None else env)
    try:
        result = subprocess.run([real, *args], capture_output=True, text=True, env=env, timeout=timeout)
    except FileNotFoundError:
        return Outcome(127, "", "%s: command not found\n" % real)
    except (OSError, subprocess.SubprocessError) as error:
        return Outcome(1, "", "%s: %s\n" % (real, error))
    return Outcome(result.returncode, result.stdout, result.stderr)


def cached_pr(argv, real, runner=None, clock=time.time, ttl=None) -> Outcome:
    """One cacheable pr read: the saved answer inside the ttl, else one upstream call."""
    ttl = pr_ttl() if ttl is None else ttl
    env = child_env("")
    repo, token = effective_repo(argv), token_identity()
    key = pr_key(argv, repo, token)
    entry = read_pr_entry(key)
    now = int(clock())
    if _fresh(entry, now, ttl):
        _log_call(argv, bucket=_LAST_BUCKET[0], marker="hit")
        return Outcome(entry.get("code") or 0, entry.get("stdout"), entry.get("stderr"))
    try:
        lock = pr_lock(key)
    except OSError:
        budget_charge(now=now)
        return upstream(real, argv[1:], runner, env)
    try:
        entry = read_pr_entry(key)
        now = int(clock())
        if _fresh(entry, now, ttl):
            _log_call(argv, bucket=_LAST_BUCKET[0], marker="hit")
            return Outcome(entry.get("code") or 0, entry.get("stdout"), entry.get("stderr"))
        verdict, count = budget_verdict(argv, now=now)
        if verdict == "refuse":
            _log_call(argv, bucket=_LAST_BUCKET[0], marker="refused")
            sys_stderr(budget_message(verdict, budget_session(), count, argv))
            return Outcome(75, "", "")
        if verdict == "warn":
            sys_stderr(budget_message(verdict, budget_session(), count, argv))
        outcome = upstream(real, argv[1:], runner, env)
        budget_charge(now=now)
        _log_call(argv, bucket=_LAST_BUCKET[0], marker="warned" if verdict == "warn" else "miss")
        try:
            write_pr_entry(key, {
                "key": key,
                "argv": list(argv[1:]),
                "repo": repo,
                "token": token,
                "stdout": outcome.out,
                "stderr": outcome.err,
                "code": outcome.code,
                "fetchedAt": int(clock()),
            })
        except OSError:
            pass  # a full or read only cache folder must never break the call itself
        return outcome
    finally:
        lock.close()


def replay(outcome: Outcome, out=None, err=None) -> int:
    """Print what gh.real printed, in the same streams, with the same exit code."""
    out = out or sys.stdout
    err = err or sys.stderr
    if outcome.out:
        out.write(outcome.out)
    if outcome.err:
        err.write(outcome.err)
    out.flush()
    err.flush()
    return outcome.code


def _pending_row(text: str) -> bool:
    return any("\tpending\t" in line for line in (text or "").splitlines())


def pr_checks_watch(argv, real, runner=None, sleeper=time.sleep, clock=time.time, out=None, err=None) -> int:
    """`pr checks --watch` run as a loop over the cached read, never as a gh.real poll.

    gh.real's own watch polls on its interval and every poll is a fresh GraphQL call. Here
    each round reads the cache and only a miss reaches GitHub, so the floor is the cache ttl.
    """
    base, interval, fail_fast = split_watch(argv)
    every = max(int(interval or 10), PR_TTL)
    out = out or sys.stdout
    err = err or sys.stderr
    while True:
        try:
            out.write("Refreshing checks status every %d seconds. Press Ctrl+C to quit.\n\n" % every)
            out.flush()
            outcome = cached_pr(base, real, runner=runner, clock=clock)
            replay(outcome, out, err)
        except BrokenPipeError:
            return 0
        if outcome.code == 8:
            sleeper(every)
            continue
        if outcome.code != 0 and not fail_fast and _pending_row(outcome.out):
            sleeper(every)
            continue
        return outcome.code


# --- keep the shared cache small -------------------------------------------------


def prune_stamp() -> Path:
    return cache_dir() / "prune-stamp"


def prune_recent(now: int) -> bool:
    try:
        return now - int(prune_stamp().stat().st_mtime) < PRUNE_EVERY
    except (OSError, ValueError):
        return False


def stamp_prune(now: int) -> None:
    target = prune_stamp()
    target.parent.mkdir(parents=True, mode=0o700, exist_ok=True)
    tmp = target.with_name("prune-stamp.%s.tmp" % os.getpid())
    tmp.write_text(str(int(now)) + "\n", encoding="utf-8")
    os.replace(tmp, target)


def walk_entries(root: str, budget, clock=time.monotonic):
    """Yield (path, mtime, size) for entry files, stopping when the time budget runs out.

    A single call sees only part of a six-figure folder; the stamp spaces the calls out, so
    the whole backlog drains over a few minutes of ordinary gh traffic.
    """
    deadline = float("inf") if budget is None else clock() + float(budget)
    stack = [str(root)]
    while stack:
        if clock() > deadline:
            return
        directory = stack.pop()
        try:
            with os.scandir(directory) as items:
                for item in items:
                    if clock() > deadline:
                        return
                    try:
                        if item.is_dir(follow_symlinks=False):
                            stack.append(item.path)
                            continue
                        if not ENTRY_NAME.match(item.name):
                            continue
                        info = item.stat()
                    except OSError:
                        continue
                    yield item.path, info.st_mtime, info.st_size
        except OSError:
            continue


def prune_cache(now=None, max_age=PRUNE_MAX_AGE, cap_bytes=PRUNE_CAP, budget=PRUNE_BUDGET,
                force=False) -> dict:
    """Drop entries older than a day, then delete the oldest until the folder fits cap_bytes."""
    current = int(time.time() if now is None else now)
    if not force and prune_recent(current):
        return {"skipped": True, "removed": 0, "freed": 0, "seen": 0}
    stamp_prune(current)
    seen = list(walk_entries(cache_dir(), None if force else budget))
    total = sum(size for _path, _mtime, size in seen)
    removed = freed = 0
    keep = []
    for path, mtime, size in seen:
        if current - mtime > max_age and _unlink(path):
            removed += 1
            freed += size
            total -= size
            continue
        keep.append((mtime, size, path))
    if total > cap_bytes:
        keep.sort()
        while keep and total > cap_bytes:
            _mtime, size, path = keep.pop(0)
            if _unlink(path):
                removed += 1
                freed += size
                total -= size
    return {"skipped": False, "removed": removed, "freed": freed, "seen": len(seen)}


def _unlink(path: str) -> bool:
    try:
        os.unlink(path)
        return True
    except OSError:
        return False


def prune_mode() -> int:
    """GH_WRAPPER_PRUNE=1 gh: one unbound pass, for the deploying chat to clear the backlog."""
    result = prune_cache(force=True)
    sys.stdout.write("gh-wrapper prune: removed %d entries, freed %d bytes, seen %d\n" % (
        result["removed"], result["freed"], result["seen"]))
    return 0


def cacheable_pr(argv) -> bool:
    if pr_command(argv) not in PR_READ_SUBS:
        return False
    if os.environ.get(PR_NO_CACHE_ENV):
        return False
    return not (set(argv) & PR_BYPASS_FLAGS)


def wrap_main(argv=None) -> int:
    """Process-wide gh entry. Shares GET snapshots, logs real upstream calls, then execs the real gh."""
    argv = list(sys_argv() if argv is None else argv)
    real = os.environ.get("GH_REAL", "/usr/bin/gh.real")
    if not os.path.isfile(real):
        real = gh_binary()
    if os.environ.get("GH_WRAPPER_PRUNE") == "1":
        return prune_mode()
    if _subcommand(argv) == "budget":
        return budget_mode(real)
    try:
        prune_cache()
    except Exception:
        pass
    if pr_command(argv) == "checks" and "--watch" in argv and cacheable_pr(argv):
        return pr_checks_watch(argv, real)
    if cacheable_pr(argv):
        return replay(cached_pr(argv, real))
    if "--no-cache" in argv:
        argv = [arg for arg in argv if arg != "--no-cache"]
    method, path, jq, flags, fields = _api_path(argv)
    key = request_key(path, fields)
    include = "--include" in flags or "-i" in flags
    if "api" not in argv[1:] or not path or path == "graphql" or not shares_snapshot(method, flags):
        env = child_env(path) if path else os.environ.copy()
        bucket = "app" if env.get("GH_TOKEN") else "user"
        marker = "-"
        if budgeted_read(argv):
            verdict, count = budget_verdict(argv)
            if verdict == "refuse":
                _log_call(argv, bucket=bucket, marker="refused")
                sys_stderr(budget_message(verdict, budget_session(), count, argv))
                return 75
            if verdict == "warn":
                marker = "warned"
                sys_stderr(budget_message(verdict, budget_session(), count, argv))
        _log_call(argv, bucket=bucket, marker=marker)
        if reaches_github(argv):
            budget_charge()
        return _passthrough(real, argv, env)
    waited = False
    while True:
        _wait_out_pause(time.sleep, time.time)
        lock = _lock(cache_dir())
        try:
            if read_pause() > int(time.time()):
                continue
            entry = read_entry(key)
            current = int(time.time())
            if entry and 0 <= current - int(entry.get("fetchedAt") or 0) < DEFAULT_TTL:
                return _emit_cached(entry, include, jq)
            verdict, count = budget_verdict(argv)
            if verdict == "refuse":
                _log_call(argv, marker="refused")
                sys_stderr(budget_message(verdict, budget_session(), count, argv))
                return 75
            marker = "-"
            if verdict == "warn":
                marker = "warned"
                sys_stderr(budget_message(verdict, budget_session(), count, argv))
            etag = entry.get("etag") if entry else ""
            status, headers, body, code, stderr = _fetch_included(real, path, etag, fields)
            _log_call(argv, "304" if status == 304 else method, marker=marker)
            if status != 304:
                budget_charge()
            if status == 304 and entry:
                write_entry(key, entry["body"], headers.get("etag") or etag, current,
                            entry.get("status") or 200, entry.get("headers") or {})
                return _emit_cached(read_entry(key), include, jq)
            if rate_limited(status, body, stderr) and not waited:
                write_pause(backoff_epoch(headers, current))
                waited = True
                continue
            if code != 0 or status >= 400 or not body.strip():
                sys_stderr(stderr or body)
                return code or 1
            write_entry(key, body, headers.get("etag") or "", int(time.time()), status, headers)
            return _emit_cached(read_entry(key), include, jq)
        finally:
            lock.close()


def _emit_cached(entry, include, jq) -> int:
    if not entry:
        return 1
    if include:
        return _emit_included(entry.get("status") or 200, entry.get("headers") or {}, entry.get("body") or "")
    return _emit(entry.get("body") or "", jq)


def _emit_included(status, headers, body) -> int:
    import sys
    lines = ["HTTP/2.0 %s" % (status or 200)]
    for key, value in (headers or {}).items():
        lines.append("%s: %s" % (key, value))
    text = "\n".join(lines) + "\n\n" + (body or "")
    sys.stdout.write(text if text.endswith("\n") else text + "\n")
    return 0


def _fetch_included(real, path, etag, fields=()):
    argv = [real, "api", "--include", "--method", "GET"]
    if etag:
        argv += ["-H", "If-None-Match: %s" % etag]
    for field in fields:
        argv += ["-f", field]
    argv.append(path)
    result = subprocess.run(argv, capture_output=True, text=True, env=child_env(path))
    status, headers, body = parse_included(result.stdout or "")
    return status, headers, body, result.returncode, result.stderr or ""


def _emit(body: str, jq) -> int:
    import sys
    if not jq:
        sys.stdout.write(body if body.endswith("\n") or not body else body + "\n")
        return 0
    result = subprocess.run(["jq", "-r", "-c", "-S", jq], input=body, capture_output=True, text=True)
    sys.stdout.write(result.stdout or "")
    if result.returncode != 0:
        sys.stderr.write(result.stderr or "")
    return result.returncode


def _passthrough(real, argv, env) -> int:
    result = subprocess.run([real, *argv[1:]], env=env)
    return result.returncode


def sys_argv():
    import sys
    return sys.argv


def sys_stderr(text: str) -> None:
    import sys
    if text:
        sys.stderr.write(text if text.endswith("\n") else text + "\n")


if __name__ == "__main__":
    raise SystemExit(wrap_main())
