PRUNE_EVERY = 600
PRUNE_MAX_AGE = 86400
PRUNE_CAP = 2 * 1024 ** 3
PRUNE_BUDGET = 2.0
LOG_ROLL_BYTES = 50 * 1024 ** 2
LOG_ROLL_KEEP = 2
LOG_ROLL_BYTES_ENV = "GH_CALL_LOG_ROLL_BYTES"
