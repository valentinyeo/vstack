#!/usr/bin/env bash
# install: point Claude Code, Codex, Cursor, pi and shared agents at these skills.
# Safe to run twice. A stale symlink is replaced. A real file or directory with
# the same skill name is moved to ~/.local/state/skill-dupes-<epoch>/ and kept.
set -euo pipefail

ROOT=$(cd "$(dirname "$0")" && pwd -P)
SRC="$ROOT/skills"
SHARE=${VSTACK_DIR:-$HOME/.local/share/vstack}
EPOCH=$(date +%s)
DUPES="$HOME/.local/state/skill-dupes-$EPOCH"
moved=0

# One checkout links every chat onto itself. A git worktree that runs this would
# hand every chat an unmerged branch, so only the shared checkout may run it
# (VSTA-47). Tests set VSTACK_INSTALL_ANYWHERE=1 and a throwaway HOME (VSTA-135).
SHARE_REAL=$(cd "$SHARE" 2>/dev/null && pwd -P) || SHARE_REAL=$SHARE
if [ "$ROOT" != "$SHARE_REAL" ]; then
  if [ "${VSTACK_INSTALL_ANYWHERE:-0}" != 1 ]; then
    echo "vstack install: refusing to link from $ROOT; run ~/.local/share/vstack/install, or set VSTACK_INSTALL_ANYWHERE=1 with a throwaway HOME for a test checkout" >&2
    exit 2
  fi
  LOGIN_HOME=$(getent passwd "$(id -un)" 2>/dev/null | cut -d: -f6)
  if [ -z "$LOGIN_HOME" ]; then
    LOGIN_HOME=$(eval echo ~"$(id -un)")
  fi
  HOME_REAL=$(cd "$HOME" 2>/dev/null && pwd -P) || HOME_REAL=$HOME
  LOGIN_HOME_REAL=$(cd "$LOGIN_HOME" 2>/dev/null && pwd -P) || LOGIN_HOME_REAL=$LOGIN_HOME
  if [ "$HOME_REAL" = "$LOGIN_HOME_REAL" ]; then
    echo "vstack install: VSTACK_INSTALL_ANYWHERE=1 must use a throwaway HOME; refusing to link into $HOME" >&2
    exit 2
  fi
fi

if [ ! -d "$SRC" ]; then
  echo "vstack install: no skills dir at $SRC" >&2
  exit 1
fi

# One copy of the repo. The stable path points at this checkout.
# pwd -P so a second run cannot replace that path with a link to itself.
if [ "$ROOT" = "$SHARE" ]; then
  :
elif [ -d "$SHARE" ] && [ ! -L "$SHARE" ]; then
  if [ "$(cd "$SHARE" && pwd -P)" != "$ROOT" ]; then
    echo "vstack install: $SHARE is its own checkout. Linking skills from $ROOT." >&2
  fi
else
  mkdir -p "$(dirname "$SHARE")"
  ln -sfn "$ROOT" "$SHARE"
fi

dests=(
  "$HOME/.claude/skills"
  "$HOME/.codex/skills"
  "$HOME/.cursor/skills"
  "$HOME/.pi/agent/skills"
  "$HOME/.agents/skills"
  "$HOME/.gemini/antigravity-cli/skills"
  "$HOME/.gemini/config/skills"
)

link_one() {
  local name=$1 target=$2 dest=$3 t bucket
  t="$dest/$name"
  mkdir -p "$dest"
  if [ -L "$t" ] || [ ! -e "$t" ]; then
    ln -sfn "$target" "$t"
    return
  fi
  bucket="$DUPES${dest#"$HOME"}"
  mkdir -p "$bucket"
  mv "$t" "$bucket/$name"
  moved=1
  ln -sfn "$target" "$t"
  echo "vstack install: moved $t to $bucket/$name" >&2
}

shopt -s nullglob
for s in "$SRC"/*/; do
  name=$(basename "$s")
  # hypertask-work holds only scripts now; its SKILL.md moved to skills/hypertask.
  # The reconcile and lease tools keep their old path, so the folder stays linked.
  if [ ! -f "$s/SKILL.md" ] && [ "$name" != hypertask-work ]; then
    continue
  fi
  target=$(cd "$s" && pwd -P)
  if [ -f "$s/SKILL.md" ] && grep -q '^hooks:' "$s/SKILL.md"; then
    target=$(python3 "$ROOT/scripts/install-hook-config.py" --skill "$s")
  else
    link_one "$name" "$target" "$HOME/.local/state/vstack/skills"
  fi
  for dest in "${dests[@]}"; do
    link_one "$name" "$target" "$dest"
  done
done

# An installed valentin-mode is assembled from links, so its own folder has no
# git history and version.sh had nothing to count (VSTA-203). Stamp the counts
# from this checkout next to the installed script; version.sh reads git first
# and falls back to this file.
stamp_version() {
  local dest="$HOME/.local/state/vstack/skills/valentin-mode" count latest
  [ -d "$dest" ] || return 0
  count=$(git -C "$ROOT" rev-list --count HEAD -- skills/valentin-mode 2>/dev/null) || count=
  case "$count" in '' | *[!0-9]*) return 0 ;; esac
  latest=$(git -C "$ROOT" rev-list --count origin/main -- skills/valentin-mode 2>/dev/null) || latest=
  case "$latest" in '' | *[!0-9]*) latest=$count ;; esac
  printf '# written by vstack install; version.sh reads it when git cannot.\ncount=%s\nlatest=%s\n' \
    "$count" "$latest" > "$dest/VERSION.vstack-tmp"
  mv "$dest/VERSION.vstack-tmp" "$dest/VERSION"
}
stamp_version

# Retired skills that now live inside another skill. Move a real folder to the
# dupes store; never delete it. A link is the old install, so drop the link.
for name in ticket hypertask-checkup; do
  for dest in "${dests[@]}"; do
    t="$dest/$name"
    if [ -L "$t" ]; then
      rm -f "$t"
      echo "vstack install: removed retired link $t" >&2
      continue
    fi
    if [ ! -e "$t" ]; then
      continue
    fi
    bucket="$DUPES${dest#"$HOME"}"
    mkdir -p "$bucket"
    mv "$t" "$bucket/$name"
    moved=1
    echo "vstack install: moved $t to $bucket/$name" >&2
  done
done

# Ship the launcher, hooks and their imported helpers together, not a second list.
for hook in "$ROOT"/hooks/*; do
  [ -f "$hook" ] || continue
  link_one "$(basename "$hook")" "$hook" "$HOME/.claude/hooks"
done
link_one vps-state "$ROOT/skills/vps-state/vps-state" "$HOME/.local/bin"
# vps-tidy is the one cleaner for temp files, caches, docker leftovers and stray
# programs. Any chat runs it from its own loop; this script only links the tool.
link_one vps-tidy "$ROOT/skills/vps-tidy/vps-tidy" "$HOME/.local/bin"
link_one excalidraw-share "$ROOT/skills/excalidraw/excalidraw-share" "$HOME/.local/bin"
link_one ci-key-set "$ROOT/tools/ci-key-set" "$HOME/.local/bin"

# pstack's watch-pr runs on bun (VSTA-229); a throwaway HOME skips the download,
# so tests and verify runs stay off the network.
if [ "${VSTACK_INSTALL_ANYWHERE:-0}" != 1 ]; then
  "$ROOT/scripts/install-bun" || echo "vstack install: the bun step did not run; pstack watch-pr will not run" >&2
fi

# Chats read one server facts file (VSTA-146). A hand-written tools.md note had
# the two servers the wrong way round and said only inne runs on Hetzner, and a
# chat repeated it. Link the file every harness already reads reference notes
# from, so the old claim cannot come back and Multi Bot can read the JSON twin.
link_one servers.md "$ROOT/docs/servers.md" "$HOME/.claude/reference"
link_one servers.json "$ROOT/config/servers.json" "$HOME/.claude/reference"

if [ "$moved" -eq 0 ]; then
  echo "vstack install: linked skills from $ROOT"
else
  echo "vstack install: linked skills from $ROOT; plain copies in $DUPES"
fi

if [ -f "$ROOT/scripts/merge-antigravity-hooks.py" ]; then
  python3 "$ROOT/scripts/merge-antigravity-hooks.py" || {
    echo "vstack install: merge-antigravity-hooks failed" >&2
    exit 1
  }
else
  echo "vstack install: skip antigravity hooks (no $ROOT/scripts/merge-antigravity-hooks.py)" >&2
fi

# Pacer workers on OpenCode and Antigravity never run Claude hooks, so the same refusal
# is generated as a command shim on a folder plan-pick puts first on a worker's PATH
# (VSTA-165). The shims come from the config the hook reads, so the two cannot drift.
python3 "$ROOT/scripts/worker-shims" --dir "$HOME/.local/state/vstack/worker-shims" \
  --hook "$HOME/.claude/hooks/heavy-local-guard.py" \
  --pr-cap-hook "$HOME/.claude/hooks/pr-cap-guard.py" \
  --agent-lane-hook "$HOME/.claude/hooks/agent-lane-guard.py" || {
  echo "vstack install: worker-shims failed; pacer workers have no guard" >&2
}

# Record the commit this install came from. A chat links to this checkout, so a
# chat that reports a broken hook can be tied to the tree it is actually
# running, rather than the one someone thought was installed (VSTA-137).
python3 - "$ROOT" "$HOME/.local/state/vstack/install.json" <<'PY'
import datetime
import json
import os
import subprocess
import sys
from pathlib import Path

root, destination = sys.argv[1], Path(sys.argv[2])
commit = subprocess.run(['git', '-C', root, 'rev-parse', 'HEAD'],
                        capture_output=True, text=True).stdout.strip() or 'unknown'
destination.parent.mkdir(parents=True, exist_ok=True)
entry = {'root': root, 'commit': commit,
         'at': datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')}
temporary = destination.with_name(destination.name + '.tmp')
temporary.write_text(json.dumps(entry, indent=2) + '\n')
os.replace(temporary, destination)
PY

# repo-tidy runs explicitly after this chat merges work.
link_one repo-tidy "$ROOT/skills/repo-tidy/repo-tidy" "$HOME/.local/bin"
link_one vstack-feedback "$ROOT/skills/vstack-feedback/vstack-feedback" "$HOME/.local/bin"
link_one failed-handover "$ROOT/skills/long-chat/failed-handover" "$HOME/.local/bin"
link_one worker-shims "$ROOT/scripts/worker-shims" "$HOME/.local/bin"

# Remove retired registrations before their links, including the old bare Python
# command that would otherwise block every prompt when its file disappears.
retired_hooks=(claude-helper-gate.py gh-watch-guard.py launch-gate.py plan-pick-only.py pstack-reply.py reconcile-auto.py repo-tidy-stop)
python3 - "$HOME/.claude/settings.json" "$ROOT/.claude/settings.local.json" -- "${retired_hooks[@]}" <<'PY'
import json
import os
from pathlib import Path
import re
import sys

split = sys.argv.index('--')
pattern = re.compile(r'/hooks/(?:' + '|'.join(re.escape(name) for name in sys.argv[split + 1:])
                     + r''')(?=[\s"';]|$)''')
for name in sys.argv[1:split]:
    path = Path(name)
    if not path.is_file():
        continue
    data = json.loads(path.read_text())
    changed = False
    for event, groups in list(data.get('hooks', {}).items()):
        kept = []
        event_changed = False
        for group in groups:
            hooks = group.get('hooks', [])
            remaining = [hook for hook in hooks if not pattern.search(hook.get('command', ''))]
            if len(remaining) == len(hooks):
                kept.append(group)
                continue
            event_changed = True
            if remaining:
                kept.append(dict(group, hooks=remaining))
        if event_changed:
            changed = True
            data['hooks'][event] = kept
    if changed:
        temporary = path.with_name(path.name + '.vstack-tmp')
        temporary.write_text(json.dumps(data, indent=2) + '\n')
        temporary.chmod(path.stat().st_mode & 0o777)
        os.replace(temporary, path)
PY

# A hook named only in a repo's .claude/settings.json fires only in chats whose cwd is
# that repo, so a Multi Bot chat on its own project reached neither the PR cap nor the
# valentin-mode reload (VSTA-204, VSTA-207). Register the hooks every chat needs in user
# settings through run-hook, once however often this runs.
SKILL_UPDATE_HOOK='{"type": "command", "command": "\"$HOME/.local/share/vstack/hooks/run-hook\" \"$HOME/.claude/hooks/skill-update.py\""}'
PR_CAP_HOOK='{"type": "command", "command": "\"$HOME/.local/share/vstack/hooks/run-hook\" \"$HOME/.claude/hooks/pr-cap-guard.py\"", "timeout": 30}'
AGENT_LANE_HOOK='{"type": "command", "command": "\"$HOME/.local/share/vstack/hooks/run-hook\" \"$HOME/.claude/hooks/agent-lane-guard.py\"", "timeout": 10}'
python3 "$ROOT/scripts/register-user-hook.py" --event UserPromptSubmit \
  --entry "$SKILL_UPDATE_HOOK" || {
  echo "vstack install: could not register skill-update in ~/.claude/settings.json" >&2
  exit 1
}
python3 "$ROOT/scripts/register-user-hook.py" --event PreToolUse \
  --matcher Bash --matcher 'mcp__.*create_pull_request' \
  --entry "$PR_CAP_HOOK" || {
  echo "vstack install: could not register pr-cap-guard in ~/.claude/settings.json" >&2
  exit 1
}
python3 "$ROOT/scripts/register-user-hook.py" --event PreToolUse \
  --matcher Bash \
  --entry "$AGENT_LANE_HOOK" || {
  echo "vstack install: could not register agent-lane-guard in ~/.claude/settings.json" >&2
  exit 1
}

# Migrate only this checkout's registered hooks, after their files are installed.
if [ -f "$ROOT/scripts/install-hook-config.py" ]; then
  python3 "$ROOT/scripts/install-hook-config.py"
fi

# Drop retired links from older installs; preserve real files and unrelated hooks.
for name in "${retired_hooks[@]}"; do
  [ ! -L "$HOME/.claude/hooks/$name" ] || rm -f "$HOME/.claude/hooks/$name"
done
