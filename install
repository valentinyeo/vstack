#!/usr/bin/env bash
# install: point Claude Code, Codex, Cursor, pi and shared agents at these skills.
# Safe to run twice. A stale symlink is replaced. A real file or directory with
# the same skill name is moved to ~/.local/state/skill-dupes-<epoch>/ and kept.
set -euo pipefail

ROOT=$(cd "$(dirname "$0")" && pwd -P)
SRC="$ROOT/skills"
SHARE=${VSTACK_DIR:-$HOME/.local/share/vstack}
EPOCH=$(date +%s)
DUPES="$HOME/.local/state/skill-dupes-$EPOCH"
moved=0

# One checkout links every chat onto itself. A git worktree that runs this would
# hand every chat an unmerged branch, so only the shared checkout may run it
# (VSTA-47). Tests and throwaway HOMEs set VSTACK_INSTALL_ANYWHERE=1.
SHARE_REAL=$(cd "$SHARE" 2>/dev/null && pwd -P) || SHARE_REAL=$SHARE
if [ "$ROOT" != "$SHARE_REAL" ] && [ "${VSTACK_INSTALL_ANYWHERE:-0}" != 1 ]; then
  echo "vstack install: refusing to link from $ROOT; run ~/.local/share/vstack/install, or set VSTACK_INSTALL_ANYWHERE=1 for a test checkout" >&2
  exit 2
fi

if [ ! -d "$SRC" ]; then
  echo "vstack install: no skills dir at $SRC" >&2
  exit 1
fi

# One copy of the repo. The stable path points at this checkout.
# pwd -P so a second run cannot replace that path with a link to itself.
if [ "$ROOT" = "$SHARE" ]; then
  :
elif [ -d "$SHARE" ] && [ ! -L "$SHARE" ]; then
  if [ "$(cd "$SHARE" && pwd -P)" != "$ROOT" ]; then
    echo "vstack install: $SHARE is its own checkout. Linking skills from $ROOT." >&2
  fi
else
  mkdir -p "$(dirname "$SHARE")"
  ln -sfn "$ROOT" "$SHARE"
fi

dests=(
  "$HOME/.claude/skills"
  "$HOME/.codex/skills"
  "$HOME/.cursor/skills"
  "$HOME/.pi/agent/skills"
  "$HOME/.agents/skills"
)

link_one() {
  local name=$1 target=$2 dest=$3 t bucket
  t="$dest/$name"
  mkdir -p "$dest"
  if [ -L "$t" ] || [ ! -e "$t" ]; then
    ln -sfn "$target" "$t"
    return
  fi
  bucket="$DUPES${dest#"$HOME"}"
  mkdir -p "$bucket"
  mv "$t" "$bucket/$name"
  moved=1
  ln -sfn "$target" "$t"
  echo "vstack install: moved $t to $bucket/$name" >&2
}

shopt -s nullglob
for s in "$SRC"/*/; do
  name=$(basename "$s")
  # hypertask-work holds only scripts now; its SKILL.md moved to skills/hypertask.
  # The reconcile and lease tools keep their old path, so the folder stays linked.
  if [ ! -f "$s/SKILL.md" ] && [ "$name" != hypertask-work ]; then
    continue
  fi
  target=$(cd "$s" && pwd -P)
  for dest in "${dests[@]}"; do
    link_one "$name" "$target" "$dest"
  done
done

# Retired skills that now live inside another skill. Move a real folder to the
# dupes store; never delete it. A link is the old install, so drop the link.
for name in ticket hypertask-checkup; do
  for dest in "${dests[@]}"; do
    t="$dest/$name"
    if [ -L "$t" ]; then
      rm -f "$t"
      echo "vstack install: removed retired link $t" >&2
      continue
    fi
    if [ ! -e "$t" ]; then
      continue
    fi
    bucket="$DUPES${dest#"$HOME"}"
    mkdir -p "$bucket"
    mv "$t" "$bucket/$name"
    moved=1
    echo "vstack install: moved $t to $bucket/$name" >&2
  done
done

# These hooks need a ~/.claude/hooks path. This script never edits a settings
# file: each chat adds the Stop hook and its PreToolUse guards to its own
# project's .claude/settings.json.

# Claude settings call this guard at its ~/.claude/hooks path; the copy lives here (SOFT-2845).
link_one agent-identity-guard.py "$ROOT/hooks/agent-identity-guard.py" "$HOME/.claude/hooks"
link_one pacer-guard.py "$ROOT/hooks/pacer-guard.py" "$HOME/.claude/hooks"
link_one reconcile-auto.py "$ROOT/hooks/reconcile-auto.py" "$HOME/.claude/hooks"
link_one test-timeout-guard.py "$ROOT/hooks/test-timeout-guard.py" "$HOME/.claude/hooks"
link_one pstack-new-gates.py "$ROOT/hooks/pstack-new-gates.py" "$HOME/.claude/hooks"

# vps-state answers "can this server take another chat or worker", and the
# SessionStart hook can print that answer as a session opens. This script only
# links the script and the hook file. Each chat registers the hook in its own
# project's .claude/settings.json, as skills/vps-state/SKILL.md says.
link_one vps-state "$ROOT/skills/vps-state/vps-state" "$HOME/.local/bin"
link_one vps-state-hook "$ROOT/hooks/vps-state-hook" "$HOME/.claude/hooks"

# vps-tidy is the one cleaner for temp files, caches, docker leftovers and stray
# programs. Any chat runs it from its own loop; this script only links the tool.
link_one vps-tidy "$ROOT/skills/vps-tidy/vps-tidy" "$HOME/.local/bin"
# launch-gate blocks a worker, build or test run while vps-state says HOLD; each
# chat registers it in its own project with --install-for-project.
link_one launch-gate.py "$ROOT/hooks/launch-gate.py" "$HOME/.claude/hooks"
link_one plan-pick-only.py "$ROOT/hooks/plan-pick-only.py" "$HOME/.claude/hooks"
link_one claude-helper-gate.py "$ROOT/hooks/claude-helper-gate.py" "$HOME/.claude/hooks"

# skill-update keeps the shared checkout current and tells a chat to re-read a
# changed valentin-mode (VSTA-56). It still needs registering as a
# UserPromptSubmit hook in each project's .claude/settings.json.
link_one skill-update.py "$ROOT/hooks/skill-update.py" "$HOME/.claude/hooks"

# The two lane hooks act only in a chat that loaded valentin-mode, so they are
# safe to register once in the global ~/.claude/settings.json (VSTA-70). They
# import their sibling modules by path, so those are linked too.
link_one plan-pick-only.py "$ROOT/hooks/plan-pick-only.py" "$HOME/.claude/hooks"
link_one claude-helper-gate.py "$ROOT/hooks/claude-helper-gate.py" "$HOME/.claude/hooks"
link_one valentin_mode_loaded.py "$ROOT/hooks/valentin_mode_loaded.py" "$HOME/.claude/hooks"
link_one book-check.py "$ROOT/hooks/book-check.py" "$HOME/.claude/hooks"

if [ "$moved" -eq 0 ]; then
  echo "vstack install: linked skills from $ROOT"
else
  echo "vstack install: linked skills from $ROOT; plain copies in $DUPES"
fi

# repo-tidy: the command, and the Stop hook each chat adds to its own project (SOFT-2937).
link_one repo-tidy "$ROOT/skills/repo-tidy/repo-tidy" "$HOME/.local/bin"
link_one repo-tidy-stop "$ROOT/hooks/repo-tidy-stop" "$HOME/.claude/hooks"
