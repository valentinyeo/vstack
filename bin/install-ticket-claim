#!/usr/bin/env python3
"""Install Poteto's claim route without replacing unrelated global guards."""
from pathlib import Path
import shutil

ROOT = Path(__file__).resolve().parents[1]
GUARD = Path.home() / '.claude/hooks/ticket-first-guard.py'
INSTALLED = Path.home() / '.local/lib/poteto-ticket/poteto-ticket'
MARKER = '    # poteto-ticket claim route (SOFT-2573)\n'
ROUTE = '''    # poteto-ticket claim route (SOFT-2573)
    cwd = Path(data.get("cwd") or ".").resolve()
    command = (data.get("tool_input") or {}).get("command", "")
    if (any(p.name == "poteto-2-advisor" or (p / "bin/poteto-ticket").is_file()
            for p in (cwd, *cwd.parents)) and data.get("tool_name") == "Bash"
            and WORKER.search(command) and not any(x in command for x in
                ("NO_TICKET_REASON=", "--help", "--dry-run"))):
        text = command + "\\n" + brief_text(command)
        key = re.search(r"\\bSOFT-([1-9][0-9]*)\\b", text)
        url = re.search(r"app\\.hypertask\\.ai/detail/project-2060/([1-9][0-9]*)", text)
        if key or url:
            ticket = "SOFT-" + (key or url).group(1)
            helper = Path.home() / ".local/lib/poteto-ticket/poteto-ticket"
            result = subprocess.run([sys.executable, str(helper), "claim", ticket],
                                    capture_output=True, text=True)
            print(result.stdout, end="")
            print(result.stderr, end="", file=sys.stderr)
            return result.returncode
'''


def main():
    text = GUARD.read_text()
    if MARKER not in text:
        anchor = 'def claim(data):\n'
        if text.count(anchor) != 1:
            raise SystemExit('Cannot locate claim(data). Global guard unchanged.')
        backup = GUARD.with_suffix('.py.before-poteto-ticket')
        if not backup.exists():
            shutil.copy2(GUARD, backup)
        updated = text.replace(anchor, anchor + ROUTE)
        compile(updated, str(GUARD), 'exec')
        GUARD.write_text(updated)
    INSTALLED.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(ROOT / 'bin/poteto-ticket', INSTALLED)
    print('Installed Poteto claim route. Other claim routes preserved.')


if __name__ == '__main__':
    main()
